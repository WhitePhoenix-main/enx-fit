@page
@model ResetPasswordModel
@{
    ViewData["Title"] = "Новый пароль";
    ViewData["AuthDescription"] = "Укажите email аккаунта и новый пароль.";
    ViewData["AuthBackUrl"] = Url.Page("./ForgotPassword", new { returnUrl = Model.ReturnUrl });
    ViewData["AuthBackLabel"] = "К восстановлению";
}
<partial name="_AuthStepHeader" />
<section class="auth-card auth-step-card">
@if (Model.HasValidLink) {
    <form method="post" asp-route-returnUrl="@Model.ReturnUrl" data-auth-form>
        <div asp-validation-summary="ModelOnly" class="auth-errors app-status app-notice" data-app-state="error" role="alert"></div>
        <input asp-for="Input.Code" type="hidden" />
        <div class="auth-field"><label asp-for="Input.Email">Email аккаунта</label><div class="auth-input"><svg class="auth-icon" aria-hidden="true"><use href="#auth-mail" /></svg><input asp-for="Input.Email" type="email" autocomplete="username" inputmode="email" spellcheck="false" placeholder="name@domain.com" aria-describedby="email-error" required /></div><span asp-validation-for="Input.Email" id="email-error" class="auth-field-error"></span></div>
        <div class="auth-field"><label asp-for="Input.Password">Новый пароль</label><div class="auth-input"><svg class="auth-icon" aria-hidden="true"><use href="#auth-lock" /></svg><input asp-for="Input.Password" autocomplete="new-password" placeholder="Придумайте пароль" aria-describedby="password-error password-hint" required /><button class="auth-reveal app-icon-button" type="button" data-reveal="Input_Password" aria-label="Показать пароль" aria-pressed="false" hidden><svg class="auth-icon" aria-hidden="true"><use href="#auth-eye-off" /></svg></button></div><span asp-validation-for="Input.Password" id="password-error" class="auth-field-error"></span><p id="password-hint" class="auth-hint">@Model.PasswordHint</p></div>
        <div class="auth-field"><label asp-for="Input.ConfirmPassword">Повторите пароль</label><div class="auth-input"><svg class="auth-icon" aria-hidden="true"><use href="#auth-lock" /></svg><input asp-for="Input.ConfirmPassword" autocomplete="new-password" placeholder="Введите пароль ещё раз" aria-describedby="confirm-error" required /><button class="auth-reveal app-icon-button" type="button" data-reveal="Input_ConfirmPassword" aria-label="Показать повторный пароль" aria-pressed="false" hidden><svg class="auth-icon" aria-hidden="true"><use href="#auth-eye-off" /></svg></button></div><span asp-validation-for="Input.ConfirmPassword" id="confirm-error" class="auth-field-error"></span></div>
        <button type="submit" class="auth-submit app-button"><span>Сохранить новый пароль</span><svg class="auth-icon" aria-hidden="true"><use href="#auth-arrow" /></svg></button>
        <p data-auth-feedback class="auth-form-feedback app-status app-notice" data-app-state="info" hidden role="status" aria-live="polite"></p>
    </form>
} else {
    <div class="auth-notice is-error app-status app-notice" data-app-state="error"><h2>Ссылка не подходит</h2><p>Откройте полную ссылку из письма или запросите новую.</p></div>
}
    <p class="auth-secondary-link"><a asp-page="./ForgotPassword" asp-route-returnUrl="@Model.ReturnUrl">Запросить новую ссылку</a></p>
</section>
