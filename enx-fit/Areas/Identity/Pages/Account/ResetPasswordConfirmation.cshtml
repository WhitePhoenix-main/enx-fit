@page
@using enx_fit.Services.Accounts
@model ResetPasswordConfirmationModel
@{
    ViewData["Title"] = Model.Succeeded ? "Пароль изменён" : "Восстановление доступа";
    ViewData["AuthDescription"] = Model.Succeeded ? "Теперь войдите с новым паролем." : "Для изменения пароля откройте ссылку из письма.";
    var destination = AuthPageLinks.LocalReturnUrl(Url, Request.Query["returnUrl"]);
}
<partial name="/Pages/Shared/Account/_AuthStepHeader.cshtml" />
<section class="auth-card auth-step-card">
    <div class="auth-notice app-status app-notice" data-app-state="@(Model.Succeeded ? "saved" : "info")" role="status"><h2>@(Model.Succeeded ? "Используйте новый пароль" : "Вернитесь к входу")</h2><p>@(Model.Succeeded ? "Вход в аккаунт выполнится после проверки новых данных." : "Если уже изменили пароль, используйте его при входе.")</p></div>
    <a class="auth-submit app-button" asp-area="" asp-page="/Account/Login" asp-route-returnUrl="@destination">Войти в Enix Fit</a>
</section>
