@page
@model LockoutModel
@{
    ViewData["Title"] = "Вход временно ограничен";
    ViewData["AuthDescription"] = "Слишком много попыток входа. Подождите и попробуйте позже.";
}
<partial name="_AuthStepHeader" />
<section class="auth-card auth-step-card">
    <div class="auth-notice app-status app-notice" data-app-state="info"><h2>Можно вернуться позже</h2><p>Проверьте раскладку клавиатуры и данные аккаунта. Если пароль забыт, используйте восстановление доступа.</p></div>
    <a class="auth-submit app-button" asp-area="" asp-page="/TechnicalPages/Login">Вернуться к входу</a>
    <p class="auth-secondary-link"><a asp-page="./ForgotPassword">Восстановить доступ</a></p>
</section>
