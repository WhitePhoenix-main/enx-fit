@page
@model ForgotPasswordConfirmation
@using enx_fit.Services
@inject Microsoft.AspNetCore.Identity.UI.Services.IEmailSender EmailSender
@{
    ViewData["Title"] = AccountEmailDelivery.IsAvailable(EmailSender) ? "Проверьте почту" : "Восстановление доступа";
    ViewData["AuthDescription"] = "Для смены пароля нужна ссылка из письма.";
    var destination = AuthPageLinks.LocalReturnUrl(Url, Request.Query["returnUrl"]);
}
<partial name="_AuthStepHeader" />
<section class="auth-card auth-step-card">
    <div class="auth-notice app-status app-notice" data-app-state="info">
    @if (AccountEmailDelivery.IsAvailable(EmailSender)) {
        <h2>Следующий шаг — открыть письмо</h2><p>Если адрес подтверждён и связан с аккаунтом, проверьте почту и папку «Спам».</p>
    } else { <h2>Отправка писем не подключена</h2><p>Восстановление по email пока недоступно.</p> }
    </div>
    <a class="auth-submit app-button" asp-area="" asp-page="/TechnicalPages/Login" asp-route-returnUrl="@destination">Вернуться к входу</a>
    <p class="auth-secondary-link"><a asp-page="./ForgotPassword" asp-route-returnUrl="@destination">Вернуться к восстановлению</a></p>
</section>
