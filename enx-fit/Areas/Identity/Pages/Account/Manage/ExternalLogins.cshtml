@page
@model ExternalLoginsModel
@{ ViewData["Title"] = "Способы входа"; ViewData["ActivePage"] = ManageNavPages.ExternalLogins; }
<partial name="_StatusMessage" for="StatusMessage" />
@if (Model.CurrentLogins?.Count > 0) {
    <h2>Подключённые аккаунты</h2><table class="table"><tbody>@foreach (var login in Model.CurrentLogins) { <tr><td id="@($"login-provider-{login.LoginProvider}")">@login.ProviderDisplayName</td><td>@if (Model.ShowRemoveButton) { <form id="@($"remove-login-{login.LoginProvider}")" asp-page-handler="RemoveLogin" method="post"><input name="LoginProvider" value="@login.LoginProvider" type="hidden" /><input name="ProviderKey" value="@login.ProviderKey" type="hidden" /><button type="submit" class="btn btn-link app-button secondary">Отключить</button></form> }</td></tr> }</tbody></table>
}
@if (Model.OtherLogins?.Count > 0) {
    <h2>Добавить способ входа</h2><form id="link-login-form" asp-page-handler="LinkLogin" method="post"><div id="socialLoginList" class="account-button-row">@foreach (var provider in Model.OtherLogins) { <button id="@($"link-login-button-{provider.Name}")" type="submit" class="btn app-button" name="provider" value="@provider.Name">@provider.DisplayName</button> }</div></form>
}
@if (Model.CurrentLogins?.Count == 0 && Model.OtherLogins?.Count == 0) { <p>Дополнительные способы входа пока недоступны. Используйте логин и пароль.</p> }
