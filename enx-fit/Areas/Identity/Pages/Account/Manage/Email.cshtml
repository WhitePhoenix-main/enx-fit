@page
@model EmailModel
@{ ViewData["Title"] = "Email"; ViewData["ActivePage"] = ManageNavPages.Email; }
<partial name="_StatusMessage" for="StatusMessage" />
<div class="account-field"><label asp-for="Email">Текущий адрес</label><input asp-for="Email" type="email" disabled /><small>@(Model.IsEmailConfirmed ? "Адрес подтверждён." : "Адрес пока не подтверждён.")</small></div>
@if (Model.CanSendEmail) {
    @if (!Model.IsEmailConfirmed) { <form method="post" asp-page-handler="SendVerificationEmail"><button id="email-verification" type="submit" class="btn btn-link">Подтвердить текущий адрес</button></form> }
    <h2>Изменить адрес</h2><p>Новый адрес станет доступен после перехода по ссылке из письма подтверждения.</p>
    <form id="email-form" method="post" asp-page-handler="ChangeEmail" data-account-form><div asp-validation-summary="All" class="text-danger" role="alert"></div><div class="account-field"><label asp-for="Input.NewEmail">Новый email</label><input asp-for="Input.NewEmail" type="email" inputmode="email" autocomplete="email" required /><span asp-validation-for="Input.NewEmail" class="text-danger"></span></div><button id="change-email-button" class="account-save" type="submit" data-account-save>Получить ссылку подтверждения</button><p class="account-feedback" role="status" aria-live="polite" data-account-feedback></p></form>
} else {
    <div asp-validation-summary="All" class="text-danger" role="alert"></div><div class="alert"><strong>Изменение email пока недоступно</strong><p>Продолжайте пользоваться текущим адресом. Подтверждение почты станет доступно после подключения отправки писем.</p></div>
}
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
