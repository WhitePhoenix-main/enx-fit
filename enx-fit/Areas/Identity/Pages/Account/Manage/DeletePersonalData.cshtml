@page
@model DeletePersonalDataModel
@{ ViewData["Title"] = "Удаление аккаунта"; ViewData["ActivePage"] = ManageNavPages.PersonalData; }
<div class="alert alert-warning"><strong>Это действие необратимо</strong><p>Аккаунт будет удалён. Сначала можно скачать свои данные в предыдущем разделе.</p></div>
<form id="delete-user" method="post"><div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>@if (Model.RequirePassword) { <div class="account-field"><label asp-for="Input.Password">Текущий пароль</label><div class="account-password-field"><input asp-for="Input.Password" autocomplete="current-password" required data-password-reveal /></div><span asp-validation-for="Input.Password" class="text-danger"></span></div> }<button class="btn btn-danger" type="submit">Удалить аккаунт</button></form><p><a asp-page="./PersonalData">Отмена</a></p>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
