@page
@using Microsoft.AspNetCore.Http.Features
@model TwoFactorAuthenticationModel
@{ ViewData["Title"] = "Двухэтапный вход"; ViewData["ActivePage"] = ManageNavPages.TwoFactorAuthentication; }
<partial name="_StatusMessage" for="StatusMessage" />
@{ var consentFeature = HttpContext.Features.Get<ITrackingConsentFeature>(); }
@if (consentFeature?.CanTrack ?? true) {
    <div class="account-security-state"><reference-icon name="shield" /><span><strong>@(Model.Is2faEnabled ? "Двухэтапный вход включён" : "Двухэтапный вход не включён")</strong><small>Код из приложения для подтверждения входа</small></span></div>
    <p>После пароля понадобится одноразовый код из приложения для аутентификации.</p>
    @if (Model.Is2faEnabled) {
        <p>Осталось резервных кодов: <strong>@Model.RecoveryCodesLeft</strong>.</p>
        @if (Model.RecoveryCodesLeft <= 3) { <div class="alert alert-warning">Сохраните новый набор резервных кодов, чтобы входить при потере доступа к приложению.</div> }
        <div class="account-button-row"><a asp-page="./GenerateRecoveryCodes" class="btn btn-link">Новые резервные коды</a>@if (Model.IsMachineRemembered) { <form method="post"><button type="submit" class="btn btn-link">Забыть этот браузер</button></form> }</div>
    }
    <h2>Приложение для аутентификации</h2><a id="enable-authenticator" asp-page="./EnableAuthenticator" class="btn">@(Model.HasAuthenticator ? "Открыть настройку" : "Подключить приложение")</a>
    @if (Model.Is2faEnabled || Model.HasAuthenticator) { <details class="account-danger"><summary>Дополнительные действия</summary><div class="account-button-row">@if (Model.Is2faEnabled) { <a asp-page="./Disable2fa" class="btn btn-danger">Отключить двухэтапный вход</a> }@if (Model.HasAuthenticator) { <a id="reset-authenticator" asp-page="./ResetAuthenticator" class="btn btn-danger">Сбросить ключ приложения</a> }</div></details> }
} else { <div class="alert alert-warning">Для подключения двухэтапного входа нужно разрешить использование необходимых cookie.</div> }
