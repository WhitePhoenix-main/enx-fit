@page
@model ChangePasswordModel
@{ ViewData["Title"] = "Пароль"; ViewData["ActivePage"] = ManageNavPages.ChangePassword; }
<partial name="_StatusMessage" for="StatusMessage" />
<p class="account-intro">Для изменения понадобится текущий пароль.</p><p class="account-hint">@AccountMessages.PasswordHint(Model.PasswordRules)</p>
<form id="change-password-form" method="post" data-account-form>
    <div asp-validation-summary="ModelOnly" class="text-danger app-status app-notice" data-app-state="error" role="alert"></div>
    <div class="account-field"><label asp-for="Input.OldPassword">Текущий пароль</label><div class="account-password-field"><input asp-for="Input.OldPassword" autocomplete="current-password" required data-password-reveal /></div><span asp-validation-for="Input.OldPassword" class="text-danger"></span></div>
    <div class="account-field"><label asp-for="Input.NewPassword">Новый пароль</label><div class="account-password-field"><input asp-for="Input.NewPassword" autocomplete="new-password" required data-password-reveal /></div><span asp-validation-for="Input.NewPassword" class="text-danger"></span></div>
    <div class="account-field"><label asp-for="Input.ConfirmPassword">Повторите новый пароль</label><div class="account-password-field"><input asp-for="Input.ConfirmPassword" autocomplete="new-password" required data-password-reveal /></div><span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span></div>
    <button class="account-save app-button" type="submit" data-account-save>Сохранить новый пароль</button><p class="account-feedback app-status" role="status" aria-live="polite" data-account-feedback></p>
</form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
