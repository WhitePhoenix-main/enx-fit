@page
@model ShowRecoveryCodesModel
@{ ViewData["Title"] = "Резервные коды"; ViewData["ActivePage"] = ManageNavPages.TwoFactorAuthentication; }
<partial name="_StatusMessage" for="StatusMessage" />
<div class="alert alert-warning"><strong>Сохраните коды в доступном вам месте</strong><p>Они позволят войти, если приложение для аутентификации недоступно. Каждый код используется один раз.</p></div>
<div class="account-recovery-codes">@foreach (var code in Model.RecoveryCodes) { <code class="recovery-code">@code</code> }</div><p><a asp-page="./TwoFactorAuthentication">К настройкам входа</a></p>
