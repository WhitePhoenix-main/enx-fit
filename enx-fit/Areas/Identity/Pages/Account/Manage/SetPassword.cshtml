@page
@model SetPasswordModel
@{ ViewData["Title"] = "Создать пароль"; ViewData["ActivePage"] = ManageNavPages.ChangePassword; }
<partial name="_StatusMessage" for="StatusMessage" />
<p class="account-intro">У аккаунта пока нет пароля. Создайте его, чтобы входить с логином и паролем.</p><p class="account-hint">@AccountMessages.PasswordHint(Model.PasswordRules)</p>
<form id="set-password-form" method="post" data-account-form><div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
    <div class="account-field"><label asp-for="Input.NewPassword">Новый пароль</label><div class="account-password-field"><input asp-for="Input.NewPassword" autocomplete="new-password" required data-password-reveal /></div><span asp-validation-for="Input.NewPassword" class="text-danger"></span></div>
    <div class="account-field"><label asp-for="Input.ConfirmPassword">Повторите пароль</label><div class="account-password-field"><input asp-for="Input.ConfirmPassword" autocomplete="new-password" required data-password-reveal /></div><span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span></div>
    <button class="account-save" type="submit" data-account-save>Создать пароль</button><p class="account-feedback" role="status" aria-live="polite" data-account-feedback></p>
</form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
