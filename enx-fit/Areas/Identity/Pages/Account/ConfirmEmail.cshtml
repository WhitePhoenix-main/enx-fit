@page
@model ConfirmEmailModel
@{
    ViewData["Title"] = Model.Succeeded ? "Email подтверждён" : "Подтверждение email";
    ViewData["AuthDescription"] = "Результат подтверждения вашего адреса.";
    ViewData["AuthStatusState"] = Model.Succeeded ? "saved" : "error";
}
<partial name="_AuthStepHeader" />
<section class="auth-card auth-step-card">
    <partial name="_StatusMessage" model="Model.StatusMessage" />
    @if (Model.Succeeded) { <a class="auth-submit app-button" asp-area="" asp-page="/TechnicalPages/Login" asp-route-returnUrl="@Model.ReturnUrl">Войти в Enix Fit</a> }
    else { <a class="auth-submit app-button" asp-page="./ResendEmailConfirmation" asp-route-returnUrl="@Model.ReturnUrl">Запросить новое письмо</a> }
</section>
