@page
@model ForgotPasswordModel
@{
    ViewData["Title"] = "Восстановить доступ";
    ViewData["AuthDescription"] = "Укажите email аккаунта. Для смены пароля понадобится ссылка из письма.";
}
<partial name="_AuthStepHeader" />
<section class="auth-card auth-step-card">
@if (Model.CanSendEmail) {
    <form method="post" asp-route-returnUrl="@Model.ReturnUrl" data-auth-form>
        <div asp-validation-summary="ModelOnly" class="auth-errors" role="alert"></div>
        <div class="auth-field"><label asp-for="Input.Email">Email аккаунта</label><div class="auth-input"><svg class="auth-icon" aria-hidden="true"><use href="#auth-mail" /></svg><input asp-for="Input.Email" type="email" autocomplete="username" inputmode="email" spellcheck="false" placeholder="name@domain.com" aria-describedby="email-error" required /></div><span asp-validation-for="Input.Email" id="email-error" class="auth-field-error"></span></div>
        <button type="submit" class="auth-submit"><span>Получить ссылку</span><svg class="auth-icon" aria-hidden="true"><use href="#auth-arrow" /></svg></button>
        <p data-auth-feedback class="auth-form-feedback" role="status" aria-live="polite"></p>
    </form>
    <p class="auth-hint">Если вы ещё не подтвердили email, сначала запросите письмо подтверждения.</p>
} else {
    <div class="auth-notice"><h2>Восстановление пока недоступно</h2><p>Отправка писем ещё не подключена. Если помните пароль, вернитесь к входу.</p></div>
    <div asp-validation-summary="ModelOnly" class="auth-errors" role="alert"></div>
    <a class="auth-submit" asp-area="" asp-page="/TechnicalPages/Login" asp-route-returnUrl="@Model.ReturnUrl">Вернуться к входу</a>
}
    <p class="auth-secondary-link"><a asp-page="./ResendEmailConfirmation" asp-route-returnUrl="@Model.ReturnUrl">Подтвердить email</a></p>
</section>
