@page
@model AccessDeniedModel
@{
    ViewData["Title"] = "Нет доступа к странице";
    ViewData["AuthDescription"] = "Текущему аккаунту этот раздел недоступен.";
}
<partial name="_AuthStepHeader" />
<section class="auth-card auth-step-card">
    <a class="auth-submit" asp-area="" asp-page="/Dashboard">Открыть главную</a>
    <p class="auth-secondary-link"><a asp-area="" asp-page="/Profile">Перейти в профиль</a></p>
</section>
