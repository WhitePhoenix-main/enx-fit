@page "/Admin/Exercises"
@model enx_fit.Pages.Admin.Exercises.IndexModel
@{ ViewData["Title"] = "Упражнения"; }
<header class="admin-page-heading"><div><p class="admin-eyebrow">БИБЛИОТЕКА ПЛАТФОРМЫ</p><h1>Упражнения <span class="admin-count">@Model.Total</span></h1><p>Проверяйте описание, группу мышц и оборудование.</p></div><a class="btn btn-primary app-button" asp-page="/Exercises/Create"><admin-icon name="plus" />Добавить упражнение</a></header>
<partial name="_AdminStatus" />
<section class="admin-card"><div class="admin-card-heading"><div><h2>Каталог</h2><p>Найдено: @Model.FilteredCount · на странице @Model.Items.Count</p></div><a class="admin-text-link" asp-page="/Exercises/Index">Открыть библиотеку в приложении →</a></div>
<form method="get" class="admin-filter"><label class="admin-search-field"><span class="sr-only">Название или оборудование</span><input class="form-control" asp-for="Search" type="search" maxlength="120" placeholder="Название или оборудование" /></label><label><span class="sr-only">Группа мышц</span><select class="form-select" asp-for="Group"><option value="">Все группы</option>@foreach (var group in Model.Groups) { <option value="@group">@group</option> }</select></label><button class="btn btn-outline-primary app-button secondary" type="submit">Найти</button>@if (!string.IsNullOrEmpty(Model.Search) || !string.IsNullOrEmpty(Model.Group)) { <a class="admin-text-link" asp-page="./Index">Сбросить</a> }</form>
@if (Model.Items.Count == 0) { <div class="admin-empty"><admin-icon name="search" /><h2>Упражнения не найдены</h2><p>Измените запрос или группу мышц.</p><a class="btn btn-outline-secondary app-button secondary" asp-page="./Index">Показать все</a></div> }
else { <div class="table-responsive"><table class="table admin-table admin-responsive-table"><thead><tr><th>Упражнение</th><th>Мышцы</th><th>Оборудование</th><th>Действия</th></tr></thead><tbody>@foreach (var exercise in Model.Items) {
<tr data-admin-exercise="@exercise.Id"><td data-label="Упражнение"><a class="admin-row-title" asp-page="/Exercises/Details" asp-route-id="@exercise.Id">@ExercisePresentation.DisplayName(exercise)</a></td><td data-label="Мышцы">@exercise.MuscleGroup</td><td data-label="Оборудование">@exercise.Equipment</td><td data-label="Действия" class="admin-row-actions"><a class="btn btn-sm app-button secondary" asp-page="/Exercises/Details" asp-route-id="@exercise.Id">Открыть</a><a class="btn btn-sm btn-outline-primary app-button secondary" asp-page="/Exercises/Edit" asp-route-id="@exercise.Id">Изменить</a><a class="btn btn-sm btn-outline-danger app-button danger" asp-page="/Exercises/Delete" asp-route-id="@exercise.Id">Удалить</a></td></tr>
}</tbody></table></div> }
<div class="admin-table-footer"><span>Каталог · @Model.FilteredCount записей</span><nav class="admin-pagination" aria-label="Страницы упражнений">@if (Model.PageNumber > 1) { <a class="btn btn-sm app-button secondary" asp-route-PageNumber="@(Model.PageNumber-1)" asp-route-Search="@Model.Search" asp-route-Group="@Model.Group" aria-label="Предыдущая страница"><admin-icon name="back" /></a> }<span>@Model.PageNumber / @Model.PageCount</span>@if (Model.PageNumber < Model.PageCount) { <a class="btn btn-sm app-button secondary" asp-route-PageNumber="@(Model.PageNumber+1)" asp-route-Search="@Model.Search" asp-route-Group="@Model.Group" aria-label="Следующая страница"><admin-icon name="arrow" /></a> }</nav></div></section>
