@page "{id}"
@model enx_fit.Pages.Admin.Users.EditModel
@{ ViewData["Title"] = "Профиль пользователя"; }
<header class="admin-page-heading"><div><p class="admin-eyebrow">ПОЛЬЗОВАТЕЛИ / ПРОФИЛЬ</p><h1>Редактирование профиля</h1><p>Контакты, доступ и назначенный тренер.</p></div><a class="btn btn-outline-secondary app-button secondary" asp-page="./Index" asp-route-Search="@Model.DirectorySearch" asp-route-Role="@Model.DirectoryRole" asp-route-PageNumber="@Model.DirectoryPage"><admin-icon name="back" />К списку</a></header>
<partial name="_AdminStatus" />
<div class="admin-edit-grid">
<section class="admin-card"><div class="admin-card-heading"><div><h2>@Model.Input.UserName</h2><p>@(Model.IsCurrentUser ? "Ваш аккаунт" : "Выбранный пользователь")</p></div><admin-icon name="users" /></div>
<form method="post" class="admin-form" data-admin-form>
<input asp-for="DirectorySearch" type="hidden" /><input asp-for="DirectoryRole" type="hidden" /><input asp-for="DirectoryPage" type="hidden" />
<div asp-validation-summary="All" class="alert alert-danger app-status app-notice" data-app-state="error" role="alert"></div>
<div class="mb-3"><label class="form-label" asp-for="Input.UserName"></label><input class="form-control" asp-for="Input.UserName" autocomplete="off" /><span class="text-danger" asp-validation-for="Input.UserName"></span></div>
<div class="mb-3"><label class="form-label" asp-for="Input.Email"></label><input class="form-control" asp-for="Input.Email" type="email" inputmode="email" autocomplete="off" /><span class="text-danger" asp-validation-for="Input.Email"></span><small class="admin-field-help">При изменении адреса потребуется повторное подтверждение email.</small></div>
<div class="mb-3"><label class="form-label" asp-for="Input.PhoneNumber"></label><input class="form-control" asp-for="Input.PhoneNumber" type="tel" autocomplete="off" placeholder="+7…" /><span class="text-danger" asp-validation-for="Input.PhoneNumber"></span></div>
<details class="admin-access-fields app-disclosure" open="@Model.AccessExpanded"><summary><span>Права, план и тренер<small>Дополнительные настройки аккаунта</small></span><admin-icon name="chevron" /></summary><div>
<div class="mb-3"><label class="form-label" asp-for="Input.Role"></label>
@if (Model.IsCurrentUser) { <input type="hidden" asp-for="Input.Role" /><p><span class="admin-badge purple">@((int)Model.Input.Role) — @Model.Input.Role.DisplayName()</span></p><small class="admin-field-help">Роль своего аккаунта изменить нельзя.</small> }
else { <select class="form-select" asp-for="Input.Role">@foreach (var role in Model.AvailableRoles) { <option value="@((int)role)">@((int)role) — @role.DisplayName()</option> }</select><small class="admin-field-help">Можно назначить роль до своего уровня включительно.</small> }
<span class="text-danger" asp-validation-for="Input.Role"></span></div>
<div class="mb-3"><label class="form-label" asp-for="Input.SubscriptionPlan">План Enix Fit</label><select class="form-select" asp-for="Input.SubscriptionPlan"><option value="Free">Athlete Free</option><option value="Pro">Athlete Pro</option><option value="Coach">Coach</option></select><span class="text-danger" asp-validation-for="Input.SubscriptionPlan"></span><small class="admin-field-help">Возможности Coach требуют роль тренера или администратора. Дневник и ручные программы доступны в Free.</small></div>
<div class="mb-3"><label class="form-label" asp-for="Input.TrainerId"></label><select class="form-select" asp-for="Input.TrainerId"><option value="">Без тренера</option>@if (!string.IsNullOrWhiteSpace(Model.Input.TrainerId) && Model.Trainers.All(t => t.Id != Model.Input.TrainerId)) { <option value="@Model.Input.TrainerId">Текущий тренер недоступен — выберите заново</option> }@foreach (var trainer in Model.Trainers) { <option value="@trainer.Id">@trainer.UserName</option> }</select><small class="admin-field-help">Тренер увидит статистику клиента. Назначение программ зависит от его плана доступа.</small><span class="text-danger" asp-validation-for="Input.TrainerId"></span></div>
</div></details>
<p class="admin-form-feedback app-status app-notice" data-app-state="info" aria-live="polite" role="status" hidden data-admin-feedback></p>
<div class="admin-form-actions"><button class="btn btn-primary app-button" type="submit"><admin-icon name="check" />Сохранить изменения</button><a class="btn btn-outline-secondary app-button secondary" asp-page="./Index" asp-route-Search="@Model.DirectorySearch" asp-route-Role="@Model.DirectoryRole" asp-route-PageNumber="@Model.DirectoryPage">Отмена</a></div>
</form></section>
<aside class="admin-card admin-profile-data"><span class="admin-empty-icon"><admin-icon name="activity" /></span><h2>Данные пользователя</h2><p>История и новые записи выбранного аккаунта.</p><a class="admin-data-link" asp-page="/Dashboard" asp-route-ClientId="@Model.Id"><span>Обзор результатов</span><admin-icon name="arrow" /></a><a class="admin-data-link" asp-page="/Workouts/Index" asp-route-UserId="@Model.Id"><span>Записи тренировок</span><strong>@Model.WorkoutCount</strong><admin-icon name="arrow" /></a><a class="admin-data-link" asp-page="/Body/Index" asp-route-UserId="@Model.Id"><span>Замеры тела</span><strong>@Model.MeasurementCount</strong><admin-icon name="arrow" /></a><a class="btn btn-primary app-button" asp-page="/Workouts/Create" asp-route-userId="@Model.Id"><admin-icon name="plus" />Добавить тренировку</a></aside>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
