@page "/"
@model enx_fit.Pages.Public.IndexModel
@using enx_fit.Presentation.Navigation
@using enx_fit.ViewModels.Public
@{
    Layout = "/Pages/Shared/Layouts/_PublicHomeLayout.cshtml";
    ViewData["Title"] = "Тренировки и прогресс";
    ViewData["Description"] = "Enix Fit — дневник силовых тренировок: программы без лимита, подходы, отдых и история результатов. Рекомендации нагрузки Pro и инструменты тренера Coach.";
    var home = new PublicHomeViewModel(
        User.Identity?.IsAuthenticated == true,
        PublicPageLinks.Open(Url, User, "/Dashboard/Index"),
        PublicPageLinks.Open(Url, User, "/Account/Subscription"));
}
<partial name="/Pages/Shared/PublicHome/_Hero.cshtml" model="home" />
<partial name="/Pages/Shared/PublicHome/_Workflow.cshtml" model="home" />
<partial name="/Pages/Shared/PublicHome/_Pro.cshtml" model="home" />
<partial name="/Pages/Shared/PublicHome/_Coach.cshtml" model="home" />
<partial name="/Pages/Shared/PublicHome/_Plans.cshtml" model="home" />
