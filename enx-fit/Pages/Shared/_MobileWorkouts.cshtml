@model enx_fit.Pages.DashboardModel
@using enx_fit.ViewModels
@{
    var vm = new DashboardWorkoutsViewModel(Model);
    var ru = DashboardWorkoutsViewModel.Russian;
    var active = Model.ActiveWorkout;
    var planned = Model.Data.NextWorkout;
    var program = Model.NextProgramWorkout;
    var date = planned?.Date ?? program?.Date;
    var title = Model.Reference ? "Ноги и кор" : active?.Title ?? planned?.Title ?? program?.Workout.Name ?? "Начать тренировку";
    var count = active?.WorkoutExercises.Count ?? planned?.WorkoutExercises.Count ?? program?.Workout.Exercises.Count;
    var hasMonthQuery = Model.Request.Query.ContainsKey("Month");
    var history = vm.History.Where(w => !hasMonthQuery || w.Date.Month == vm.Month.Month && w.Date.Year == vm.Month.Year).Take(Model.Reference ? 3 : int.MaxValue).ToList();
    string? PageUrl(DateOnly? month = null, DateOnly? workoutDate = null) => Url.Page("/Dashboard/Workouts", new { Model.ClientId, Model.Days, Model.Until, Reference = Model.Reference ? (bool?)true : null, Month = (month ?? vm.Month).ToString("yyyy-MM-dd"), Model.Search, Model.WorkoutProgram, WorkoutDate = workoutDate?.ToString("yyyy-MM-dd") });
}
<div class="ef-mobile-screen em-workouts">
    <h1>Тренировки</h1>
    <section class="em-card em-workout-hero">
        <reference-photo class="em-hero-art" image="programs" window="565 425 293 117" />
        <p class="em-eyebrow"><reference-icon name="calendar" />@(Model.Reference || date == Model.Data.Today ? "Сегодня по программе" : active is not null ? "Тренировка продолжается" : date.HasValue ? "Ближайшая тренировка" : "В вашем темпе")</p><h2>@title</h2><p class="em-hero-description">@(Model.Reference ? "4 упражнения · Неделя 3 из 6" : count.HasValue ? DashboardWorkoutsViewModel.ExerciseCount(count.Value) : "Добавляйте упражнения по ходу")</p>
        @if (Model.IsCoachView) { <a class="em-primary em-hero-start" href="@Url.Page("/Dashboard/Plans", Model.NavigationValues)">План тренировок</a> }
        else if (!Model.Reference && active is not null) { <a class="em-primary em-hero-start" asp-page="/Workouts/Details" asp-route-id="@active.Id"><reference-icon name="play" />Продолжить тренировку</a> }
        else if (!Model.Reference && date == Model.Data.Today) { <form method="post" asp-page="/Dashboard" asp-page-handler="Start"><input type="hidden" name="source" value="@(planned is not null ? "planned" : "program")"/><input type="hidden" name="plannedId" value="@planned?.Id"/><input type="hidden" name="programId" value="@Model.ActiveProgram?.Id"/><button class="em-primary em-hero-start" type="submit"><reference-icon name="play" />Начать по плану</button></form> }
        else if (!Model.Reference && date.HasValue) { <a class="em-primary em-hero-start" href="@(planned is not null ? Url.Page("/Workouts/Details", new { id = planned.Id }) : Url.Page("/Programs/Details", new { id = Model.ActiveProgram?.Id }))"><reference-icon name="calendar" />Открыть план</a> }
        else { <button class="em-primary em-hero-start" type="button" data-dialog="quick-workout-dialog"><reference-icon name="play" />@(Model.Reference ? "Начать по плану" : "Начать тренировку")</button> }
        @if (!Model.IsCoachView) { <div class="em-shortcuts"><button type="button" data-dialog="quick-workout-dialog"><reference-icon name="bolt" /><span>Быстрая<br/>тренировка</span></button><button type="button" data-dialog="template-start-dialog"><reference-icon name="document" /><span>Из шаблона</span></button><form method="post" asp-page="/Dashboard" asp-page-handler="Start"><input type="hidden" name="source" value="previous"/><button type="@(Model.Reference ? "button" : "submit")" data-dialog="@(Model.Reference ? "quick-workout-dialog" : null)" disabled="@(!Model.Reference && !Model.Data.Completed.Any())"><reference-icon name="repeat" /><span>Повторить</span></button></form></div> }
    </section>
    @if (!Model.IsCoachView) { <div class="em-manual-actions"><a class="em-primary" asp-page="/Workouts/Record">Записать прошедшую</a><a asp-page="/Workouts/Create">Создать план</a></div> }
    <section class="em-card em-workout-stats"><div><reference-icon name="bars" /><p><strong>@vm.MonthlyWorkouts</strong><span>тренировок<br/>за месяц</span></p></div><div><reference-icon name="calendar" /><p><strong>@vm.WeeklyWorkouts / @vm.WeeklyTarget</strong><span>на этой неделе</span></p></div></section>
    <div class="em-segments" role="tablist" aria-label="Просмотр тренировок"><button class="active" type="button" role="tab" aria-selected="true" aria-controls="mobile-history" data-mobile-tab="mobile-history">История</button><button type="button" role="tab" aria-selected="false" aria-controls="mobile-calendar" data-mobile-tab="mobile-calendar">Календарь</button></div>
    <section id="mobile-history" role="tabpanel">
        <div class="em-history-tools"><details class="em-month-picker"><summary>@ru.TextInfo.ToTitleCase((Model.Reference && !hasMonthQuery ? new DateOnly(2026, 9, 1) : vm.Month).ToString("MMMM yyyy", ru))<reference-icon name="chevron" /></summary><div>@for (var i = 0; i < 6; i++) { var m = vm.Month.AddMonths(-i); <a href="@(PageUrl(month: m, workoutDate: null) + "#mobile-history")">@ru.TextInfo.ToTitleCase(m.ToString("MMMM yyyy", ru))</a> }</div></details><button class="em-icon-button" type="button" data-dialog="mobile-workout-filters" aria-label="Фильтры истории"><reference-icon name="sliders" /></button></div>
        <div class="em-history-list">
            @foreach (var w in history) {
                var photo = w.Photo == "history-2" || w.Title.Contains("Верх") ? "187 1214 136 139" : w.Photo == "history-3" ? "187 1405 136 139" : "187 1024 136 139";
                <a class="em-card em-history-card" href="@(Model.Reference ? "#mobile-workout-" + w.Id : Url.Page("/Workouts/Details", new { id = w.Id }))" data-dialog="@(Model.Reference ? "mobile-workout-" + w.Id : "history-peek-" + w.Id)"><reference-photo class="em-history-photo" image="workouts" window="@photo" alt="Оборудование в тренажёрном зале"/><div><h2>@w.Title</h2><time datetime="@w.Date.ToString("yyyy-MM-dd")">@w.Date.ToString("d MMMM", ru)</time><p>@DashboardWorkoutsViewModel.ExerciseCount(w.Exercises) · @w.Sets подходов</p><span class="em-saved"><reference-icon name="check" />@(w.IsManual ? "Внесена вручную" : "Сохранена")</span></div><reference-icon name="chevron" /></a>
            }
            @if (history.Count == 0) { <div class="em-card em-empty"><reference-icon name="workout" /><h2>Тренировки не найдены</h2><p>Выберите другой период или начните занятие.</p></div> }
        </div>
    </section>
    <section id="mobile-calendar" role="tabpanel" hidden><div class="em-card em-calendar"><header><a href="@PageUrl(month: vm.Month.AddMonths(-1))" aria-label="Предыдущий месяц"><reference-icon name="chevron" /></a><h2>@ru.TextInfo.ToTitleCase(vm.Month.ToString("MMMM yyyy", ru))</h2><a href="@PageUrl(month: vm.Month.AddMonths(1))" aria-label="Следующий месяц"><reference-icon name="chevron" /></a></header><div class="em-calendar-grid">@foreach (var day in new[] { "Пн", "Вт", "Ср", "Чт", "Пт", "Сб", "Вс" }) { <span>@day</span> }@foreach (var day in vm.Calendar) { var status = Model.Reference ? day.Date is { Year: 2026, Month: 9, Day: 28 or 30 } ? "completed" : day.Date >= new DateOnly(2026, 10, 2) && (day.Date.DayOfWeek is DayOfWeek.Monday or DayOfWeek.Wednesday or DayOfWeek.Friday) ? "planned" : "none" : day.Status; <a href="@(day.PlannedWorkoutId is { } id ? Url.Page("/Workouts/Details", new { id }) : day.ProgramId is { } pid ? Url.Page("/Programs/Details", new { id = pid, Tab = "schedule", Week = day.Date.ToString("yyyy-MM-dd"), Day = day.Date.ToString("yyyy-MM-dd") }) : PageUrl(workoutDate: day.Date))" class="@(day.Date.Month != vm.Month.Month ? "outside" : "")" aria-label="@day.Date.ToString("d MMMM", ru), @(status == "completed" ? "Выполнена" : status == "planned" ? "Запланирована" : "Нет тренировки")">@day.Date.Day<i class="@status"></i></a> }</div><footer><span><i class="completed"></i>Выполнена</span><span><i class="planned"></i>Запланирована</span></footer></div></section>
</div>
<dialog id="mobile-workout-filters" class="app-dialog app-workspace"><div class="dialog-heading"><h2>Фильтры истории</h2><button class="icon-button" type="button" data-close aria-label="Закрыть"><reference-icon name="close" /></button></div><form method="get" class="em-filter-form app-workspace"><input type="hidden" name="Reference" value="@Model.Reference.ToString().ToLowerInvariant()"/><input type="hidden" name="ClientId" value="@Model.ClientId"/><label>Поиск<input type="search" name="Search" value="@Model.Search" placeholder="Название или упражнение"/></label><label>Программа<select name="WorkoutProgram"><option value="">Все программы</option>@foreach (var p in vm.Programs) { <option value="@p.Value" selected="@(p.Value == Model.WorkoutProgram)">@p.Name</option> }</select></label><label>Период<select name="Days">@foreach (var (days, label) in new[] { (7,"Неделя"), (30,"Месяц"), (365,"Год") }) { <option value="@days" selected="@(days == Model.Days)">@label</option> }</select></label><button class="app-button" type="submit">Применить</button></form></dialog>
@if (Model.Reference) { @foreach (var w in vm.History) { <dialog id="mobile-workout-@w.Id" class="app-dialog app-workspace"><div class="dialog-heading"><h2>@w.Title · @w.Date.ToString("d MMMM", ru)</h2><button class="icon-button" type="button" data-close aria-label="Закрыть"><reference-icon name="close" /></button></div><div class="em-workout-detail">@foreach (var e in w.Preview) { <div><reference-icon name="workout" /><p><strong>@e.Name</strong><span>@e.Summary</span></p></div> }</div></dialog> } }
