@model enx_fit.Pages.ProfileModel
@using enx_fit.Models
<div class="profile-workspace app-workspace">
    <header class="profile-heading"><div><span class="profile-eyebrow">Личный кабинет</span><h1>Ваш профиль</h1><p>Условия занятий, аккаунт и ваши данные</p></div><a class="profile-edit-link app-button secondary" asp-area="Identity" asp-page="/Account/Manage/Index"><reference-icon name="pencil" />Контакты</a></header>
    <section class="ef-card profile-identity"><span class="profile-initial" aria-hidden="true">@Model.Initial</span><div><h2>@Model.DisplayName</h2><p>@Model.Viewer.Email</p></div><span class="profile-plan">@ViewData["ProfilePlan"]</span></section>
    <div class="profile-columns"><div class="profile-primary">
        <section class="ef-card profile-conditions profile-training-setup">
            <header><span class="profile-section-icon"><reference-icon name="target" /></span><div><h2>Условия тренировок</h2><p>Ваш ориентир для занятий</p></div></header>
            @if (Model.HasPreferences) {
                <dl class="profile-preferences"><div><dt>Цель</dt><dd>@Model.Preferences!.GoalTitle</dd></div><div><dt>Место</dt><dd>@TrainingPreferences.LocationTitle(Model.Preferences.TrainingLocation)</dd></div><div><dt>Оборудование</dt><dd>@TrainingPreferences.EquipmentTitle(Model.Preferences.AvailableEquipment)</dd></div><div><dt>Удобные дни</dt><dd>@TrainingPreferences.DaysTitle(Model.Preferences.PreferredDays)</dd></div></dl>
                <a class="profile-condition-action" asp-page="/Onboarding" asp-route-ReturnTo="profile">Изменить условия <reference-icon name="arrow" /></a>
            } else {
                <p class="profile-empty-conditions">Выберите цель, доступное оборудование и удобные дни. Начать тренировку можно и без настройки.</p><a class="profile-condition-action" asp-page="/Onboarding" asp-route-ReturnTo="profile">Настроить под себя <reference-icon name="arrow" /></a>
            }
        </section>
        <section class="ef-card profile-group"><h2>Аккаунт</h2><a class="profile-row" asp-area="Identity" asp-page="/Account/Manage/Index"><reference-icon name="user" /><span><strong>Контакты</strong><small>Логин и номер телефона</small></span><reference-icon name="chevron" /></a><a class="profile-row" asp-area="Identity" asp-page="/Account/Manage/Email"><reference-icon name="mail" /><span><strong>Email</strong><small>@(Model.Viewer.EmailConfirmed ? "Адрес подтверждён" : "Адрес не подтверждён")</small></span><reference-icon name="chevron" /></a><a class="profile-row" asp-area="Identity" asp-page="/Account/Manage/ChangePassword"><reference-icon name="shield" /><span><strong>Пароль</strong><small>Настройки входа</small></span><reference-icon name="chevron" /></a><a class="profile-row" asp-area="Identity" asp-page="/Account/Manage/TwoFactorAuthentication"><reference-icon name="lock" /><span><strong>Двухэтапный вход</strong><small>@(Model.Viewer.TwoFactorEnabled ? "Включён" : "Не включён")</small></span><reference-icon name="chevron" /></a></section>
    </div><aside class="profile-secondary">
        <section class="ef-card profile-group"><h2>Сервисы</h2><a class="profile-row" asp-page="/Subscription"><reference-icon name="crown" /><span><strong>Подписка</strong><small>Текущий план: @ViewData["ProfilePlan"]</small></span><reference-icon name="chevron" /></a><details class="profile-details app-disclosure"><summary class="profile-row"><reference-icon name="users" /><span><strong>Мой тренер</strong><small>@(Model.TrainerName ?? "Пока не назначен")</small></span><reference-icon name="chevron" /></summary><div class="profile-reveal"><p>@(Model.TrainerName is null ? "Информация появится здесь, когда к вашему аккаунту будет привязан тренер." : "Ваш тренер: " + Model.TrainerName)</p></div></details></section>
        <section class="ef-card profile-group"><h2>Данные и устройство</h2><details class="profile-details app-disclosure" data-profile-export><summary class="profile-row"><reference-icon name="download" /><span><strong>Экспорт тренировок</strong><small>Упражнения и записанные подходы</small></span><reference-icon name="chevron" /></summary><div class="profile-reveal"><p>Выберите формат для скачивания своего журнала.</p><div class="profile-export-actions"><a class="app-button secondary" asp-page-handler="Export" asp-route-format="csv">Скачать CSV</a><a class="app-button secondary" asp-page-handler="Export" asp-route-format="json">Скачать JSON</a></div></div></details><details class="profile-details app-disclosure"><summary class="profile-row"><reference-icon name="globe" /><span><strong>Часовой пояс</strong><small data-current-timezone="false">Часовой пояс устройства</small></span><reference-icon name="chevron" /></summary><div class="profile-reveal"><p>Время начала и окончания тренировки показывается в часовом поясе вашего устройства.</p></div></details><a class="profile-row" asp-area="Identity" asp-page="/Account/Manage/PersonalData"><reference-icon name="settings" /><span><strong>Данные аккаунта</strong><small>Скачать данные или закрыть аккаунт</small></span><reference-icon name="chevron" /></a></section>
        <form method="post" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="/" class="profile-signout"><button class="app-button secondary" type="submit">Выйти из аккаунта <reference-icon name="arrow" /></button></form>
    </aside></div>
</div>

