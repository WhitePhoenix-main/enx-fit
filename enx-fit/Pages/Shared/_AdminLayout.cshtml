@using System.Security.Claims
@{
    var currentPage = ViewContext.RouteData.Values["page"]?.ToString() ?? "";
    var accountName = string.IsNullOrWhiteSpace(User.Identity?.Name) ? "Администратор" : User.Identity.Name;
    var initial = accountName[..1].ToUpperInvariant();
    var links = enx_fit.ViewModels.AdminNavigationViewModel.Sections;
    var adminNavigation = new enx_fit.ViewModels.AdminNavigationViewModel(currentPage, accountName, initial);
    var sectionLabel = adminNavigation.SectionLabel;
}
<!DOCTYPE html>
<html lang="ru">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
        <meta name="color-scheme" content="dark" />
        <meta name="theme-color" content="#09131e" />
        <title>@ViewData["Title"] · Администрирование · Enix Fit</title>
        <partial name="_AppIcons" />
        @if (currentPage.StartsWith("/Workouts/", StringComparison.OrdinalIgnoreCase))
        {
            <link rel="stylesheet" href="~/css/dashboard.css" asp-append-version="true" />
        }
        <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
        <link rel="stylesheet" href="~/css/workout-shared.css" asp-append-version="true" />
        @await RenderSectionAsync("Styles", required: false)
        <link rel="stylesheet" href="~/css/mobile-shell.css" asp-append-version="true" />
        <link rel="stylesheet" href="~/css/admin-workspace.css" asp-append-version="true" />
        <link rel="stylesheet" href="~/css/app-components.css" asp-append-version="true" />
    </head>
    <body class="admin-shell em-app-shell">
        <a class="admin-skip" href="#main-content">К содержимому</a>
        <aside class="admin-sidebar" id="admin-sidebar" aria-label="Меню администратора">
            <a class="admin-brand" asp-page="/Admin/Index">
                <span class="admin-brand-mark">
                    <i>
                    </i>
                    <i>
                    </i>
                    <i>
                    </i>
                </span>
                <span>enix<span class="admin-brand-light">fit</span>
                    <small>ADMINISTRATION</small>
                </span>
            </a>
            <div class="admin-workspace">
                <span class="admin-workspace-icon">
                    <admin-icon name="shield" />
                </span>
                <div>
                    <strong>Панель управления</strong>
                    <small>Enix Fit Workspace</small>
                </div>
                <span class="admin-online" title="Сеанс активен"></span>
            </div>
            <a class="admin-new app-button" asp-page="/Workouts/Create">
                <admin-icon name="plus" /> Добавить тренировку</a>
            <p class="admin-nav-label">УПРАВЛЕНИЕ</p>
            <nav class="admin-nav">
                @foreach (var link in links)
                {
                    var active = link.IsActive(currentPage);
                    <a class="@(active ? "is-active" : "")" asp-page="@link.Page" aria-current="@(active ? "page" : null)">
                        <admin-icon name="@link.Icon" />
                        <span>@link.Label</span>
                        @if(active) {
                            <span class="admin-nav-dot"></span>
                        }
                    </a>
                }
            </nav>
            <div class="admin-sidebar-bottom">
                <p class="admin-nav-label">ЛИЧНЫЙ КАБИНЕТ</p>
                <nav class="admin-nav">
                    <a asp-page="/Dashboard">
                        <admin-icon name="back" />
                        <span>Вернуться в приложение</span>
                    </a>
                    <a asp-area="Identity" asp-page="/Account/Manage/Index">
                        <admin-icon name="shield" />
                        <span>Настройки аккаунта</span>
                    </a>
                </nav>
                <div class="admin-sidebar-note">
                    <span class="admin-online"></span> Всё для уверенного прогресса</div>
            </div>
        </aside>
        <div class="admin-workarea">
            <partial name="_AdminMobileShell" model="adminNavigation" />
            <header class="admin-topbar em-desktop-header">
                <button class="admin-icon-button app-icon-button" id="admin-menu-toggle" type="button" aria-controls="admin-sidebar" aria-expanded="true" aria-label="Переключить меню">
                    <admin-icon name="menu" />
                </button>
                <form class="admin-global-search" method="get" asp-page="/Admin/Users/Index" role="search">
                    <admin-icon name="search" />
                    <input name="Search" type="search" placeholder="Найти пользователя…" aria-label="Поиск пользователей" />
                    <kbd>/</kbd>
                </form>
                <div class="admin-topbar-end">
                    <span class="admin-admin-label">
                        <admin-icon name="shield" /> Администратор</span>
                    <a class="admin-account" asp-page="/Admin/Users/Edit" asp-route-id="@User.FindFirstValue(ClaimTypes.NameIdentifier)" title="@accountName">
                        <span class="admin-avatar">@initial</span>
                        <span>@accountName<small>Мой профиль</small>
                        </span>
                    </a>
                    <form asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Page("/Index", new { area = "" })" method="post">
                        <button class="admin-icon-button app-icon-button" type="submit" aria-label="Выйти">
                            <admin-icon name="logout" />
                        </button>
                    </form>
                </div>
            </header>
            <main class="admin-main app-workspace" id="main-content" tabindex="-1">
                <div class="admin-breadcrumb">
                    <a asp-page="/Admin/Index">Панель управления</a>
                    <admin-icon name="chevron" />
                    <span>@sectionLabel</span>
                </div>
                @RenderBody()
            </main>
            <footer class="admin-footer">
                <span>© @DateTime.Today.Year Enix Fit</span>
                <span>Тренировки. Данные. Прогресс.</span>
            </footer>
        </div>
        <script src="~/lib/jquery/dist/jquery.min.js">
        </script>
        <script src="~/js/admin.js" asp-append-version="true">
        </script>
        <script src="~/js/mobile-shell.js" asp-append-version="true"></script>
        <script src="~/js/exercise-ids.js" asp-append-version="true"></script>
        <script src="~/js/admin-workspace.js" asp-append-version="true"></script>
        <script src="~/js/app-components.js" asp-append-version="true"></script>
        @await RenderSectionAsync("Scripts", required: false)
    </body>
</html>
