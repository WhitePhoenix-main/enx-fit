@model enx_fit.ViewModels.Public.PublicHomeViewModel
<section class="ph-feature-band ph-coach-band" id="coach" aria-labelledby="coach-title">
    <div class="ph-feature ph-wrap">
        <picture class="ph-demo ph-demo-coach">
            <source media="(max-width: 600px)" srcset="@Url.Content("~/images/landing/demos/coach-mobile.webp")" width="1290" height="1455" />
            <img src="~/images/landing/demos/coach-desktop.webp" asp-append-version="true" width="2250" height="1365" loading="lazy" decoding="async" draggable="false" alt="Кабинет Coach: возможное плато Алексея после четырёх тренировок без роста, завершённая тренировка Марии и расписание клиентов." />
        </picture>
        <div class="ph-feature-copy">
            <p class="ph-tier-label"><span><svg class="ph-icon"><use href="#ph-users" /></svg></span>COACH</p>
            <h2 id="coach-title">Внимание нужным клиентам</h2>
            <ul class="ph-feature-list">
                <li><span class="ph-feature-icon"><svg class="ph-icon"><use href="#ph-chart" /></svg></span><div><h3>Сигналы по занятиям</h3><p>Пропуски, плато и завершение программы.</p></div></li>
                <li><span class="ph-feature-icon"><svg class="ph-icon"><use href="#ph-message" /></svg></span><div><h3>Ведение клиента</h3><p>Программа, расписание, сообщения и результаты.</p></div></li>
            </ul>
            <a class="ph-text-link" href="#plan-coach">Все возможности Coach <svg class="ph-icon"><use href="#ph-arrow" /></svg></a>
        </div>
    </div>
</section>
