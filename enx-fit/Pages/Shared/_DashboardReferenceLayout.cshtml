@using enx_fit.Services
@inject enx_fit.Security.IFeatureAccessService FeatureAccess
@{
    var dashboard = ViewData["Dashboard"] as enx_fit.Pages.DashboardModel;
    var access = await FeatureAccess.GetAsync();
    var viewer = User.Identity?.Name?.Split('@')[0] is { Length: > 0 } name ? name : "Спортсмен";
    if (dashboard?.Reference == true) viewer = "Алексей";
    string? PageUrl(string page) => Url.Page(page, dashboard?.NavigationValues);
    var trainer = dashboard?.Reference != true && (User.GetUserRole() == UserRole.Trainer || User.HasMinimumRole(UserRole.Administrator));
    var activePage = ViewContext.RouteData.Values["page"] as string;
    bool IsActive(string page) => string.Equals(activePage, page, StringComparison.OrdinalIgnoreCase);
}
<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#09131e" />
    <title>@ViewData["Title"] — Enix Fit</title>
    <link rel="icon" href="~/images/landing/favicon.svg" type="image/svg+xml" />
    @* Shared forms and optional widgets; the home screen has its own new layout and stylesheet. *@
    <link rel="stylesheet" href="~/css/dashboard.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/dashboard-widgets.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/dashboard-reference.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="fitness-app dashboard-home @(IsActive("/Dashboard/Workouts") ? "ef-workouts-page" : "") @(dashboard?.IsCoachView == true ? "coach-mode" : "personal-mode")">
<a class="skip-link" href="#main-content">Перейти к содержимому</a>
<aside class="ef-sidebar">
    <a class="ef-brand" asp-page="/Dashboard"><span class="ef-brand-mark" aria-hidden="true"><i></i><i></i><i></i></span><span>Enix Fit</span></a>
    <nav class="ef-navigation" aria-label="Основная навигация">
        <a class="ef-nav-item @(IsActive("/Dashboard") ? "active" : "")" href="@PageUrl("/Dashboard")" aria-current="@(IsActive("/Dashboard") ? "page" : null)"><reference-icon name="@(IsActive("/Dashboard") ? "home" : "home-outline")" />Главная</a>
        <a class="ef-nav-item @(IsActive("/Dashboard/Workouts") ? "active" : "")" href="@PageUrl("/Dashboard/Workouts")" aria-current="@(IsActive("/Dashboard/Workouts") ? "page" : null)"><reference-icon name="workout" />Тренировки</a>
        <a class="ef-nav-item" href="@PageUrl("/Programs/Index")"><reference-icon name="calendar" />Программы</a>
        <a class="ef-nav-item" href="@PageUrl("/Dashboard/Progress")"><reference-icon name="bars" />Прогресс</a>
        <a class="ef-nav-item" asp-page="/Exercises/Index"><reference-icon name="book" />Библиотека</a>
        @if (trainer) { <a class="ef-nav-item" asp-page="/Trainer/Clients"><reference-icon name="users" />Мои клиенты</a> }
        <a class="ef-nav-item ef-habits-link" href="@PageUrl("/Dashboard/Habits")"><reference-icon name="check-circle" />Привычки</a>
    </nav>
    <nav class="ef-sidebar-bottom" aria-label="Профиль и настройки">
        <a class="ef-nav-item" asp-area="Identity" asp-page="/Account/Manage/Index"><reference-icon name="user" />Профиль</a>
        <a class="ef-nav-item" asp-area="Identity" asp-page="/Account/Manage/Email"><reference-icon name="settings" />Настройки</a>
    </nav>
</aside>
<div class="ef-app">
    <header class="ef-topbar">
        <a class="ef-brand ef-mobile-brand" asp-page="/Dashboard"><span class="ef-brand-mark" aria-hidden="true"><i></i><i></i><i></i></span>Enix Fit</a>
        <button class="ef-search" type="button" data-dialog="search-dialog"><reference-icon name="search" /><span>Поиск разделов</span></button>
        <div class="ef-topbar-actions">
            <button class="ef-notification" type="button" data-dialog="notifications-dialog" aria-label="Уведомления"><reference-icon name="bell" /></button>
            <details class="account-menu ef-account"><summary><span class="ef-avatar" aria-hidden="true"></span><strong>@viewer</strong><span class="ef-plan">@(dashboard?.Reference == true ? "Pro" : access.Plan switch { SubscriptionPlan.Pro => "Pro", SubscriptionPlan.Coach => "Coach", _ => "Free" })</span><reference-icon name="chevron" /></summary>
                <div class="account-dropdown"><a asp-area="Identity" asp-page="/Account/Manage/Index">Настройки профиля</a>@if (trainer) { <a asp-page="/Trainer/Clients">Мои клиенты</a> }<form method="post" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="/"><button type="submit">Выйти</button></form></div>
            </details>
        </div>
    </header>
    <main id="main-content" class="ef-main" tabindex="-1">@RenderBody()</main>
</div>
<nav class="ef-bottom-nav" aria-label="Мобильная навигация">
    <a class="@(IsActive("/Dashboard") ? "active" : "")" href="@PageUrl("/Dashboard")" aria-current="@(IsActive("/Dashboard") ? "page" : null)"><reference-icon name="@(IsActive("/Dashboard") ? "home" : "home-outline")" /><span>Главная</span></a>
    <a class="@(IsActive("/Dashboard/Workouts") ? "active" : "")" href="@PageUrl("/Dashboard/Workouts")" aria-current="@(IsActive("/Dashboard/Workouts") ? "page" : null)"><reference-icon name="workout" /><span>Тренировки</span></a>
    <a href="@PageUrl("/Programs/Index")"><reference-icon name="calendar" /><span>Программы</span></a>
    <a href="@PageUrl("/Dashboard/Progress")"><reference-icon name="bars" /><span>Прогресс</span></a>
    <button type="button" data-dialog="navigation-dialog"><reference-icon name="menu" /><span>Ещё</span></button>
</nav>
<dialog id="navigation-dialog" class="app-dialog">
    <div class="dialog-heading"><h2>Разделы</h2><button class="icon-button" type="button" data-close aria-label="Закрыть"><reference-icon name="close" /></button></div>
    <nav class="search-results" aria-label="Все разделы"><a href="@PageUrl("/Dashboard/Habits")">Привычки <reference-icon name="check-circle" /></a><a asp-page="/Exercises/Index">Библиотека <reference-icon name="book" /></a><a asp-area="Identity" asp-page="/Account/Manage/Index">Профиль <reference-icon name="user" /></a>@if (trainer) { <a asp-page="/Trainer/Clients">Мои клиенты <reference-icon name="users" /></a> }</nav>
</dialog>
<dialog id="search-dialog" class="app-dialog">
    <div class="dialog-heading"><h2>Быстрый переход</h2><button class="icon-button" type="button" data-close aria-label="Закрыть"><reference-icon name="close" /></button></div>
    <input class="dialog-search" type="search" placeholder="Что хотите найти?" aria-label="Поиск раздела" data-section-search />
    <div class="search-results"><a href="@PageUrl("/Dashboard/Workouts")">Тренировки и упражнения <reference-icon name="workout" /></a><a href="@PageUrl("/Programs/Index")">Программы тренировок <reference-icon name="calendar" /></a><a href="@PageUrl("/Dashboard/Progress")">Прогресс, вес и замеры тела <reference-icon name="bars" /></a><a asp-page="/Exercises/Index">Библиотека упражнений <reference-icon name="book" /></a><a href="@PageUrl("/Dashboard/Habits")">Вода, сон и привычки <reference-icon name="check-circle" /></a><a href="@PageUrl("/Dashboard/Achievements")">Достижения и личные рекорды <reference-icon name="trophy" /></a><p hidden data-search-empty>Ничего не найдено. Попробуйте другой запрос.</p></div>
</dialog>
<dialog id="notifications-dialog" class="app-dialog">
    <div class="dialog-heading"><h2>Центр уведомлений</h2><button class="icon-button" type="button" data-close aria-label="Закрыть"><reference-icon name="close" /></button></div><div class="empty-state"><reference-icon name="bell" /><h3>Вы всё посмотрели</h3><p>Новых уведомлений пока нет.</p></div>
</dialog>
<script src="~/js/dashboard.js" asp-append-version="true"></script>
<script src="~/js/dashboard-widgets.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
