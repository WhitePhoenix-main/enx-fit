@model enx_fit.ViewModels.ExerciseLibraryModel
@{
    var selected = Model.SelectedIds.ToHashSet();
    var recent = Model.RecentIds.ToHashSet();
    var recentOrder = Model.RecentIds.Distinct().Select((id, index) => (id, index)).ToDictionary(e => e.id, e => e.index);
    var groups = Model.Exercises.Select(e => e.MuscleGroup).Distinct().OrderBy(g => g);
    var equipment = Model.Exercises.Select(e => e.Equipment).Distinct().OrderBy(e => e);
}
<section id="@Model.Id" class="exercise-library @(Model.ForBuilder ? "wb-panel wb-library" : "")"
         data-exercise-library data-viewer="@Model.ViewerId" data-mode="@(Model.ForBuilder || Model.ForSelection ? "builder" : "submit")"
         data-prescription="@(Model.ForSelection ? "results" : "plan")" aria-labelledby="@(Model.Id)-heading">
    <header class="exercise-library-heading">
        <div><span class="exercise-library-eyebrow">СОБЕРИТЕ СВОЙ ПЛАН</span><h2 id="@(Model.Id)-heading">Добавить упражнения</h2></div>
        @if (Model.ForBuilder)
        { <button type="button" class="exercise-library-action wb-library-close" data-close-library aria-label="Закрыть библиотеку"><admin-icon name="close" /></button> }
    </header>
    <label class="exercise-library-search"><admin-icon name="search" /><input type="search" id="@(Model.ForBuilder ? "wb-search" : Model.Id + "-search")" data-library-search placeholder="Название, мышцы или оборудование" aria-label="Поиск по всей библиотеке упражнений" autocomplete="off" enterkeyhint="search" /><button type="button" data-clear-search aria-label="Очистить поиск" hidden><admin-icon name="close" /></button></label>
    <div class="exercise-library-context"><admin-icon name="workout" /><div><strong data-library-context>@Model.ContextName</strong><small><span data-library-existing>@selected.Count</span> в тренировке · можно выбрать несколько</small></div></div>
    @if (Model.ForBuilder)
    { <label class="wb-library-target">Добавить в блок<select id="wb-library-target" aria-label="Блок для новых упражнений"></select></label> }
    <div class="exercise-library-tabs" role="group" aria-label="Раздел библиотеки"><button type="button" data-library-tab="all" aria-pressed="true">Все</button><button type="button" data-library-tab="recent" aria-pressed="false" hidden="@(recent.Count == 0)">Недавние <span data-tab-count="recent">@recent.Count</span></button><button type="button" data-library-tab="favorites" aria-pressed="false" hidden>Избранные <span data-tab-count="favorites">0</span></button></div>
    <div class="exercise-library-browse" data-library-browse>
    <div class="exercise-library-filter-bar"><details class="exercise-library-filter-details" data-library-filter-details><summary>Фильтры <span data-filter-count hidden>0</span><admin-icon name="chevron" /></summary><div>
    <div class="exercise-library-filters" role="group" aria-label="Быстрый выбор мышц">
        <button type="button" data-muscle-filter="" aria-pressed="true">Все мышцы</button>
        @foreach (var group in new[] { "Грудь", "Спина", "Ноги" })
        { <button type="button" data-muscle-filter="@group" aria-pressed="false">@group</button> }
    </div>
    <label class="exercise-library-group">Группа мышц<select data-library-group aria-label="Группа мышц"><option value="">Все группы</option>@if (!groups.Contains("Ноги")) { <option value="Ноги">Ноги</option> }@foreach (var group in groups) { <option value="@group">@group</option> }</select></label>
    <label class="exercise-library-group">Оборудование<select data-library-equipment aria-label="Оборудование"><option value="">Любое оборудование</option>@foreach (var item in equipment) { <option value="@item">@item</option> }</select></label>
    </div></details><button type="button" class="exercise-library-reset" data-clear-filters hidden>Сбросить фильтры</button></div>
    <div class="exercise-library-result-count"><span>Доступные упражнения</span><span id="@(Model.ForBuilder ? "wb-library-count" : null)" data-library-count aria-live="polite">@Model.Exercises.Count</span></div>
    <div class="exercise-library-list" data-library-list>
        @foreach (var exercise in Model.Exercises)
        {
            var name = ExercisePresentation.DisplayName(exercise);
            var isSelected = selected.Contains(exercise.Id);
            <article class="exercise-library-item @(isSelected ? "is-added" : "")" data-exercise-id="@exercise.Id" data-name="@name" data-group="@exercise.MuscleGroup" data-equipment="@exercise.Equipment"
                     data-search="@name @exercise.Name @exercise.MuscleGroup @exercise.Equipment" data-recent="@(recent.Contains(exercise.Id) ? "true" : "false")" data-recent-order="@(recentOrder.GetValueOrDefault(exercise.Id, int.MaxValue))">
                <div class="exercise-library-row">
                    <button type="button" class="exercise-library-select" data-library-add name="AddExercise.ExerciseId" value="@exercise.Id" disabled="@(isSelected ? "disabled" : null)" aria-pressed="false" aria-label="@(isSelected ? "Добавлено" : "Добавить"): @name">
                        <span class="exercise-library-icon" data-library-icon aria-hidden="true"><admin-icon name="@ExercisePresentation.MuscleIcon(exercise.MuscleGroup)" /></span>
                        <span class="exercise-library-copy"><strong>@name</strong><small>@exercise.MuscleGroup · @exercise.Equipment</small><small class="exercise-library-added" data-added-label hidden="@(!isSelected)">В тренировке</small></span>
                        <span class="exercise-library-check"><span data-add-icon hidden="@isSelected"><admin-icon name="plus" /></span><span data-selected-icon hidden="@(!isSelected)"><admin-icon name="check" /></span></span>
                    </button>
                    <button type="button" class="exercise-library-action" data-library-favorite aria-pressed="false" aria-label="В избранное: @name"><admin-icon name="star" /></button>
                </div>
                <button type="button" class="exercise-library-prescription" data-configure-pick hidden aria-expanded="false"><span data-pick-summary></span><span>Настроить <admin-icon name="chevron" /></span></button>
                <div data-pick-settings class="exercise-library-settings" id="@(Model.Id)-settings-@exercise.Id" hidden></div>
                <details class="exercise-library-info"><summary>Оборудование и техника</summary>
                    <p>@(string.IsNullOrWhiteSpace(exercise.Notes) ? $"{exercise.MuscleGroup} · {exercise.Equipment}" : exercise.Notes)</p>
                    @if (ExerciseTechniqueCatalog.Find(exercise) is { } technique) { <partial name="_ExerciseTechnique" model="technique" /> }
                    else { <p class="exercise-technique-empty">Подсказка по технике для этого упражнения пока не добавлена.</p> }
                    <a asp-page="/Exercises/Details" asp-route-id="@exercise.Id" target="_blank" rel="noopener" aria-label="Оборудование и описание: @name (новая вкладка)">Открыть карточку <admin-icon name="arrow" /></a>
                </details>
            </article>
        }
        <div class="exercise-library-empty" data-library-empty hidden="@(Model.Exercises.Count > 0)"><p data-empty-message>В библиотеке пока нет упражнений.</p><button type="button" class="exercise-library-reset" data-reset-library hidden>Показать все упражнения</button></div>
    </div>
    </div>
    <footer class="exercise-library-selection">
        <div class="exercise-library-selection-heading"><strong data-selection-summary>Выберите упражнения</strong><button type="button" data-clear-selection hidden>Очистить</button></div>
        <div class="exercise-library-chips" data-selection-chips hidden></div>
        <p class="exercise-library-status" data-library-status role="status" hidden></p>
        <button type="button" class="exercise-library-commit" data-library-commit disabled><admin-icon name="plus" /><span>Добавить в тренировку</span><admin-icon name="arrow" /></button>
        <small data-selection-hint>@(Model.ForSelection ? "Результаты можно внести после добавления" : "Нагрузку можно настроить здесь или после добавления")</small>
    </footer>
</section>
