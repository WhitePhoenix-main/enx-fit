@using enx_fit.Services
<div class="public-product-preview" data-public-preview>
    <p class="public-example-label">Обзор экранов · пример данных</p>
    <div class="public-preview-tabs" role="tablist" aria-label="Экраны приложения" hidden>
        <button type="button" role="tab" id="preview-tab-workout" aria-controls="preview-workout" aria-selected="true" data-preview-tab="workout">Занятие</button>
        <button type="button" role="tab" id="preview-tab-programs" aria-controls="preview-programs" aria-selected="false" tabindex="-1" data-preview-tab="programs">Программы</button>
        <button type="button" role="tab" id="preview-tab-progress" aria-controls="preview-progress" aria-selected="false" tabindex="-1" data-preview-tab="progress">Прогресс</button>
    </div>
    <details class="app-disclosure" id="preview-workout" data-preview-panel="workout" open><summary>Выполнение занятия</summary><div class="public-preview-content"><figure class="mobile-preview"><div class="mobile-preview-frame"><img src="~/images/landing/product/workout-mobile.jpg" asp-append-version="true" width="390" height="844" loading="lazy" alt="Пример мобильного занятия: упражнение, выполненный подход и таймер отдыха." /></div><figcaption>Подход за подходом · пример данных</figcaption></figure><a class="public-preview-action" href="@PublicPageLinks.Open(Url, User, "/Dashboard")">Начать свою тренировку <svg class="icon"><use href="#i-arrow" /></svg></a></div></details>
    <details class="app-disclosure" id="preview-programs" data-preview-panel="programs"><summary>Выбор программы</summary><div class="public-preview-content"><figure class="mobile-preview"><div class="mobile-preview-frame"><img src="~/images/landing/product/programs-mobile.jpg" asp-append-version="true" width="364" height="393" loading="lazy" alt="Пример выбора программы и готовых шаблонов на телефоне." /></div><figcaption>План и шаблоны · пример данных</figcaption></figure><a class="public-preview-action" href="@PublicPageLinks.Open(Url, User, "/Programs/Index", new { Tab = "templates" })">Выбрать свой шаблон <svg class="icon"><use href="#i-arrow" /></svg></a></div></details>
    <details class="app-disclosure" id="preview-progress" data-preview-panel="progress"><summary>Результаты по неделям</summary><div class="public-preview-content"><figure class="mobile-preview"><div class="mobile-preview-frame"><img src="~/images/landing/product/progress-mobile.jpg" asp-append-version="true" width="364" height="476" loading="lazy" alt="Пример прогресса: регулярность тренировок по неделям." /></div><figcaption>Динамика занятий · пример данных</figcaption></figure><a class="public-preview-action" href="@PublicPageLinks.Open(Url, User, "/Dashboard/Progress")">Посмотреть свой прогресс <svg class="icon"><use href="#i-arrow" /></svg></a></div></details>
</div>
