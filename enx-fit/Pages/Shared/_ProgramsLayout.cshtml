@{
    Layout = "_DashboardLayout";
}
@section Styles { <link rel="stylesheet" href="~/css/programs.css" asp-append-version="true" /> }
<div class="programs-page">
    @if (TempData["StatusMessage"] is string status) { <div class="program-notice" role="status">@status</div> }
    @if (TempData["ErrorMessage"] is string error) { <div class="program-notice error" role="alert">@error</div> }
    @RenderBody()
</div>
@section Scripts {
    <script src="~/js/programs.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
}
