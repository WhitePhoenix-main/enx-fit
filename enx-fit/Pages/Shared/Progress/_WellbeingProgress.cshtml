@using enx_fit.ViewModels.Dashboard
@using System.Globalization
@model enx_fit.Pages.Dashboard.DashboardModel
@{
    var w = new WellbeingViewModel(Model.Data, Model.Month);
    var strength = new DashboardProgressViewModel(Model);
    var ru = WellbeingViewModel.Russian;
    string? Link(string tab = "overview", DateOnly? month = null) => Url.Page("/Progress/Index", new { Model.ClientId, ProgressTab = tab, Month = (month ?? w.Month).ToString("yyyy-MM-dd"), Model.ProgressExercise, Model.ChartWeeks });
    var firstWeekday = ((int)w.Month.DayOfWeek + 6) % 7;
    var priorMonthName = ru.DateTimeFormat.MonthGenitiveNames[w.Month.AddMonths(-1).Month - 1];
}
<header class="wb-progress-heading"><p class="wb-eyebrow">Шаг за шагом, месяц за месяцем</p><h1>Всё это — ваш путь.</h1><p>Занятия, паузы и новые начала. Здесь есть место каждому из них.</p></header>
<nav class="wb-progress-tabs" aria-label="Разделы прогресса">@foreach (var (key, label) in new[] { ("overview", "Ритм"), ("analytics", "Сила"), ("records", "Результаты") }) { <a href="@Link(key)" class="@(Model.ProgressTab == key ? "is-active" : "")" aria-current="@(Model.ProgressTab == key ? "page" : null)">@label</a> }</nav>
@if (Model.ProgressTab == "overview") {
    <section class="wb-month-story"><header><div><p class="wb-eyebrow">Ваш месяц в движении</p><h2>@w.Month.ToString("MMMM yyyy", ru)</h2></div><button class="wb-month-picker" type="button" data-wb-open="wb-month-select" aria-label="Выбрать месяц"><reference-icon name="calendar" /></button></header><div class="wb-month-lead"><span>@w.ActiveDays</span><div>@WellbeingViewModel.Plural(w.ActiveDays, "день", "дня", "дней")<br />вы находили время<br />для движения</div></div><p>@(w.Sessions == 0 ? "Пока здесь чистый лист. Ваши первые записи появятся, когда вы будете готовы." : "Это ваше время для себя. Даже если между занятиями были паузы.")</p><button type="button" class="wb-story-button" data-wb-open="wb-month-recap">Листать историю месяца <reference-icon name="arrow" /></button><div class="wb-month-hills" aria-hidden="true"></div></section>
    <dialog class="wb-sheet" id="wb-month-select"><header><h2>Месяцы вашей истории</h2><button type="button" data-wb-close aria-label="Закрыть">×</button></header><div class="wb-menu-links wb-month-links">@for (var i = 0; i < 12; i++) { var m = new DateOnly(Model.Data.Today.Year, Model.Data.Today.Month, 1).AddMonths(-i); <a href="@Link(month: m)" aria-current="@(m == w.Month ? "date" : null)">@m.ToString("MMMM yyyy", ru)@if (m == w.Month) { <reference-icon name="check" /> }</a> }</div></dialog>
    <div class="wb-progress-columns"><section class="wb-month-calendar"><header class="wb-section-heading"><h2>Ритм месяца</h2><button class="wb-info" type="button" data-wb-open="wb-metrics-help" aria-label="Что означают показатели">?</button></header><div class="wb-calendar-grid">@foreach (var label in new[] { "Пн", "Вт", "Ср", "Чт", "Пт", "Сб", "Вс" }) { <span class="wb-weekday">@label</span> }@for (var i = 0; i < firstWeekday; i++) { <span aria-hidden="true"></span> }@foreach (var p in w.MonthDays) { <a class="@(p.Sessions > 0 ? "has-activity" : p.Rest ? "is-rest" : "") @(p.Date == Model.Data.Today ? "is-today" : "")" href="@Url.Page("/Training/Index", new { Model.ClientId, WorkoutDate = p.Date.ToString("yyyy-MM-dd") })" aria-label="@p.Date.ToString("d MMMM", ru): занятий @p.Sessions@(p.Rest ? ", выбран отдых" : "")">@p.Date.Day<span aria-hidden="true">@(p.Sessions > 0 ? "•" : p.Rest ? "◡" : "")</span></a> }</div><p class="wb-calendar-key"><span><i></i>Занятие</span><span><i class="is-rest"></i>Выбран отдых</span><span>Без точки — нет записи</span></p></section>
    <section class="wb-month-numbers"><h2>Немного о сделанном</h2><dl><div><dt>Завершено занятий</dt><dd>@w.Sessions</dd></div><div><dt>Дней с движением</dt><dd>@w.ActiveDays</dd></div><div><dt>Минут записано</dt><dd>@(w.Minutes?.ToString() ?? "—")</dd></div></dl><p class="wb-comparison">@(w.Sessions == w.PreviousSessions ? "Столько же занятий, сколько" : w.Sessions > w.PreviousSessions ? $"На {w.Sessions - w.PreviousSessions} больше, чем" : $"На {w.PreviousSessions - w.Sessions} меньше, чем") за 1–@Math.Min(w.MonthEnd.Day, DateTime.DaysInMonth(w.Month.AddMonths(-1).Year, w.Month.AddMonths(-1).Month)) @priorMonthName. Это сравнение записей, а не оценка ваших усилий.</p>@if (w.MissingDurations > 0) { <p class="wb-footnote">Без записанной длительности: @w.MissingDurations. В минуты они не включены.</p> }<button class="wb-text-link" type="button" data-wb-open="wb-metrics-help">Что за этими числами <reference-icon name="arrow" /></button></section></div>
    <a class="wb-soft-link" href="@Url.Page("/Training/Index", new { Model.ClientId })"><reference-icon name="workout-outline" /><span><strong>У каждого занятия своя история</strong><small>Открыть журнал тренировок</small></span><reference-icon name="chevron" /></a>
    <partial name="/Pages/Shared/Progress/_MonthRecap.cshtml" model="w" />
}
else if (Model.ProgressTab == "analytics") {
    <section class="wb-strength"><header class="wb-section-heading"><div><p class="wb-eyebrow">Сравнивайте себя с собой</p><h2>Ваша сила в деталях</h2></div></header><form method="get" class="wb-strength-controls"><input type="hidden" name="ClientId" value="@Model.ClientId" /><input type="hidden" name="ProgressTab" value="analytics" /><label>Упражнение<select name="ProgressExercise" data-wb-submit>@foreach (var e in strength.Exercises) { <option value="@e.Id" selected="@(e.Id == strength.ExerciseId)">@e.Name</option> }</select></label><label>Период<select name="ChartWeeks" data-wb-submit>@foreach (var weeks in new[] { 2, 4, 6, 12 }) { <option value="@weeks" selected="@(Model.ChartWeeks == weeks)">@weeks нед.</option> }</select></label><noscript><button type="submit">Показать</button></noscript></form>
    @if (strength.Strength.Count > 0) { <p class="wb-strength-number">@strength.WorkingWeight?.ToString("0.#", ru)<span>кг · максимальный рабочий вес</span></p><div class="wb-strength-plot"><partial name="/Pages/Shared/Progress/_ProgressChart.cshtml" model="@(new ProgressChart("wb-strength-chart", "Выполненный рабочий вес, кг", strength.Strength))" /></div><p class="wb-footnote">График показывает максимальный вес выполненного рабочего подхода за каждый день. Разминка не учитывается. Условия и техника тоже влияют на результат — одна цифра не описывает всю тренировку.</p> }
    else { <p class="wb-empty-path">Здесь появятся результаты после завершённых рабочих подходов с весом. Для упражнений с собственным весом смотрите повторения в журнале.</p> }
    </section><a class="wb-soft-link" asp-page="/Progress/Measurements/Index"><reference-icon name="scale" /><span><strong>Замеры — ещё одна часть истории</strong><small>Ваши записи веса и измерений</small></span><reference-icon name="chevron" /></a>
}
else {
    <section class="wb-results"><p class="wb-eyebrow">Личные ориентиры</p><h2>Ваши лучшие записи</h2><p>Максимальный вес выполненного рабочего подхода. Без сравнения с другими.</p>@foreach (var record in strength.Records) { <a class="wb-activity" asp-page="/Training/Workouts/Details" asp-route-id="@record.WorkoutId"><span class="wb-activity-icon"><reference-icon name="trophy" /></span><span><strong>@record.Name</strong><small>@record.Date.ToString("d MMMM yyyy", ru)</small></span><b>@record.Weight.ToString("0.#", ru)<small> кг</small></b></a> }@if (strength.Records.Count == 0) { <p class="wb-empty-path">Ваша история ещё впереди. Результаты появятся после первых завершённых рабочих подходов с весом.</p> }</section>
}
<dialog class="wb-sheet progress-metric-help" id="wb-metrics-help"><header><h2>О чём говорят числа</h2><button type="button" data-wb-close aria-label="Закрыть">×</button></header><h3>Завершено занятий</h3><p>Тренировки с хотя бы одним выполненным рабочим подходом, включая ручные записи. Отменённые и незавершённые занятия не входят в расчёт.</p><h3>Дни с движением</h3><p>Дни, в которые вы завершили занятия. Две тренировки в один день — два занятия и один активный день. Шаги и другая незаписанная активность здесь не учитываются.</p><h3>Минут записано</h3><p>Сумма сохранённой длительности завершённых тренировок. Если время не записано, мы его не угадываем.</p><h3>Сравнение месяцев</h3><p>Неполный месяц сравнивается с таким же числом дней предыдущего месяца. Это помогает сопоставлять записи честнее. Больше не обязательно лучше.</p><h3>День отдыха</h3><p>Это ваша отметка на конкретную дату. Она не считается тренировкой, не переносит расписание и не означает, что приложение оценило восстановление.</p></dialog>
