@using enx_fit.Pages.Dashboard
@using enx_fit.Presentation.Exercises
@using enx_fit.ViewModels.Dashboard
@model enx_fit.Pages.Dashboard.DashboardModel
@{
    var vm = new DashboardProgressViewModel(Model);
    var ru = DashboardWorkoutsViewModel.Russian;
    var weekly = Model.Data.ThisWeek.Count();
    var sessionWord = weekly % 100 is >= 11 and <= 14 ? "занятий" : weekly % 10 == 1 ? "занятие" : weekly % 10 is >= 2 and <= 4 ? "занятия" : "занятий";
    string N(decimal? value) => value?.ToString("0.#", ru) ?? "—";
    string Delta(decimal value) => (value < 0 ? "−" : "+") + N(Math.Abs(value));
    string? PageUrl(string? tab = null, int? weeks = null, Guid? exercise = null) => Url.Page("/Progress/Index", new { Model.ClientId, Model.Days, Model.Until, Reference = Model.Reference ? (bool?)true : null, ProgressTab = tab ?? Model.ProgressTab, ProgressWeeks = Model.ProgressWeeks, ChartWeeks = weeks ?? Model.ChartWeeks, ProgressExercise = exercise ?? vm.ExerciseId });
}
<div class="ef-mobile-screen native-progress">
    <header class="native-page-title"><p>Сравнивайте себя с собой</p><h1>Ваш прогресс<span class="native-title-dot">.</span></h1></header>
    <nav class="native-tabs" aria-label="Разделы прогресса">@foreach (var (tab, label) in new[] { ("overview", "Обзор"), ("analytics", "Подробнее"), ("records", "Рекорды") }) { <a href="@PageUrl(tab)" class="@(Model.ProgressTab == tab ? "active" : "")" aria-current="@(Model.ProgressTab == tab ? "page" : null)">@label</a> }</nav>
    @if (Model.Data.CompletedCount == 0 && Model.Data.Measurements.Count == 0 && !Model.Reference) {
        <section class="native-catalog-empty"><reference-icon name="bars" /><h2>У каждой истории<br />есть начало.</h2><p>Завершите первое занятие. Здесь появятся ваши результаты и ритм тренировок.</p><a class="native-primary" href="@Url.Page("/Training/Index", Model.NavigationValues)">К первой тренировке <reference-icon name="arrow" /></a>@if (!Model.IsCoachView) { <a class="native-record-link" asp-page="/Progress/Measurements/Create">Добавить первый замер</a> }</section>
    }
    else if (Model.ProgressTab == "records") {
        <section class="native-records"><header class="native-section-title"><h2>Ваши лучшие результаты</h2><reference-icon name="trophy" /></header><p>Максимальный вес выполненного рабочего подхода. Каждый рекорд — ваша собственная точка роста.</p>@foreach (var record in vm.Records) { <a class="native-record-row" asp-page="/Training/Workouts/Details" asp-route-id="@record.WorkoutId"><span><reference-icon name="trophy" /></span><div><strong>@record.Name</strong><small>@record.Date.ToString("d MMMM yyyy", ru)</small></div><b>@N(record.Weight)<small> кг</small></b><reference-icon name="chevron" /></a> }@if (vm.Records.Count == 0) { <p>После первых рабочих подходов с весом здесь появятся ваши рекорды.</p> }</section>
    }
    else {
        @if (Model.ProgressTab == "overview") {
            <section class="native-progress-lead"><span class="native-kicker">Эта неделя</span><h2>@weekly <span>@sessionWord<br />для себя.</span></h2><p>@(weekly > 0 ? "Вы уже находите время для движения. Дальше — в вашем темпе." : "Можно начать с одного занятия. Паузы не обнуляют ваш путь.")</p></section>
            <partial name="/Pages/Shared/Progress/_TrainingRhythm.cshtml" model="Model.Data" />
        }
        <section class="native-strength-chart"><header class="native-section-title"><h2>Становитесь сильнее</h2><details class="native-period-picker"><summary>@Model.ChartWeeks нед. <reference-icon name="chevron" /></summary><div>@foreach (var weeks in new[] { 2, 4, 6, 12 }) { <a href="@PageUrl(weeks: weeks)">@weeks недель</a> }</div></details></header>
            @if (vm.Exercises.Count > 0) { <form method="get" class="native-progress-exercise"><input type="hidden" name="ClientId" value="@Model.ClientId" /><input type="hidden" name="ProgressTab" value="@Model.ProgressTab" /><input type="hidden" name="ChartWeeks" value="@Model.ChartWeeks" /><input type="hidden" name="ProgressWeeks" value="@Model.ProgressWeeks" /><input type="hidden" name="Until" value="@Model.Until?.ToString("yyyy-MM-dd")" /><label class="sr-only" for="native-progress-exercise">Упражнение для графика</label><select id="native-progress-exercise" name="ProgressExercise" data-submit-change>@foreach (var exercise in vm.Exercises) { <option value="@exercise.Id" selected="@(exercise.Id == vm.ExerciseId)">@exercise.Name</option> }</select><noscript><button type="submit">Показать</button></noscript></form> }
            <div class="native-weight-result"><strong>@N(vm.WorkingWeight)<small> кг</small></strong>@if (vm.StrengthChange is { } strength) { <span>@Delta(strength) кг<small>за выбранный период</small></span> }</div><p class="native-chart-caption">Максимальный рабочий вес · @vm.ExerciseName</p>
            <partial name="/Pages/Shared/Progress/_ProgressChart.cshtml" model="@(new ProgressChart("native-progress-strength", vm.ExerciseName + ": выполненный рабочий вес, кг", vm.Strength))" />
        </section>
        @if (Model.NextRecommendation is { } recommendation && Model.NextGoalExercise is { } goalExercise && Model.ProgressTab == "overview") { <a class="native-progress-proposal" asp-page="/Training/Programs/Details" asp-route-id="@Model.ActiveProgram?.Id" asp-route-Tab="progression" asp-route-ExerciseId="@goalExercise.Id"><reference-icon name="spark" /><div><small>Ваш следующий шаг</small><strong>@ExercisePresentation.DisplayName(goalExercise.Exercise)</strong><p>@N(recommendation.CurrentValue) → @N(recommendation.SuggestedValue) кг · Рассмотреть рекомендацию</p></div><reference-icon name="arrow" /></a> }
        <a class="native-list-link" asp-page="/Progress/Measurements/Index"><span class="native-list-icon"><reference-icon name="body-scale" /></span><span><small>Последний замер · @(vm.Latest?.Date.ToString("d MMMM", ru) ?? "пока нет")</small><strong>@N(vm.Latest?.WeightKg) кг <small>Вес тела</small></strong></span><reference-icon name="chevron" /></a>
        @if (!Model.IsCoachView) { <a class="native-record-link" asp-page="/Progress/Measurements/Create"><reference-icon name="plus" />Добавить замер</a> }
        @if (Model.ProgressTab == "analytics") { <section class="native-strength-chart"><header class="native-section-title"><h2>Объём тренировок</h2><span>кг × повторения</span></header><partial name="/Pages/Shared/Progress/_ProgressChart.cshtml" model="@(new ProgressChart("native-progress-volume", "Объём рабочих подходов, кг", vm.Volume))" /></section><section class="native-strength-chart"><header class="native-section-title"><h2>Изменения веса</h2><span>кг</span></header><partial name="/Pages/Shared/Progress/_ProgressChart.cshtml" model="@(new ProgressChart("native-progress-body", "Вес тела, кг", vm.Body, DecimalLabels: true))" /></section> }
        <details class="progress-metric-help"><summary>Что означают показатели</summary><p>Рабочий вес — максимальный вес выполненного рабочего подхода выбранного упражнения за период. На графике — максимум за каждый день. Разминка и незавершённые занятия не учитываются.</p><p>Объём — сумма веса × повторений в выполненных рабочих подходах, включая ступени дропсетов. Это записанная нагрузка, а не оценка качества тренировки. Вес тела берётся из ваших замеров.</p></details>
    }
</div>
