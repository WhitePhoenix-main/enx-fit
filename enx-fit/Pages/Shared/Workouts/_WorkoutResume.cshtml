@using enx_fit.Services.Workouts
@using enx_fit.ViewModels.Navigation
@model enx_fit.ViewModels.Navigation.MobileAppNavigationViewModel
@inject enx_fit.Services.Workouts.WorkoutService Workouts
@if (!Model.Reference && Model.Client is null && !Model.Page.StartsWith("/Coaching/") && Model.Page is not ("/Dashboard/Index" or "/Training/Index") && !Model.Page.StartsWith("/Training/Workouts/Details"))
{
    var active = Model.Dashboard?.ActiveWorkout ?? await Workouts.ActiveAsync();
    if (active is not null)
    {
        <a class="workout-resume" asp-area="" asp-page="/Training/Workouts/Details" asp-route-id="@active.Id"><admin-icon name="play" /><span><strong>Тренировка продолжается</strong><small>@active.Title</small></span><admin-icon name="arrow" /></a>
    }
}
