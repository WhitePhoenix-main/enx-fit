@using enx_fit.Pages.Dashboard
@using enx_fit.ViewModels.Dashboard
@model enx_fit.Pages.Dashboard.DashboardModel
@{
    var vm = new DashboardWorkoutsViewModel(Model);
    var ru = DashboardWorkoutsViewModel.Russian;
    var active = Model.ActiveWorkout;
    var program = Model.NextProgramWorkout;
    var planned = Model.Data.NextWorkout is { } candidate && (program is null || candidate.Date <= program.Date) ? candidate : null;
    var date = planned?.Date ?? program?.Date;
    var title = Model.Reference ? "Ноги и кор" : active?.Title ?? planned?.Title ?? program?.Workout.Name ?? "Начать тренировку";
    var count = active?.WorkoutExercises.Count ?? planned?.WorkoutExercises.Count ?? program?.Workout.Exercises.Count;
    var hasMonthQuery = Model.Request.Query.ContainsKey("Month");
    var history = vm.History.Where(w => !hasMonthQuery || w.Date.Month == vm.Month.Month && w.Date.Year == vm.Month.Year).Take(Model.Reference ? 3 : int.MaxValue).ToList();
    string? PageUrl(DateOnly? month = null, DateOnly? workoutDate = null) => Url.Page("/Training/Index", new { Model.ClientId, Model.Days, Model.Until, Reference = Model.Reference ? (bool?)true : null, Month = (month ?? vm.Month).ToString("yyyy-MM-dd"), Model.Search, Model.WorkoutProgram, WorkoutDate = workoutDate?.ToString("yyyy-MM-dd") });
}
<div class="ef-mobile-screen em-workouts native-workouts">
    <header class="native-page-title"><p>Ваш тренировочный дневник</p><h1>Тренировки<span class="native-title-dot">.</span></h1></header>
    <section class="native-workout-start">
        @if (active is not null) { <span class="native-kicker">Тренировка идёт</span><h2>@title</h2> }
        else { <h2>Время двигаться.</h2> }
        @if (Model.IsCoachView) { <a class="em-primary em-hero-start" href="@Url.Page("/Training/Plans", Model.NavigationValues)">План тренировок</a> }
        else if (!Model.Reference && active is not null) { <a class="em-primary em-hero-start" asp-page="/Training/Workouts/Details" asp-route-id="@active.Id"><reference-icon name="play" />Продолжить тренировку</a> }
        else if (!Model.Reference && date == Model.Data.Today) { <form method="post" asp-page="/Dashboard/Index" asp-page-handler="Start"><input type="hidden" name="source" value="@(planned is not null ? "planned" : "program")"/><input type="hidden" name="plannedId" value="@planned?.Id"/><input type="hidden" name="programId" value="@Model.ActiveProgram?.Id"/><button class="em-primary em-hero-start" type="submit"><reference-icon name="play" />Начать по плану</button></form> }
        else if (!Model.Reference && date.HasValue) { <a class="em-primary em-hero-start" href="@(planned is not null ? Url.Page("/Training/Workouts/Details", new { id = planned.Id }) : Url.Page("/Training/Programs/Details", new { id = Model.ActiveProgram?.Id }))"><reference-icon name="calendar" />Открыть план</a> }
        else { <button class="em-primary em-hero-start" type="button" data-dialog="quick-workout-dialog"><reference-icon name="play" />@(Model.Reference ? "Начать по плану" : "Начать тренировку")</button> }
        @if (!Model.IsCoachView && active is null)
        {
            <div class="em-shortcuts" aria-label="Способы начала тренировки">
                <form method="post" asp-page="/Dashboard/Index" asp-page-handler="Start" data-quick-start>
                    <input type="hidden" name="source" value="empty" />
                    <button type="submit" aria-label="Быстрая тренировка"><reference-icon name="bolt" /><span>Быстрая<br/>тренировка</span></button>
                </form>
                <button type="button" data-dialog="template-start-dialog"><reference-icon name="document" /><span>Из шаблона</span></button>
                <form method="post" asp-page="/Dashboard/Index" asp-page-handler="Start"><input type="hidden" name="source" value="previous"/><button type="@(Model.Reference ? "button" : "submit")" data-dialog="@(Model.Reference ? "quick-workout-dialog" : null)" disabled="@(!Model.Reference && !Model.Data.Completed.Any())"><reference-icon name="repeat" /><span>Повторить</span></button></form>
            </div>
        }
    </section>
    @if (!Model.IsCoachView) { <div class="em-manual-actions"><a class="em-outline" asp-page="/Training/Workouts/Record"><reference-icon name="pencil" />Записать результат</a><a asp-page="/Training/Workouts/Create">Составить тренировку</a></div> }
    <section class="native-history-totals"><div><strong>@vm.MonthlyWorkouts</strong><span>за последние 30 дней</span></div><div><strong>@vm.WeeklyWorkouts<small> / @vm.WeeklyTarget</small></strong><span>цель на неделю</span></div></section>
    <div class="em-segments" role="tablist" aria-label="Просмотр тренировок"><button class="active" type="button" role="tab" aria-selected="true" aria-controls="mobile-history" data-mobile-tab="mobile-history">История</button><button type="button" role="tab" aria-selected="false" aria-controls="mobile-calendar" data-mobile-tab="mobile-calendar">Календарь</button></div>
    <section id="mobile-history" role="tabpanel">
        <div class="em-history-tools"><details class="em-month-picker"><summary>@ru.TextInfo.ToTitleCase((Model.Reference && !hasMonthQuery ? new DateOnly(2026, 9, 1) : vm.Month).ToString("MMMM yyyy", ru))<reference-icon name="chevron" /></summary><div>@for (var i = 0; i < 6; i++) { var m = vm.Month.AddMonths(-i); <a href="@(PageUrl(month: m, workoutDate: null) + "#mobile-history")">@ru.TextInfo.ToTitleCase(m.ToString("MMMM yyyy", ru))</a> }</div></details><button class="em-icon-button" type="button" data-dialog="mobile-workout-filters" aria-label="Фильтры истории"><reference-icon name="sliders" /></button></div>
        <div class="em-history-list">
            @foreach (var w in history) {
                <a class="native-history-row" href="@(Model.Reference ? "#mobile-workout-" + w.Id : Url.Page("/Training/Workouts/Details", new { id = w.Id }))" data-dialog="@(Model.Reference ? "mobile-workout-" + w.Id : "history-peek-" + w.Id)"><time datetime="@w.Date.ToString("yyyy-MM-dd")"><strong>@w.Date.Day</strong><span>@w.Date.ToString("MMM", ru)</span></time><div><h2>@w.Title</h2><p>@DashboardWorkoutsViewModel.ExerciseCount(w.Exercises) · Подходов: @w.Sets</p><small><reference-icon name="check" />@(w.IsManual ? "Внесена вручную" : "Завершена")</small></div><reference-icon name="chevron" /></a>
            }
            @if (history.Count == 0) { <div class="em-card em-empty"><reference-icon name="workout" /><h2>Тренировки не найдены</h2><p>Выберите другой период или начните занятие.</p></div> }
        </div>
    </section>
    <section id="mobile-calendar" role="tabpanel" hidden><div class="em-card em-calendar"><header><a href="@PageUrl(month: vm.Month.AddMonths(-1))" aria-label="Предыдущий месяц"><reference-icon name="chevron" /></a><h2>@ru.TextInfo.ToTitleCase(vm.Month.ToString("MMMM yyyy", ru))</h2><a href="@PageUrl(month: vm.Month.AddMonths(1))" aria-label="Следующий месяц"><reference-icon name="chevron" /></a></header><div class="em-calendar-grid">@foreach (var day in new[] { "Пн", "Вт", "Ср", "Чт", "Пт", "Сб", "Вс" }) { <span>@day</span> }@foreach (var day in vm.Calendar) { var status = Model.Reference ? day.Date is { Year: 2026, Month: 9, Day: 28 or 30 } ? "completed" : day.Date >= new DateOnly(2026, 10, 2) && (day.Date.DayOfWeek is DayOfWeek.Monday or DayOfWeek.Wednesday or DayOfWeek.Friday) ? "planned" : "none" : day.Status; <a href="@(day.PlannedWorkoutId is { } id ? Url.Page("/Training/Workouts/Details", new { id }) : day.ProgramId is { } pid ? Url.Page("/Training/Programs/Details", new { id = pid, Tab = "schedule", Week = day.Date.ToString("yyyy-MM-dd"), Day = day.Date.ToString("yyyy-MM-dd") }) : PageUrl(workoutDate: day.Date))" class="@(day.Date.Month != vm.Month.Month ? "outside" : "")" aria-label="@day.Date.ToString("d MMMM", ru), @(status == "completed" ? "Выполнена" : status == "planned" ? "Запланирована" : "Нет тренировки")">@day.Date.Day<i class="@status"></i></a> }</div><footer><span><i class="completed"></i>Выполнена</span><span><i class="planned"></i>Запланирована</span></footer></div></section>
</div>
<dialog id="mobile-workout-filters" class="app-dialog app-workspace"><div class="dialog-heading"><h2>Фильтры истории</h2><button class="icon-button" type="button" data-close aria-label="Закрыть"><reference-icon name="close" /></button></div><form method="get" class="em-filter-form app-workspace"><input type="hidden" name="Reference" value="@Model.Reference.ToString().ToLowerInvariant()"/><input type="hidden" name="ClientId" value="@Model.ClientId"/><label>Поиск<input type="search" name="Search" value="@Model.Search" placeholder="Название или упражнение"/></label><label>Программа<select name="WorkoutProgram"><option value="">Все программы</option>@foreach (var p in vm.Programs) { <option value="@p.Value" selected="@(p.Value == Model.WorkoutProgram)">@p.Name</option> }</select></label><label>Период<select name="Days">@foreach (var (days, label) in new[] { (7,"Неделя"), (30,"Месяц"), (365,"Год") }) { <option value="@days" selected="@(days == Model.Days)">@label</option> }</select></label><button class="app-button" type="submit">Применить</button></form></dialog>
@if (Model.Reference) { @foreach (var w in vm.History) { <dialog id="mobile-workout-@w.Id" class="app-dialog app-workspace"><div class="dialog-heading"><h2>@w.Title · @w.Date.ToString("d MMMM", ru)</h2><button class="icon-button" type="button" data-close aria-label="Закрыть"><reference-icon name="close" /></button></div><div class="em-workout-detail">@foreach (var e in w.Preview) { <div><reference-icon name="workout" /><p><strong>@e.Name</strong><span>@e.Summary</span></p></div> }</div></dialog> } }
