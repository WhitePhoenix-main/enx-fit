@using enx_fit.Pages.Dashboard
@model enx_fit.Pages.Dashboard.DashboardModel
@if (!Model.IsCoachView)
{
<dialog class="app-dialog quick-dialog app-workspace" id="quick-workout-dialog" aria-labelledby="quick-title">
    <div class="dialog-heading"><h2 id="quick-title">Как хотите тренироваться?</h2><button type="button" class="icon-button" data-close aria-label="Закрыть"><admin-icon name="close" /></button></div>
    <div class="quick-options">
        <a class="quick-option" asp-page="/Training/Workouts/Record"><admin-icon name="plus" /><span><strong>Записать тренировку</strong><small>Внести уже выполненное занятие без запуска таймера</small></span><admin-icon name="arrow" /></a>
        <a class="quick-option" asp-page="/Training/Workouts/Templates"><admin-icon name="layers" /><span><strong>Заниматься по шаблону</strong><small>Начать с готовым составом упражнений и подходов</small></span><admin-icon name="arrow" /></a>
        <form method="post" asp-page="/Dashboard/Index" asp-page-handler="Start"><input type="hidden" name="source" value="empty" /><button class="quick-option"><admin-icon name="bolt" /><span><strong>Добавлять упражнения на лету</strong><small>Начать свободно и собирать занятие по ходу</small></span><admin-icon name="arrow" /></button></form>
    </div>
</dialog>
<dialog class="app-dialog quick-dialog app-workspace" id="template-start-dialog" aria-labelledby="template-start-title"
        data-templates-url="@Url.Page("/Dashboard/Index", "Templates", new { area = "" })">
    <div class="dialog-heading"><h2 id="template-start-title">Загрузить шаблон</h2><button class="icon-button" data-close aria-label="Закрыть"><admin-icon name="close" /></button></div>
    <p class="muted">Тренировки из ваших программ и готовых шаблонов. Изменения занятия не затронут оригинал.</p>
    <div data-template-content><p class="muted" role="status" aria-live="polite">Загружаем шаблоны…</p></div>
    <button class="button secondary" type="button" data-template-retry hidden>Повторить загрузку</button>
</dialog>
}
