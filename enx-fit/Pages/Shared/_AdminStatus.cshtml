@if (TempData["StatusMessage"] is string message) { <div class="alert alert-success app-status app-notice" data-app-state="saved" role="status"><admin-icon name="check" />@message</div> }
@if (TempData["ErrorMessage"] is string error) { <div class="alert alert-danger app-status app-notice" data-app-state="error" role="alert">@error</div> }
