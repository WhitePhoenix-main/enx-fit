@model enx_fit.Pages.DashboardModel
@using enx_fit.Services
@using enx_fit.ViewModels
@{
    var vm = new DashboardWorkoutsViewModel(Model);
    var ru = DashboardWorkoutsViewModel.Russian;
}
@if (!Model.Reference)
{
    @foreach (var item in vm.History)
    {
        <dialog class="app-dialog history-peek-dialog" id="history-peek-@item.Id" aria-labelledby="history-peek-title-@item.Id">
            <div class="dialog-heading"><h2 id="history-peek-title-@item.Id">@item.Title</h2><button class="icon-button" type="button" data-close aria-label="Закрыть"><reference-icon name="close" /></button></div>
            <p class="muted">@item.Date.ToString("d MMMM yyyy", ru) · @item.Sets рабочих подходов · @item.Volume.ToString("0.##", ru) кг</p>
            <div class="history-peek-exercises">@foreach (var exercise in item.Preview) { <div><reference-icon name="workout" /><span><strong>@exercise.Name</strong><small>@exercise.Summary</small></span></div> }</div>
            <div class="history-peek-actions"><a class="button secondary" asp-page="/Workouts/Details" asp-route-id="@item.Id">Все подходы<reference-icon name="arrow" /></a>
            @if (!Model.IsCoachView) { <form method="post" asp-page="/Dashboard" asp-page-handler="Start"><input type="hidden" name="source" value="previous" /><input type="hidden" name="previousId" value="@item.Id" /><button class="button"><reference-icon name="repeat" />Повторить занятие</button></form> }</div>
        </dialog>
    }
}
