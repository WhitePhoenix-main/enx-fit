@using enx_fit.ViewModels.Navigation
@model enx_fit.ViewModels.Navigation.MobileAppNavigationViewModel
@{
    string? PageUrl(string page) => Model.PageUrl(Url, page);
    var name = Model.Reference ? "Алексей" : Model.Dashboard?.Data.Name ?? User.Identity?.Name?.Split('@')[0] ?? "Спортсмен";
    var initial = string.IsNullOrWhiteSpace(name) ? "Я" : name[..1].ToUpperInvariant();
    var root = Model.Page is "/Dashboard/Index" or "/Training/Index" or "/Training/Programs/Index" or "/Progress/Index";
    var parent = Model.IsActive("workouts") ? "/Training/Index" : Model.IsActive("programs") ? "/Training/Programs/Index" : Model.IsActive("progress") ? "/Progress/Index" : "/Dashboard/Index";
}
@if (Model.Reference)
{
    <div class="em-mobile-statusbar" aria-hidden="true"><span>9:41</span><div><svg viewBox="0 0 20 16"><rect x="0" y="10" width="3" height="6" rx="1"/><rect x="5" y="7" width="3" height="9" rx="1"/><rect x="10" y="4" width="3" height="12" rx="1"/><rect x="15" width="3" height="16" rx="1"/></svg><svg viewBox="0 0 24 18" fill="none"><path d="M2 5a16 16 0 0 1 20 0M6 10a10 10 0 0 1 12 0M10 15a3 3 0 0 1 4 0" stroke="currentColor" stroke-width="3" stroke-linecap="round"/></svg><svg viewBox="0 0 29 15"><rect x="1" y="1" width="24" height="13" rx="3" fill="none" stroke="currentColor"/><rect x="3" y="3" width="20" height="9" rx="1"/><path d="M27 5v5" stroke="currentColor" stroke-width="2"/></svg></div></div>
}
<header class="em-mobile-header">
    <div class="em-mobile-header-inner">
        @if (root) { <a class="em-mobile-brand" href="@PageUrl("/Dashboard/Index")" aria-label="Enix Fit — главная"><partial name="/Pages/Shared/Navigation/_Brand.cshtml" /></a> }
        else { <a class="mc-back-link" href="@PageUrl(parent)" aria-label="Вернуться в раздел"><reference-icon name="chevron" /><span>@(Model.Page.StartsWith("/Training/Workouts/Details") ? "Тренировки" : ViewData["Title"])</span></a> }
        <div class="em-mobile-actions">
            <a class="em-mobile-schedule" href="@PageUrl("/Training/Plans")" aria-label="Расписание тренировок"><reference-icon name="calendar" /></a>
            <a class="em-mobile-avatar" href="@PageUrl("/Account/Profile")" aria-label="Профиль">@initial</a>
        </div>
    </div>
</header>
<partial name="/Pages/Shared/Navigation/_MobileBottomNavigation.cshtml" model="Model" />
<dialog id="mobile-notifications-dialog" class="em-mobile-dialog app-workspace">
    <div class="em-mobile-dialog-heading"><h2>Центр уведомлений</h2><button class="app-icon-button" type="button" data-mobile-close aria-label="Закрыть"><reference-icon name="close" /></button></div>
    <div class="em-mobile-notifications-empty"><reference-icon name="bell" /><h3>Вы всё посмотрели</h3><p>Новых уведомлений пока нет.</p></div>
</dialog>
