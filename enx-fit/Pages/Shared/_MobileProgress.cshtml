@model enx_fit.Pages.DashboardModel
@using enx_fit.ViewModels
@{
    var vm = new DashboardProgressViewModel(Model);
    var ru = DashboardWorkoutsViewModel.Russian;
    string N(decimal? value) => value?.ToString("0.#", ru) ?? "—";
    string Delta(decimal value) => (value < 0 ? "−" : "+") + N(Math.Abs(value));
    string? PageUrl(string? tab = null, int? weeks = null, Guid? exercise = null) => Url.Page("/Dashboard/Progress", new { Model.ClientId, Model.Days, Model.Until, Reference = Model.Reference ? (bool?)true : null, ProgressTab = tab ?? Model.ProgressTab, ProgressWeeks = Model.ProgressWeeks, ChartWeeks = weeks ?? Model.ChartWeeks, ProgressExercise = exercise ?? vm.ExerciseId });
    var points = Model.Reference && vm.ExerciseId == ExerciseIds.FromLegacy(1) && Model.ChartWeeks == 6 ? vm.Strength.Select((p, i) => i == 0 ? p with { Date = new DateOnly(2026, 8, 27) } : p).ToList() : vm.Strength;
}
<div class="ef-mobile-screen em-progress">
    <header class="em-page-heading"><h1>Прогресс</h1>@if (!Model.IsCoachView) { <a class="em-primary" asp-page="/Body/Create"><reference-icon name="plus" />Добавить замер</a> }</header>
    <nav class="em-segments" aria-label="Разделы прогресса">@foreach (var (tab, label) in new[] { ("overview","Обзор"), ("analytics","Аналитика"), ("records","Рекорды") }) { <a class="@(Model.ProgressTab == tab ? "active" : "")" href="@PageUrl(tab)">@label</a> }</nav>
    <div class="em-progress-stats"><a class="em-card em-progress-stat" href="#mobile-strength"><reference-icon name="bars"/><div><strong>@N(vm.WorkingWeight) кг</strong><p>Рабочий вес</p>@if (vm.StrengthChange is { } strength) { <span><reference-icon name="@(strength < 0 ? "down-right" : "up-right")"/>@Delta(strength) кг</span> }</div><reference-icon name="chevron"/></a><a class="em-card em-progress-stat" asp-page="/Body/Index"><reference-icon name="body-scale"/><div><strong>@N(vm.Latest?.WeightKg) кг</strong><p>Вес тела</p>@if (vm.WeightChange is { } weight) { <span><reference-icon name="@(weight < 0 ? "down-right" : "up-right")"/>@Delta(weight) кг</span> }</div><reference-icon name="chevron"/></a></div>
    @if (Model.ProgressTab != "records") {
        <section class="em-card em-strength" id="mobile-strength"><header><details class="em-exercise-picker"><summary><reference-icon name="bars"/>@vm.ExerciseName</summary><div>@foreach (var exercise in vm.Exercises) { <a href="@PageUrl(exercise: exercise.Id)">@exercise.Name</a> }</div></details><details class="em-chart-period"><summary>@Model.ChartWeeks @(Model.ChartWeeks == 6 ? "недель" : "недели")<reference-icon name="chevron"/></summary><div>@foreach (var weeks in new[] { 2, 4, 6 }) { <a href="@PageUrl(weeks: weeks)">@weeks @(weeks == 6 ? "недель" : "недели")</a> }</div></details></header><p>Выполненный рабочий вес, кг</p><partial name="_ProgressChart" model="@(new ProgressChart("mobile-progress-strength", vm.ExerciseName + ": выполненный рабочий вес, кг", points, FixedScale: Model.Reference && vm.ExerciseId == ExerciseIds.FromLegacy(1) ? (40m, 70m, 10m) : null))"/></section>
        @if (Model.ProgressTab == "overview") {
            <section class="em-card em-progress-goal"><reference-photo class="em-goal-photo" image="progress" window="155 1015 165 268" alt="Штанга для жима лёжа"/><div><h2><reference-icon name="target"/>Следующая цель<reference-icon name="chevron"/></h2>@if (Model.Reference || Model.NextRecommendation is not null) { var goal = Model.NextRecommendation; <strong>@(Model.Reference ? "60 → 62,5 кг" : $"{N(goal!.CurrentValue)} → {N(goal.SuggestedValue)} кг")</strong><p>@(Model.Reference ? "Жим лёжа" : ExercisePresentation.DisplayName(Model.NextGoalExercise!.Exercise)) · Рабочий вес</p><span class="em-pending"><reference-icon name="clock"/>Ожидает подтверждения</span><footer><button class="em-why" type="button" data-dialog="progress-goal-dialog"><reference-icon name="info"/>Почему?</button>@if (Model.Reference) { <button class="em-primary" type="button" data-dialog="progress-goal-dialog">Рассмотреть</button> } else { <a class="em-primary" asp-page="/Programs/Details" asp-route-id="@Model.ActiveProgram?.Id" asp-route-Tab="progression" asp-route-ExerciseId="@Model.NextGoalExercise?.Id">Рассмотреть</a> }</footer> } else { <strong>@Model.Data.ThisWeek.Count() / @Model.Data.Settings.WeeklyWorkoutGoal</strong><p>@Model.Data.Settings.GoalTitle</p><a class="em-primary" asp-page="/Programs/Index">Открыть программу</a> }</div></section>
            <section class="em-card em-last-measurement"><h2><reference-icon name="body-scale"/>Последний замер тела<reference-icon name="chevron"/></h2><div><p>Вес<strong>@N(vm.Latest?.WeightKg) кг</strong><span>@(Model.Reference ? "28 сентября" : vm.Latest?.Date.ToString("d MMMM", ru) ?? "Замеров пока нет")</span></p>@if (!Model.IsCoachView) { <a class="em-outline" asp-page="/Body/Create"><reference-icon name="plus"/>Добавить замер</a> }</div></section>
        }
        else { <section class="em-card em-strength"><h2>Вес тела · кг</h2><partial name="_ProgressChart" model="@(new ProgressChart("mobile-progress-body", "Вес тела, кг", vm.Body, DecimalLabels: true))"/></section><section class="em-card em-strength"><h2>Объём тренировок · кг</h2><partial name="_ProgressChart" model="@(new ProgressChart("mobile-progress-volume", "Объём рабочих подходов, кг", vm.Volume))"/></section> }
    }
    else { <section class="em-records"><h2>Личные рекорды</h2>@foreach (var record in vm.Records) { <a class="em-card em-record" href="@(Model.Reference ? "#progress-record-" + record.ExerciseId : Url.Page("/Workouts/Details", new { id = record.WorkoutId }))" data-dialog="@(Model.Reference ? "progress-record-" + record.ExerciseId : null)"><reference-icon name="trophy"/><div><h3>@record.Name</h3><strong>@N(record.Weight) кг</strong><p>@record.Date.ToString("d MMMM yyyy", ru)</p></div><reference-icon name="chevron"/></a> }@if (vm.Records.Count == 0) { <p class="em-card em-empty">Рекорды появятся после сохранения рабочих подходов.</p> }</section> }
</div>
