@model enx_fit.ViewModels.DashboardProgressViewModel
@{
    var dashboard = ViewData["Dashboard"] as enx_fit.Pages.DashboardModel;
    var ru = enx_fit.ViewModels.DashboardWorkoutsViewModel.Russian;
    var max = Math.Max(3, Model.Weeks.Select(w => w.Count).DefaultIfEmpty().Max());
    var active = Model.Weeks.Count(w => w.Count > 0);
}
<div class="pw-week-chart" role="group" aria-label="Завершённые тренировки по семидневным отрезкам" style="--weeks:@Model.Weeks.Count">
    @foreach (var week in Model.Weeks) {
        var height = Math.Max(3m, 100m * week.Count / max).ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);
        var label = week.Since.ToString("d MMMM", ru) + " — " + week.Until.ToString("d MMMM yyyy", ru) + ": " + week.Count + " занятий";
        <a class="pw-week @(week.Count == 0 ? "is-zero" : "")" href="@Url.Page("/Dashboard/Workouts", new { ClientId = dashboard?.IsCoachView == true ? dashboard.Data.Subject.Id : null, Days = 7, Until = week.Until.ToString("yyyy-MM-dd") })" aria-label="@label. Открыть историю" title="@label" data-progress-week data-count="@week.Count" data-since="@week.Since.ToString("yyyy-MM-dd")" data-until="@week.Until.ToString("yyyy-MM-dd")"><span class="pw-week-track"><span class="pw-week-bar" style="--bar-height:@(height)%"><strong>@week.Count</strong></span></span><time datetime="@week.Since.ToString("yyyy-MM-dd")">@week.Since.ToString("dd.MM")</time></a>
    }
</div>
<p class="pw-consistency-note">@active из @Model.Weeks.Count отрезков с занятиями. Каждый столбец — 7 дней; нажмите, чтобы открыть тренировки.</p>
@if (Model.WorkoutCount == 0) { <p class="pw-note">За выбранный период завершённых занятий нет. Можно сменить период или записать прошедшую тренировку.</p> }
