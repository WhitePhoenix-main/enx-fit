@inject enx_fit.Security.IFeatureAccessService SubscriptionAccess
@{ var subscriptionAccess = User.Identity?.IsAuthenticated == true ? await SubscriptionAccess.GetAsync() : null; }
@using enx_fit.ViewModels.Navigation
@{
    var authenticated = User.Identity?.IsAuthenticated == true;
    var mobileNavigation = enx_fit.ViewModels.Navigation.MobileAppNavigationViewModel.Create(ViewData, User, ViewContext.RouteData.Values["page"] as string);
}
<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <title>@(ViewData["DocumentTitle"] ?? $"{ViewData["Title"]} - Enix Fit")</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/app-header.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/enx-fit.styles.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
    @if (authenticated) {
        <partial name="/Pages/Shared/Icons/_AppIcons.cshtml" />
        <link rel="stylesheet" href="~/css/mobile-shell.css" asp-append-version="true" />
        <link rel="stylesheet" href="~/css/app-components.css" asp-append-version="true" />
        <link rel="stylesheet" href="~/css/mobile-coach.css" asp-append-version="true" />
        <link rel="stylesheet" href="~/css/native-app.css" asp-append-version="true" />
    }
    <link rel="stylesheet" href="~/css/subscription-theme.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/app-chrome.css" asp-append-version="true" />
</head>
<body data-subscription="@subscriptionAccess?.Plan.ToString().ToLowerInvariant()" class="@(authenticated ? "em-app-shell" : "")">
    <a class="skip-link" href="#main-content">Перейти к основному содержимому</a>
    <partial name="/Pages/Shared/Navigation/_Header.cshtml" />
    @if (authenticated) { <partial name="/Pages/Shared/Navigation/_MobileAppShell.cshtml" model="mobileNavigation" /><partial name="/Pages/Shared/Workouts/_WorkoutResume.cshtml" model="mobileNavigation" /> }

    <main id="main-content" class="container py-4" role="main" tabindex="-1">
        @RenderBody()
    </main>

    <footer class="border-top py-3 mt-auto text-muted">
        <div class="container">
            &copy; 2026 Enix Fit
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
