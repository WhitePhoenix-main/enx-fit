@using enx_fit.ViewModels.Progress
@{ var mobileNavigation = enx_fit.ViewModels.Navigation.MobileAppNavigationViewModel.Create(ViewData, User, ViewContext.RouteData.Values["page"] as string);
 var page=(enx_fit.Pages.Progress.IndexModel)Model; var data=page.Data; var coach=data.Coach;
    var nav=coach ? new[] { ("home-outline","Главная","/Dashboard/Index"),("users","Клиенты","/Coaching/Clients"),("calendar","Программы","/Training/Programs/Index"),("calendar","Календарь","/Coaching/Calendar"),("bars","Аналитика","/Progress/Analytics"),("workout-outline","Упражнения","/Training/Exercises/Index"),("book","Библиотека","/Training/Programs/Index"),("settings","Настройки","/Account/Profile") }
        : data.Advanced ? new[] { ("home-outline","Главная","/Dashboard/Index"),("calendar","Тренировки","/Training/Index"),("document","Программы","/Training/Programs/Index"),("bars","Прогресс","/Progress/Index"),("nutrition","Питание","/Nutrition/Index"),("pulse","Восстановление","/Dashboard/Habits"),("bars-outline","Аналитика","/Progress/Analytics"),("book","Упражнения","/Training/Exercises/Index"),("settings","Настройки","/Account/Profile") }
        : new[] { ("home-outline","Главная","/Dashboard/Index"),("calendar","Тренировки","/Training/Index"),("document","Программы","/Training/Programs/Index"),("bars","Прогресс","/Progress/Index"),("workout-outline","Упражнения","/Training/Exercises/Index"),("nutrition","Питание","/Nutrition/Index") };
}
<!DOCTYPE html>
<html lang="ru"><head><meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" /><meta name="theme-color" content="#030e1a" /><meta name="color-scheme" content="dark" /><title>@ViewData["Title"] — Enix Fit</title>
<link rel="stylesheet" href="~/css/subscription-dashboard.css" asp-append-version="true" /><link rel="stylesheet" href="~/css/subscription-theme.css" asp-append-version="true" /><link rel="stylesheet" href="~/css/progress-overview.css" asp-append-version="true" />    <link rel="stylesheet" href="~/css/app-chrome.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/fitness-reference.css" asp-append-version="true" /><link rel="stylesheet" href="~/css/coach-progress-reference.css" asp-append-version="true" /><link rel="stylesheet" href="~/css/reference-polish.css" asp-append-version="true" /></head>
<body class="fitness-app ref-app rd-app pa-app" data-subscription="@data.Theme" data-progress-plan="@data.Badge">
<a class="rd-skip" href="#main-content">Перейти к содержимому</a><div class="rd-shell"><aside class="rd-sidebar"><a class="rd-brand" asp-page="/Dashboard/Index"><partial name="/Pages/Shared/Navigation/_Brand.cshtml" /> @if(data.Access.Plan!=SubscriptionPlan.Free){<span class="rd-badge">@data.Badge</span>}</a><partial name="/Pages/Shared/Navigation/_FitnessNavigation.cshtml" />
<div class="rd-sidebar-footer">
    @if(!data.Advanced){<div class="rd-upgrade"><reference-icon name="crown" /><h3>Больше возможностей<br />в Pro</h3><p>Расширенная аналитика, подробные графики и персональные рекомендации.</p><a asp-page="/Account/Subscription">Узнать больше <reference-icon name="arrow" /></a></div>}
    <a class="rd-profile" asp-page="/Account/Profile"><span class="rd-avatar">@data.ViewerName[..1].ToUpperInvariant()</span><span><strong>@data.ViewerName</strong><small>@(coach?"Тренерский аккаунт":data.Advanced?"План Pro":"Базовый план")</small></span><span class="rd-badge">@data.Badge</span></a>
</div></aside><div class="rd-content"><header class="rd-mobile-header"><a class="rd-brand" asp-page="/Dashboard/Index"><partial name="/Pages/Shared/Navigation/_Brand.cshtml" /> <span class="rd-badge">@data.Badge</span></a><button type="button" class="rd-icon-button" data-progress-dialog="progress-notifications" aria-label="Уведомления"><reference-icon name="bell" />@if(coach&&data.Alerts.Count>0){<i class="rd-notification-dot"></i>}</button></header><main id="main-content" tabindex="-1">@RenderBody()</main></div></div>
<partial name="/Pages/Shared/Navigation/_MobileBottomNavigation.cshtml" model="mobileNavigation" />

<dialog class="rd-dialog" id="progress-notifications"><div class="dialog-heading"><h2>@(coach?"Требуют внимания":"Уведомления")</h2><button type="button" data-progress-close aria-label="Закрыть"><reference-icon name="close" /></button></div>@if(coach&&data.Alerts.Count>0){<div class="search-results">@foreach(var alert in data.Alerts.Take(8)){<a asp-page="/Coaching/Client" asp-route-id="@alert.ClientId">@alert.Name · @alert.Reason <reference-icon name="chevron" /></a>}</div>}else{<p>Новых уведомлений пока нет.</p>}</dialog>
<script src="~/js/progress-overview.js" asp-append-version="true"></script><script src="/js/dashboard.js"></script></body></html>

