@inject enx_fit.Security.IFeatureAccessService ProgramAccess
@{
    var access = await ProgramAccess.GetAsync();
    var navigation = enx_fit.ViewModels.Navigation.MobileAppNavigationViewModel.Create(ViewData, User, ViewContext.RouteData.Values["page"] as string);
}
<!DOCTYPE html><html lang="ru"><head>
<meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" /><meta name="theme-color" content="#11191d" /><meta name="color-scheme" content="dark" />
<title>@ViewData["Title"] — Enix Fit</title><partial name="/Pages/Shared/Icons/_AppIcons.cshtml" />
<link rel="preload" href="~/fonts/dashboard-sans.ttf" as="font" type="font/ttf" crossorigin /><link rel="preload" href="~/fonts/dashboard-condensed.ttf" as="font" type="font/ttf" crossorigin />
<link rel="stylesheet" href="~/css/subscription-dashboard.css" asp-append-version="true" /><link rel="stylesheet" href="~/css/programs.css" asp-append-version="true" /><link rel="stylesheet" href="~/css/program-catalog.css" asp-append-version="true" /><link rel="stylesheet" href="~/css/subscription-theme.css" asp-append-version="true" /><link rel="stylesheet" href="~/css/app-chrome.css" asp-append-version="true" /><link rel="stylesheet" href="~/css/account-avatar.css" asp-append-version="true" /><link rel="stylesheet" href="~/css/workout-hub.css" asp-append-version="true" />
@await RenderSectionAsync("Styles", required: false)
<link rel="stylesheet" href="~/css/program-workspace.css" asp-append-version="true" />
</head><body class="fitness-app rd-app workout-hub programs-app" data-subscription="@access.Plan.ToString().ToLowerInvariant()">
<a class="rd-skip" href="#main-content">Перейти к содержимому</a>
<div class="rd-shell"><aside class="rd-sidebar"><a class="rd-brand" asp-page="/Dashboard/Index"><partial name="/Pages/Shared/Navigation/_Brand.cshtml" /></a><partial name="/Pages/Shared/Navigation/_FitnessNavigation.cshtml" /><div class="rd-sidebar-footer"><a class="rd-profile" asp-page="/Account/Profile"><reference-icon name="user" /><span><strong>@User.Identity?.Name</strong><small>Подписка @access.Plan</small></span></a></div></aside>
<div class="rd-content"><header class="wh-brand-header"><a asp-page="/Dashboard/Index" aria-label="Главная Enix Fit"><partial name="/Pages/Shared/Navigation/_Brand.cshtml" /></a><div class="account-tools"><button class="wh-icon-button" type="button" data-dialog="program-notifications" aria-label="Уведомления"><reference-icon name="bell" /></button><partial name="/Pages/Shared/Navigation/_AccountAvatar.cshtml" /></div></header><main id="main-content" tabindex="-1"><div class="programs-page app-workspace">@RenderBody()</div></main></div></div>
<partial name="/Pages/Shared/Navigation/_MobileBottomNavigation.cshtml" model="navigation" />
<dialog class="app-dialog" id="program-notifications"><div class="dialog-heading"><h2>Уведомления</h2><button type="button" data-close aria-label="Закрыть"><reference-icon name="close" /></button></div><p>Новых уведомлений пока нет.</p></dialog>
<script src="~/js/site.js" asp-append-version="true"></script><script src="~/js/account-avatar.js" asp-append-version="true" defer></script><script src="~/js/training.js" asp-append-version="true"></script><script src="~/js/program-workspace.js" asp-append-version="true" defer></script>
@await RenderSectionAsync("Scripts", required: false)
</body></html>
