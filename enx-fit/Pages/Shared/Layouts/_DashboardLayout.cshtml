@using enx_fit.Pages.Dashboard
@using enx_fit.Presentation.Dashboard
@using enx_fit.Services.Dashboard
@using enx_fit.ViewModels.Navigation
@inject enx_fit.Security.IFeatureAccessService FeatureAccess
@inject DashboardService DashboardService
@{
    var featureAccess = await FeatureAccess.GetAsync();
    var dashboard = ViewData["Dashboard"] as enx_fit.Pages.Dashboard.DashboardModel;
    var goalTitle = dashboard?.Data.Settings.GoalTitle ?? await DashboardService.GetGoalTitleAsync();
    var activePage = ViewContext.RouteData.Values["page"] as string;
    bool IsActive(string page) => page == "/Progress/Index"
        ? activePage is "/Progress/Index" or "/Progress/Analytics" or "/Progress/Achievements"
        : page == "/Training/Index"
        ? activePage == page || activePage?.StartsWith("/Training/Workouts/", StringComparison.OrdinalIgnoreCase) == true
        : page == "/Training/Programs/Index"
        ? activePage?.StartsWith("/Training/Programs/", StringComparison.OrdinalIgnoreCase) == true || activePage == "/Training/Plans"
        : string.Equals(activePage, page, StringComparison.OrdinalIgnoreCase);
    var navigation = DashboardSections.All.Where(tab => tab.Page is not ("/Progress/Analytics" or "/Progress/Achievements")).Select(tab => tab.Page == "/Training/Plans"
        ? tab with { Page = "/Training/Programs/Index", Title = "Программы", Icon = "calendar" } : tab)
        .OrderBy(tab => tab.Page switch { "/Training/Index" => 0, "/Training/Programs/Index" => 1, "/Progress/Index" => 2, "/Dashboard/Habits" => 3, _ => 4 }).ToList();


    var viewer = User.Identity?.Name?.Split('@')[0] is { Length: > 0 } name ? name : "Спортсмен";
    var isTrainer = User.GetUserRole() == UserRole.Trainer || User.HasMinimumRole(UserRole.Administrator);
    var clientsActive = IsActive("/Coaching/Clients");
    var mobileNavigation = enx_fit.ViewModels.Navigation.MobileAppNavigationViewModel.Create(ViewData, User, activePage);
    var clientId = mobileNavigation.Client?.Id;
    string? PageUrl(string page) => mobileNavigation.PageUrl(Url, page);
    var dashboardUrl = PageUrl("/Dashboard/Index");
}
<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#0b111b" media="(min-width:1024px)" />
    <meta name="theme-color" content="#0b121a" media="(max-width:1023px)" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <title>@ViewData["Title"] — Enix Fit</title>
    <partial name="/Pages/Shared/Icons/_AppIcons.cshtml" />
    <link rel="stylesheet" href="~/css/dashboard.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/dashboard-widgets.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/dashboard-refresh.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/dashboard-design.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/workout-shared.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
    <link rel="stylesheet" href="~/css/mobile-shell.css" asp-append-version="true" />
    @if (isTrainer) { <link rel="stylesheet" href="~/css/coach-workspace.css" asp-append-version="true" /> }
    <link rel="stylesheet" href="~/css/app-components.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/mobile-coach.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/native-app.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/subscription-theme.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/app-chrome.css" asp-append-version="true" />
</head>
<body data-subscription="@featureAccess.Plan.ToString().ToLowerInvariant()" class="fitness-app em-app-shell @(clientId is not null ? "coach-mode" : "personal-mode") @(activePage == "/Dashboard/Index" ? "dashboard-home" : "")">
<a class="skip-link" href="#main-content">Перейти к содержимому</a>
<aside class="sidebar">
    <a class="brand" asp-page="/Dashboard/Index">
<partial name="/Pages/Shared/Navigation/_Brand.cshtml" />
</a>
    <nav aria-label="Основная навигация">
        <a class="nav-item @(IsActive("/Dashboard/Index") ? "active" : "")" href="@dashboardUrl" aria-current="@(IsActive("/Dashboard/Index") ? "page" : null)">
<admin-icon name="home" />Главная</a>
        @if (isTrainer) { <a class="nav-item @(clientsActive ? "active" : "")" asp-page="/Coaching/Clients" aria-current="@(clientsActive ? "page" : null)">
<admin-icon name="users" />Мои клиенты</a> }
        @foreach (var tab in navigation)
        {
            @if (tab.Page == "/Dashboard/Habits") { <a class="nav-item @(IsActive("/Training/Exercises/Index") ? "active" : "")" asp-page="/Training/Exercises/Index" aria-current="@(IsActive("/Training/Exercises/Index") ? "page" : null)"><admin-icon name="book" />Библиотека</a> }
            <a class="nav-item @(tab.Page == "/Dashboard/Habits" ? "nav-secondary" : "") @(IsActive(tab.Page) ? "active" : "")" href="@PageUrl(tab.Page)" aria-current="@(IsActive(tab.Page) ? "page" : null)">
                <admin-icon name="@(tab.Page == "/Dashboard/Habits" ? "check-circle" : tab.Page == "/Progress/Index" ? "bars" : tab.Icon)" />@tab.Title
            </a>
        }
    </nav>
    <div class="sidebar-bottom">
        <a class="nav-item" asp-area="Identity" asp-page="/Account/Manage/Index">
<admin-icon name="user" />Профиль</a>
        <a class="nav-item" asp-area="Identity" asp-page="/Account/Manage/Email"><admin-icon name="settings" />Настройки</a>
        @if (User.HasMinimumRole(UserRole.Administrator)) { <a class="nav-item" asp-page="/Admin/Index">
<admin-icon name="shield" />Администрирование</a> }
        <div class="sidebar-motivation">
<admin-icon name="spark" />
<strong>Текущая цель</strong>
<p>@goalTitle</p>
<a href="@PageUrl("/Training/Plans")" class="button secondary">К моей цели <admin-icon name="arrow" />
</a>
</div>
        <form method="post" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="/">
<button class="nav-item" type="submit">
<admin-icon name="logout" />Выйти</button>
</form>
    </div>
</aside>
<div class="app-body">
    <partial name="/Pages/Shared/Navigation/_MobileAppShell.cshtml" model="mobileNavigation" /><partial name="/Pages/Shared/Workouts/_WorkoutResume.cshtml" model="mobileNavigation" />
    <header class="topbar em-desktop-header">
        <a class="brand mobile-brand" asp-page="/Dashboard/Index">
<partial name="/Pages/Shared/Navigation/_Brand.cshtml" />
</a>
        <button class="search-trigger" data-dialog="search-dialog">
<admin-icon name="search" />
<span>Поиск разделов</span><kbd>Ctrl K</kbd>
</button>
        <div class="topbar-actions">
            <button class="icon-button notification-button" data-dialog="notifications-dialog" aria-label="Уведомления">
<admin-icon name="bell" />
</button>
            <details class="account-menu"><summary>
<span class="avatar reference-avatar" aria-hidden="true">@viewer[..1].ToUpperInvariant()</span>
<span class="account-copy">
<strong>@viewer</strong>
<small class="account-plan">@(featureAccess.Plan switch { SubscriptionPlan.Pro => "Pro", SubscriptionPlan.Coach => "Coach", _ => "Free" })</small>
</span>
<admin-icon name="chevron" />
</summary>
<div class="account-dropdown">
<a asp-page="/Dashboard/Index">Моя статистика</a>@if (isTrainer) { <a asp-page="/Coaching/Clients">Мои клиенты</a> }<a asp-area="Identity" asp-page="/Account/Manage/Index">Настройки профиля</a>
<form method="post" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="/">
<button type="submit">Выйти</button>
</form>
</div>
</details>
        </div>
    </header>
    <main id="main-content" class="app-workspace" tabindex="-1"><partial name="/Pages/Shared/Coaching/_CoachContext.cshtml" model="mobileNavigation" />@RenderBody()</main>
</div>
<dialog id="navigation-dialog" class="app-dialog app-workspace">
    <div class="dialog-heading">
        <h2>Разделы</h2>
        <button class="icon-button" data-close aria-label="Закрыть"><admin-icon name="close" /></button>
    </div>
    <nav class="search-results" aria-label="Все разделы">
        <a href="@dashboardUrl" aria-current="@(IsActive("/Dashboard/Index") ? "page" : null)">Главная <admin-icon name="home" /></a>
        @foreach (var tab in navigation)
        {
            <a href="@PageUrl(tab.Page)" aria-current="@(IsActive(tab.Page) ? "page" : null)">@tab.Title <admin-icon name="@tab.Icon" /></a>
        }
        @if (isTrainer) { <a asp-page="/Coaching/Clients" aria-current="@(clientsActive ? "page" : null)">Мои клиенты <admin-icon name="users" /></a> }
        <a asp-page="/Training/Exercises/Index">Библиотека упражнений <admin-icon name="book" /></a>
        <a asp-area="Identity" asp-page="/Account/Manage/Index">Профиль <admin-icon name="user" /></a>
    </nav>
</dialog>
<dialog id="search-dialog" class="app-dialog app-workspace">
<div class="dialog-heading">
<h2>Быстрый переход</h2>
<button class="icon-button" data-close aria-label="Закрыть">
<admin-icon name="close" />
</button>
</div>
<input class="dialog-search" type="search" placeholder="Что хотите найти?" aria-label="Поиск раздела" data-section-search />
<div class="search-results">
<a href="@PageUrl("/Training/Index")">Тренировки и упражнения <admin-icon name="workout" />
</a>
<a href="@PageUrl("/Progress/Analytics")">Аналитика и тренировочный объём <admin-icon name="bars" />
</a>
<a href="@PageUrl("/Progress/Index")">Прогресс, вес и замеры тела <admin-icon name="scale" />
</a>
<a href="@PageUrl("/Training/Programs/Index")">Программы тренировок <admin-icon name="calendar" />
</a>
<a asp-page="/Training/Exercises/Index">Библиотека упражнений <admin-icon name="book" /></a>
<a href="@PageUrl("/Dashboard/Habits")">Вода, сон и привычки <admin-icon name="water" />
</a>
<a href="@PageUrl("/Progress/Achievements")">Достижения и личные рекорды <admin-icon name="trophy" /></a>
@if (isTrainer) { <a asp-page="/Coaching/Clients">Мои клиенты <admin-icon name="users" />
</a> }<p hidden data-search-empty>Ничего не найдено. Попробуйте другой запрос.</p>
</div>
</dialog>
<dialog id="notifications-dialog" class="app-dialog app-workspace">
<div class="dialog-heading">
<h2>Центр уведомлений</h2>
<button class="icon-button" data-close aria-label="Закрыть">
<admin-icon name="close" />
</button>
</div>
<div class="empty-state">
<admin-icon name="bell" />
<h3>Вы всё посмотрели</h3>
<p>Новых уведомлений пока нет.</p>
</div>
</dialog>
<script src="~/js/site.js" asp-append-version="true"></script>
<script src="~/js/dashboard.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
