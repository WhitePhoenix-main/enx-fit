@{ Layout = "/Pages/Shared/Layouts/_FitnessLayout.cshtml"; ViewData["AppClass"] = ""; }
@section Styles {
<link rel="stylesheet" href="~/css/dashboard-widgets.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/coach-workspace.css" asp-append-version="true" />
@await RenderSectionAsync("Styles", required: false)
}
@RenderBody()
@section Scripts {
<script src="~/js/training.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
}
