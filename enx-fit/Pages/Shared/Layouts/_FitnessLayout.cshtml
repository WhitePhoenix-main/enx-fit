@inject enx_fit.Security.IFeatureAccessService FitnessAccess
@{
    var access = await FitnessAccess.GetAsync();
    var theme = access.Plan.ToString().ToLowerInvariant();
    var nav = enx_fit.ViewModels.Navigation.MobileAppNavigationViewModel.Create(ViewData, User, ViewContext.RouteData.Values["page"] as string);
    var name = nav.Dashboard?.Data.Name ?? User.Identity?.Name?.Split('@')[0] ?? "Спортсмен";
    var coach = access.CanUse(enx_fit.Security.Feature.CoachClientManagement) && nav.IsTrainer;
}
<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#030e1b" /><meta name="color-scheme" content="dark" />
    <title>@ViewData["Title"] — Enix Fit</title>
    <partial name="/Pages/Shared/Icons/_AppIcons.cshtml" />
    <link rel="stylesheet" href="~/css/dashboard.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/dashboard-reference.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/workout-shared.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/app-components.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/subscription-dashboard.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
    <link rel="stylesheet" href="~/css/subscription-theme.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/app-chrome.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/fitness-reference.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/reference-polish.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/exercise-reference.css" asp-append-version="true" />
</head>
<body class="fitness-app rd-app ref-app @ViewData["AppClass"]" data-subscription="@theme">
<a class="rd-skip" href="#main-content">Перейти к содержимому</a>
<div class="rd-shell">
    <aside class="rd-sidebar">
        <a class="rd-brand" asp-page="/Dashboard/Index"><partial name="/Pages/Shared/Navigation/_Brand.cshtml" /><span class="ref-plan">@access.Plan</span></a>
        <partial name="/Pages/Shared/Navigation/_FitnessNavigation.cshtml" />
        <div class="rd-sidebar-footer">
            @if (access.Plan == SubscriptionPlan.Free) { <a class="ref-upgrade" asp-page="/Account/Subscription"><reference-icon name="crown" /><strong>Больше с Enix Fit Pro</strong><small>Программы, аналитика и рекомендации</small><span>Узнать больше <reference-icon name="arrow" /></span></a> }
            <a class="rd-profile" asp-page="/Account/Profile"><span class="rd-avatar">@name[..1].ToUpperInvariant()</span><span><strong>@name</strong><small>@(coach ? "Фитнес-тренер" : access.Plan == SubscriptionPlan.Pro ? "Премиум-доступ" : "Базовый план")</small></span><reference-icon name="settings" /></a>
        </div>
    </aside>
    <div class="rd-content">
        <header class="ref-mobile-header"><a class="rd-brand" asp-page="/Dashboard/Index"><partial name="/Pages/Shared/Navigation/_Brand.cshtml" /><span class="ref-plan">@access.Plan</span></a><button class="ref-icon" type="button" data-dialog="notifications-dialog" aria-label="Уведомления"><reference-icon name="bell" /></button></header>
        <div class="ref-desktop-tools"><button class="ref-search" type="button" data-dialog="search-dialog"><reference-icon name="search" />Поиск тренировок, упражнений, программ…</button><button class="ref-icon" type="button" data-dialog="notifications-dialog" aria-label="Уведомления"><reference-icon name="bell" /></button></div>
        <main class="ref-main app-workspace" id="main-content" tabindex="-1">@RenderBody()</main>
    </div>
</div>
<partial name="/Pages/Shared/Navigation/_MobileBottomNavigation.cshtml" model="nav" />

<dialog class="app-dialog rd-dialog" id="search-dialog"><div class="dialog-heading"><h2>Быстрый переход</h2><button type="button" data-close aria-label="Закрыть"><reference-icon name="close" /></button></div><input class="dialog-search" type="search" data-section-search placeholder="Найти раздел…" aria-label="Найти раздел" /><div class="search-results"><a asp-page="/Training/Index">Тренировки</a><a asp-page="/Training/Workouts/Templates">Шаблоны тренировок</a><a asp-page="/Training/Exercises/Index">Упражнения</a><a asp-page="/Training/Programs/Index">Программы</a><a asp-page="/Training/Plans">План / Календарь</a><a asp-page="/Nutrition/Index">Питание</a><a asp-page="/Progress/Index">Прогресс</a><p hidden data-search-empty>Ничего не найдено</p></div></dialog>
<dialog class="app-dialog rd-dialog" id="notifications-dialog"><div class="dialog-heading"><h2>Уведомления</h2><button type="button" data-close aria-label="Закрыть"><reference-icon name="close" /></button></div><div class="ref-empty"><reference-icon name="bell" /><h3>Вы всё посмотрели</h3><p>Новых уведомлений пока нет.</p></div></dialog>
<script src="~/js/site.js" asp-append-version="true"></script>
<script src="~/js/dashboard.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body></html>
