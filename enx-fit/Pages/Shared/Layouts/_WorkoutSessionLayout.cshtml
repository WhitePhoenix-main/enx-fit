@inject enx_fit.Security.IFeatureAccessService QuickSessionAccess
@{
    var access = await QuickSessionAccess.GetAsync();
    ViewData["QuickPlan"] = access.Plan.ToString();
    var navigation = enx_fit.ViewModels.Navigation.MobileAppNavigationViewModel.Create(ViewData, User, ViewContext.RouteData.Values["page"] as string);
}
<!DOCTYPE html>
<html lang="ru"><head>
<meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
<meta name="theme-color" content="#111518" /><meta name="color-scheme" content="dark" />
<title>@ViewData["Title"] — Enix Fit</title><partial name="/Pages/Shared/Icons/_AppIcons.cshtml" />
<link rel="preload" href="~/fonts/dashboard-sans.ttf" as="font" type="font/ttf" crossorigin />
<link rel="preload" href="~/fonts/dashboard-condensed.ttf" as="font" type="font/ttf" crossorigin />
<link rel="stylesheet" href="~/css/subscription-dashboard.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/exercise-library.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/training-log.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/subscription-theme.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/app-chrome.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/account-avatar.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/workout-session.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/workout-session-execution.css" asp-append-version="true" />
@await RenderSectionAsync("Styles", required: false)
</head><body class="fitness-app rd-app training-log quick-workout workout-session" data-subscription="@access.Plan.ToString().ToLowerInvariant()">
<a class="rd-skip" href="#main-content">Перейти к содержимому</a>
<div class="rd-shell">
    <aside class="rd-sidebar"><a class="rd-brand" asp-page="/Dashboard/Index"><partial name="/Pages/Shared/Navigation/_Brand.cshtml" /></a><partial name="/Pages/Shared/Navigation/_FitnessNavigation.cshtml" /><div class="qs-sidebar-account"><partial name="/Pages/Shared/Navigation/_AccountAvatar.cshtml" /></div></aside>
    <div class="rd-content">
        <main id="main-content" tabindex="-1">@RenderBody()</main>
    </div>
</div>
<partial name="/Pages/Shared/Navigation/_MobileBottomNavigation.cshtml" model="navigation" />
<script src="~/js/site.js" asp-append-version="true"></script>
<script src="~/js/account-avatar.js" asp-append-version="true" defer></script>
<script src="~/js/training.js" asp-append-version="true"></script>
<script src="~/js/training-log.js" asp-append-version="true"></script>
<script src="~/js/quick-workout.js" asp-append-version="true"></script>
<script src="~/js/workout-session.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body></html>
