@using Microsoft.AspNetCore.Identity

@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

@{
    var isSignedIn = SignInManager.IsSignedIn(User);
}

<ul class="navbar-nav app-account-nav @(!isSignedIn ? "app-account-nav--public" : null)">
@if (isSignedIn)
{
    <li class="nav-item">
        <a id="manage" class="nav-link" asp-area="Identity" asp-page="/Account/Manage/Index" title="Управление аккаунтом">
            @UserManager.GetUserName(User)
        </a>
    </li>
    <li class="nav-item">
        <form id="logoutForm" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Page("/Index", new { area = "" })">
            <button id="logout" type="submit" class="btn btn-outline-light btn-sm">Выйти</button>
        </form>
    </li>
}
else
{
    <li class="nav-item">
        <a class="nav-link app-login-link" id="login" @*href="@Url.SignInUrl()*@ href="#">Войти</a>
    </li>
    <li class="nav-item">
        <a class="btn btn-primary btn-sm" id="register" asp-area="Identity" asp-page="/Account/Register">Начать бесплатно</a>
    </li>
}
</ul>
