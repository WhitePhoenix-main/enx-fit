@model enx_fit.Services.DashboardWidgetViewModel
@using System.Globalization
@using enx_fit.Services
@{
    var dashboard = Model.Dashboard;
    var d = dashboard.Data;
    var coach = dashboard.IsCoachView;
    var home = dashboard.CurrentPage == "/Dashboard";
    var ru = CultureInfo.GetCultureInfo("ru-RU");
    string N(decimal? value, string format = "N0") => value?.ToString(format, ru) ?? "—";
    string F(double value) => value.ToString("0.##", CultureInfo.InvariantCulture);
    var today = d.TodayCheckIn;
    var workoutsPage = dashboard.Section?.Page == "/Dashboard/Workouts";
    var latest = Model.WidgetId == "workouts" ? (workoutsPage ? d.PeriodWorkouts : d.PeriodWorkouts.Take(4)).ToList() : [];
    string? PageUrl(string page) => Url.Page(page, dashboard.NavigationValues);
    var chart = Model.WidgetId == "volume" ? d.Chart.ToList() : [];
    var chartMax = chart.Count > 0 ? Math.Max(1, chart.Max(p => p.Volume)) : 1;
    var weightPoints = Model.WidgetId == "weight" ? d.Measurements.Where(m => m.Date >= d.Until.AddDays(-28)).ToList() : [];
    var minWeight = weightPoints.Count > 0 ? weightPoints.Min(m => m.WeightKg) - 1 : 60;
    var maxWeight = weightPoints.Count > 0 ? weightPoints.Max(m => m.WeightKg) + 1 : 100;
    var weightPath = string.Join(" ", weightPoints.Select(m => $"{F(34 + (m.Date.DayNumber - d.Until.AddDays(-28).DayNumber) * 236d / 28)},{F(127 - (double)((m.WeightKg - minWeight) / (maxWeight - minWeight)) * 105)}"));
    var next = Model.WidgetId == "next" ? d.NextWorkout : null;
    var weekDays = new[] { "Пн", "Вт", "Ср", "Чт", "Пт", "Сб", "Вс" };
    var monthStart = new DateOnly(d.Until.Year, d.Until.Month, 1);
    var calendarStart = monthStart.AddDays(-((int)monthStart.DayOfWeek + 6) % 7);
    var workoutDates = Model.WidgetId == "calendar" ? d.Completed.Select(w => w.Date).ToHashSet() : [];
    var hasData = Model.WidgetId == "achievements" && d.Completed.Any();
}
@switch (Model.WidgetId)
{
    case "welcome":
        <section class="panel welcome-card compact-welcome">
            <h1>@(coach ? d.Name : $"Привет, {d.Name}!")</h1>
            <p><time datetime="@d.Today.ToString("yyyy-MM-dd")">@d.Today.ToString("d MMMM, dddd", ru)</time></p>
            <button class="text-button welcome-goal" data-dialog="goal-dialog"><admin-icon name="target" />@d.Settings.GoalTitle <admin-icon name="edit" /></button>
        </section>
        break;
    case "weight":
        <section class="panel weight-card" id="weight">
        <div class="card-heading">
        <h2>
        <admin-icon name="bars" />Динамика веса</h2>@if (!coach) { <a asp-page="/Body/Index">Подробнее <admin-icon name="arrow" />
        </a> } else { <span class="muted">4 недели</span> }</div>
        <div class="weight-value">
        <strong>@N(d.Weight, "N1") <small>кг</small>
        </strong>
        <span>@(d.WeightChange is null ? "Нет замеров" : $"{(d.WeightChange >= 0 ? "+" : "")}{N(d.WeightChange, "N1")} кг")<small>за 4 недели</small>
        </span>
        </div>
                <svg class="weight-chart" viewBox="0 0 290 165" role="img" aria-label="График веса за 4 недели">
        <defs>
        <linearGradient id="weight-fill" x1="0" y1="0" x2="0" y2="1"><stop offset="0%" stop-color="#497cff" stop-opacity=".3" /><stop offset="100%" stop-color="#497cff" stop-opacity="0" />
        </linearGradient>
        </defs>@for (var i = 0; i < 4; i++) { var y = 22 + 35 * i; <g>
        <line x1="34" y1="@y" x2="275" y2="@y" stroke="#253142" />
        <text x="2" y="@(y+4)">@N(maxWeight - (maxWeight - minWeight) * i / 3)</text>
        </g> }@if (weightPoints.Count > 0) { <polygon points="34,140 @weightPath 270,140" fill="url(#weight-fill)" />
        <polyline points="@weightPath" fill="none" stroke="#5984ff" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" />@foreach (var m in weightPoints) { <circle cx="@F(34 + (m.Date.DayNumber - d.Until.AddDays(-28).DayNumber) * 236d / 28)" cy="@F(127 - (double)((m.WeightKg - minWeight) / (maxWeight - minWeight)) * 105)" r="3" fill="#6895ff"><title>@m.Date.ToString("d MMM", ru): @N(m.WeightKg, "N1") кг</title>
        </circle> } }<text x="34" y="160">@d.Until.AddDays(-28).ToString("d MMM", ru)</text>
        <text x="133" y="160">@d.Until.AddDays(-14).ToString("d MMM", ru)</text>
        <text x="235" y="160">@d.Until.ToString("d MMM", ru)</text>
        </svg>
                @if (!coach && d.Measurements.Count == 0) { <a class="empty-link" asp-page="/Body/Create">Добавить первый замер <admin-icon name="plus" />
        </a> }
            </section>
        break;
    case "records":
        <section class="panel records-card">
        <div class="card-heading">
        <h2>
        <admin-icon name="workout" />Силовые рекорды</h2>
        <button class="text-button" data-dialog="records-dialog">Все показатели <admin-icon name="arrow" />
        </button>
        </div>
        <div class="record-list">@foreach (var record in d.Records.Take(3)) { <div class="record-row">
        <admin-icon name="workout" />
        <span>@record.Name</span>
        <strong>@N(record.Weight) <small>кг</small>
        </strong>
        @if (record.Gain is { } gain) { <small class="record-gain" title="Изменение рекорда за последние 30 дней">↑ +@N(gain, "0.#") кг</small> }
        </div> }@if (!d.Records.Any()) { <div class="card-empty">
        <span class="icon-tile">
        <admin-icon name="trophy" />
        </span>
        <p>Первый рекорд впереди</p>
        <small>Запишите рабочие подходы — лучшие результаты появятся здесь.</small>
        </div> }</div>
        <button class="button secondary full" data-dialog="records-dialog">Все показатели</button>
        </section>
        break;
    case "goal":
        <section class="panel goal-card week-card" id="plan">
            <div class="card-heading"><h2><admin-icon name="calendar" />План недели</h2><button class="text-button week-completion" data-dialog="goal-dialog">@d.Completed.Count(w => w.Date >= d.Today.AddDays(-((int)d.Today.DayOfWeek + 6) % 7 + dashboard.WeekOffset * 7) && w.Date < d.Today.AddDays(-((int)d.Today.DayOfWeek + 6) % 7 + (dashboard.WeekOffset + 1) * 7)) / @d.Settings.WeeklyWorkoutGoal <span>выполнено</span></button><nav class="week-navigation" aria-label="Выбор недели"><a asp-page="/Dashboard" asp-route-ClientId="@dashboard.ClientId" asp-route-WeekOffset="@(dashboard.WeekOffset - 1)" aria-label="Предыдущая неделя"><admin-icon name="chevron" /></a><a asp-page="/Dashboard" asp-route-ClientId="@dashboard.ClientId" asp-route-WeekOffset="@(dashboard.WeekOffset + 1)" aria-label="Следующая неделя"><admin-icon name="chevron" /></a></nav></div>
            <div class="week-strip">
                @for (var i = 0; i < 7; i++)
                {
                    var date = d.Today.AddDays(-((int)d.Today.DayOfWeek + 6) % 7 + i + dashboard.WeekOffset * 7);
                    var done = d.Completed.FirstOrDefault(w => w.Date == date);
                    var planned = d.Workouts.FirstOrDefault(w => w.Date == date && w.CompletedAtUtc == null && w.StartedAtUtc == null && !DashboardData.WorkingSets(w).Any());
                    var scheduled = dashboard.ActiveProgram is { } program ? ProgramSchedule.Occurrences(program).FirstOrDefault(o => o.Date == date) : null;
                    var state = done is not null ? "done" : planned is not null || scheduled is not null ? "planned" : "rest";
                    var dayTitle = done?.Title ?? planned?.Title ?? scheduled?.Workout.Name ?? "Отдых";
                    var pastRest = state == "rest" && date < d.Today;
                    <a href="@PageUrl("/Dashboard/Plans")" class="week-day @state @(pastRest ? "past-rest" : "") @(date == d.Today ? "is-today" : "")" aria-label="@date.ToString("d MMMM", ru): @(done is not null ? "выполнено" : state == "planned" ? "запланировано" : "отдых")">
                        <span>@weekDays[i]</span><time datetime="@date.ToString("yyyy-MM-dd")">@date.ToString("dd.MM")</time><span class="week-marker">@if (done is not null || pastRest) { <admin-icon name="check" /> } else if (state == "planned") { <admin-icon name="@(dayTitle.Contains("Кардио", StringComparison.OrdinalIgnoreCase) ? "shoe" : "workout")" /> } else { <admin-icon name="coffee" /> }</span><small>@dayTitle.Split('—')[0].Trim()</small>
                    </a>
                }
            </div>
            <div class="week-legend"><span><i class="done"></i>выполнено</span><span><i class="today"></i>сегодня</span><span><i></i>запланировано</span><span>— отдых</span></div>
        </section>
        break;
    case "volume":
        <section class="panel volume-card" id="progress">
        <div class="card-heading">
        <h2>
        <admin-icon name="bars" />Прогресс по объёму</h2>
        <span class="muted">@d.Days дней</span>
        </div>
        <div class="chart-summary">
        <strong>@N(d.TotalVolume) <small>кг</small>
        </strong>
        <span class="green">@(d.VolumeChange is null ? "Ваши тренировки в цифрах" : $"{(d.VolumeChange >= 0 ? "+" : "")}{N(d.VolumeChange)}% к предыдущему периоду")</span>
        </div>
        <div class="volume-chart">
        <div class="chart-axis">
        <span>@N(chartMax / 1000, "0.#")K</span>
        <span>@N(chartMax / 2000, "0.#")K</span>
        <span>0</span>
        </div>
        <div class="chart-columns">@foreach (var point in chart) { <button class="chart-column" type="button" aria-label="@point.Date.ToString("d MMM", ru): @N(point.Volume) кг, тренировок: @point.Count">
        <span class="chart-tooltip">@point.Date.ToString("d MMM", ru)<strong>@N(point.Volume) кг</strong>
        <small>@point.Count тренировок</small>
        </span>
        <span class="column-track">
        <i style="height: @F((double)(point.Volume / chartMax * 100))%">
        </i>
        </span>
        <small>@point.Date.ToString(d.Days == 365 ? "MMM" : "dd.MM", ru)</small>
        </button> }</div>
        </div>@if (!d.PeriodWorkouts.Any()) { <p class="chart-empty">За этот период нет записанных рабочих подходов.</p> }</section>
        break;
    case "workouts":
        @if (home) { <partial name="_DashboardReferenceWidget" model="Model" /> }
        else
        {
        <section class="panel workouts-card" id="workouts">
        <div class="card-heading">
        <h2>
        <admin-icon name="menu" />@(workoutsPage ? "История тренировок" : "Последние тренировки")</h2>
        @if (!workoutsPage) { <a href="@PageUrl("/Dashboard/Workouts")">Все тренировки <admin-icon name="arrow" /></a> }
        </div>
        <div class="workout-table">
        <div class="workout-table-head">
        <span>Дата</span>
        <span>Название</span>
        <span>Объём</span>
        <span>Упражнения</span>
        <span>Статус</span>
        </div>@foreach (var w in latest) { <button class="workout-row" data-dialog="workout-@w.Id">
        <time>@w.Date.ToString("d MMM, ddd", ru)</time>
        <span class="workout-title">
        <span class="icon-tile">
        <admin-icon name="workout" />
        </span>
        <span>
        <strong>@(w.Title ?? "Силовая тренировка")</strong>
        <small>@w.Date.ToString("d MMM", ru) · @w.WorkoutExercises.Count упр. · @N(DashboardData.Volume(w)) кг</small>
        </span>
        </span>
        <span class="desktop-cell">@N(DashboardData.Volume(w)) кг</span>
        <span class="desktop-cell">@w.WorkoutExercises.Count упр.</span>
        <span class="workout-done">
        <span class="check-circle">
        <admin-icon name="check" />
        </span>
        <small>Выполнено</small>
        <admin-icon name="chevron" />
        </span>
        </button> }@if (latest.Count == 0) { <div class="card-empty horizontal">
        <span class="icon-tile">
        <admin-icon name="workout" />
        </span>
        <div>
        <h3>Всё начинается с первой тренировки</h3>
        <p>Здесь будет история занятий за выбранный период.</p>
        </div>@if (!coach) { <a asp-page="/Workouts/Create" class="button">Добавить <admin-icon name="plus" />
        </a> }</div> }</div>
        </section>
        }
        break;
    case "recommendations":
        @if (home) { <partial name="_DashboardReferenceWidget" model="Model" /> }
        else
        {
        <section class="panel recommendations-card" id="recommendations">
            <div class="card-heading"><h2><admin-icon name="spark" />Инсайты</h2><a href="@PageUrl("/Dashboard/Analytics")">Все <admin-icon name="arrow" /></a></div>
            <div class="insight-grid">
                <article class="insight"><span class="insight-icon"><admin-icon name="target" /></span><div><h3>@(d.GoalPercent >= 100 ? "Недельная цель выполнена" : $"До недельной цели осталось {Math.Max(0, d.Settings.WeeklyWorkoutGoal - d.ThisWeek.Count())} тренировок")</h3><p>Выполнено @d.GoalPercent% от цели: @d.Settings.WeeklyWorkoutGoal занятий.</p><button class="text-button" data-dialog="goal-dialog">Настроить цель</button></div></article>
                @if (d.VolumeChange is { } change) { <article class="insight"><span class="insight-icon green"><admin-icon name="trend" /></span><div><h3>Объём тренировок: @(change >= 0 ? "+" : "")@N(change)%</h3><p>По сравнению с предыдущими @d.Days днями. Учитываются выполненные рабочие подходы.</p></div></article> }
                @if (!string.IsNullOrWhiteSpace(d.Settings.TrainerNote)) { <article class="insight"><span class="insight-icon"><admin-icon name="users" /></span><div><h3>От вашего тренера</h3><p>@d.Settings.TrainerNote</p></div></article> }
                else if (d.VolumeChange is null) { <p class="insight-empty">Запишите тренировки за два периода, чтобы сравнить нагрузку.</p> }
                @if (coach) { <button class="text-button" data-dialog="goal-dialog">Изменить рекомендацию</button> }
            </div>
        </section>
        }
        break;
    case "strength":
        <partial name="_DashboardStrength" model="dashboard" />
        break;
    case "today":
        <section class="panel today-card compact-today" aria-label="Показатели дня">
            @foreach (var item in new[] { ("shoe", today.Steps > 0 ? N(today.Steps) : "—", "шагов сегодня", Math.Min(100, today.Steps * 100 / 8000), "green"), ("water", today.WaterMl > 0 ? N(today.WaterMl / 1000m, "0.#") + " л" : "—", "воды", Math.Min(100, today.WaterMl * 100 / 2000), "blue"), ("moon", today.SleepMinutes > 0 ? $"{today.SleepMinutes / 60} ч {today.SleepMinutes % 60} мин" : "—", "сон", Math.Min(100, today.SleepMinutes * 100 / 480), "blue"), ("flame", d.Streak.ToString() + " дн.", "подряд", Math.Min(100, d.Streak * 100 / 7), "orange") })
            {
                <a class="day-metric @item.Item5" href="@PageUrl("/Dashboard/Habits")"><admin-icon name="@item.Item1" /><span><strong>@item.Item2</strong><small>@item.Item3</small></span><span class="metric-ring" style="--ring:@item.Item4" aria-hidden="true"></span></a>
            }
        </section>
        break;
    case "next":
        <partial name="_WorkoutStart" model="dashboard" />
        break;
    case "sleep":
        <section class="panel sleep-card" id="sleep">
        <div class="card-heading">
        <h2>
        <admin-icon name="moon" />Сон и восстановление</h2>@if (!coach) { <button class="text-button" data-dialog="checkin-dialog">Записать <admin-icon name="plus" />
        </button> }</div>
        <div class="sleep-value">
        <strong>@(today.SleepMinutes > 0 ? $"{today.SleepMinutes / 60} ч {today.SleepMinutes % 60} мин" : "—")</strong>
        <small>сегодня</small>
        </div>
        <div class="sleep-chart" role="img" aria-label="Продолжительность сна за последние 7 дней">@for (var i = 6; i >= 0; i--) { var day = d.Today.AddDays(-i); var minutes = d.CheckIns.FirstOrDefault(c => c.Date == day)?.SleepMinutes ?? 0; <div title="@day.ToString("d MMM", ru): @(minutes > 0 ? $"{minutes / 60} ч {minutes % 60} мин" : "нет записи")">
        <span>
        <i style="height: @(Math.Min(100, minutes * 100 / 720))%">
        </i>
        </span>
        <small>@weekDays[((int)day.DayOfWeek + 6) % 7]</small>
        </div> }</div>
        </section>
        break;
    case "habits":
        @if (home) { <partial name="_DashboardReferenceWidget" model="Model" /> }
        else
        {
        <section class="panel habits-card" id="habits">
        <div class="card-heading">
        <h2>
        <admin-icon name="activity" />Привычки</h2>
        <span class="count-pill">@d.HabitsDone / 4</span>@if (!coach) { <button class="text-button" data-dialog="checkin-dialog" aria-label="Записать показатели дня">
        <admin-icon name="plus" />
        </button> }</div>
        <div class="habit-list">@foreach (var habit in new[] { ("water", "Выпить 2 л воды", today.WaterMl >= 2000), ("shoe", "Пройти 8 000 шагов", today.Steps >= 8000), ("nutrition", "Дневник питания", today.NutritionLogged), ("activity", "Растяжка 10 минут", today.StretchingDone) }) { <div class="habit-row">
        <span class="habit-check @(habit.Item3 ? "done" : "")" aria-label="@(habit.Item3 ? "Выполнено" : "Не выполнено")">@if (habit.Item3) { <admin-icon name="check" /> }</span>
        <admin-icon name="@habit.Item1" />
        <span>@habit.Item2</span>
        </div> }</div>@if (!coach) { <button class="text-button habit-edit" data-dialog="checkin-dialog">Отметить привычки <admin-icon name="arrow" />
        </button> }</section>
        }
        break;
    case "achievements":
        <section class="panel achievements-card" id="achievements">
        <div class="card-heading">
        <h2>
        <admin-icon name="trophy" />Последние достижения</h2>
        </div>
        <div class="achievement">
        <span class="medal gold">
        <admin-icon name="@(hasData ? "flame" : "target")" />
        </span>
        <div>
        <h3>@(d.Streak > 1 ? $"{d.Streak} дней подряд" : hasData ? "Первый шаг сделан" : "Всё впереди")</h3>
        <p>@(hasData ? $"{d.Completed.Count()} тренировок записано" : "Запишите первую тренировку")</p>
        </div>
        </div>
        <div class="achievement">
        <span class="medal purple">
        <admin-icon name="workout" />
        </span>
        <div>
        <h3>@(d.Records.Any() ? "Личный рекорд" : "На пути к рекорду")</h3>
        <p>@(d.Records.Any() ? $"{d.Records.First().Name} · {N(d.Records.First().Weight)} кг" : "Ваш лучший подход появится здесь")</p>
        </div>
        </div>
        </section>
        break;
    case "calendar":
        <section class="panel calendar-card">
        <div class="card-heading">
        <h2>
        <admin-icon name="calendar" />Календарь</h2>
        <a asp-page="@dashboard.CurrentPage" asp-route-clientId="@dashboard.ClientId" asp-route-days="@dashboard.Days">Сегодня</a>
        </div>
        <div class="calendar-month">
        <strong>@d.Until.ToString("MMMM yyyy", ru)</strong>
        <span>
        <a asp-page="@dashboard.CurrentPage" asp-route-clientId="@dashboard.ClientId" asp-route-days="@dashboard.Days" asp-route-until="@monthStart.AddDays(-1).ToString("yyyy-MM-dd")" aria-label="Предыдущий месяц">
        <admin-icon name="back" />
        </a>@if (monthStart.AddMonths(1) <= d.Today) { <a asp-page="@dashboard.CurrentPage" asp-route-clientId="@dashboard.ClientId" asp-route-days="@dashboard.Days" asp-route-until="@(monthStart.AddMonths(2).AddDays(-1) > d.Today ? d.Today.ToString("yyyy-MM-dd") : monthStart.AddMonths(2).AddDays(-1).ToString("yyyy-MM-dd"))" aria-label="Следующий месяц">
        <admin-icon name="arrow" />
        </a> }</span>
        </div>
        <div class="calendar-grid">@foreach (var dayName in weekDays) { <small>@dayName</small> }@for (var i = 0; i < 42; i++) { var date = calendarStart.AddDays(i); <span class="calendar-day @(date.Month != monthStart.Month ? "outside" : "") @(workoutDates.Contains(date) ? "trained" : "") @(date == d.Today ? "is-today" : "")" title="@date.ToString("d MMMM", ru)@(workoutDates.Contains(date) ? " — тренировка записана" : "")">@date.Day</span> }</div>
        <div class="calendar-legend">
        <span>
        <i>
        </i>Тренировка</span>
        <span>
        <i>
        </i>Сегодня</span>
        </div>
        </section>
        break;
    case "stat-volume":
        @if (home)
        {
            <a class="panel reference-stat consistency-stat" href="@PageUrl("/Dashboard/Plans")"><admin-icon name="calendar" /><div><span>Регулярность</span><p><strong>@d.ThisWeek.Count() / @d.Settings.WeeklyWorkoutGoal</strong><small>на этой неделе</small></p></div><admin-icon name="chevron" /></a>
        }
        else
        {
        <a class="panel stat-card stat-volume" href="@PageUrl("/Dashboard/Analytics")"><span class="stat-label"><admin-icon name="bars" />Объём</span><strong>@(d.VolumeChange is { } delta ? $"{(delta >= 0 ? "+" : "")}{N(delta)}%" : "—")</strong><small>к предыдущим @d.Days дням</small><span class="mini-bars" aria-hidden="true">@foreach (var point in d.Chart) { <i style="height:@F((double)(point.Volume / Math.Max(1, d.Chart.Max(p => p.Volume)) * 45))px"></i> }</span></a>
        }
        break;
    case "stat-workouts":
        @if (home)
        {
            var monthly = d.Completed.Count(w => w.Date >= d.Today.AddDays(-29));
            var previousMonth = d.Completed.Count(w => w.Date >= d.Today.AddDays(-59) && w.Date < d.Today.AddDays(-29));
            var change = previousMonth > 0 ? (int?)Math.Round((monthly - previousMonth) * 100d / previousMonth) : null;
            <a class="panel reference-stat" href="@PageUrl("/Dashboard/Workouts")"><admin-icon name="bars" /><div><strong>@monthly</strong><span>тренировок за месяц</span></div>@if (change.HasValue) { <span class="stat-change @(change < 0 ? "negative" : "")"><admin-icon name="trend" />@(change >= 0 ? "+" : "")@change%</span> }</a>
        }
        else
        {
        <a class="panel stat-card stat-workouts" href="@PageUrl("/Dashboard/Workouts")"><span class="stat-label"><admin-icon name="workout" />Тренировки</span><strong>@d.ThisWeek.Count() <small>/ @d.Settings.WeeklyWorkoutGoal</small></strong><small>на этой неделе</small><span class="weekly-segments" aria-hidden="true">@for (var i = 0; i < d.Settings.WeeklyWorkoutGoal; i++) { <i class="@(i < d.ThisWeek.Count() ? "done" : "")"></i> }</span></a>
        }
        break;
    case "stat-weight":
        @if (home) { <partial name="_DashboardReferenceWidget" model="Model" /> }
        else
        {
        <a class="panel stat-card stat-weight" href="@PageUrl("/Dashboard/Progress")">
        <span class="stat-label">
        <span class="icon-tile">
        <admin-icon name="scale" />
        </span>Текущий вес</span>
        <strong>@N(d.Weight, "N1") <small>кг</small>
        </strong>
        <span class="stat-delta">@(d.WeightChange is null ? "Добавьте первый замер" : $"{(d.WeightChange >= 0 ? "+" : "")}{N(d.WeightChange, "N1")} кг")</span>
        <small>изменение за 4 недели</small>
        </a>
        }
        break;
    case "stat-streak":
        <a class="panel stat-card stat-streak" href="@PageUrl("/Dashboard/Achievements")">
        <span class="stat-label">
        <span class="icon-tile orange">
        <admin-icon name="flame" />
        </span>Серия</span>
        <strong>@d.Streak <small>дн.</small>
        </strong>
        <span class="stat-delta green">День за днём</span>
        <small>тренировочные дни подряд</small>
        </a>
        break;
    case "stat-goal":
        @if (home)
        {
            <a class="panel reference-stat" href="@PageUrl("/Dashboard/Achievements")"><admin-icon name="trophy" /><div><strong>@d.Records.Count()</strong><span>личных рекорда</span></div>@if (d.NewRecords > 0) { <span class="stat-change"><admin-icon name="trend" />+@d.NewRecords</span> }</a>
        }
        else
        {
        <a class="panel stat-card stat-goal" href="@PageUrl("/Dashboard/Achievements")"><span class="stat-label"><admin-icon name="trophy" />Рекорды</span><strong>@d.NewRecords <small>новых</small></strong><small>за последние 30 дней</small><span class="record-kpi-link"><admin-icon name="arrow" /></span></a>
        }
        break;
}
