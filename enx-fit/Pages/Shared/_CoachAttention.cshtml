@model enx_fit.Services.CoachAttention
@using enx_fit.Services
@{
    var groups = Model.Alerts.GroupBy(a => a.ClientId).ToList();
    string Label(ClientAttentionKind kind) => kind switch { ClientAttentionKind.Ending => "Окончание программы", ClientAttentionKind.Plateau => "Возможное плато", ClientAttentionKind.Effort => "Запас повторений", _ => "Пропуски занятий" };
}
<section class="panel coach-attention" aria-label="Сигналы по назначенным программам">
    <div class="coach-section-heading"><div><p class="eyebrow">По результатам и расписанию</p><h2>Сигналы внимания <span class="coach-count">@groups.Count</span></h2><p>Откройте клиента, чтобы посмотреть причину и нужную программу.</p></div></div>
    @if (groups.Count == 0) { <p class="coach-attention-empty">Сигналов по назначенным программам пока нет. Здесь появятся пропуски, окончание программы и возможное плато.</p> }
    else
    {
        <div class="coach-attention-groups">
        @foreach (var group in groups)
        {
            <details class="coach-alert-group app-disclosure" data-client-alert="@group.Key">
                <summary><span><strong>@group.First().Name</strong><small>Сигналов: @group.Count() · @string.Join(", ", group.Select(a => Label(a.Kind)).Distinct())</small></span><reference-icon name="chevron" /></summary>
                <div class="coach-detail-body"><a class="coach-text-link" asp-page="/Trainer/Client" asp-route-id="@group.Key">Открыть клиента →</a><ul>
                @foreach (var alert in group) { <li><span class="coach-alert-kind">@Label(alert.Kind)</span><p>@alert.Reason</p><a class="coach-text-link" asp-page="/Programs/Details" asp-route-id="@alert.ProgramId" asp-route-Tab="@(alert.Kind is ClientAttentionKind.Ending or ClientAttentionKind.Missed ? "schedule" : "progression")">@(alert.Kind is ClientAttentionKind.Ending or ClientAttentionKind.Missed ? "Проверить расписание" : "Посмотреть нагрузку") →</a></li> }
                </ul></div>
            </details>
        }
        </div>
    }
</section>
