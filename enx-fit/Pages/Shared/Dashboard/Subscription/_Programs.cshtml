@using enx_fit.ViewModels.Dashboard
@model SubscriptionDashboardViewModel
<section class="rd-programs"><header class="rd-section-header"><h2>@(Model.Coach ? "Мои программы и шаблоны" : "Подборка программ для вас")</h2><a asp-page="/Training/Programs/Index" asp-route-Tab="@(Model.Coach ? "mine" : "templates")">Все программы <reference-icon name="arrow" /></a></header><div class="rd-program-grid">
    @for (var i = 0; i < Model.Programs.Count; i++) { var program = Model.Programs[i]; <a class="rd-card rd-program" asp-page="@(Model.Preview ? "/Training/Programs/Index" : "/Training/Programs/Details")" asp-route-id="@(Model.Preview ? (int?)null : program.Id)"><span class="rd-program-photo rd-program-photo-@i" aria-hidden="true"></span><span class="rd-program-content">@if (!Model.Premium || Model.Coach) { <small class="rd-tag">@(Model.Coach ? "Шаблон" : Model.Preview ? program.Categories : program.Level == ProgramLevel.Beginner ? "Для новичков" : "Для прогресса")</small> }<strong>@program.Name</strong><small>@program.Weeks недель · @(Model.Premium ? TrainingPreferences.LevelTitle(program.Level) : $"{program.DaysPerWeek} трен./нед.")</small>@if (Model.Premium && !Model.Coach) { <span class="rd-program-tags">@foreach (var tag in program.Categories.Split('|', StringSplitOptions.RemoveEmptyEntries).Take(3)) { <span>@tag</span> }</span> }</span><reference-icon name="chevron" /></a> }
    @if (Model.Programs.Count == 0) { <a class="rd-card rd-program-empty" asp-page="@(Model.Coach ? "/Training/Programs/Edit" : "/Training/Programs/Index")"><reference-icon name="plus" /><span>@(Model.Coach ? "Создайте свою первую программу для клиента" : "Открыть каталог программ")</span><reference-icon name="arrow" /></a> }
</div></section>
