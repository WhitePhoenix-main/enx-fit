@using enx_fit.ViewModels.Dashboard
@using enx_fit.Services.Dashboard
@model SubscriptionDashboardViewModel
@{ var page=Model.Page; var d=page.Data; var recent=d.Completed.Where(w=>w.Date>=d.Today.AddDays(-27)).ToList();
   var completed=Model.Preview?12:d.CountCompleted(d.Today.AddDays(-27),d.Today);
   var minutes=Model.Preview?320:recent.Sum(w=>(w.DurationSeconds??0)/60);
   var exercises=Model.Preview?36:recent.Sum(w=>w.WorkoutExercises.Count);
}
<div class="rd-dashboard ref-home @(Model.Premium?"ref-home-pro":"ref-home-free")">
<div class="ref-home-top"><partial name="/Pages/Shared/Dashboard/Subscription/_Hero.cshtml" model="Model" />
@if(Model.Premium){<section class="ref-panel ref-home-why"><header class="ref-panel-heading"><h2><reference-icon name="idea" />Почему именно сегодня?</h2></header><p class="ref-tip"><reference-icon name="clock" />@(page.NextRecommendation?.Reason??"Ваш план учитывает порядок тренировок и доступное оборудование.")</p><p class="ref-tip"><reference-icon name="pulse" />Сверьтесь со своим самочувствием перед началом занятия.</p><p class="ref-tip"><reference-icon name="bars" />Записывайте подходы, чтобы отслеживать рост силы.</p><a class="ref-link" asp-page="/Dashboard/Habits">Самочувствие и восстановление <reference-icon name="arrow" /></a></section><partial name="/Pages/Shared/Dashboard/Subscription/_Streak.cshtml" model="Model" />}
else{<section class="ref-panel ref-home-quick"><header class="ref-panel-heading"><h2><reference-icon name="bolt" />Быстрая тренировка</h2></header><p>Нет времени? Выберите короткую тренировку и начните прямо сейчас.</p><div class="ref-quick-list"><a class="ref-secondary" asp-page="/Training/Workouts/Templates">Всё тело — готовый комплекс <reference-icon name="play" /></a><a class="ref-secondary" asp-page="/Training/Workouts/Templates">Верх тела — силовая <reference-icon name="play" /></a><a class="ref-secondary" asp-page="/Training/Workouts/Templates">Ноги — сила и тонус <reference-icon name="play" /></a></div></section>}
</div>
@if(!page.IsCoachView){<partial name="/Pages/Shared/Dashboard/Subscription/_QuickActions.cshtml" model="Model" />}
<div class="ref-home-middle"><section class="ref-panel ref-home-progress"><header class="ref-panel-heading"><h2>Ваш прогресс</h2><a class="ref-link" asp-page="/Progress/Index">За 4 недели <reference-icon name="chevron" /></a></header><div class="ref-home-stats"><a asp-page="/Progress/Index"><span><reference-icon name="workout" />Тренировки</span><strong>@completed</strong><small>за последние 4 недели</small></a><a asp-page="/Progress/Index"><span><reference-icon name="clock" />Время</span><strong>@(minutes/60) ч @(minutes%60) мин</strong><small>время тренировок</small></a><a asp-page="/Progress/Index"><span><reference-icon name="bars" />Упражнения</span><strong>@exercises</strong><small>выполнено упражнений</small></a>@if(Model.Premium){<a asp-page="/Progress/Index"><span><reference-icon name="scale" />Общий вес</span><strong>@(d.Weight?.ToString("0.#")??"—") <small>кг</small></strong><small>последний замер</small></a>}</div></section>
@if(Model.Premium){<section class="ref-panel ref-home-nutrition"><header class="ref-panel-heading"><h2><reference-icon name="spark" />Поддержи прогресс</h2><a class="ref-link" asp-page="/Nutrition/Index">Подробнее <reference-icon name="chevron" /></a></header><div><design-photo kind="chicken" /><span><strong>Питание для твоих целей</strong><p>Следи за балансом белков, жиров и углеводов. Записывай рацион в дневник.</p><a class="ref-primary" asp-page="/Nutrition/Index">Показать питание <reference-icon name="arrow" /></a></span></div></section>}
else{<partial name="/Pages/Shared/Dashboard/Subscription/_RecentWorkouts.cshtml" model="Model" />}
</div>
<div class="ref-home-bottom"><partial name="/Pages/Shared/Dashboard/Subscription/_Week.cshtml" model="Model" />@if(Model.Premium){<partial name="/Pages/Shared/Dashboard/Subscription/_RecentWorkouts.cshtml" model="Model" />}else{<a class="ref-upgrade ref-home-upgrade" asp-page="/Account/Subscription"><reference-icon name="crown" /><strong>Больше с Enix Fit Pro</strong><small>Дополнительные программы, расширенная статистика и персональные рекомендации.</small><span>Узнать больше <reference-icon name="arrow" /></span><design-photo kind="hero-pro" /></a>}</div>
</div>
