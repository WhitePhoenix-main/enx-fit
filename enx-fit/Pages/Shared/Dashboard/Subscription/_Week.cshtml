@using enx_fit.ViewModels.Dashboard
@model SubscriptionDashboardViewModel
<section class="rd-card rd-week"><header class="rd-section-header"><h2>План на неделю</h2><a asp-page="/Training/Plans" asp-route-ClientId="@(Model.Page.IsCoachView ? Model.Page.Data.Subject.Id : null)">Все <reference-icon name="chevron" /></a></header><div class="rd-week-days">@foreach (var day in Model.Week) { <a class="rd-day @(day.Today ? "is-today" : "")" asp-page="/Training/Plans" asp-route-ClientId="@(Model.Page.IsCoachView ? Model.Page.Data.Subject.Id : null)" asp-route-Day="@day.Date.ToString("yyyy-MM-dd")" aria-label="@($"{day.Name}, {day.Date:d MMMM}: {day.Title}")" aria-current="@(day.Today ? "date" : null)"><span>@day.Name</span><strong>@day.Date.Day</strong><i class="@(day.Done ? "is-done" : day.Planned ? "is-planned" : "")">@if (day.Done) { <reference-icon name="check" /> }</i><small>@day.Title</small></a> }</div></section>
