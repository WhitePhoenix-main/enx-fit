@using enx_fit.ViewModels.Dashboard
@model SubscriptionDashboardViewModel
@{ var last = Model.Page.Data.Completed.OrderByDescending(w => w.Date).FirstOrDefault(); }
<div class="rd-quick-actions" aria-label="Быстрые действия">
    @if (Model.Preview) { <button class="rd-card rd-quick-action" type="button" data-dialog="preview-action-dialog"><span class="rd-action-icon"><reference-icon name="bolt" /></span><span><strong>Быстрая<br />тренировка</strong><small>Добавляйте упражнения по ходу</small></span><reference-icon name="chevron" /></button> }
    else { <form method="post" asp-page="/Dashboard/Index" asp-page-handler="Start"><input name="source" type="hidden" value="empty" /><button class="rd-card rd-quick-action" type="submit"><span class="rd-action-icon"><reference-icon name="bolt" /></span><span><strong>Быстрая<br />тренировка</strong><small>Добавляйте упражнения по ходу</small></span><reference-icon name="chevron" /></button></form> }
    @if(Model.Preview){<button class="rd-card rd-quick-action" type="button" data-dialog="preview-action-dialog"><span class="rd-action-icon"><reference-icon name="document" /></span><span><strong>По шаблону</strong><small>Выбрать из своих тренировок</small></span><reference-icon name="chevron" /></button>}
    else {<a class="rd-card rd-quick-action" asp-page="/Training/Workouts/Templates"><span class="rd-action-icon"><reference-icon name="document" /></span><span><strong>По шаблону</strong><small>Выбрать готовую тренировку</small></span><reference-icon name="chevron" /></a>}
    <a class="rd-card rd-quick-action" asp-page="/Training/Workouts/Record"><span class="rd-action-icon"><reference-icon name="plus" /></span><span><strong>Записать<br />прошедшую</strong><small>Добавить вручную</small></span><reference-icon name="chevron" /></a>
    @if (last is not null && !Model.Preview && !Model.Page.IsCoachView) { <form method="post" asp-page-handler="Start"><input type="hidden" name="source" value="previous" /><input type="hidden" name="previousId" value="@last.Id" /><button class="rd-card rd-quick-action" type="submit"><span class="rd-action-icon"><reference-icon name="repeat" /></span><span><strong>Повторить прошлую</strong><small>@last.Title</small></span><reference-icon name="chevron" /></button></form> }
    else { <button class="rd-card rd-quick-action" type="button" data-dialog="@(Model.Preview ? "preview-action-dialog" : "quick-workout-dialog")"><span class="rd-action-icon"><reference-icon name="repeat" /></span><span><strong>Повторить прошлую</strong><small>@(Model.Preview ? "Верх тела · 48 мин" : "После первого занятия")</small></span><reference-icon name="chevron" /></button> }
</div>
