@using enx_fit.ViewModels.Dashboard
@model SubscriptionDashboardViewModel
@{ var max = Math.Max(1, Model.Bars.Max(b => b.Value)); var scale = Model.Preview ? Model.Coach ? 24 : Model.Premium ? 12000 : 6 : Math.Max(Model.Premium && !Model.Coach ? 1000 : 4, Math.Ceiling(max / 4) * 4); }
<section class="rd-card rd-chart"><header class="rd-section-header"><h2>@(Model.Coach ? "Прогресс клиентов за 6 недель" : "Прогресс за 6 недель")</h2><a class="rd-chart-filter" asp-page="@(Model.Coach ? "/Coaching/Clients" : "/Progress/Index")">@(Model.Coach ? "Все клиенты" : Model.Premium ? "Объём нагрузки" : "Тренировки")<reference-icon name="chevron-down" /></a></header><div class="rd-chart-plot" role="img" aria-label="@string.Join("; ", Model.Bars.Select(b => $"{b.Label}: {b.Value:0.##}"))"><div class="rd-chart-axis">@for (var i = 3; i >= 0; i--) { var tick = scale * i / 3; <span>@(tick >= 1000 ? $"{tick / 1000:0.#}k" : $"{tick:0.#}")</span> }</div><div class="rd-chart-columns">@foreach (var bar in Model.Bars) { <div class="rd-chart-column"><div class="rd-bar-track"><i style="height:@((bar.Value / scale * 100).ToString("0.##", System.Globalization.CultureInfo.InvariantCulture))%" title="@bar.Value.ToString("0.##")"></i></div><span>@bar.Label</span></div> }</div></div>@if (!Model.Preview && Model.Bars.All(b => b.Value == 0)) { <p class="rd-chart-empty">Завершите тренировку, чтобы увидеть прогресс.</p> }</section>
