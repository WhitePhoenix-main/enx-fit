@using enx_fit.ViewModels.Dashboard
@model SubscriptionDashboardViewModel
@{var page=Model.Page;var overview=Model.Overview;var activity=page.Clients.Where(c=>c.LastWorkout==Model.Today).Take(5).ToArray();var total=overview.Days.Sum(d=>d.Count);var percent=Model.Preview?78:overview.CompletionPercent;var max=Math.Max(1,Model.Bars.Max(b=>b.Value));var polyline=string.Join(" ",Model.Bars.Select((b,i)=>$"{25+i*53},{155-(int)(b.Value/max*115)}"));}
<div class="rd-dashboard ref-coach-home">
<div class="ref-coach-top"><section class="ref-panel ref-coach-greeting"><design-photo kind="coach" /><div><span class="ref-pill"><reference-icon name="users" />COACH</span><h2>Добрый день,<br />тренер!</h2><p>Сегодня @Model.CompletedClients ваших клиентов провели тренировки. Продолжайте вдохновлять их и помогать становиться сильнее!</p></div></section><div class="ref-coach-top-side"><div class="ref-coach-summary">@foreach(var (label,value,icon) in new[]{("Клиентов",Model.ActiveClients.ToString(),"users"),("Тренировок сегодня",Model.ScheduledToday.ToString(),"workout"),("Активных программ",(Model.Preview?18:overview.ActivePrograms).ToString(),"document"),("Выполнение планов",percent+"%","target")}){<a class="ref-panel" asp-page="@(icon=="users"?"/Coaching/Clients":icon=="workout"?"/Coaching/Calendar":"/Training/Programs/Index")"><reference-icon name="@icon" /><small>@label</small><strong>@value</strong></a>}</div><div class="ref-coach-primary-actions"><a class="ref-primary" asp-page="/Training/Programs/Edit"><reference-icon name="plus-circle" /><span><strong>Создать программу</strong><small>План тренировок для клиента</small></span><reference-icon name="chevron" /></a><a class="ref-secondary" asp-page="/Coaching/Calendar"><reference-icon name="calendar" /><span><strong>Назначить тренировку</strong><small>Выбрать клиента и дату</small></span><reference-icon name="chevron" /></a></div></div></div>
<div class="ref-coach-middle"><section class="ref-panel ref-coach-activity"><header class="ref-panel-heading"><h2><reference-icon name="bars" />Активность клиентов сегодня</h2><a class="ref-link" asp-page="/Coaching/Clients">Все <reference-icon name="chevron" /></a></header><div class="ref-tabs"><a asp-page="/Coaching/Clients" aria-current="page">Все @Model.CompletedClients</a><a asp-page="/Coaching/Calendar">Тренировки</a><a asp-page="/Nutrition/Index">Питание</a></div>@if(Model.Preview){@foreach(var name in new[]{"Алексей Петров","Мария Иванова","Дмитрий Соколов","Екатерина Смирнова","Олег Кузнецов"}){<a class="ref-coach-activity-row" asp-page="/Coaching/Clients"><span class="ref-client-initial">@name[..1]</span><strong>@name</strong><small>Тренировка завершена</small><reference-icon name="check-circle" /></a>}}else{@foreach(var client in activity){<a class="ref-coach-activity-row" asp-page="/Coaching/Client" asp-route-id="@client.Id"><span class="ref-client-initial">@client.Name[..1]</span><strong>@client.Name</strong><small>Тренировка завершена</small><reference-icon name="check-circle" /></a>}@if(activity.Length==0){<div class="ref-empty"><reference-icon name="users" /><p>Здесь появятся завершённые сегодня тренировки клиентов.</p></div>}}</section>
<section class="ref-panel ref-coach-progress"><header class="ref-panel-heading"><h2><reference-icon name="bars" />Прогресс клиентов</h2><a class="ref-link" asp-page="/Progress/Index">Все <reference-icon name="chevron" /></a></header><div class="ref-coach-progress-stats"><div><strong>@(Model.Preview?12:total)</strong><small>тренировок за 6 недель</small></div><div><strong>@(Model.Preview?18:overview.Records.Count(r=>r.Gain>0))</strong><small>улучшенных рекордов</small></div><div><strong>@percent%</strong><small>выполнение планов</small></div></div><svg class="ref-coach-progress-chart" viewBox="0 0 320 190" role="img" aria-label="Количество тренировок по неделям"><defs><linearGradient id="coach-home-chart-fill" x1="0" y1="0" x2="0" y2="1"><stop stop-color="currentColor" stop-opacity=".3"/><stop offset="1" stop-color="currentColor" stop-opacity="0"/></linearGradient></defs>@for(var i=0;i<4;i++){<line x1="25" x2="297" y1="@(40+i*38)" y2="@(40+i*38)" /> }<polygon points="25,155 @polyline 290,155" fill="url(#coach-home-chart-fill)" /><polyline points="@polyline" fill="none" stroke="currentColor" stroke-width="3"/>@for(var i=0;i<Model.Bars.Count;i++){var b=Model.Bars[i];<circle cx="@(25+i*53)" cy="@(155-(int)(b.Value/max*115))" r="4" fill="currentColor"/><g><text x="@(25+i*53)" y="179" text-anchor="middle">@b.Label</text></g>}</svg></section>
<partial name="/Pages/Shared/Dashboard/Subscription/_CoachAttentionReference.cshtml" model="Model" /></div>
<div class="ref-coach-bottom"><section class="ref-panel ref-coach-week"><header class="ref-panel-heading"><h2><reference-icon name="calendar" />Расписание на неделю</h2><a class="ref-link" asp-page="/Coaching/Calendar">Все события <reference-icon name="chevron" /></a></header><div class="ref-week-strip">@for(var i=0;i<7;i++){var day=Model.Today.AddDays(-((int)Model.Today.DayOfWeek+6)%7+i);var count=Model.Preview?new[]{5,8,7,6,4,3,2}[i]:overview.WeekPlans?.FirstOrDefault(d=>d.Date==day)?.Count??0;<a class="ref-week-day" asp-page="/Coaching/Calendar" asp-route-Day="@day.ToString("yyyy-MM-dd")" aria-current="@(day==Model.Today?"date":null)"><span>@day.ToString("ddd",DashboardWorkoutsViewModel.Russian)</span><small>@day.ToString("d MMM",DashboardWorkoutsViewModel.Russian)</small><strong>@count</strong><small>занятий</small></a>}</div></section>
<section class="ref-panel ref-coach-messages"><header class="ref-panel-heading"><h2><reference-icon name="message" />Последние сообщения</h2><a class="ref-link" asp-page="/Coaching/Messages">Все сообщения <reference-icon name="chevron" /></a></header>@if(Model.Preview){@foreach(var(name,copy,time)in new[]{("Мария Иванова","Добрый день! Можно заменить упражнение?","11:20"),("Алексей Петров","Спасибо за тренировку! Чувствую прогресс.","10:48"),("Екатерина Смирнова","Сегодня не получится прийти, перенесём?","09:15")}){<a class="ref-coach-message-row" asp-page="/Coaching/Messages"><span class="ref-client-initial">@name[..1]</span><span><strong>@name</strong><small>@copy</small></span><time>@time</time></a>}}else{@foreach(var message in overview.Messages??[]){<a class="ref-coach-message-row" asp-page="/Coaching/Messages" asp-route-ContactId="@message.ClientId"><span class="ref-client-initial">@message.ClientName[..1]</span><span><strong>@message.ClientName</strong><small>@message.Text</small></span><time>@message.CreatedAtUtc.ToString("d MMM",DashboardWorkoutsViewModel.Russian)</time></a>}@if(overview.Messages is null||overview.Messages.Count==0){<div class="ref-empty"><reference-icon name="message" /><p>Сообщения от ваших клиентов появятся здесь.</p><a class="ref-link" asp-page="/Coaching/Messages">Открыть диалоги <reference-icon name="arrow" /></a></div>}}</section></div>
</div>

