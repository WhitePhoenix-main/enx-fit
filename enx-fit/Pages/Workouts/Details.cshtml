@page "{id:int}"
@model enx_fit.Pages.Workouts.DetailsModel
@using System.Globalization
@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = Model.Workout.Title ?? "Тренировка";
    var workout = Model.Workout;
    var locked = workout.StartedAtUtc.HasValue && workout.CompletedAtUtc.HasValue;
}
<div class="active-workout" data-active-workout>
    <a class="workout-back" asp-page="/Dashboard"><admin-icon name="back" />На главную</a>
    <header class="active-header">
        <div><p class="eyebrow">@(workout.CompletedAtUtc.HasValue ? "ТРЕНИРОВКА ЗАВЕРШЕНА" : "ВАША ТРЕНИРОВКА") · @workout.Date.ToString("dd.MM.yyyy")</p><h1>@(workout.Title ?? "Быстрая тренировка")</h1>
            @if (workout.StartedAtUtc is { } started)
            { <p class="active-session-meta"><span class="live-dot"></span><strong data-session-clock="@DateTime.SpecifyKind(started, DateTimeKind.Utc).ToString("O")" data-session-end="@(workout.CompletedAtUtc is { } ended ? DateTime.SpecifyKind(ended, DateTimeKind.Utc).ToString("O") : null)">00:00</strong><span>Начало: <time data-local-time="@DateTime.SpecifyKind(started, DateTimeKind.Utc).ToString("O")">@started.ToString("HH:mm") UTC</time></span><span>· Сохранено</span></p> }
            @if (Model.IsAdministrator) { <p class="muted">Пользователь: @Model.OwnerName</p> }
            @if (!string.IsNullOrWhiteSpace(workout.Notes)) { <p class="muted">@workout.Notes</p> }
        </div>
        <div class="active-header-actions">
            @if (!locked && workout.WorkoutExercises.Count == 0) { <button class="button secondary" data-dialog="load-template-dialog">Загрузить шаблон <admin-icon name="chevron" /></button> }
            @if (!workout.StartedAtUtc.HasValue && !workout.CompletedAtUtc.HasValue) { <form method="post" asp-page-handler="Start"><button class="button">Начать занятие <admin-icon name="play" /></button></form> }
            @if (workout.TrainingProgramId is { } programId) { <a class="button secondary" asp-page="/Programs/Details" asp-route-id="@programId">К программе</a> }
            <a class="button secondary" asp-page="./Edit" asp-route-id="@workout.Id">Название и заметки</a>
        </div>
    </header>
    @if (TempData["StatusMessage"] is string message) { <p class="status-message" role="status"><admin-icon name="check" />@message</p> }
    <div asp-validation-summary="All" class="validation-message" role="alert"></div>
    @if (workout.TemplateDecisionPending)
    {
        <section class="panel template-decision" aria-labelledby="template-decision-title"><h2 id="template-decision-title">Вы изменили тренировку относительно шаблона</h2><p class="muted">Результаты уже сохранены. Исходный шаблон пока без изменений.</p>
            <form method="post" asp-page-handler="TemplateDecision"><button name="choice" value="keep" class="button">Оставить шаблон без изменений</button>
                @if (Model.CanUpdateTemplate) { <button name="choice" value="update" class="button secondary">Обновить шаблон</button> }
            </form>
            <details><summary>Сохранить как новый шаблон</summary><form method="post" asp-page-handler="TemplateDecision"><label>Название шаблона<input name="templateName" required maxlength="120" value="@workout.Title" /></label><button class="button secondary" name="choice" value="new">Сохранить как новый шаблон</button></form></details>
        </section>
    }
    @if (Model.Blueprint is { } blueprint)
    {
        <details class="panel workout-blueprint"><summary>План тренировки · @blueprint.Goal · ~ @blueprint.DurationMinutes мин</summary>
            @foreach (var block in blueprint.Blocks) { <p>@block.Name</p>@foreach (var e in block.Exercises) { <p class="muted">@string.Join(" · ", e.Sets.Select(s => $"{s.Weight} кг × {s.Reps}, отдых {s.RestSeconds} с"))</p> } }
        </details>
    }
    @if (workout.WorkoutExercises.Count == 0)
    {
        <section class="panel workout-empty"><span class="start-icon"><admin-icon name="workout" /></span><h2>Всё начинается с первого упражнения</h2><p>Добавляйте упражнения и записывайте подходы в своём темпе.</p><button class="button" data-dialog="exercise-dialog" data-add-exercise><admin-icon name="plus" />Добавить упражнение</button><button class="text-button" data-dialog="load-template-dialog">Или загрузить шаблон</button></section>
    }
    <div class="session-exercises">
    @foreach (var exercise in workout.WorkoutExercises.OrderBy(e => e.Order))
    {
        var sets = exercise.SetEntries.OrderBy(s => s.SetNumber).ThenBy(s => s.Id).ToList();
        var nextNumber = sets.Count == 0 ? 1 : sets.Max(s => s.SetNumber) + 1;
        var planned = Model.Blueprint?.Blocks.SelectMany(b => b.Exercises).FirstOrDefault(e => e.ExerciseId == exercise.ExerciseId)?.Sets.ElementAtOrDefault(nextNumber - 1);
        <section class="panel session-exercise" id="exercise-@exercise.Id">
            <header><span class="exercise-order">@(workout.WorkoutExercises.OrderBy(e => e.Order).ToList().IndexOf(exercise) + 1)</span><div><h2>@ExercisePresentation.DisplayName(exercise.Exercise)</h2><p>@exercise.Exercise.MuscleGroup · @exercise.Exercise.Equipment</p></div>
                @if (!locked) { <details class="exercise-menu"><summary aria-label="Действия: @ExercisePresentation.DisplayName(exercise.Exercise)">⋯</summary><div>
                    <button type="button" data-dialog="exercise-dialog" data-replace-exercise="@exercise.Id">Заменить упражнение</button>
                    <form method="post" asp-page-handler="Exercise"><input type="hidden" name="ExerciseEntryId" value="@exercise.Id" /><button name="action" value="up">Переместить выше</button><button name="action" value="down">Переместить ниже</button><button name="action" value="remove" class="danger-text">Удалить из тренировки</button></form>
                </div></details> }
            </header>
            @if (exercise.TargetRpe is { } rpe) { <p class="muted">RPE по плану: @rpe</p> }
            @if (!string.IsNullOrWhiteSpace(exercise.Notes)) { <p class="muted">@exercise.Notes</p> }
            <div class="set-labels" aria-hidden="true"><span>№</span><span>Вес, кг</span><span>Повторения</span><span>Выполнено</span></div>
            @foreach (var set in sets)
            {
                <form method="post" asp-page-handler="Set" class="set-form @(set.IsCompleted ? "is-completed" : "")">
                    <input type="hidden" name="setId" value="@set.Id" /><input type="hidden" name="AddSet.WorkoutExerciseId" value="@exercise.Id" /><input type="hidden" name="AddSet.SetNumber" value="@set.SetNumber" />
                    <div class="set-main"><span class="set-number">@set.SetNumber</span>
                        <input aria-label="Вес подхода @set.SetNumber, кг" name="AddSet.Weight" type="number" inputmode="decimal" min="0" max="10000" step="0.01" value="@set.Weight.ToString(CultureInfo.InvariantCulture)" readonly="@locked" required />
                        <input aria-label="Повторения подхода @set.SetNumber" name="AddSet.Reps" type="number" inputmode="numeric" min="0" max="1000" value="@set.Reps" readonly="@locked" required />
                        <label class="set-completed"><input type="checkbox" name="completed" value="true" checked="@set.IsCompleted" disabled="@locked" aria-label="Подход @set.SetNumber выполнен" /><span><admin-icon name="check" /></span></label>
                    </div>
                    <details class="set-extra"><summary>RIR, заметка и действия</summary><div>
                        <label>RIR<input type="number" name="AddSet.Rir" min="0" max="10" value="@set.Rir" readonly="@locked" /></label><label class="set-note">Комментарий<input name="AddSet.Notes" maxlength="500" value="@set.Notes" readonly="@locked" /></label><label class="warmup-check"><input type="checkbox" name="AddSet.IsWarmup" value="true" checked="@set.IsWarmup" disabled="@locked" />Разминка</label>
                        @if (!locked) { <button class="button secondary">Сохранить подход</button><button name="remove" value="true" formnovalidate class="text-button danger-text">Удалить подход</button> }
                    </div></details>
                    @if (!locked) { <p class="set-save-status" role="status" hidden></p><noscript><button class="button secondary">Сохранить</button></noscript> }
                </form>
            }
            @if (!locked)
            {
                <form method="post" asp-page-handler="AddSet" class="new-set-form"><input type="hidden" name="AddSet.WorkoutExerciseId" value="@exercise.Id" /><input type="hidden" name="AddSet.SetNumber" value="@nextNumber" />
                    <label>Вес, кг<input name="AddSet.Weight" aria-label="Вес нового подхода, кг" type="number" inputmode="decimal" min="0" max="10000" step="0.01" value="@((planned?.Weight ?? sets.LastOrDefault()?.Weight ?? exercise.TargetWeightKg ?? 0).ToString(CultureInfo.InvariantCulture))" required /></label>
                    <label>Повторения<input name="AddSet.Reps" aria-label="Повторения нового подхода" type="number" inputmode="numeric" min="1" max="1000" value="@(planned?.Reps ?? sets.LastOrDefault()?.Reps ?? exercise.TargetRepsMin ?? 8)" required /></label>
                    <button class="button secondary"><admin-icon name="plus" />Добавить подход</button><small>Добавленный подход отмечается выполненным</small>
                </form>
            }
        </section>
    }
    </div>
    @if (!locked)
    {
        <button class="button secondary add-session-exercise" data-dialog="exercise-dialog" data-add-exercise><admin-icon name="plus" />Добавить упражнение</button>
        <div class="workout-sticky-actions"><button class="button secondary" data-dialog="exercise-dialog" data-add-exercise><admin-icon name="plus" /><span>Упражнение</span></button><form method="post" asp-page-handler="Complete"><button class="button"><admin-icon name="check" />Завершить тренировку</button></form></div>
    }
    else { <a class="button" asp-page="/Dashboard">Вернуться на главную <admin-icon name="arrow" /></a> }
</div>
<dialog class="app-dialog exercise-picker-dialog" id="exercise-dialog" aria-labelledby="exercise-dialog-title"><div class="dialog-heading"><h2 id="exercise-dialog-title">Добавить упражнение</h2><button type="button" class="icon-button" data-close aria-label="Закрыть"><admin-icon name="close" /></button></div><form method="post" asp-page-handler="AddExercise"><input name="ExerciseEntryId" type="hidden" value="0" data-exercise-entry /><partial name="~/Pages/Shared/_ExerciseLibrary.cshtml" model="Model.Library" /></form></dialog>
<dialog class="app-dialog quick-dialog" id="load-template-dialog" aria-labelledby="load-template-title"><div class="dialog-heading"><h2 id="load-template-title">Загрузить шаблон</h2><button type="button" class="icon-button" data-close aria-label="Закрыть"><admin-icon name="close" /></button></div><p class="muted">Упражнения и подходы копируются в текущее занятие. Оригинал сохраняется.</p><div class="quick-options">
    @foreach (var template in Model.Templates) { <form method="post" asp-page-handler="LoadTemplate"><input type="hidden" name="templateId" value="@template.Id" /><button class="quick-option"><admin-icon name="workout" /><span><strong>@template.Name</strong><small>@template.ProgramName · @template.Exercises упражнений</small></span><admin-icon name="arrow" /></button></form> }
    @if (Model.Templates.Count == 0) { <a class="button secondary" asp-page="/Programs/Index">Создать шаблон в программе</a> }
</div></dialog>
@section Styles { <link rel="stylesheet" href="~/css/exercise-library.css" asp-append-version="true" /><link rel="stylesheet" href="~/css/active-workout.css" asp-append-version="true" /> }
@section Scripts { <script src="~/js/exercise-library.js" asp-append-version="true"></script><script src="~/js/active-workout.js" asp-append-version="true"></script> }
