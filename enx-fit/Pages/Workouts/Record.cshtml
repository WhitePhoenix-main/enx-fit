@page
@model enx_fit.Pages.Workouts.RecordModel
@{
    Layout = "_DashboardReferenceLayout";
    ViewData["Title"] = "Записать прошедшую тренировку";
}
<div class="active-workout record-workout" data-record-workout data-viewer="@Model.ViewerId">
    <a class="workout-back" asp-page="/Dashboard/Workouts"><admin-icon name="back" />Тренировки</a>
    <header class="active-header"><div><p class="eyebrow">ДНЕВНИК ТРЕНИРОВОК</p><h1>Записать тренировку</h1><p class="muted">Укажите дату и то, что уже выполнили.</p></div><span class="record-mode"><admin-icon name="document" />Запись результата</span></header>
    <div asp-validation-summary="All" class="validation-message" role="alert"></div>
    <div class="record-draft"><p data-record-status role="status">Черновик сохраняется на этом устройстве</p><button type="button" class="text-button" data-reset-draft>Начать заново</button></div>
    <form method="post" id="record-form" data-record-form novalidate>
        <input asp-for="Input.ClientRequestId" type="hidden" />
        <input asp-for="Input.UtcOffsetMinutes" type="hidden" />
        <input asp-for="Input.ResultsJson" type="hidden" />
        <section class="panel record-metadata">
            <details class="record-basics" open><summary><span><strong data-record-title>@Model.Input.Title</strong><small data-record-date>@Model.Input.Date.ToString("dd.MM.yyyy")</small></span><span>Изменить</span></summary><div class="record-fields">
                <label>Название<input asp-for="Input.Title" required maxlength="160" /></label><label>Дата тренировки<input asp-for="Input.Date" type="date" min="1970-01-01" max="@Model.Today.ToString("yyyy-MM-dd")" required /></label>
                <details class="record-optional"><summary>Длительность и заметка <span data-record-optional-summary>необязательно</span></summary><div><label>Длительность, мин<input asp-for="Input.DurationMinutes" type="number" inputmode="numeric" min="1" max="1440" placeholder="Не указана" /></label><label>Заметка<textarea asp-for="Input.Notes" rows="2" maxlength="1000" placeholder="Как прошла тренировка?"></textarea></label></div></details>
            </div></details>
        </section>
        <details class="record-sources"><summary><admin-icon name="repeat" />Взять упражнения из прошлой записи или шаблона</summary><div><button type="button" class="button secondary" data-record-source="previous">Из последней тренировки</button><button type="button" class="button secondary" data-dialog="record-template-dialog">Из шаблона</button></div></details>
        <p class="record-source-note" data-record-source-note hidden></p>
        <div class="record-feedback" data-record-feedback hidden><span role="status" data-record-feedback-text></span><button class="text-button" type="button" data-record-undo hidden>Отменить</button></div>
        <div class="record-workspace">
            <aside class="panel record-outline" data-record-outline-host hidden><header><h2>Упражнения</h2><span data-record-count></span></header><nav data-record-outline aria-label="Упражнения записи"></nav><button type="button" class="button secondary" data-dialog="record-exercise-dialog"><admin-icon name="plus" />Добавить</button></aside>
            <div><div class="session-exercises" data-record-exercises></div><section class="panel record-empty" data-record-empty><span class="record-empty-icon"><admin-icon name="workout" /></span><h2>Что вы выполнили?</h2><p class="muted">Добавьте упражнения. Вес и повторения можно заполнить по подходам.</p><button type="button" class="button primary" data-dialog="record-exercise-dialog"><admin-icon name="plus" />Добавить упражнения</button></section></div>
        </div>
        <div class="workout-sticky-actions record-savebar"><p data-record-summary>Начните с упражнения</p><button type="button" class="button secondary" data-dialog="record-exercise-dialog" aria-label="Добавить упражнение"><admin-icon name="plus" /><span>Упражнение</span></button><button type="submit" class="button primary" data-record-save>Проверить запись<admin-icon name="arrow" /></button></div>
    </form>
    <noscript><p class="validation-message">Для заполнения результатов включите JavaScript в браузере.</p></noscript>
</div>
<dialog class="app-dialog exercise-picker-dialog" id="record-exercise-dialog" aria-labelledby="record-picker-title"><div class="dialog-heading"><h2 id="record-picker-title">Добавить упражнения</h2><button type="button" class="icon-button" data-close aria-label="Закрыть"><admin-icon name="close" /></button></div><partial name="~/Pages/Shared/_ExerciseLibrary.cshtml" model="Model.Library" /></dialog>
<dialog class="app-dialog quick-dialog record-sheet" id="record-template-dialog" aria-labelledby="record-template-title"><div class="dialog-heading"><h2 id="record-template-title">Основа для записи</h2><button type="button" class="icon-button" data-close aria-label="Закрыть"><admin-icon name="close" /></button></div><p class="muted">Это плановые значения. Проверьте их и укажите фактические результаты перед сохранением.</p><div class="quick-options">@foreach (var template in Model.Templates) { <button class="quick-option" type="button" data-record-source="template" data-template-id="@template.Id"><admin-icon name="workout" /><span><strong>@template.Name</strong><small>@template.ProgramName · @template.Exercises упр.</small></span><admin-icon name="arrow" /></button> }@if (Model.Templates.Count == 0) { <p>В программах пока нет заполненных шаблонов.</p> }</div></dialog>
<dialog class="app-dialog record-sheet record-review" id="record-review-dialog" aria-labelledby="record-review-title"><div class="dialog-heading"><h2 id="record-review-title">Проверьте результат</h2><button type="button" class="icon-button" data-close aria-label="Закрыть"><admin-icon name="close" /></button></div><div data-record-review-content></div><p class="record-review-hint">Все указанные подходы попадут в историю как выполненные. Объём учитывает только рабочие подходы.</p><p data-record-review-status role="status" hidden></p><div class="record-review-actions"><button type="button" class="button secondary" data-close>Продолжить ввод</button><button type="submit" form="record-form" class="button primary" data-record-confirm>Сохранить в историю<admin-icon name="check" /></button></div></dialog>
@section Styles { <link rel="stylesheet" href="~/css/exercise-library.css" asp-append-version="true" /><link rel="stylesheet" href="~/css/active-workout.css" asp-append-version="true" /><link rel="stylesheet" href="~/css/record-workout.css" asp-append-version="true" /> }
@section Scripts { <script src="~/js/exercise-library.js" asp-append-version="true"></script><script src="~/js/record-workout.js" asp-append-version="true"></script> }
