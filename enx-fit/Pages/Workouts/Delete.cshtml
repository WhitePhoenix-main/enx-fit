@page "{id:int}"
@model enx_fit.Pages.Workouts.DeleteModel
@{
    ViewData["Title"] = "Удалить тренировку";
}

<div class="mb-4">
    <h1 class="h3 mb-1">Удалить тренировку</h1>
    <p class="text-muted mb-0">Проверьте тренировку перед удалением.</p>
</div>

<div class="card border-danger">
    <div class="card-body">
        <h2 class="h5">@(string.IsNullOrWhiteSpace(Model.Workout.Title) ? "Тренировка" : Model.Workout.Title)</h2>
        <p class="text-muted">@Model.Workout.Date.ToString("yyyy-MM-dd")</p>
        <p>Будут удалены тренировка, её упражнения и все записанные подходы.</p>
        <form method="post">
            <input type="hidden" asp-for="Workout.Id" />
            <div class="d-flex gap-2">
                <button class="btn btn-danger" type="submit">Удалить тренировку</button>
                <a class="btn btn-outline-secondary" asp-page="./Details" asp-route-id="@Model.Workout.Id">Отмена</a>
            </div>
        </form>
    </div>
</div>
