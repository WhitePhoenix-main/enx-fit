@model enx_fit.Pages.Training.IndexModel
<dialog class="wh-dialog" id="hub-appointment"><div class="wh-dialog-heading"><h2>Назначить тренировку</h2><button type="button" data-hub-close aria-label="Закрыть"><reference-icon name="close" /></button></div><form method="post" asp-page-handler="Assign" data-hub-appointment><input type="hidden" asp-for="Appointment.RequestId" /><label>Клиент<select asp-for="Appointment.ClientId" required><option value="">Выберите клиента</option>@foreach(var c in Model.Clients){<option value="@c.Id">@c.Name</option>}</select></label><label>Шаблон<select asp-for="Appointment.WorkoutId" required><option value="">Выберите тренировку</option>@foreach(var c in Model.AssignmentChoices){<option value="@c.Id">@c.Title</option>}</select></label><div class="wh-form-grid"><label>Дата<input asp-for="Appointment.Date" type="date" required /></label><label>Время<input asp-for="Appointment.Time" type="time" required /></label></div><label>Длительность, мин<input asp-for="Appointment.Minutes" type="number" min="15" max="180" step="5" required /></label><button class="wh-primary" type="submit">Назначить тренировку <reference-icon name="arrow" /></button></form></dialog>
