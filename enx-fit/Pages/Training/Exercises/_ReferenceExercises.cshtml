@using enx_fit.Presentation.Exercises
@using System.Security.Claims
@inject enx_fit.Security.IFeatureAccessService LibraryAccess
@model enx_fit.Pages.Training.Exercises.IndexModel
@{ var access=await LibraryAccess.GetAsync(); var premium=access.Plan!=SubscriptionPlan.Free; var coach=access.CanUse(Feature.CoachClientManagement);
   string? Photo(Exercise e) {var n=ExercisePresentation.DisplayName(e).ToLowerInvariant();return n.Contains("отжиман")&&!n.Contains("брусь")?"pushup":n.Contains("выпад")?"lunge":ExercisePhotography.Key(e);}
}
<div class="ref-library-@(coach?"coach":premium?"pro":"free")" data-ref-library data-viewer="@User.FindFirstValue(ClaimTypes.NameIdentifier)">
<header class="ref-heading"><div><h1>Упражнения</h1><p>@(coach?"Библиотека упражнений с подробной информацией. Подбирайте упражнения клиентам.":premium?"Библиотека упражнений с техникой и рекомендациями для ваших тренировок.":"Изучайте технику, находите новые упражнения и собирайте свои тренировки.")</p></div>@if(User.HasMinimumRole(UserRole.Administrator)){<a class="ref-primary" asp-page="./Create"><reference-icon name="plus" />Добавить упражнение</a>}</header>
<div class="ref-library-tools"><label class="ref-input"><reference-icon name="search" /><input type="search" placeholder="Поиск упражнений, мышц или инвентаря…" aria-label="Поиск упражнений" data-ref-search /></label><select data-ref-equipment aria-label="Оборудование"><option value="">Любой инвентарь</option><option value="штанг">Штанга</option><option value="гантел">Гантели</option><option value="тренаж">Тренажёры</option><option value="турник">Турник</option><option value="вес тела">Вес тела</option></select><select data-ref-sort aria-label="Сортировка"><option value="popular">Популярные</option><option value="name">По названию</option></select></div>
<nav class="ref-muscle-tabs" aria-label="Группа мышц">@foreach(var(key,label,icon) in new[]{("","Все","grid"),("груд","Грудь","heart"),("спин","Спина","workout"),("ног","Ноги","legs"),("плеч","Плечи","muscle"),("рук","Руки","muscle"),("пресс","Пресс","target")}){<button type="button" data-ref-muscle="@key" aria-pressed="@(key==""?"true":"false")"><reference-icon name="@icon" />@label</button>}</nav>
@if(premium){<nav class="ref-tabs" aria-label="Разделы библиотеки"><button type="button" data-ref-tab="all" aria-pressed="true">Все упражнения</button><button type="button" data-ref-tab="favorites" aria-pressed="false">Избранные</button><button type="button" data-ref-tab="recent" aria-pressed="false">Недавно просмотренные</button>@if(!coach){<button type="button" data-ref-compare-open>Сравнение <span data-ref-compare-count>0</span></button>}</nav><section class="ref-panel ref-recommendations" style="margin-bottom:18px"><header class="ref-panel-heading"><h2><reference-icon name="target" />@(coach?"Подбирайте упражнения под задачи клиента":"Техника и последовательный прогресс")</h2><a class="ref-link" asp-page="/Account/TrainingSetup">Мои условия <reference-icon name="chevron" /></a></header><p style="color:var(--ref-muted);font-size:13px">Выбирайте знакомые движения, учитывайте доступный инвентарь и сохраняйте рабочие результаты.</p><div class="ref-benefits"><span><reference-icon name="shield" />Контроль техники</span><span><reference-icon name="workout" />Доступное оборудование</span><span><reference-icon name="bars" />История результатов</span><span><reference-icon name="target" />Ваши цели</span></div></section>}
<div class="ref-library-layout">@if(coach){<aside class="ref-panel ref-exercise-filters"><header class="ref-panel-heading"><h2>Фильтры</h2><button class="ref-link" type="button" data-ref-sidebar-reset>Сбросить</button></header><label>Клиент<select data-ref-client aria-label="Клиент для назначения">@foreach(var client in Model.Clients){<option value="@client.Id">@client.Name</option>}</select></label><h3>Целевые мышцы</h3><div>@foreach(var(key,label) in new[]{("","Все группы"),("груд","Грудь"),("спин","Спина"),("ног","Ноги"),("плеч","Плечи"),("рук","Руки"),("пресс","Пресс")}){<button type="button" data-ref-muscle="@key" aria-pressed="@(key==""?"true":"false")">@label</button>}</div><h3>Инструменты клиента</h3><a class="ref-history-row" asp-page="/Training/Programs/Index"><reference-icon name="document" /><span>Назначенные программы</span><reference-icon name="chevron" /></a><a class="ref-history-row" asp-page="/Coaching/Calendar"><reference-icon name="calendar" /><span>Расписание тренировок</span><reference-icon name="chevron" /></a></aside>}<div><header class="ref-panel-heading"><h2>@(premium?"Все упражнения":"Популярные упражнения") <small class="ref-link" data-ref-count></small></h2>@if(!premium){<button class="ref-link" type="button" data-ref-tab="favorites">Избранные <reference-icon name="star" /></button>}</header>
<div class="ref-exercise-grid" data-ref-exercise-grid>
@if(!premium){<h2 class="ref-library-subheading" data-ref-library-subheading>Все упражнения</h2>}
@foreach(var exercise in Model.Exercises){var name=ExercisePresentation.DisplayName(exercise);var photo=Photo(exercise);<article class="ref-exercise" data-ref-exercise="@exercise.Id" data-name="@name" data-muscle="@exercise.MuscleGroup" data-equipment="@exercise.Equipment" data-recent="@Model.RecentIds.Contains(exercise.Id).ToString().ToLowerInvariant()">
@if(photo is not null){<design-photo class="ref-exercise-photo" kind="@photo" alt="@name" />}else{<div class="ref-exercise-placeholder"><admin-icon name="@ExercisePresentation.MuscleIcon(exercise.MuscleGroup)" /></div>}
<button type="button" class="ref-favorite" data-ref-favorite aria-label="В избранное: @name" aria-pressed="false"><reference-icon name="bookmark" /></button><div class="ref-exercise-copy"><h2>@name</h2><p><reference-icon name="muscle" />@exercise.MuscleGroup</p><p><reference-icon name="workout" />@exercise.Equipment</p>@if(premium&&!coach){<label class="ref-compare-toggle"><input type="checkbox" data-ref-compare />Сравнить упражнение</label>}@if(coach){<button class="ref-primary" type="button" data-ref-assign="@exercise.Id" data-ref-assign-name="@name" data-dialog="assign-exercise-dialog">Назначить клиенту <reference-icon name="arrow" /></button>}else{<a class="ref-primary" asp-page="./Details" asp-route-id="@exercise.Id">Открыть <reference-icon name="arrow" /></a>}</div></article>}
</div><div class="ref-empty ref-panel" data-ref-empty hidden><reference-icon name="search" /><h3>Упражнения не найдены</h3><p>Измените поиск, группу мышц или оборудование.</p><button class="ref-secondary" type="button" data-ref-reset>Сбросить фильтры</button></div></div>
<aside class="ref-library-aside"><section class="ref-panel"><reference-icon name="crown" style="color:var(--plan-bright);width:30px;height:30px;margin-bottom:14px" /><h2>@(premium?"Развивайте технику и следите за прогрессом":"Развивайте технику с Enix Fit Pro")</h2><ul><li><reference-icon name="check-circle" />Библиотека упражнений</li><li><reference-icon name="check-circle" />Техника и подсказки</li><li><reference-icon name="check-circle" />Личные рекорды</li><li><reference-icon name="check-circle" />@(premium?"Сравнение упражнений":"Расширенная аналитика")</li></ul><a class="ref-primary" asp-page="@(premium?"/Training/Records":"/Account/Subscription")"><reference-icon name="@(premium?"trophy":"crown")" />@(premium?"Мои рекорды":"Открыть Pro")</a><design-photo kind="row" class="ref-aside-photo" /></section><section class="ref-panel"><h2>Полезные инструменты</h2><a class="ref-history-row" asp-page="/Training/Workouts/Templates"><reference-icon name="layers" /><span><strong>Готовые тренировки</strong><small>Собранные комплексы упражнений</small></span><reference-icon name="chevron" /></a><a class="ref-history-row" asp-page="/Training/Programs/Index"><reference-icon name="document" /><span><strong>Программы тренировок</strong><small>План для вашей цели</small></span><reference-icon name="chevron" /></a></section></aside></div>
@if(premium&&!coach){<div class="ref-compare-bar" data-ref-compare-bar hidden><reference-icon name="copy" /><strong>Сравнение упражнений · <span data-ref-compare-count>0</span> / 3</strong><button class="ref-primary" type="button" data-ref-compare-open>Сравнить</button><button class="ref-icon" type="button" data-ref-compare-reset aria-label="Очистить сравнение"><reference-icon name="close" /></button></div>}
</div>
<dialog class="app-dialog" id="exercise-comparison"><div class="dialog-heading"><h2>Сравнение упражнений</h2><button type="button" data-close aria-label="Закрыть"><reference-icon name="close" /></button></div><div data-ref-compare-content></div></dialog>
@if(coach){<dialog class="app-dialog" id="assign-exercise-dialog"><div class="dialog-heading"><h2>Назначить упражнение</h2><button type="button" data-close aria-label="Закрыть"><reference-icon name="close" /></button></div><p data-ref-assign-caption style="margin-bottom:18px"></p><form class="ref-form-grid" method="post" asp-page-handler="Assign"><input type="hidden" name="exerciseId" data-ref-assign-id /><label class="ref-full">Клиент<select name="clientId" required>@foreach(var client in Model.Clients){<option value="@client.Id">@client.Name</option>}</select></label><label class="ref-full">Дата<input type="date" name="date" value="@Model.Today.ToString("yyyy-MM-dd")" required /></label><p class="ref-full" style="color:var(--ref-muted);font-size:12px">В план клиента будет добавлена тренировка: 3 подхода по 8–12 повторений, отдых 90 секунд.</p><button class="ref-primary ref-full" type="submit" disabled="@(Model.Clients.Count==0)">Назначить клиенту <reference-icon name="arrow" /></button></form></dialog>}

