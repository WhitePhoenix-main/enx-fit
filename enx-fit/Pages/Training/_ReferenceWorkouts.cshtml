@using enx_fit.ViewModels.Dashboard
@inject enx_fit.Security.IFeatureAccessService HubAccess
@model enx_fit.Pages.Dashboard.DashboardModel
@{ var vm = new DashboardWorkoutsViewModel(Model); var active = Model.ActiveWorkout; var next = Model.Data.NextWorkout; var program = Model.NextProgramWorkout; var pro=(await HubAccess.GetAsync()).Plan==SubscriptionPlan.Pro; var templates=Model.CoachTemplates.Where(c=>c.Mine).Take(3).ToArray();if(templates.Length==0)templates=Model.CoachTemplates.Take(3).ToArray(); }
<header class="ref-heading"><div><h1>Тренировки</h1><p>@(Model.IsTrainer && Model.CanManageClients ? "Управляйте тренировками, следите за результатами и помогайте клиентам расти." : "Ваше пространство для тренировок. Простые инструменты, которые работают.")</p></div></header>
<nav class="ref-tabs" aria-label="Разделы тренировок"><a asp-page="/Training/Index" aria-current="page">Сегодня</a><button type="button" data-dialog="quick-workout-dialog">Быстрая</button><a asp-page="/Training/Workouts/Templates">Шаблоны</a><a asp-page="/Training/Index" asp-route-View="history" asp-route-Days="30" asp-route-ClientId="@Model.ClientId">История</a></nav>
@if (Model.IsCoachView) { <p class="ref-notice">Тренировки клиента · @Model.Data.Name <a class="ref-link" asp-page="/Coaching/Client" asp-route-id="@Model.ClientId">Карточка клиента →</a></p> }
@if (Model.IsTrainer && Model.CanManageClients && !Model.IsCoachView) { <div class="ref-client-strip" aria-label="Клиенты">@foreach(var client in Model.Clients.Take(8)) { <a asp-page="/Training/Index" asp-route-ClientId="@client.Id"><span class="ref-client-initial">@client.Name[..1]</span><span><strong>@client.Name</strong><small>@client.Workouts тренировок</small></span></a> }</div> }
<div class="ref-hub-grid @(pro?"ref-hub-pro":"")">
    <section class="ref-panel ref-workout-hero"><h2>@(active is not null ? "Продолжить текущую тренировку" : "Тренировка на сегодня")</h2><design-photo class="ref-hero-photo" kind="row" /><div class="ref-hero-copy"><span class="ref-pill">@(active is not null ? "В процессе" : "Ваш следующий шаг")</span><h3>@(active?.Title ?? next?.Title ?? program?.Workout.Name ?? "Сильнее с каждым подходом")</h3><p>@(active is not null ? "Возвращайтесь к упражнениям. Все записанные подходы сохранены." : "Соберите тренировку под свою цель или выберите готовый план.")</p></div>
    <div class="ref-hero-metrics"><span><reference-icon name="stopwatch" />@(active?.StartedAtUtc is {} start ? $"{Math.Max(0,(int)(DateTime.UtcNow-start).TotalMinutes)} мин" : "В вашем темпе")</span><span><reference-icon name="workout" />@(active?.WorkoutExercises.Count ?? next?.WorkoutExercises.Count ?? program?.Workout.Exercises.Count ?? 0) упражнений</span></div>
    @if (Model.IsCoachView) { <a class="ref-primary" asp-page="/Coaching/Client" asp-route-id="@Model.ClientId">Открыть план клиента <reference-icon name="arrow" /></a> }
    else if (active is not null) { <a class="ref-primary" asp-page="/Training/Workouts/Details" asp-route-id="@active.Id">Продолжить тренировку <reference-icon name="arrow" /></a> }
    else if (next?.Date == Model.Data.Today || program?.Date == Model.Data.Today) { <form method="post" asp-page="/Dashboard/Index" asp-page-handler="Start"><input type="hidden" name="source" value="@(next?.Date == Model.Data.Today ? "planned" : "program")" /><input type="hidden" name="plannedId" value="@next?.Id" /><input type="hidden" name="programId" value="@Model.ActiveProgram?.Id" /><button class="ref-primary" type="submit">Начать тренировку <reference-icon name="arrow" /></button></form> }
    else { <form method="post" asp-page="/Dashboard/Index" asp-page-handler="Start"><input type="hidden" name="source" value="empty" /><button class="ref-primary" type="submit">Начать тренировку <reference-icon name="arrow" /></button></form> }
    </section>
    <section class="ref-panel ref-hub-quick"><header class="ref-panel-heading"><h2><reference-icon name="@(pro?"star":"bolt")" />@(pro?"Рекомендация на сегодня":"Быстрая тренировка")</h2></header>@if(pro){<design-photo kind="hero-pro" class="ref-hub-photo" /><h2>@(program?.Workout.Name??"Сила и последовательный прогресс")</h2><p style="color:var(--ref-muted)">@(program is null?"Выберите программу под вашу цель и продолжайте в своём темпе.":$"{program.Date:d MMMM} · {program.Workout.Exercises.Count} упражнений в вашем плане.")</p><a class="ref-primary" asp-page="/Training/Programs/Index">@(program is null?"Подобрать программу":"Открыть программу") <reference-icon name="arrow" /></a>}else{<design-photo kind="pushup" class="ref-hub-photo" /><p style="color:var(--ref-muted)">Всё, что нужно — это несколько минут. Выберите готовую тренировку и начните прямо сейчас.</p><button class="ref-primary" type="button" data-dialog="quick-workout-dialog" style="margin-top:auto">Начать тренировку <reference-icon name="arrow" /></button>}</section>
@if(pro){<section class="ref-panel ref-hub-plan-progress"><h2>Ваш прогресс в плане</h2><p><strong>@Model.Data.ThisWeek.Count() из @Model.Data.Settings.WeeklyWorkoutGoal</strong><br />тренировок на этой неделе</p><div class="ref-ring" style="--ref-pct:@Model.Data.GoalPercent%"><div><strong>@Model.Data.GoalPercent%</strong><small>недельной цели</small></div></div><a class="ref-link" asp-page="/Progress/Index">Продолжайте в том же духе <reference-icon name="chevron" /></a></section>}
</div>
<div class="ref-actions" style="grid-template-columns:repeat(@(pro?4:3),minmax(0,1fr))"><button class="ref-action" type="button" data-dialog="quick-workout-dialog"><reference-icon name="bolt" /><span><strong>Быстрая тренировка</strong><small>Короткая сессия</small></span><reference-icon name="chevron" /></button><a class="ref-action" asp-page="/Training/Workouts/Templates"><reference-icon name="layers" /><span><strong>По шаблону</strong><small>Выбрать готовую тренировку</small></span><reference-icon name="chevron" /></a>@if(pro){<a class="ref-action" asp-page="/Training/Programs/Index"><reference-icon name="play" /><span><strong>Продолжить программу</strong><small>Текущий план тренировок</small></span><reference-icon name="chevron" /></a>}<a class="ref-action" asp-page="/Training/Workouts/Record"><reference-icon name="plus" /><span><strong>Записать тренировку</strong><small>Добавить вручную</small></span><reference-icon name="chevron" /></a></div>
<div class="ref-two-col"><section class="ref-panel"><header class="ref-panel-heading"><h2>@(templates.Any(c=>c.Mine)?"Мои шаблоны":"Готовые шаблоны")</h2><a class="ref-link" asp-page="/Training/Workouts/Templates">Все шаблоны <reference-icon name="arrow" /></a></header><div class="ref-template-grid">@foreach(var card in templates){<a class="ref-workout-card" asp-page="/Training/Workouts/Templates" asp-route-Selected="@card.Workout.Id"><design-photo kind="@(card.Focus=="legs"?"squat":card.Home?"pushup":"row")" /><div><h3>@card.Title</h3><p><reference-icon name="clock" />@(card.Workout.EstimatedMinutes>0?card.Workout.EstimatedMinutes.ToString():"—") мин</p><p><reference-icon name="workout" />@card.Exercises.Count упражнений</p></div></a>}</div>@if(templates.Length==0){<a class="ref-primary" asp-page="/Training/Programs/Edit"><reference-icon name="plus" />Создать шаблон</a>}</section>
<section class="ref-panel"><header class="ref-panel-heading"><h2>Последние тренировки</h2><a class="ref-link" asp-page="/Training/Index" asp-route-View="history" asp-route-Days="30" asp-route-ClientId="@Model.ClientId">Все <reference-icon name="chevron" /></a></header><div class="ref-history-list">@foreach(var w in vm.History.Take(4)) { <a class="ref-history-row" asp-page="/Training/Workouts/Details" asp-route-id="@w.Id"><design-photo kind="@w.Photo" /><span><strong>@w.Title</strong><small>@w.Date.ToString("d MMM yyyy",DashboardWorkoutsViewModel.Russian) · @w.Exercises упр. · @DashboardWorkoutsViewModel.Number(w.Volume) кг</small></span><reference-icon name="chevron" /></a> }</div>@if(vm.History.Count==0) { <div class="ref-empty"><reference-icon name="clock" /><p>Завершённые тренировки появятся здесь.</p></div> }</section></div>
<section class="ref-panel ref-hub-popular"><header class="ref-panel-heading"><h2>Популярные тренировки</h2><a class="ref-link" asp-page="/Training/Workouts/Templates">Все <reference-icon name="arrow" /></a></header><div>@foreach(var card in Model.CoachTemplates.Where(c=>!c.Mine).Take(4)){<a class="ref-workout-card" asp-page="/Training/Workouts/Templates" asp-route-Selected="@card.Workout.Id"><design-photo kind="@(card.Focus=="legs"?"squat":card.Home?"pushup":"row")" /><div><h3>@card.Title</h3><p><reference-icon name="clock" />@(card.Workout.EstimatedMinutes>0?card.Workout.EstimatedMinutes.ToString():"—") мин · @card.Exercises.Count упражнений</p></div></a>}</div></section>
<partial name="/Pages/Shared/Workouts/_QuickWorkoutDialogs.cshtml" model="Model" />
