@using enx_fit.ViewModels.Workouts
@model enx_fit.Pages.Training.IndexModel
@if(Model.Coach){<a class="wh-back" href="@Url.Page(null,Model.Values(view:"train"))"><reference-icon name="arrow" />Все тренировки</a>}
<form method="get" class="wh-history-filters" role="search"><input type="hidden" name="View" value="history" />@if(Model.Personal){<input type="hidden" name="Personal" value="true" />}@if(Model.ClientId is not null){<input type="hidden" name="ClientId" value="@Model.ClientId" />}<label class="wh-search"><button type="submit" aria-label="Найти тренировки"><reference-icon name="search" /></button><input type="search" name="Search" value="@Model.Search" placeholder="Название или упражнение" aria-label="Поиск тренировок" /></label><label class="wh-select"><span class="wh-sr">Месяц истории</span><select name="Month" data-hub-submit>@foreach(var month in Model.HistoryMonths){<option value="@month.ToString("yyyy-MM-dd")" selected="@(month==Model.Month)">@month.ToString("MMMM yyyy", Model.Russian)</option>}</select><reference-icon name="chevron-down" /></label><noscript><button class="wh-secondary">Применить</button></noscript></form>
@{var minutes=Model.History.Sum(w=>w.Session?.DurationSeconds??0)/60;}
<p class="wh-history-summary">@WorkoutHubCard.Count(Model.History.Count,"тренировка","тренировки","тренировок") · @(minutes/60) ч @(minutes%60) мин</p>
<div class="wh-history-grid">@foreach(var(w,index) in Model.History.Select((w,i)=>(w,i))){<section class="wh-history-entry"><h2>@w.Date.ToString("d MMMM · dddd", Model.Russian)</h2><div class="wh-card"><div class="wh-history-card-heading"><span class="wh-done-icon"><reference-icon name="check" /></span><div><h3>@w.Title</h3>@if(Model.Coach){<p class="wh-history-client">@w.ClientName</p>}<p>@if(w.Minutes is {} duration){<span>@duration мин · </span>}@WorkoutHubCard.Count(w.Exercises.Count,"упражнение","упражнения","упражнений") · @WorkoutHubCard.Count(w.Done,"подход","подхода","подходов")</p><p>@WorkoutHubCard.N(w.Volume) кг · объём</p></div><a class="wh-history-state" asp-page="/Training/Workouts/Details" asp-route-id="@w.Session!.Id" asp-route-Coach="@(Model.Coach?(bool?)true:null)"><span class="wh-success"><reference-icon name="check-circle" />@(w.Session!.EntryMode==WorkoutEntryMode.Manual?"Внесена вручную":"Завершена")</span><reference-icon name="chevron" /></a></div>
@if(index==0){<div class="wh-history-preview">@foreach(var exercise in w.Exercises.Take(2)){<a class="wh-row" asp-page="/Training/Workouts/Details" asp-route-id="@w.Session!.Id" asp-route-Coach="@(Model.Coach?(bool?)true:null)"><reference-icon name="dumbbell-outline" /><strong>@exercise.Name</strong><b>@exercise.Result</b><reference-icon name="chevron" /></a>}</div>@if(!Model.Coach){<form method="post" asp-page-handler="Start"><input type="hidden" name="source" value="previous" /><input type="hidden" name="previousId" value="@w.Session!.Id" /><button class="wh-row wh-repeat" type="submit"><reference-icon name="repeat" /><strong>Повторить тренировку</strong><reference-icon name="up-right" /></button></form>}else{<a class="wh-row wh-repeat" asp-page="/Training/Workouts/Details" asp-route-id="@w.Session!.Id" asp-route-Coach="true"><reference-icon name="history" /><strong>Открыть результаты</strong><reference-icon name="arrow" /></a>}}
</div></section>}
@if(Model.History.Count==0){<section class="wh-card wh-empty"><reference-icon name="history" /><h2>Тренировки не найдены</h2><p>Попробуйте другой месяц или название. Завершённые занятия появятся здесь.</p></section>}
</div>
@if(!Model.Coach){<a class="wh-secondary wh-record-past" asp-page="/Training/Workouts/Record"><reference-icon name="plus" />Записать прошлую тренировку</a>}
