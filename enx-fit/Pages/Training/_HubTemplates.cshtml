@using enx_fit.ViewModels.Workouts
@model enx_fit.Pages.Training.IndexModel
@if(Model.Coach){<a class="wh-back" href="@Url.Page(null,Model.Values(view:"train"))"><reference-icon name="arrow" />Все тренировки</a>}
<header class="wh-section-heading"><h2>Шаблоны тренировок</h2><a asp-page="/Training/Programs/Edit"><reference-icon name="plus" />Создать</a></header>
<label class="wh-search wh-template-search"><reference-icon name="search" /><input type="search" placeholder="Название или упражнение" aria-label="Поиск шаблонов" data-hub-template-search /></label>
<nav class="wh-template-filters" aria-label="Категории шаблонов"><button type="button" data-hub-template-filter="all" aria-pressed="true">Все</button><button type="button" data-hub-template-filter="mine" aria-pressed="false">Мои</button><button type="button" data-hub-template-filter="ready" aria-pressed="false">Готовые</button></nav>
<div class="wh-template-grid">@foreach(var card in Model.Templates.OrderByDescending(t=>t.Mine)){<section class="wh-card wh-template" data-template-name="@card.Search" data-template-owner="@(card.Mine?"mine":"ready")"><header><reference-icon name="dumbbell-outline" /><span><h2>@card.Title</h2><small>@(card.Mine?"Мой шаблон":"Готовый шаблон") · @card.Level</small></span></header><p>@WorkoutHubCard.Count(card.Exercises.Count,"упражнение","упражнения","упражнений") · @WorkoutHubCard.Count(card.Exercises.Sum(e=>e.Prescription.Sets),"подход","подхода","подходов") @if(card.Workout.EstimatedMinutes>0){<span> · @card.Workout.EstimatedMinutes мин</span>}</p><p class="wh-muted">@string.Join(" · ",card.Exercises.Take(3).Select(e=>e.Exercise.Name))</p><div class="wh-template-actions">@if(Model.Coach){<button class="wh-primary" type="button" data-assign-template="@card.Workout.Id" disabled="@(!Model.AssignmentChoices.Any(c=>c.Id==card.Workout.Id)||Model.Clients.Count==0)">Назначить</button>}else{<form method="post" asp-page-handler="Start"><input type="hidden" name="source" value="template" /><input type="hidden" name="templateId" value="@card.Workout.Id" /><button class="wh-primary" type="submit">@(Model.Active is null?"Начать":"Продолжить текущую")</button></form>}<a class="wh-secondary" asp-page="/Training/Workouts/Templates" asp-route-Selected="@card.Workout.Id">Подробнее <reference-icon name="chevron" /></a></div></section>}</div>
<p class="wh-empty" data-hub-templates-empty hidden>Шаблоны не найдены. Попробуйте другое название или категорию.</p>
@if(Model.Templates.Count==0){<section class="wh-card wh-empty"><reference-icon name="layers" /><h2>Ваш первый шаблон</h2><p>Сохраните упражнения и подходы, чтобы быстро возвращаться к ним.</p><a class="wh-primary" asp-page="/Training/Programs/Edit">Создать шаблон</a></section>}
