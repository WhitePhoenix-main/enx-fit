@using enx_fit.ViewModels.Workouts
@model enx_fit.Pages.Training.IndexModel
<div class="wh-week"><div class="wh-week-heading"><a href="@Url.Page(null,Model.Values(day:Model.SelectedDay.AddDays(-7)))" aria-label="Предыдущая неделя"><reference-icon name="chevron" /></a><strong>@Model.WeekStart.Day — @Model.WeekStart.AddDays(6).ToString("d MMMM yyyy", Model.Russian)</strong><a href="@Url.Page(null,Model.Values(day:Model.SelectedDay.AddDays(7)))" aria-label="Следующая неделя"><reference-icon name="chevron" /></a></div><div class="wh-week-days">@for(var i=0;i<7;i++){var date=Model.WeekStart.AddDays(i);var done=date<=Model.Today&&Model.Sessions.Any(w=>w.Date==date&&w.State==WorkoutStatus.Completed&&w.WorkoutExercises.Any(e=>e.SetEntries.Any(WorkoutHubCard.Valid)));var planned=Model.Sessions.Any(w=>w.Date==date&&w.State!=WorkoutStatus.Cancelled)||Model.Occurrences.Any(o=>o.Date==date);<a href="@Url.Page(null,Model.Values(day:date))" aria-current="@(date==Model.SelectedDay?"date":null)" aria-label="@date.ToString("d MMMM, dddd", Model.Russian)"><small>@date.ToString("ddd", Model.Russian)</small><strong>@date.Day</strong><i class="@(done?"is-done":planned&&date!=Model.SelectedDay?"is-planned":"")">@if(done){<reference-icon name="check" />}</i></a>}</div></div>
