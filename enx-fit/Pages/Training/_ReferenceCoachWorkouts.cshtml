@using enx_fit.ViewModels.Dashboard
@model enx_fit.Pages.Dashboard.DashboardModel
@{var d=Model.Data;var session=d.Workouts.FirstOrDefault(w=>w.IsActive)??d.Workouts.Where(w=>w.State==WorkoutStatus.Planned&&w.Date>=d.Today).OrderBy(w=>w.Date).FirstOrDefault();var templates=Model.CoachTemplates.Where(t=>!t.Mine).Take(4).ToArray();}
<header class="ref-heading"><div><h1>Тренировки</h1><p>Управляйте тренировками своих клиентов</p></div></header>
<nav class="ref-tabs" aria-label="Разделы тренировок"><a asp-route-ClientId="@Model.ClientId" aria-current="page">Сегодня</a><a asp-page="/Coaching/Calendar">Расписание</a><a asp-page="/Coaching/Clients">Клиенты</a><a asp-page="/Training/Workouts/Templates">Шаблоны</a><a asp-page="/Training/Exercises/Index">Упражнения</a><a asp-page="/Training/Index" asp-route-View="history" asp-route-ClientId="@Model.ClientId">История</a></nav>
<div class="ref-coach-workout-top"><section class="ref-panel"><header class="ref-panel-heading"><h2>Выбор клиента</h2></header><div class="ref-client-strip ref-coach-workout-clients">@foreach(var client in Model.Clients){<a asp-route-ClientId="@client.Id" aria-current="@(client.Id==d.Subject.Id?"true":null)"><span class="ref-client-initial">@client.Name[..1]</span><span><strong>@client.Name</strong><small>@client.Workouts тренировок</small></span></a>}</div><h3 style="font-size:13px;margin:17px 0 12px">Статистика клиента</h3><div class="ref-coach-client-stats"><div><strong>@d.CompletedCount</strong><small>Тренировок</small></div><div><strong>@d.ThisWeek.Count()</strong><small>На этой неделе</small></div><div><strong>@(d.WeightChange?.ToString("+0.#;-0.#;0")??"—") <small>кг</small></strong><small>Изменение веса</small></div></div></section>
<section class="ref-panel ref-coach-assigned-workout"><header class="ref-panel-heading"><h2>Назначенная тренировка</h2><span class="ref-pill">@(session?.Date.ToString("d MMM")??"По плану")</span></header>@if(session is not null){<div><design-photo kind="row" /><span><h2>@session.Title</h2><p><reference-icon name="stopwatch" />@(session.PlannedMinutes??60) мин</p><p><reference-icon name="workout" />@session.WorkoutExercises.Count упражнений</p><span class="ref-pill">@(session.IsActive?"В процессе":"Запланирована")</span></span></div><a class="ref-primary" asp-page="/Training/Workouts/Details" asp-route-id="@session.Id" asp-route-Coach="true">Открыть тренировку <reference-icon name="arrow" /></a>}else{<div class="ref-empty"><reference-icon name="workout" /><h3>Назначьте тренировку</h3><p>Подберите комплекс и удобное время для клиента.</p><a class="ref-primary" asp-page="/Coaching/Calendar">Назначить тренировку</a></div>}</section>
<section class="ref-panel ref-coach-workout-actions"><header class="ref-panel-heading"><h2>Быстрые действия</h2></header>@foreach(var(icon,title,copy,target)in new[]{("document","Создать программу","С нуля или по шаблону","/Training/Programs/Edit"),("calendar","Назначить тренировку","Выбрать клиента и дату","/Coaching/Calendar"),("layers","Использовать шаблон","Быстрое назначение","/Training/Workouts/Templates"),("copy","Скопировать из клиента","Повторить или адаптировать","/Coaching/Clients")}){<a asp-page="@target"><reference-icon name="@icon" /><span><strong>@title</strong><small>@copy</small></span></a>}</section></div>
<div class="ref-coach-workout-middle"><section class="ref-panel"><header class="ref-panel-heading"><h2>Шаблоны тренировок</h2><a class="ref-link" asp-page="/Training/Workouts/Templates">Все шаблоны <reference-icon name="chevron" /></a></header><div class="ref-coach-workout-templates">@foreach(var card in templates){<a class="ref-workout-card" asp-page="/Training/Programs/Assign" asp-route-id="@card.Program.Id"><design-photo kind="@(card.Focus=="legs"?"squat":card.Home?"pushup":"row")" /><div><h3>@card.Title</h3><p><reference-icon name="clock" />@card.Workout.EstimatedMinutes мин</p><p><reference-icon name="workout" />@card.Exercises.Count упражнений</p><span class="ref-pill">@card.Goal</span></div></a>}</div></section><section class="ref-panel"><header class="ref-panel-heading"><h2>Активные клиенты</h2><a class="ref-link" asp-page="/Coaching/Clients">Все клиенты <reference-icon name="chevron" /></a></header>@foreach(var client in Model.Clients.Take(5)){var slot=Model.CoachCalendar.FirstOrDefault(s=>s.ClientId==client.Id&&s.Status==WorkoutStatus.Planned);<a class="ref-coach-active-client" asp-route-ClientId="@client.Id" aria-current="@(client.Id==d.Subject.Id?"page":null)"><span class="ref-client-initial">@client.Name[..1]</span><span><strong>@client.Name</strong><small>@(client.LastWorkout?.ToString("d MMM")??"Новый клиент")</small></span><time>@(slot is not null?slot.Date.ToString("d MMM")+" "+slot.Time.ToString("HH:mm"):"По плану")</time></a>}</section></div>
<div class="ref-two-col" style="margin-top:15px"><section class="ref-panel"><header class="ref-panel-heading"><h2>Расписание тренировок</h2><a class="ref-link" asp-page="/Coaching/Calendar">Все тренировки <reference-icon name="chevron" /></a></header>@foreach(var entry in Model.CoachCalendar.Where(s=>s.Date==d.Today)){<a class="ref-history-row" asp-page="/Training/Workouts/Details" asp-route-id="@entry.Id" asp-route-Coach="true"><time>@entry.Time.ToString("HH:mm")</time><span class="ref-client-initial">@entry.ClientName[..1]</span><span><strong>@entry.ClientName</strong><small>@entry.Title</small></span><reference-icon name="@(entry.Status==WorkoutStatus.Completed?"check-circle":"play")" /></a>}@if(!Model.CoachCalendar.Any(s=>s.Date==d.Today)){<p style="font-size:12px;color:var(--ref-muted)">Занятия с назначенным временем появятся здесь.</p>}</section><section class="ref-panel"><header class="ref-panel-heading"><h2>План клиента: @d.Name</h2><a class="ref-link" asp-page="/Training/Plans" asp-route-ClientId="@d.Subject.Id">Все тренировки <reference-icon name="chevron" /></a></header><div class="ref-week-strip" style="margin:0">@for(var i=0;i<7;i++){var date=d.Today.AddDays(-((int)d.Today.DayOfWeek+6)%7+i);var planned=Model.CoachCalendar.Any(s=>s.ClientId==d.Subject.Id&&s.Date==date);<a class="ref-week-day" asp-page="/Training/Plans" asp-route-ClientId="@d.Subject.Id" asp-route-Day="@date.ToString("yyyy-MM-dd")" aria-current="@(date==d.Today?"date":null)"><span>@date.ToString("ddd",DashboardWorkoutsViewModel.Russian)</span><small>@date.Day</small><reference-icon name="@(planned?"workout":"leaf")" /></a>}</div></section></div>

