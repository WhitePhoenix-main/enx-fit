@using enx_fit.Services.Programs
@inject enx_fit.Services.Nutrition.NutritionService Nutrition
@model enx_fit.Pages.Dashboard.DashboardModel
@{var d=Model.Data;var ru=System.Globalization.CultureInfo.GetCultureInfo("ru-RU");var selected=DateOnly.TryParse(Context.Request.Query["Day"],out var date)?date:d.Today;if(selected<d.Today.AddYears(-2)||selected>d.Today.AddYears(2))selected=d.Today;var monday=selected.AddDays(-((int)selected.DayOfWeek+6)%7);var occurrences=Model.WorkoutPrograms.Where(p=>!p.IsArchived).SelectMany(ProgramSchedule.Occurrences).ToArray();var food=await Nutrition.LoadAsync(d.Subject.Id,d.Today);var workout=d.Workouts.FirstOrDefault(w=>w.Date==selected&&w.State!=WorkoutStatus.Cancelled);var occurrence=occurrences.FirstOrDefault(o=>o.Date==selected);var name=workout?.Title??occurrence?.Workout.Name;var count=workout?.WorkoutExercises.Count??occurrence?.Workout.Exercises.Count??0;var minutes=workout?.PlannedMinutes??occurrence?.Workout.EstimatedMinutes??60;}
<header class="ref-heading"><div><h1>План / Календарь</h1><p>Адаптивный план тренировок, отдыха и восстановления</p></div><div class="ref-heading-actions"><a class="ref-secondary" asp-page="/Training/Plans" asp-route-ClientId="@Model.ClientId"><reference-icon name="calendar" />Сегодня</a><a class="ref-icon" asp-route-Day="@selected.AddDays(-7).ToString("yyyy-MM-dd")" asp-route-ClientId="@Model.ClientId" aria-label="Предыдущая неделя">‹</a><strong>@selected.ToString("MMMM yyyy",ru)</strong><a class="ref-icon" asp-route-Day="@selected.AddDays(7).ToString("yyyy-MM-dd")" asp-route-ClientId="@Model.ClientId" aria-label="Следующая неделя">›</a></div></header>
<div class="ref-pro-calendar-summary"><section class="ref-panel"><div class="ref-ring" style="--ref-pct:@d.GoalPercent%"><div><strong>@d.GoalPercent%</strong><small>недельной цели</small></div></div><span><h3>Ваш ритм</h3><strong>@d.ThisWeek.Count() из @d.Settings.WeeklyWorkoutGoal</strong><p>тренировок на этой неделе</p></span></section><section class="ref-panel"><reference-icon name="bars" /><span><h3>Недельная цель</h3><strong>@d.ThisWeek.Count() / @d.Settings.WeeklyWorkoutGoal</strong><p>тренировки</p><div class="ref-meter"><span style="width:@d.GoalPercent%"></span></div></span></section><section class="ref-panel"><reference-icon name="flame" /><span><h3>Калории сегодня</h3><strong>@food.Calories / @food.Settings.Calories</strong><p>ккал в дневнике</p><div class="ref-meter"><span style="width:@Math.Min(100,food.Calories*100/Math.Max(1,food.Settings.Calories))%"></span></div></span></section><a class="ref-panel" asp-page="/Dashboard/Habits" asp-route-ClientId="@Model.ClientId"><reference-icon name="leaf" /><span><h3>Восстановление</h3><strong>@(d.TodayCheckIn.SleepMinutes>0?((d.TodayCheckIn.SleepMinutes/60m).ToString("0.#")+" ч сна"):"Как самочувствие?")</strong><p>@enx_fit.ViewModels.Dashboard.WellbeingViewModel.FeelingName(d.TodayCheckIn.Feeling??0)</p></span></a></div>
<section class="ref-panel"><div class="ref-calendar-toolbar"><nav class="ref-tabs" style="margin:0"><a asp-route-Day="@selected.ToString("yyyy-MM-dd")" asp-route-ClientId="@Model.ClientId" aria-current="page">Неделя</a><a asp-route-View="month" asp-route-Day="@selected.ToString("yyyy-MM-dd")" asp-route-ClientId="@Model.ClientId">Месяц</a><a asp-route-View="list" asp-route-Day="@selected.ToString("yyyy-MM-dd")" asp-route-ClientId="@Model.ClientId">Список</a></nav><strong>@monday.ToString("d",ru) — @monday.AddDays(6).ToString("d MMMM yyyy",ru)</strong><a class="ref-secondary" asp-page="@(Model.IsCoachView?"/Coaching/Calendar":"/Training/Workouts/Create")"><reference-icon name="plus" />Добавить тренировку</a></div><div class="ref-pro-week-cards">@for(var i=0;i<7;i++){var day=monday.AddDays(i);var own=d.Workouts.FirstOrDefault(w=>w.Date==day&&w.State!=WorkoutStatus.Cancelled);var plan=occurrences.FirstOrDefault(o=>o.Date==day);var title=own?.Title??plan?.Workout.Name;var done=own?.State==WorkoutStatus.Completed;<a class="ref-pro-week-card" asp-route-Day="@day.ToString("yyyy-MM-dd")" asp-route-ClientId="@Model.ClientId" aria-current="@(day==selected?"date":null)"><header><span>@day.ToString("ddd",ru)</span><strong>@day.Day</strong></header>@if(title is not null){<design-photo kind="@(title.Contains("ног",StringComparison.OrdinalIgnoreCase)?"squat":"row")" />}else{<span class="ref-pro-rest"><reference-icon name="leaf" /></span>}<strong>@(title??"Отдых")</strong><p>@(done?"Выполнено":title is not null?"По плану":"Восстановление")</p><small><reference-icon name="@(done?"check-circle":"clock")" />@(title is not null?$"{own?.PlannedMinutes??plan?.Workout.EstimatedMinutes??60} мин":"В своём темпе")</small></a>}</div></section>
<div class="ref-pro-calendar-bottom"><section class="ref-panel"><header class="ref-panel-heading"><h2><reference-icon name="workout" />Детали тренировки</h2><span class="ref-pill">@(name is null?"День отдыха":"По плану")</span></header><div class="ref-pro-calendar-detail">@if(name is not null){<design-photo kind="bench-pro" />}else{<span class="ref-pro-rest"><reference-icon name="leaf" /></span>}<div><h2>@(name??"Отдых и восстановление")</h2><p>@selected.ToString("dddd, d MMMM",ru) · @(name is not null?$"{minutes} минут":"В своём темпе")</p>@if(workout is not null){<a class="ref-primary" asp-page="/Training/Workouts/Details" asp-route-id="@workout.Id" asp-route-Coach="@(Model.IsCoachView?"true":null)"><reference-icon name="play" />@(workout.State==WorkoutStatus.Completed?"Результаты":"Открыть тренировку")</a>}else if(occurrence is not null){<a class="ref-primary" asp-page="/Training/Programs/Details" asp-route-id="@occurrence.Workout.TrainingProgramId"><reference-icon name="play" />Начать тренировку</a>}else{<a class="ref-secondary" asp-page="/Dashboard/Habits">Самочувствие и привычки <reference-icon name="arrow" /></a>}<div class="ref-mini-stats"><div><small>Упражнения</small><strong>@count</strong></div><div><small>Длительность</small><strong>@(name is not null?$"{minutes} мин":"—")</strong></div></div></div></div></section><section class="ref-panel"><header class="ref-panel-heading"><h2><reference-icon name="idea" />Умная рекомендация</h2></header><p class="ref-tip"><reference-icon name="target" />@(Model.NextRecommendation?.Reason??(name is not null?"Тренировка из вашего плана. Откройте состав и проверьте рабочие предписания.":"В расписании день отдыха. Можно отметить самочувствие и подготовить следующую тренировку."))</p><a class="ref-history-row" asp-page="/Training/Programs/Index"><reference-icon name="document" /><span><strong>Скорректировать план</strong><small>Программы и расписание</small></span><reference-icon name="chevron" /></a><a class="ref-history-row" asp-page="/Dashboard/Habits"><reference-icon name="leaf" /><span><strong>Восстановление</strong><small>Сон и самочувствие</small></span><reference-icon name="chevron" /></a></section></div>
