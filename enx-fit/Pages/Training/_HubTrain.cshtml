@using enx_fit.ViewModels.Workouts
@model enx_fit.Pages.Training.IndexModel
<partial name="_HubWeek" model="Model" />
<header class="wh-section-heading"><h2>@(Model.SelectedDay==Model.Today?"Сегодня, ":"")@Model.SelectedDay.ToString("d MMMM", Model.Russian)</h2><span>@Model.WeeklyDone из @Model.WeeklyGoal за неделю</span></header>
<div class="wh-athlete-grid"><div class="wh-section-group">
@if(Model.Primary is {} primary){<partial name="_HubWorkoutCard" model="@(new WorkoutHubCardViewModel(Model,primary))" />}
else{<section class="wh-card wh-empty-workout"><reference-icon name="dumbbell-outline" /><h2>@(Model.SelectedDay==Model.Today?"Сегодня без плана":"На этот день нет тренировки")</h2><p>Начните с чистого листа или выберите готовый шаблон.</p>@if(Model.Active is {} active){<a class="wh-primary" asp-page="/Training/Workouts/Details" asp-route-id="@active.Session!.Id">Продолжить текущую <reference-icon name="arrow" /></a>}else{<form method="post" asp-page-handler="Start"><input type="hidden" name="source" value="empty" /><button type="submit" class="wh-primary">Начать тренировку <reference-icon name="arrow" /></button></form>}</section>}
@if(Model.Active is null){<div class="wh-quick-actions"><form method="post" asp-page-handler="Start"><input type="hidden" name="source" value="empty" /><button type="submit"><reference-icon name="bolt" /><span><strong>С нуля</strong><small>Свой набор</small></span><reference-icon name="chevron" /></button></form><a href="@Url.Page(null,Model.Values(view:"templates"))"><reference-icon name="layers" /><span><strong>По шаблону</strong><small>Готовые упражнения</small></span><reference-icon name="chevron" /></a><form method="post" asp-page-handler="Start"><input type="hidden" name="source" value="previous" /><button type="submit" disabled="@(!Model.HasPrevious)"><reference-icon name="repeat" /><span><strong>Повторить</strong><small>Последнюю</small></span><reference-icon name="chevron" /></button></form><a asp-page="/Training/Workouts/Record"><reference-icon name="pencil" /><span><strong>Записать</strong><small>Прошедшую</small></span><reference-icon name="chevron" /></a></div>}
</div><div class="wh-section-group">
@if(Model.Recommendation is {} proposal){<section class="wh-card wh-recommendation"><p class="wh-eyebrow">ДЛЯ СЛЕДУЮЩЕЙ ТРЕНИРОВКИ</p><h2>Предложение по прогрессии</h2><p class="wh-muted">@Model.RecommendationExercise</p><strong class="wh-proposed-weight">@WorkoutHubCard.N(proposal.CurrentValue) → @WorkoutHubCard.N(proposal.SuggestedValue) кг</strong><p class="wh-recommendation-reason">@proposal.Reason</p><a class="wh-text-link" asp-page="/Training/Programs/Details" asp-route-id="@proposal.TrainingProgramId" asp-route-Tab="progression" asp-route-ExerciseId="@proposal.ProgramWorkoutExerciseId">Рассмотреть в программе <reference-icon name="arrow" /></a><small>Изменения — после подтверждения</small></section>}
<section><header class="wh-section-heading"><h2>@(Model.Templates.Any(t=>t.Mine)?"Мои шаблоны":"Готовые шаблоны")</h2><a href="@Url.Page(null,Model.Values(view:"templates"))">Все <reference-icon name="arrow" /></a></header><div class="wh-card">@foreach(var card in Model.Templates.OrderByDescending(t=>t.Mine).Take(2)){<a class="wh-row" asp-page="/Training/Workouts/Templates" asp-route-Selected="@card.Workout.Id"><reference-icon name="dumbbell-outline" /><span><strong>@card.Title</strong><small>@WorkoutHubCard.Count(card.Exercises.Count,"упражнение","упражнения","упражнений")@if(card.Workout.EstimatedMinutes>0){<span> · @card.Workout.EstimatedMinutes мин</span>}</small></span><reference-icon name="chevron" /></a>}@if(Model.Templates.Count==0){<a class="wh-row" asp-page="/Training/Programs/Edit"><reference-icon name="plus" /><span>Создать первый шаблон</span><reference-icon name="chevron" /></a>}</div></section>
@if(Model.Upcoming is {} next&&Model.Primary is null){<section><header class="wh-section-heading"><h2>Далее по плану</h2></header><a class="wh-card wh-row" href="@Url.Page(null,Model.Values(view:"calendar",day:next.Date,month:new(next.Date.Year,next.Date.Month,1)))"><reference-icon name="calendar" /><span><small>@next.Date.ToString("d MMMM · dddd", Model.Russian)</small><strong>@next.Title</strong></span><reference-icon name="chevron" /></a></section>}
</div></div>
