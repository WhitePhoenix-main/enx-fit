@using enx_fit.Services.Programs
@using enx_fit.Services.Dashboard
@model enx_fit.Pages.Dashboard.DashboardModel
@{ var ru=System.Globalization.CultureInfo.GetCultureInfo("ru-RU");
   var selected=DateOnly.TryParse(Context.Request.Query["Day"],out var parsed) ? parsed : Model.Data.Today;
   if(selected<Model.Data.Today.AddYears(-2)||selected>Model.Data.Today.AddYears(2)) selected=Model.Data.Today;
   var monday=selected.AddDays(-((int)selected.DayOfWeek+6)%7);
   var occurrences=Model.WorkoutPrograms.Where(p=>!p.IsArchived).SelectMany(ProgramSchedule.Occurrences).ToList();
   var monthView=Context.Request.Query["View"]=="month";
   var days=monthView ? DateTime.DaysInMonth(selected.Year,selected.Month) : 7;
   var first=monthView ? new DateOnly(selected.Year,selected.Month,1) : monday;
}
<header class="ref-heading"><div><h1>План / Календарь</h1><p>Ваш план тренировок, отдыха и восстановления. Двигайтесь к целям в своём темпе.</p></div><div class="ref-heading-actions"><a class="ref-secondary" asp-page="/Training/Plans" asp-route-ClientId="@Model.ClientId"><reference-icon name="calendar" />Сегодня</a><a class="ref-primary" asp-page="/Training/Workouts/Create"><reference-icon name="plus" />Добавить тренировку</a></div></header>
@if(Model.IsCoachView){<p class="ref-notice">План клиента · @Model.Data.Name</p>}
<div class="ref-calendar-toolbar"><nav class="ref-tabs" style="margin:0" aria-label="Вид календаря"><a asp-page="/Training/Plans" asp-route-Day="@selected.ToString("yyyy-MM-dd")" asp-route-ClientId="@Model.ClientId" aria-current="@(!monthView?"page":null)">Неделя</a><a asp-page="/Training/Plans" asp-route-Day="@selected.ToString("yyyy-MM-dd")" asp-route-View="month" asp-route-ClientId="@Model.ClientId" aria-current="@(monthView?"page":null)">Месяц</a></nav><a class="ref-icon" asp-page="/Training/Plans" asp-route-Day="@(monthView?selected.AddMonths(-1).ToString("yyyy-MM-dd"):selected.AddDays(-7).ToString("yyyy-MM-dd"))" asp-route-View="@(monthView?"month":null)" asp-route-ClientId="@Model.ClientId" aria-label="Предыдущий период">‹</a><h2>@(monthView?selected.ToString("MMMM yyyy",ru):$"{monday:d} – {monday.AddDays(6):d}")</h2><a class="ref-icon" asp-page="/Training/Plans" asp-route-Day="@(monthView?selected.AddMonths(1).ToString("yyyy-MM-dd"):selected.AddDays(7).ToString("yyyy-MM-dd"))" asp-route-View="@(monthView?"month":null)" asp-route-ClientId="@Model.ClientId" aria-label="Следующий период">›</a></div>
<div class="ref-calendar-layout"><div>
<nav class="@(monthView?"ref-calendar-month":"ref-week-strip")" aria-label="Даты календаря">@for(var i=0;i<days;i++){var date=first.AddDays(i);var workout=Model.Data.Workouts.FirstOrDefault(w=>w.Date==date);var occurrence=occurrences.FirstOrDefault(o=>o.Date==date);<a class="ref-week-day @(workout is not null||occurrence is not null?"has-workout":"")" asp-page="/Training/Plans" asp-route-Day="@date.ToString("yyyy-MM-dd")" asp-route-ClientId="@Model.ClientId" aria-current="@(date==selected?"date":null)"><span>@date.ToString("ddd",ru)</span><strong>@date.Day</strong><i></i>@if(monthView){<small>@(workout?.Title??occurrence?.Workout.Name??"Отдых")</small>}</a>}</nav>
<section class="ref-schedule" aria-label="План на неделю">@for(var i=0;i<7;i++){var date=monday.AddDays(i);var sessions=Model.Data.Workouts.Where(w=>w.Date==date&&w.State!=WorkoutStatus.Cancelled).ToList();var planned=occurrences.Where(o=>o.Date==date).ToList();var titles=sessions.Select(w=>w.Title??"Тренировка").Concat(planned.Where(o=>!sessions.Any(w=>w.TrainingProgramId==o.Workout.TrainingProgramId)).Select(o=>o.Workout.Name)).ToList();var session=sessions.FirstOrDefault();var occurrence=planned.FirstOrDefault();var completed=sessions.Any(w=>w.State==WorkoutStatus.Completed);<article class="ref-schedule-row @(date==selected?"is-today":"")"><div class="ref-schedule-day"><strong>@date.ToString("ddd",ru)</strong><small>@date.ToString("d MMM",ru)</small></div>@if(titles.Count>0){<design-photo kind="@(titles[0].Contains("Ног",StringComparison.OrdinalIgnoreCase)?"squat":"bench")" />}else{<span class="ref-rest-photo"><reference-icon name="leaf" /></span>}<div><h3>@(titles.Count>0?string.Join(" · ",titles):"Отдых")</h3><p>@(titles.Count>0?completed?"Тренировка завершена":"По вашему плану":"Восстановление — часть прогресса")</p></div>@if(session is not null){<a class="@(completed?"ref-secondary":"ref-primary")" asp-page="/Training/Workouts/Details" asp-route-id="@session.Id" aria-label="@(completed?"Результаты":"Открыть тренировку")"><reference-icon name="@(completed?"check-circle":"play")" />@(completed?"Результаты":"Открыть")</a>}else if(occurrence is not null){<a class="ref-primary" asp-page="/Training/Programs/Details" asp-route-id="@occurrence.Workout.TrainingProgramId" aria-label="Открыть тренировку программы"><reference-icon name="play" />Открыть</a>}else{<reference-icon name="leaf" />}</article>}</section>
</div><aside class="ref-calendar-aside"><section class="ref-panel"><h2>Ваша неделя</h2><div class="ref-ring" style="--ref-pct:@Model.Data.GoalPercent%"><div><strong>@Model.Data.ThisWeek.Count() / @Model.Data.Settings.WeeklyWorkoutGoal</strong><small>тренировок<br />выполнено</small></div></div></section><section class="ref-panel"><header class="ref-panel-heading"><h2><reference-icon name="idea" />Для стабильности</h2></header><p class="ref-tip"><reference-icon name="calendar" />Планируйте тренировки заранее и оставляйте время для восстановления.</p><p class="ref-tip"><reference-icon name="heart" />Даже короткая тренировка помогает поддерживать привычку.</p><p class="ref-tip"><reference-icon name="bars" />Регулярность важнее идеальности.</p></section><a class="ref-upgrade" asp-page="/Training/Programs/Index"><reference-icon name="document" /><strong>План под вашу цель</strong><small>Готовые программы и управление расписанием</small><span>Выбрать программу <reference-icon name="arrow" /></span></a></aside></div>
