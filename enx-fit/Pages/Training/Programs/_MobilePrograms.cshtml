@using enx_fit.Presentation.Programs
@using enx_fit.ViewModels.Dashboard
@using enx_fit.ViewModels.Programs
@model IndexModel
@{
    var vm = new ProgramsOverviewViewModel(Model);
    string? PageUrl(string? tab = "mine", bool archived = false, string? category = null) => Url.Page("/Training/Programs/Index", new { Tab = tab, Archived = archived, Category = category, Search = tab == "templates" ? Model.Search : null, MaxMinutes = tab == "templates" ? Model.MaxMinutes : null, Level = tab == "templates" ? Model.Level : null, Days = tab == "templates" ? Model.Days : null, MatchPreferences = tab == "templates" && Model.Tab == "templates" ? Model.MatchPreferences : (bool?)null, Reference = Model.Reference ? (bool?)true : null, All = true });
    string Cover(TrainingProgram p) => TrainingPreferences.HasEquipment(p, TrainingEquipment.None) ? "home-session.png" : "strength-session.png";
    var categories = IndexModel.Categories.Select(key => (Key: key, Label: key switch { "Для начинающих" => "Начать", "Дом" => "Дома", "Набор массы" => "Мышцы", "Full Body" => "Всё тело", _ => key })).Prepend((Key: "", Label: "Все"));
}
<div class="ef-mobile-screen native-programs">
    <header class="native-page-title native-discovery-title"><p>Найдите свой ритм</p><h1>Программы<span class="native-title-dot">.</span></h1></header>
    <nav class="native-tabs" aria-label="Разделы программ"><a href="@PageUrl()" class="@(Model.Tab == "mine" ? "active" : "")" aria-current="@(Model.Tab == "mine" ? "page" : null)">Мой план</a><a href="@PageUrl("templates")" class="@(Model.Tab == "templates" ? "active" : "")" aria-current="@(Model.Tab == "templates" ? "page" : null)">Открыть новое</a>@if (Model.Access.IsCoach && !Model.Reference) { <a href="@PageUrl("assigned")" class="@(Model.Tab == "assigned" ? "active" : "")">Клиенты</a> }</nav>
    <div asp-validation-summary="All" class="program-notice error app-status app-notice" data-app-state="error" role="alert"></div>
    @if (Model.ShowUpgrade) { <partial name="_UpgradePrompt" model="@(-1)" /> }
    @if (Model.PageError is not null) { <partial name="_ProgramError" model="Model.PageError" /> }
    else {
        @if (Model.Tab == "templates") {
            <div class="native-discovery-tools"><form method="get" asp-page="Index" role="search" aria-label="Найти готовую программу"><input type="hidden" name="Tab" value="templates" /><input type="hidden" name="MatchPreferences" value="@Model.MatchPreferences.ToString().ToLowerInvariant()" /><input type="hidden" name="Level" value="@Model.Level" /><input type="hidden" name="Days" value="@Model.Days" /><input type="hidden" name="Category" value="@Model.Category" /><input type="hidden" name="MaxMinutes" value="@Model.MaxMinutes" />@if (Model.Reference) { <input type="hidden" name="Reference" value="true" /> }<reference-icon name="search" /><label class="sr-only" for="native-program-search">Название или цель программы</label><input id="native-program-search" type="search" name="Search" maxlength="120" value="@Model.Search" placeholder="Поиск программы" /><button type="submit" aria-label="Найти программу"><reference-icon name="arrow" /></button></form><button type="button" class="native-filter-button" data-dialog="native-program-filters" aria-label="Фильтры программ"><reference-icon name="sliders" />@if (Model.MaxMinutes.HasValue || Model.Level.HasValue || Model.Days.HasValue) { <i aria-label="Есть активные фильтры"></i> }</button></div>
            <nav class="native-categories" aria-label="Направления программ">@foreach (var (key, label) in categories) { <a href="@PageUrl("templates", category: string.IsNullOrEmpty(key) ? null : key)" class="@((Model.Category ?? "") == key ? "active" : "")">@label</a> }</nav>
            @if (Model.MatchPreferences && Model.HasPreferences) { <div class="native-personal-match"><reference-icon name="spark" /><span>Подобрано под вас<small>@TrainingPreferences.LevelTitle(Model.Preferences!.TrainingLevel) · @TrainingPreferences.EquipmentTitle(Model.Preferences.AvailableEquipment)</small></span><a asp-page="/Account/TrainingSetup" asp-route-ReturnTo="profile" aria-label="Изменить условия подбора"><reference-icon name="pencil" /></a></div> }
            <header class="native-section-title"><h2>@(Model.MatchPreferences && Model.HasPreferences ? "Ваш следующий план" : string.IsNullOrEmpty(Model.Category) ? "Выберите направление" : Model.Category)</h2><span>Планов: @Model.Items.Count</span></header>
        }
        @if (vm.Active is { } active) { var p = active.Program;
            <section class="native-active-program"><span class="native-kicker">Сейчас вы здесь</span><h2>@p.Name</h2><div class="native-program-stage"><strong>Неделя @vm.CurrentWeek <small>из @p.Weeks</small></strong><span>@active.Done / @active.Total занятий</span></div><progress max="100" value="@active.Percent" aria-label="Выполнение программы"></progress><a class="native-next-session" asp-page="Details" asp-route-id="@p.Id" asp-route-Tab="schedule"><span>Следующая тренировка<strong>@vm.NextTitle</strong></span><reference-icon name="arrow" /></a><a class="native-primary" asp-page="Details" asp-route-id="@p.Id">Продолжить программу <reference-icon name="arrow" /></a></section>
        }
        <div class="native-program-grid">
            @foreach (var card in vm.Others) { var p = card.Program; var reasons = Model.MatchPreferences ? ProgramDiscovery.Reasons(p, Model.Preferences) : [];
                <article class="native-program-card" data-mobile-program-id="@p.Id">
                    @if (p.IsTemplate) { <button type="button" class="native-program-cover" data-dialog="template-preview-@p.Id" aria-label="Посмотреть программу @p.Name"><img src="~/images/training/@Cover(p)" alt="" loading="lazy" /><span class="native-cover-shade"></span><span class="native-cover-copy"><small>@(string.IsNullOrWhiteSpace(p.Goal) ? "В вашем темпе" : p.Goal)</small><strong>@p.Name</strong></span><span class="native-cover-arrow"><reference-icon name="arrow" /></span></button> }
                    else { <a class="native-program-cover" asp-page="Details" asp-route-id="@p.Id"><img src="~/images/training/@Cover(p)" alt="" loading="lazy" /><span class="native-cover-shade"></span><span class="native-cover-copy"><small>@card.Status</small><strong>@p.Name</strong></span><span class="native-cover-arrow"><reference-icon name="arrow" /></span></a> }
                    <div class="native-program-info"><div class="native-program-metadata"><span>@card.Status</span><span>@p.Weeks нед.</span><span>@p.DaysPerWeek в неделю</span>@if (p.Workouts.Count > 0) { <span>@(p.Workouts.Min(w => w.EstimatedMinutes) == p.Workouts.Max(w => w.EstimatedMinutes) ? p.Workouts[0].EstimatedMinutes.ToString() : $"{p.Workouts.Min(w => w.EstimatedMinutes)}–{p.Workouts.Max(w => w.EstimatedMinutes)}") мин</span> }</div>
                        @if (reasons.Count > 0) { <details class="native-match-reasons"><summary><reference-icon name="check-circle" />Почему подходит вам <reference-icon name="chevron" /></summary><partial name="_ProgramMatchReasons" model="@((p, Model.Preferences))" /></details> }
                        @if (p.IsTemplate) { <div class="native-program-card-actions"><button type="button" data-dialog="template-preview-@p.Id">Состав программы</button><form method="post" asp-page-handler="Duplicate" asp-route-id="@p.Id" asp-route-Tab="templates" data-busy><button type="submit">Выбрать <reference-icon name="plus" /></button></form></div> }
                    </div>
                </article>
            }
        </div>
        @if (vm.Active is null && vm.Others.Count == 0) { <section class="native-catalog-empty"><reference-icon name="calendar" /><h2>@(Model.Archived ? "Архив пока пуст" : Model.Tab == "templates" ? "Попробуем другой план?" : "Ваша программа впереди")</h2><p>@(Model.Tab == "templates" ? "Под эти условия пока нет программ. Измените фильтры или откройте весь каталог." : "Выберите готовую программу — упражнения и расписание уже собраны.")</p>@if (Model.Tab == "templates") { <a class="native-primary" asp-page="Index" asp-route-Tab="templates" asp-route-MatchPreferences="false">Весь каталог <reference-icon name="arrow" /></a> } else { <a class="native-primary" href="@PageUrl("templates")">Найти свой план <reference-icon name="arrow" /></a> }</section> }
        <a class="native-create-program" asp-page="Edit"><reference-icon name="plus" />Составить свою программу</a>
        @if (Model.Tab != "templates") { <a class="native-record-link" href="@PageUrl(Model.Tab, !Model.Archived)"><reference-icon name="archive" />@(Model.Archived ? "Вернуться к программам" : "Архив программ")</a> }
    }
</div>
@if (Model.Tab == "templates") { <dialog id="native-program-filters" class="app-dialog native-filter-sheet app-workspace"><div class="dialog-heading"><h2>Под ваш день</h2><button type="button" class="icon-button" data-close aria-label="Закрыть"><reference-icon name="close" /></button></div><partial name="_ProgramTemplateFilters" model="Model" /></dialog> }
