@using enx_fit.ViewModels.Programs
@using enx_fit.Services.Programs
@model IndexModel
@{var overview=new ProgramsOverviewViewModel(Model);var coach=Model.Access.CanUse(Feature.CoachProgramAssignment);var pro=Model.Access.Plan!=SubscriptionPlan.Free;var hero=overview.Active?.Program??Model.Catalog.FirstOrDefault();var catalog=Model.Tab=="templates"?Model.Items:Model.Catalog;
  string Photo(TrainingProgram p)=>p.Categories.Contains("Дом")?"pushup":p.Name.Contains("Ног",StringComparison.OrdinalIgnoreCase)?"squat":p.Name.Contains("тонус",StringComparison.OrdinalIgnoreCase)?"lateral":"row";
}
<header class="ref-heading"><div><h1>Программы</h1><p>@(coach?"Создавайте, назначайте и управляйте тренировочными программами для своих клиентов.":pro?"Структурированные тренировочные планы. Ваш уровень, цели и прогресс — в центре внимания.":"Готовые планы тренировок для разных целей. Выберите программу и начните тренироваться.")</p></div>@if(coach){<a class="ref-primary" asp-page="Edit"><reference-icon name="plus" />Создать программу</a>}</header>
@if(TempData["StatusMessage"] is string status){<p class="ref-notice" role="status">@status</p>}<div asp-validation-summary="All" role="alert"></div>
<nav class="ref-tabs" aria-label="Разделы программ"><a asp-route-Tab="mine" aria-current="@(Model.Tab=="mine"?"page":null)">@(coach?"Мои клиенты":"Мои программы")</a><a asp-route-Tab="templates" aria-current="@(Model.Tab=="templates"?"page":null)">@(coach?"Шаблоны":"Все программы")</a>@if(coach){<a asp-route-Tab="assigned" aria-current="@(Model.Tab=="assigned"?"page":null)">Назначенные программы</a><a asp-page="/Coaching/Calendar">Календарь</a>}else{<a asp-page="/Training/Plans">План на неделю</a>}<a asp-route-Archived="@(!Model.Archived)" asp-route-Tab="mine">@(Model.Archived?"Текущие":"Архив")</a></nav>
@if(Model.PageError is not null){<partial name="_ProgramError" model="Model.PageError" />}else{
@if(Model.Tab=="templates"){<partial name="_ProgramTemplateFilters" model="Model" />}
@if(coach && Model.Tab!="templates"){
<div class="ref-coach-program-layout"><div><section class="ref-panel"><header class="ref-panel-heading"><h2>Выбор клиента</h2><a class="ref-link" asp-page="/Coaching/Clients">Все клиенты <reference-icon name="arrow" /></a></header><div class="ref-client-strip">@foreach(var client in Model.ClientNames){<a asp-route-SelectedClient="@client.Key" aria-current="@(client.Key==(Model.SelectedClient??Model.ClientPrograms.FirstOrDefault()?.OwnerId)?"true":null)"><span class="ref-client-initial">@client.Value[..1]</span><span><strong>@client.Value</strong><small>Программа назначена</small></span></a>}@if(Model.ClientNames.Count==0){<a asp-page="/Coaching/Clients"><reference-icon name="users" /><span>Добавить клиента</span></a>}</div></section>
<section class="ref-panel" style="margin-top:15px"><header class="ref-panel-heading"><h2>Программы клиентов</h2><span class="ref-pill">@Model.ClientPrograms.Count программ</span></header><div class="ref-client-programs">@foreach(var p in Model.ClientPrograms.Where(p=>Model.SelectedClient==null||p.OwnerId==Model.SelectedClient)){var completion=new ProgramOverviewCard(p,Model.Sessions.GetValueOrDefault(p.Id)??[],"bench");<article class="ref-client-program-row" data-selected="@(p.OwnerId==(Model.SelectedClient??Model.ClientPrograms.FirstOrDefault()?.OwnerId)?"true":"false")"><span class="ref-client-initial">@((Model.ClientNames.GetValueOrDefault(p.OwnerId??"")??"К")[..1])</span><div><strong>@Model.ClientNames.GetValueOrDefault(p.OwnerId??"","Клиент")</strong><small>@p.Goal</small></div><design-photo kind="@Photo(p)" /><div><h3>@p.Name</h3><small>@completion.Done из @completion.Total занятий</small><div class="ref-meter"><span style="width:@completion.Percent%"></span></div></div><span class="ref-pill">@completion.Percent%</span><a class="ref-icon" asp-page="Details" asp-route-id="@p.Id" aria-label="Результаты программы"><reference-icon name="bars" /></a><a class="ref-icon" asp-page="Edit" asp-route-id="@p.Id" aria-label="Редактировать программу"><reference-icon name="pencil" /></a></article>}</div>@if(Model.ClientPrograms.Count==0){<div class="ref-empty"><reference-icon name="users" /><h3>Назначьте первую программу</h3><p>Выберите шаблон или создайте программу для клиента.</p><a class="ref-primary" asp-page="Edit">Создать программу <reference-icon name="plus" /></a></div>}</section>
<header class="ref-panel-heading" style="margin-top:20px"><h2>Мои программы</h2><a class="ref-link" asp-page="Edit">Создать <reference-icon name="plus" /></a></header><div class="ref-program-grid">@foreach(var card in overview.Others.Prepend(overview.Active).Where(c=>c is not null)){<partial name="_ProgramOverviewCard" model="new ProgramOverviewMenu(Model,card!)" />}</div></div>
<aside class="ref-calendar-aside"><section class="ref-panel"><header class="ref-panel-heading"><h2>Шаблоны программ</h2><a class="ref-link" asp-route-Tab="templates">Все <reference-icon name="arrow" /></a></header>@foreach(var p in Model.Catalog.Take(5)){<a class="ref-history-row" asp-page="Assign" asp-route-id="@p.Id"><design-photo kind="@Photo(p)" /><span><strong>@p.Name</strong><small>@p.Weeks недель · @ProgramSchedule.LevelName(p.Level)</small></span><reference-icon name="chevron" /></a>}<a class="ref-secondary" asp-page="Edit" style="margin-top:14px;width:100%"><reference-icon name="plus" />Создать шаблон</a></section><section class="ref-panel"><h2>Статистика программ</h2><div class="ref-mini-stats"><div><reference-icon name="document" /><strong>@Model.ClientPrograms.Count</strong><small>Назначено</small></div><div><reference-icon name="users" /><strong>@Model.ClientNames.Count</strong><small>Клиентов</small></div></div></section></aside></div>
}else{
@if(hero is not null && Model.Tab!="templates" && !Model.Archived){<div class="ref-program-hero-grid"><section class="ref-panel ref-program-hero"><design-photo kind="@Photo(hero)" class="ref-program-hero-photo" /><div class="ref-program-hero-copy"><span class="ref-pill"><reference-icon name="@(pro?"crown":"star")" />@(overview.Active is not null?"Моя программа":"Рекомендуется")</span><h2>@hero.Name @if(!pro){<span class="ref-plan">Free</span>}</h2><p>@(hero.Description??hero.Goal)</p><div class="ref-hero-metrics"><span><reference-icon name="calendar" />@hero.Weeks недель</span><span><reference-icon name="workout" />@hero.DaysPerWeek трен./нед.</span><span><reference-icon name="bars" />@ProgramSchedule.LevelName(hero.Level)</span></div>@if(overview.Active is not null){<a class="ref-primary" asp-page="Details" asp-route-id="@hero.Id">Продолжить программу <reference-icon name="arrow" /></a>}else{<form method="post" asp-page-handler="Duplicate" asp-route-id="@hero.Id"><button class="ref-primary" type="submit">Начать программу <reference-icon name="arrow" /></button></form>}</div></section><section class="ref-panel"><h2>@(overview.Active is not null?"Мой прогресс в программе":"Что вы получите")</h2>@if(overview.Active is {} active){<div class="ref-ring" style="--ref-pct:@active.Percent%;margin:20px auto"><div><strong>@active.Percent%</strong><small>@active.Done из @active.Total<br />тренировок</small></div></div><p style="color:var(--ref-muted);text-align:center">Неделя @overview.CurrentWeek из @hero.Weeks</p>}else{<div class="ref-program-benefits"><p><reference-icon name="check-circle" />Пошаговый план тренировок</p><p><reference-icon name="check-circle" />Техника и подсказки к упражнениям</p><p><reference-icon name="check-circle" />Постепенное изменение нагрузки</p><p><reference-icon name="check-circle" />История ваших результатов</p></div>}</section></div>}
@if(!pro&&Model.Tab!="templates"){<header class="ref-panel-heading" style="margin-top:22px"><h2>Популярные категории</h2></header><nav class="ref-program-categories" aria-label="Категории программ">@foreach(var(key,label,copy,photo,icon) in new[]{("Сила","Сила","Стать сильнее","row","workout"),("Набор массы","Масса","Набор мышечной массы","pullup","muscle"),("Снижение веса","Похудение","Энергия и движение","lunge","flame"),("Дом","Дома","Без оборудования","pushup","home-outline"),("Full Body","Всё тело","Комплексное развитие","squat","user"),("Для начинающих","Для начинающих","Простой старт","incline","star")}){<a asp-route-Tab="templates" asp-route-Category="@key"><design-photo kind="@photo" /><span><reference-icon name="@icon" /><strong>@label</strong><small>@copy</small></span></a>}</nav>}
@if(Model.Tab!="templates"&&overview.Others.Count>0){<header class="ref-panel-heading" style="margin-top:22px"><h2>@(Model.Archived?"Архив программ":"Мои программы")</h2><a class="ref-link" asp-page="Edit">Создать программу <reference-icon name="plus" /></a></header><div class="ref-program-grid">@foreach(var card in overview.Others){<partial name="_ProgramOverviewCard" model="new ProgramOverviewMenu(Model,card)" />}</div>}
@if(!Model.Archived){<header class="ref-panel-heading" style="margin-top:22px"><h2>@(pro?"Рекомендованные программы для вас":"Все программы")</h2><a class="ref-link" asp-route-Tab="templates">Все программы <reference-icon name="arrow" /></a></header><div class="ref-program-grid">@foreach(var p in catalog.Take(Model.Tab=="templates"?int.MaxValue:5)){<article class="ref-workout-card ref-program-card"><design-photo kind="@Photo(p)" /><div><h3>@p.Name</h3><p>@(p.Description??p.Goal)</p><div class="ref-hero-metrics"><span><reference-icon name="calendar" />@p.Weeks недель</span><span><reference-icon name="workout" />@p.DaysPerWeek р./нед.</span></div></div><button class="ref-primary" type="button" data-dialog="template-preview-@p.Id">Подробнее <reference-icon name="arrow" /></button></article>}</div>}
<section class="ref-panel" style="margin-top:16px"><header class="ref-panel-heading"><h2>Ваш план на эту неделю</h2><a class="ref-link" asp-page="/Training/Plans">Открыть календарь <reference-icon name="chevron" /></a></header><div class="ref-week-strip" style="margin-bottom:0">@foreach(var day in overview.Week){<a class="ref-week-day @(day.Training?"has-workout":"")" asp-page="/Training/Plans" asp-route-Day="@day.Date.ToString("yyyy-MM-dd")" aria-current="@(day.Today?"date":null)"><span>@day.Date.ToString("ddd",System.Globalization.CultureInfo.GetCultureInfo("ru-RU"))</span><reference-icon name="@(day.Training?"workout":"leaf")" /><small>@(day.Training?"Тренировка":"Отдых")</small></a>}</div></section>
@if(!pro){<a class="ref-upgrade" asp-page="/Account/Subscription"><reference-icon name="crown" /><strong>Больше программ с Enix Fit Pro</strong><small>Планы под вашу цель, прогрессия нагрузки и расширенная аналитика</small><span>Перейти на Pro <reference-icon name="arrow" /></span></a>}
}
@foreach(var p in catalog.DistinctBy(p=>p.Id)){<partial name="_ProgramTemplatePreview" model="p" />}
}

