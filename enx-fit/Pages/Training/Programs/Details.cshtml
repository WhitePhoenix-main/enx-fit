@page "/Programs/{id:int}"
@using enx_fit.Services.Programs
@using enx_fit.ViewModels.Coaching
@model DetailsModel
@using enx_fit.Models
@{ Layout = "/Pages/Shared/Layouts/_ProgramWorkspaceLayout.cshtml"; ViewData["Title"] = Model.PageError is null ? Model.Item.Name : "Программа недоступна"; }
<div class="programs-page program-schedule-page app-workspace">
@if (TempData["StatusMessage"] is string status) { <div class="program-notice app-status app-notice" data-app-state="saved" role="status">@status</div> }
@if (Model.PageError is not null) { <partial name="_ProgramError" model="Model.PageError" /> }
else
{
    var p = Model.Item;
    @if (ViewData["CoachContext"] is enx_fit.ViewModels.Coaching.CoachContextViewModel clientContext) { <a class="program-back" asp-page="/Coaching/Client" asp-route-id="@clientContext.Id" asp-fragment="client-programs">← Программы клиента</a> } else { <a class="program-back" asp-page="Index">← Программы</a> }
    <header class="page-heading pw-detail-heading"><div><div class="pw-heading"><h1>@p.Name</h1><span class="pw-badge">@Model.Access.Plan</span></div><p>@p.Weeks недель · @p.DaysPerWeek раза в неделю · @ProgramSchedule.LevelName(p.Level)</p></div>
        <div class="program-actions">
        @if (!p.IsArchived && Model.IsOwner)
        {
            @if (!p.StartDate.HasValue) { <a class="pw-link" asp-route-id="@p.Id" asp-route-Tab="schedule">Выбрать дату старта <reference-icon name="calendar" /></a> }
        }
        <details class="program-menu"><summary class="icon-button" aria-label="Действия с программой"><reference-icon name="more" /></summary><div class="program-menu-items">
            @if (!p.IsArchived) { <a asp-page="Edit" asp-route-id="@p.Id">Редактировать</a> }
            <form method="post" asp-page-handler="Duplicate"><button>Дублировать</button></form>
            @if (Model.Access.CanUse(Feature.CoachProgramAssignment) && !p.IsArchived) { <a asp-page="Assign" asp-route-id="@p.Id">Назначить клиенту</a> }
            <form method="post" asp-page-handler="Archive" asp-route-restore="@p.IsArchived"><button>@(p.IsArchived ? "Восстановить" : "Архивировать")</button></form>
        </div></details></div>
    </header>
    @if (p.IsArchived) { <div class="program-notice app-status app-notice" data-app-state="info">Программа в архиве. Восстановите её через меню, чтобы продолжить занятия.</div> }
    @if (p.StartDate.HasValue) { <div class="pw-progress pw-detail-progress"><div><strong>@(p.StartDate > Model.Today ? $"Старт {p.StartDate.Value:dd.MM.yyyy}" : $"Неделя {Math.Clamp((Model.Today.DayNumber - p.StartDate.Value.DayNumber) / 7 + 1, 1, p.Weeks)} из {p.Weeks}")</strong><span>@Model.Done из @Model.Total · @Model.Percent%</span></div><progress max="100" value="@Model.Percent" aria-label="Выполнение программы">@Model.Percent%</progress></div> }
    <nav class="program-tabs" aria-label="Разделы программы">
        @foreach (var tab in new[] { ("overview", "Обзор"), ("schedule", "Расписание"), ("workouts", "Тренировки"), ("progression", "Прогрессия") })
        { <a asp-route-id="@p.Id" asp-route-Tab="@tab.Item1" class="@(Model.Tab == tab.Item1 ? "active" : "")" aria-current="@(Model.Tab == tab.Item1 ? "page" : null)">@tab.Item2</a> }
        @if (Model.Access.IsCoach) { <a asp-route-id="@p.Id" asp-route-Tab="clients" class="@(Model.Tab == "clients" ? "active" : "")" aria-current="@(Model.Tab == "clients" ? "page" : null)">Клиенты</a> }
    </nav>
    <div asp-validation-summary="All" class="program-notice error app-status app-notice" data-app-state="error" role="alert"></div>
    @if (Model.ShowUpgrade) { <partial name="_UpgradePrompt" model="@(-1)" /> }
    @if (Model.Tab == "overview")
    {
        <partial name="_WorkspaceOverview" model="Model" />
    }
    else if (Model.Tab == "schedule")
    {
        <partial name="_ProgramSchedule" model="Model" />
    }
    else if (Model.Tab == "workouts")
    {
        <div class="program-section-heading"><div><h2>Тренировки программы</h2><p class="program-muted">Плановые подходы и нагрузка. Выполненные подходы сохраняются в дневнике.</p></div>@if (!p.IsArchived) { <a class="button secondary" asp-page="Edit" asp-route-id="@p.Id" asp-fragment="workout-editor"><admin-icon name="plus" />Создать тренировку</a> }</div>
        @if (p.Workouts.Count == 0) { <section class="panel empty-state"><h2>Добавьте первую тренировку</h2><p>Соберите упражнения и задайте подходы и повторения в редакторе программы.</p></section> }
        @foreach (var workout in p.Workouts.OrderBy(w => w.Order))
        {
            <details class="panel program-workout" id="workout-@workout.Id"><summary><div><h2>@workout.Name</h2><span>@workout.Exercises.Count упражнений · ≈ @workout.EstimatedMinutes мин</span></div><admin-icon name="chevron" /></summary>
                <div class="program-exercise-list">@foreach (var e in workout.Exercises.OrderBy(e => e.Order)) { <div><strong>@e.Exercise.Name</strong><span>@e.Prescription.Summary</span><small>@(e.Prescription.WeightKg is { } kg ? $"{kg} кг · " : "")@(e.Prescription.Rir is { } rir ? $"RIR {rir}" : "") @(e.Prescription.Rpe is { } rpe ? $"RPE {rpe}" : "") @(e.Prescription.PercentOneRepMax is { } percent ? $"{percent}% 1ПМ" : "")</small>@if (e.Prescription.RestSeconds.HasValue || !string.IsNullOrWhiteSpace(e.Prescription.Comment)) { <p class="program-exercise-note">@(e.Prescription.RestSeconds is { } rest ? $"Отдых {rest} с. " : "")@e.Prescription.Comment</p> }</div> }</div>
                @if (!p.IsArchived) { <div class="program-actions program-workout-footer"><a class="button secondary" asp-page="Edit" asp-route-id="@p.Id" asp-fragment="workout-editor">Редактировать тренировку</a><a class="text-button" asp-page="Edit" asp-route-id="@p.Id" asp-fragment="workout-editor">Добавить упражнение / изменить порядок / дублировать</a></div> }
            </details>
        }
    }
    else if (Model.Tab == "progression")
    { <partial name="_Progression" model="Model" /> }
    else if (Model.Tab == "clients")
    {
        <div class="program-section-heading"><div><h2>Клиенты программы</h2><p class="program-muted">Каждому клиенту назначается самостоятельная копия.</p></div>@if (!p.IsArchived) { <a class="button primary" asp-page="Assign" asp-route-id="@p.Id"><admin-icon name="plus" />Назначить клиенту</a> }</div>
        @if (!Model.Access.CanUse(Feature.CoachProgramAssignment)) { <section class="panel empty-state"><h2>Назначения доступны в Coach</h2><p>Планируйте занятия клиентов и следите за выполнением программы.</p><a class="button secondary" asp-page="/Account/Subscription">Посмотреть Coach</a></section> }
        else if (Model.Clients.Count == 0) { <section class="panel empty-state"><admin-icon name="users" /><h2>Эта программа пока никому не назначена.</h2><p>Выберите клиента и дату начала, чтобы подготовить его программу.</p>@if (!p.IsArchived) { <a class="button secondary" asp-page="Assign" asp-route-id="@p.Id">Назначить клиенту</a> }</section> }
        else
        { <div class="panel program-client-table"><div class="program-client-head"><span>Клиент</span><span>Неделя</span><span>Выполнено</span><span>Последняя тренировка</span><span>Статус</span></div>
            @foreach (var client in Model.Clients) { <a class="program-client-row" asp-page="/Coaching/Client" asp-route-id="@client.Program.OwnerId"><strong>@client.Name</strong><span data-label="Неделя">@ProgramSchedule.CurrentWeek(client.Program) / @client.Program.Weeks</span><span data-label="Выполнено">@client.Percent%</span><span data-label="Последняя тренировка">@(client.Last?.ToString("dd.MM.yyyy") ?? "Ещё нет")</span><span class="program-client-status" data-label="Статус">@client.Status</span></a> }
        </div> }
    }
    @if (Model.Tab == "overview")
    {
        <section class="panel"><h2>История выполнения</h2>
        @if (Model.Sessions.Count == 0) { <p class="program-muted">Начните первую тренировку — здесь появятся ваши занятия и результаты.</p> }
        else { <ul class="program-history">@foreach (var session in Model.Sessions.OrderByDescending(s => s.Date)) { <li><span>@session.Date.ToString("dd.MM.yyyy") · @session.Title</span><span>@(session.State == WorkoutStatus.Cancelled ? "Отменена" : session.State == WorkoutStatus.Completed ? "Завершена" : session.State == WorkoutStatus.Paused ? "На паузе" : "В процессе") · @session.WorkoutExercises.Sum(e => e.SetEntries.Count(s => s.IsCompleted && !s.IsWarmup && s.Reps > 0)) рабочих подходов</span>@if (Model.IsOwner || User.HasMinimumRole(UserRole.Administrator)) { <a asp-page="/Training/Workouts/Details" asp-route-id="@session.Id">Открыть →</a> }</li> }</ul> }
        </section>
    }
}
</div>
@section Styles { <link rel="stylesheet" href="~/css/programs.css" asp-append-version="true" /><link rel="stylesheet" href="~/css/program-schedule.css" asp-append-version="true" /> }
