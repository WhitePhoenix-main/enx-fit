@using System.Globalization
@using enx_fit.Presentation.Exercises
@model enx_fit.ViewModels.Workouts.WorkoutExerciseViewModel
@{ var e = Model.Exercise; var inv = CultureInfo.InvariantCulture; var rest = e.TargetRestSeconds ?? 60; var art = ExercisePhotography.Key(e.Exercise); }
<section class="session-exercise log-exercise qw-exercise" id="exercise-@e.Id" data-catalog-id="@e.ExerciseId" data-entry-id="@e.Id" data-muscle="@e.Exercise.MuscleGroup" data-block-key="@Model.Block.Key" data-block-name="@Model.Block.Name" data-block-kind="@Model.Block.Kind" data-block-type="@Model.Block.Type"
         data-has-record="@((Model.Performance is not null).ToString().ToLowerInvariant())" data-record-weight="@((Model.Performance?.BestWeight ?? 0).ToString(inv))" data-record-volume="@((Model.Performance?.BestSetVolume ?? 0).ToString(inv))" data-record-reps="@(Model.Performance?.BestBodyweightReps ?? 0)">
    <header class="qw-exercise-heading"><span class="log-exercise-number">@Model.Number</span><span class="qw-photo @(art is null ? "qw-photo-fallback" : "qw-photo-" + art)" aria-hidden="true">@if (art is null) { <reference-icon name="workout" /> }</span><div class="qw-exercise-name"><h2><button type="button" data-exercise-history="@e.ExerciseId">@ExercisePresentation.DisplayName(e.Exercise)</button></h2><div class="qw-tags"><span><reference-icon name="muscle" />@e.Exercise.MuscleGroup</span><span>@(art is "lateral" or "curl" ? "Изоляция" : e.Exercise.MuscleGroup == "Кардио" ? "Кардио" : "Сила")</span><span>@(art is "pullup" or "dip" || e.Exercise.Equipment.Contains("Без", StringComparison.OrdinalIgnoreCase) ? "Свой вес" : art is "lateral" or "curl" or null ? e.Exercise.Equipment : "Базовое")</span></div></div>
        <div class="qw-exercise-actions"><button type="button" class="qw-outline-button" data-dialog="exercise-dialog" data-replace-exercise="@e.Id"><reference-icon name="swap" /><span>Заменить</span></button><form method="post" asp-page-handler="Exercise" data-native-order><input name="ExerciseEntryId" type="hidden" value="@e.Id" /><button class="qw-delete" type="submit" name="action" value="remove" aria-label="Удалить: @ExercisePresentation.DisplayName(e.Exercise)"><reference-icon name="trash" /></button></form></div>
        <details class="exercise-menu log-menu qw-exercise-mobile-menu"><summary aria-label="Действия: @ExercisePresentation.DisplayName(e.Exercise)"><reference-icon name="more-vertical" /></summary><div><button type="button" data-dialog="exercise-dialog" data-replace-exercise="@e.Id">Заменить упражнение</button><button type="button" data-exercise-history="@e.ExerciseId">История результатов</button><form method="post" asp-page-handler="Exercise" data-native-order><input name="ExerciseEntryId" type="hidden" value="@e.Id" /><button name="action" value="up" disabled="@(!Model.CanMoveUp)" data-order-disabled="@(!Model.CanMoveUp ? "true" : null)">Переместить выше</button><button name="action" value="down" disabled="@(!Model.CanMoveDown)" data-order-disabled="@(!Model.CanMoveDown ? "true" : null)">Переместить ниже</button><button name="action" value="remove" class="danger-text">Удалить упражнение</button></form></div></details>
    </header>
    <div class="qw-set-head" aria-hidden="true"><span>Подход</span><span>Вес (кг)</span><span>Повторы</span><span></span><span></span></div>
    @foreach (var set in Model.Sets) { <partial name="_LogSet" model="set" /> }
    <form method="post" asp-page-handler="AddSet" class="new-set-form log-add-set"><input name="AddSet.WorkoutExerciseId" type="hidden" value="@e.Id" /><input name="AddSet.SetNumber" type="hidden" value="@Model.NextSetNumber" /><input name="completed" type="hidden" value="false" /><input name="AddSet.RestSeconds" type="hidden" value="@rest" /><input name="AddSet.Weight" type="hidden" value="@Model.NextWeight.ToString(inv)" /><input name="AddSet.Reps" type="hidden" value="@Model.NextReps" />@if (Model.NextIsBodyweight) { <input name="AddSet.IsBodyweight" type="hidden" value="true" /> }<button type="submit"><reference-icon name="plus" />Добавить подход</button></form>
    <div class="qw-exercise-extra"><label class="log-rest-setting"><reference-icon name="clock" /><span>Отдых</span><select data-exercise-rest aria-label="Отдых: @ExercisePresentation.DisplayName(e.Exercise)">@foreach (var seconds in new[] { 0, 30, 60, 90, 120, 180, 300 }.Append(rest).Distinct().Order()) { <option value="@seconds" selected="@(seconds == rest)">@(seconds == 0 ? "Выкл." : $"{seconds} с")</option> }</select></label><button type="button" class="text-button" data-exercise-history="@e.ExerciseId">История</button></div>
    <p class="log-record-badge" data-live-record hidden><reference-icon name="trophy" /><span></span></p>
</section>
