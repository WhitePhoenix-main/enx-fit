@model enx_fit.Models.WorkoutSession
@if (Model.IsActive)
{
    <div class="workout-app-dock app-savebar" data-app-dock hidden>
        <div class="workout-app-dock-info">
            <span data-app-action-caption>Текущее упражнение</span>
            <strong data-app-action-detail>Укажите вес и повторения</strong>
        </div>
        <div class="workout-app-dock-actions">
            <button type="button" class="button workout-app-action" data-app-action>Подход выполнен</button>
        </div>
        <div class="workout-app-rest-tools" data-app-rest-tools hidden>
            <button type="button" class="text-button" data-control="adjust-rest" data-seconds="-15">−15 с</button>
            <button type="button" class="text-button" data-control="adjust-rest" data-seconds="30">+30 с</button>
            <button type="button" class="text-button" data-sound aria-pressed="false">Звук: выкл.</button>
        </div>
    </div>
    <p class="workout-app-feedback" data-app-feedback role="status" aria-live="polite" hidden></p>
}
else if (Model.IsFinished)
{
    <a class="button" asp-page="/Training/Index">К тренировкам
        <admin-icon name="arrow"/>
    </a>
}
