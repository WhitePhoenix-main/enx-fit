@using System.Globalization
@using enx_fit.Presentation.Exercises
@using enx_fit.ViewModels.Workouts
@model enx_fit.ViewModels.Workouts.WorkoutExerciseViewModel
@{ var e=Model.Exercise; var inv=CultureInfo.InvariantCulture; var rest=e.TargetRestSeconds??60; var art=ExercisePhotography.QuickKey(e.Exercise); var name=ExercisePresentation.DisplayName(e.Exercise); var done=e.SetEntries.Count(WorkoutHubCard.Valid); }
<section class="session-exercise log-exercise qw-exercise" id="exercise-@e.Id" data-catalog-id="@e.ExerciseId" data-entry-id="@e.Id" data-muscle="@e.Exercise.MuscleGroup" data-block-key="@Model.Block.Key" data-block-name="@Model.Block.Name" data-block-kind="@Model.Block.Kind" data-block-type="@Model.Block.Type" data-qw-expanded="@(Model.Number==1?"true":"false")"
         data-has-record="@((Model.Performance is not null).ToString().ToLowerInvariant())" data-record-weight="@((Model.Performance?.BestWeight??0).ToString(inv))" data-record-volume="@((Model.Performance?.BestSetVolume??0).ToString(inv))" data-record-reps="@(Model.Performance?.BestBodyweightReps??0)">
    <header class="qw-exercise-heading"><span class="log-exercise-number qs-sr">@Model.Number</span><span class="qw-photo @(art is null?"qw-photo-fallback":"qw-photo-"+art)" aria-hidden="true">@if(art is null){<reference-icon name="dumbbell-outline" />}</span><div class="qw-exercise-name"><h2><button type="button" data-qw-toggle aria-expanded="@(Model.Number==1?"true":"false")" aria-controls="quick-exercise-body-@e.Id">@name</button></h2><small class="qs-exercise-muscle">@e.Exercise.MuscleGroup · @e.Exercise.Equipment</small>@if(e.TargetSets is {} targetSets){<small class="qs-exercise-plan">План: @targetSets × @(e.TargetRepsMin == e.TargetRepsMax ? e.TargetRepsMin?.ToString() ?? "—" : $"{e.TargetRepsMin}–{e.TargetRepsMax}")@if(e.TargetRir is {} targetRir){<span> · RIR @targetRir</span>}</small>}<small class="qs-exercise-summary" data-qw-card-summary>@WorkoutHubCard.Count(done,"подход записан","подхода записано","подходов записано")</small></div><button type="button" class="qs-exercise-chevron" data-qw-toggle aria-label="Развернуть: @name" aria-expanded="@(Model.Number==1?"true":"false")" aria-controls="quick-exercise-body-@e.Id"><reference-icon name="chevron" /></button>
    <details class="exercise-menu log-menu qw-exercise-mobile-menu"><summary aria-label="Действия: @name"><reference-icon name="more-vertical" /></summary><div><button type="button" data-dialog="exercise-dialog" data-replace-exercise="@e.Id">Заменить упражнение</button><button type="button" data-exercise-history="@e.ExerciseId">История результатов</button><button type="button" data-session-notes="@e.Id">Заметки к подходам</button><a asp-page="/Training/Exercises/Details" asp-route-id="@e.ExerciseId" target="_blank" rel="noopener">Описание и техника ↗</a><form method="post" asp-page-handler="Exercise" data-native-order><input name="ExerciseEntryId" type="hidden" value="@e.Id" /><button name="action" value="up" disabled="@(!Model.CanMoveUp)" data-order-disabled="@(!Model.CanMoveUp?"true":null)">Переместить выше</button><button name="action" value="down" disabled="@(!Model.CanMoveDown)" data-order-disabled="@(!Model.CanMoveDown?"true":null)">Переместить ниже</button><button name="action" value="remove" class="danger-text">Удалить упражнение</button></form></div></details></header>
    <div class="qw-exercise-body" id="quick-exercise-body-@e.Id" hidden="@(Model.Number!=1)">
        @if(Model.Block.Kind!="strength" || Model.Blueprint is not null){<p class="ws-block-label">@Model.Block.Type · @Model.Block.Name</p>}
        @if(!string.IsNullOrWhiteSpace(e.Notes) && e.Notes!=Model.Block.Name){<p class="ws-exercise-note">@e.Notes</p>}
        <div class="qw-exercise-extra"><label class="log-rest-setting"><reference-icon name="clock" /><span>Отдых</span><select data-exercise-rest aria-label="Отдых: @name">@foreach(var seconds in new[]{0,30,60,90,120,180,300}.Append(rest).Distinct().Order()){<option value="@seconds" selected="@(seconds==rest)">@(seconds==0?"Выкл.":$"{seconds} с")</option>}</select></label><button type="button" class="text-button" data-exercise-history="@e.ExerciseId"><reference-icon name="chart-outline" />История <reference-icon name="chevron" /></button></div>
        <div class="qw-set-head" aria-hidden="true"><span>№</span><span>Ранее</span><span data-session-weight-heading>кг</span><span>Повт.</span><span>RIR</span><reference-icon name="check" /></div>
        @foreach(var set in Model.Sets){<partial name="_SessionSet" model="set" />}
        <form method="post" asp-page-handler="AddSet" class="new-set-form log-add-set"><input name="AddSet.WorkoutExerciseId" type="hidden" value="@e.Id" /><input name="AddSet.SetNumber" type="hidden" value="@Model.NextSetNumber" /><input name="completed" type="hidden" value="false" /><input name="AddSet.RestSeconds" type="hidden" value="@rest" /><input name="AddSet.Weight" type="hidden" value="@Model.NextWeight.ToString(inv)" /><input name="AddSet.Reps" type="hidden" value="@Model.NextReps" />@if(Model.NextIsBodyweight){<input name="AddSet.IsBodyweight" type="hidden" value="true" />}<button type="submit"><reference-icon name="plus" />Добавить подход</button></form>
        <p class="log-record-badge" data-live-record hidden><reference-icon name="trophy" /><span></span></p>
    </div>
</section>
