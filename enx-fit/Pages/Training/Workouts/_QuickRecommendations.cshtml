@using enx_fit.Presentation.Exercises
@model enx_fit.Pages.Training.Workouts.DetailsModel
@{
    string[] rank = ["squat", "deadlift", "incline", "row", "overhead", "pullup", "dip", "curl"];
    var recent = Model.Library.RecentIds.ToHashSet();
    var featured = rank.Select(key => Model.Library.Exercises.Where(e => ExercisePhotography.Key(e) == key)
        .OrderBy(e => ExercisePresentation.DisplayName(e).Length).ThenBy(e => e.Id).FirstOrDefault()?.Id).ToHashSet();
}
<section class="qw-panel qw-recommendations" aria-labelledby="quick-recommendations-title"><h2 id="quick-recommendations-title">Что добавить дальше?</h2><label class="qw-search"><input type="search" data-qw-search placeholder="Поиск упражнений (например, жим, тяга, присед...)" aria-label="Поиск следующего упражнения" /><reference-icon name="search" /></label><div class="qw-recommendation-tabs" role="group" aria-label="Подбор упражнений"><button type="button" data-qw-tab="recommended" aria-pressed="true">Рекомендуемые</button><button type="button" data-qw-tab="recent" aria-pressed="false">Недавние</button><button type="button" data-qw-tab="favorites" aria-pressed="false">Избранные</button><button type="button" data-qw-tab="all" aria-pressed="false">Все</button></div>
    <div class="qw-suggestions" data-qw-suggestions>
    @foreach (var exercise in Model.Library.Exercises.OrderBy(e => featured.Contains(e.Id) ? Array.IndexOf(rank, ExercisePhotography.Key(e)) : int.MaxValue).ThenBy(ExercisePresentation.DisplayName))
    { var photo = ExercisePhotography.Key(exercise); var name = ExercisePresentation.DisplayName(exercise); <article class="qw-suggestion" data-quick-id="@exercise.Id" data-search="@name @exercise.Name @exercise.MuscleGroup @exercise.Equipment" data-muscle="@exercise.MuscleGroup" data-recent="@recent.Contains(exercise.Id).ToString().ToLowerInvariant()"><span class="qw-photo @(photo is null ? "qw-photo-fallback" : "qw-photo-" + photo)" aria-hidden="true">@if (photo is null) { <reference-icon name="workout" /> }</span><div><strong>@name</strong><div class="qw-tags"><span><reference-icon name="muscle" />@exercise.MuscleGroup</span><span>@(photo is "pullup" or "dip" || exercise.Equipment.Contains("Без", StringComparison.OrdinalIgnoreCase) ? "Свой вес" : photo is "lateral" or "curl" ? "Изоляция" : photo is null ? exercise.Equipment : "Базовое")</span></div></div><button class="qw-suggestion-star" type="button" data-qw-favorite="@exercise.Id" aria-label="В избранное: @name" aria-pressed="false"><reference-icon name="star" /></button><button type="button" class="qw-suggestion-add" data-qw-add="@exercise.Id" aria-label="Добавить: @name"><reference-icon name="plus" /></button></article> }
    </div><p class="qw-suggestions-empty" data-qw-empty hidden>Упражнений по этому запросу нет.</p><p class="qw-suggestions-status" data-qw-add-status role="status" hidden></p><button class="qw-load-more" type="button" data-qw-more hidden>Показать ещё</button><noscript><button type="button" data-dialog="exercise-dialog">Открыть библиотеку упражнений</button></noscript>
</section>
