@using System.Globalization
@using enx_fit.Presentation.Exercises
@inject enx_fit.Security.IFeatureAccessService CurrentAccess
@model enx_fit.ViewModels.Workouts.WorkoutExerciseViewModel
@{var e=Model.Exercise;var inv=CultureInfo.InvariantCulture;var art=ExercisePhotography.Key(e.Exercise);var rest=e.TargetRestSeconds ?? 90;var prior=Model.PreviousResult?.Sets.LastOrDefault();var photo=art ?? (e.Exercise.Name.Contains("Жим гантелей сидя",StringComparison.OrdinalIgnoreCase) ? "overhead" : null); var plan=(await CurrentAccess.GetAsync()).Plan; ViewData["CurrentEffortColumn"]=plan==SubscriptionPlan.Pro; if(photo=="bench") photo=plan==SubscriptionPlan.Coach?"bench-coach":plan==SubscriptionPlan.Pro?"bench-pro":"bench-wide";}
<section class="session-exercise log-exercise cw-exercise" id="exercise-@e.Id" data-catalog-id="@e.ExerciseId" data-entry-id="@e.Id" data-photograph="@art" data-muscle="@e.Exercise.MuscleGroup" data-block-key="@Model.Block.Key" data-block-name="@Model.Block.Name" data-block-kind="@Model.Block.Kind" data-block-type="@Model.Block.Type" data-has-record="@((Model.Performance is not null).ToString().ToLowerInvariant())" data-record-weight="@((Model.Performance?.BestWeight ?? 0).ToString(inv))" data-record-volume="@((Model.Performance?.BestSetVolume ?? 0).ToString(inv))" data-record-reps="@(Model.Performance?.BestBodyweightReps ?? 0)">
    <header class="cw-exercise-heading"><span class="log-exercise-number">@Model.Number</span><div><h2><button type="button" data-exercise-history="@e.ExerciseId">@ExercisePresentation.DisplayName(e.Exercise)</button></h2><span class="cw-muscle"><reference-icon name="muscle" />@e.Exercise.MuscleGroup</span></div><button type="button" class="cw-expand" data-cw-expand="@e.Id" aria-label="Открыть упражнение"><reference-icon name="chevron" /></button><button class="qw-outline-button cw-desktop-notes" type="button" data-cw-notes="@e.Id" data-dialog="current-notes-dialog"><reference-icon name="pencil" />Заметки</button><details class="exercise-menu log-menu"><summary aria-label="Действия: @ExercisePresentation.DisplayName(e.Exercise)"><reference-icon name="more-vertical" /></summary><div><button type="button" data-dialog="exercise-dialog" data-replace-exercise="@e.Id">Заменить упражнение</button><button type="button" data-cw-notes="@e.Id" data-dialog="current-notes-dialog">Заметки к подходам</button><form method="post" asp-page-handler="Exercise" data-native-order><input name="ExerciseEntryId" type="hidden" value="@e.Id" /><button name="action" value="up" disabled="@(!Model.CanMoveUp)" data-order-disabled="@(!Model.CanMoveUp ? "true":null)">Переместить выше</button><button name="action" value="down" disabled="@(!Model.CanMoveDown)" data-order-disabled="@(!Model.CanMoveDown ? "true":null)">Переместить ниже</button><button name="action" value="remove" class="danger-text">Удалить упражнение</button></form></div></details></header>
    <div class="cw-exercise-body"><div class="cw-photo @(photo is null ? "cw-photo-empty" : "cw-photo-"+photo)" aria-hidden="true">@if(photo is null){<reference-icon name="workout" />}else{<design-photo kind="@photo" />}</div><div class="cw-exercise-log"><div class="cw-prior"><span><reference-icon name="crown" />@(prior is null ? "Предыдущего результата пока нет" : $"Предыдущая: {(prior.IsBodyweight ? "Свой вес" : prior.Weight.ToString("0.##")+" кг")} × {prior.Reps}")</span><button class="qw-outline-button" type="button" data-exercise-history="@e.ExerciseId"><reference-icon name="clock" />История</button><button class="qw-outline-button cw-mobile-notes" type="button" data-cw-notes="@e.Id" data-dialog="current-notes-dialog"><reference-icon name="pencil" />Заметки</button></div>
    <div class="cw-set-head" aria-hidden="true"><span>Подход</span><span>Пред. результат</span><span>Цель</span><span>Вес (кг)</span><span>Повторения</span>@if(plan==SubscriptionPlan.Pro){<span>RIR</span>}<span>✓</span><span></span></div>
    @foreach(var set in Model.Sets){<partial name="_LogSet" model="set" />}
    @if(plan==SubscriptionPlan.Pro){<button class="ref-primary cw-complete-set" type="button" data-complete-exercise-set="@e.Id"><reference-icon name="check" />Завершить сет</button>}
    <form method="post" asp-page-handler="AddSet" class="new-set-form log-add-set"><input name="AddSet.WorkoutExerciseId" type="hidden" value="@e.Id" /><input name="AddSet.SetNumber" type="hidden" value="@Model.NextSetNumber" /><input name="completed" type="hidden" value="false" /><input name="AddSet.RestSeconds" type="hidden" value="@rest" /><input name="AddSet.Weight" type="hidden" value="@Model.NextWeight.ToString(inv)" /><input name="AddSet.Reps" type="hidden" value="@Model.NextReps" />@if(Model.NextIsBodyweight){<input name="AddSet.IsBodyweight" type="hidden" value="true" />}<button type="submit"><reference-icon name="plus" />Добавить подход</button></form></div></div><p class="log-record-badge" data-live-record hidden><reference-icon name="trophy" /><span></span></p>
</section>

