@model enx_fit.Pages.Training.Workouts.DetailsModel
@{ var adjustment=ViewData["CurrentWorkout"] is true?(Model.CoachMode?10:30):15; }
<section class="qw-panel qw-rest-panel" data-rest-panel aria-labelledby="quick-rest-title">
    <header class="qw-section-heading"><h2 id="quick-rest-title">Таймер отдыха</h2><button type="button" class="qw-settings" data-dialog="quick-rest-settings-dialog" aria-label="Настройки таймера"><reference-icon name="settings" /></button></header>
    <div class="qw-timer-tabs" role="group" aria-label="Режим таймера"><button type="button" data-qw-mode="timer" aria-pressed="true">Таймер</button><button type="button" data-qw-mode="stopwatch" aria-pressed="false"><reference-icon name="repeat" />Секундомер</button></div>
    <div class="qw-timer-body"><div class="qw-timer-ring" data-qw-ring style="--rest-progress:75%"><div><strong data-rest-clock aria-live="off">01:00</strong><span data-rest-caption>Отдых</span></div></div>
    <div class="qw-timer-controls"><div class="qw-presets" role="group" aria-label="Продолжительность отдыха">@foreach (var seconds in new[] { 30, 60, 90, 120 }) { <button type="button" data-qw-preset="@seconds" aria-pressed="@(seconds == 60 ? "true" : "false")">@seconds<span> сек</span></button> }</div><div class="qw-adjust"><button type="button" data-qw-adjust="@(-adjustment)">−@adjustment <span>сек</span></button><button type="button" data-qw-adjust="@adjustment">+@adjustment <span>сек</span></button></div><div class="qw-timer-play-row"><button type="button" class="qw-play" data-qw-timer-toggle data-control="start-rest" data-seconds="60" aria-label="Запустить таймер отдыха"><reference-icon name="play" /></button><button type="button" class="qw-skip-rest" data-control="skip-rest" data-qw-timer-skip><reference-icon name="skip" /><span>Пропустить</span></button></div></div></div>
    <p class="qw-timer-hint"><reference-icon name="info" /><span>Настройте время отдыха под себя<small>Изменения применяются только<br />для текущей тренировки.</small></span></p>
</section>
<dialog class="app-dialog" id="quick-rest-settings-dialog"><div class="dialog-heading"><h2>Настройки отдыха</h2><button type="button" data-close aria-label="Закрыть"><reference-icon name="close" /></button></div><p>Время по умолчанию будет применено к незавершённым подходам этой тренировки.</p><form method="post" asp-page-handler="SessionRest" data-qw-rest-form><label>Продолжительность, секунды<input name="seconds" type="number" min="0" max="900" required value="@(Model.Workout.WorkoutExercises.OrderBy(e => e.Order).FirstOrDefault()?.TargetRestSeconds ?? 60)" /></label><p data-qw-rest-status role="status" hidden></p><button class="button" type="submit">Сохранить</button></form><button type="button" class="qw-sound-button" data-sound aria-pressed="false">Звук: выкл.</button></dialog>
