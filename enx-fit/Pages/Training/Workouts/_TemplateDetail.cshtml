@using enx_fit.Presentation.Exercises
@model enx_fit.ViewModels.Workouts.WorkoutTemplateDetails
@{ var card=Model.Card; }
<section class="tc-detail-content" data-template-detail="@card.Workout.Id" hidden="@(ViewData["SelectedTemplate"] is not int selected || selected != card.Workout.Id)">
    <div class="tc-detail-scroll">
    <div class="tc-detail-hero"><partial name="_TemplatePhoto" model="card.Photo" /><span class="tc-card-badge">@(card.Mine ? "Мой шаблон":"Готовая тренировка")</span><button class="tc-bookmark" type="button" data-template-favorite="@card.Workout.Id" aria-label="В избранное: @card.Title" aria-pressed="false"><reference-icon name="bookmark" /></button></div>
    <header class="tc-detail-heading"><h2>@card.Title</h2><p>@(card.Program.Description ?? card.Goal)</p><div class="tc-detail-metrics"><span><reference-icon name="clock" />@card.Workout.EstimatedMinutes мин</span><span>@card.Exercises.Count упражнений</span><span><reference-icon name="bars" />@card.Level</span></div></header>
    <form method="post" asp-page-handler="Start" class="tc-start tc-start-desktop"><input name="templateId" type="hidden" value="@card.Workout.Id" /><button class="qw-add-primary" type="submit"><span>Начать тренировку <reference-icon name="arrow" /></span></button></form>
    <div class="tc-detail-actions"><form method="post" asp-page-handler="Copy"><input name="templateId" type="hidden" value="@card.Workout.Id" /><button name="edit" value="true" class="qw-outline-button"><reference-icon name="pencil" />Редактировать</button></form><form method="post" asp-page-handler="Copy"><input name="templateId" type="hidden" value="@card.Workout.Id" /><button class="qw-outline-button"><reference-icon name="copy" />Дублировать</button></form><button class="qw-outline-button" type="button" data-template-favorite="@card.Workout.Id" aria-pressed="false"><reference-icon name="heart" />В избранное</button></div>
    @if(card.Reasons.Count > 0) { <section class="tc-reasons"><h3>Почему тебе подходит</h3>@foreach(var reason in card.Reasons) { <p><reference-icon name="check-circle" />@reason</p> }</section> }
    <nav class="tc-detail-tabs" aria-label="Описание шаблона"><button type="button" data-template-panel="exercises" aria-pressed="true">Упражнения</button><button type="button" data-template-panel="about" aria-pressed="false">О программе</button><button type="button" data-template-panel="similar" aria-pressed="false">Похожие</button></nav>
    <section data-template-panel-content="exercises"><div class="tc-equipment"><h3>Оборудование</h3><div>@foreach(var equipment in card.Equipment) { <span title="@equipment.Description"><reference-icon name="workout" />@equipment.Name</span> }</div></div><div class="tc-exercises"><h3>Упражнения (@card.Exercises.Count)</h3>@foreach(var row in card.Exercises.Select((exercise,index)=>(exercise,index))) { var photo=ExercisePhotography.Key(row.exercise.Exercise); <article><span class="tc-exercise-number">@(row.index+1)</span><span class="qw-photo @(photo is null ? "qw-photo-fallback" : "qw-photo-"+photo)" aria-hidden="true">@if(photo is null){<reference-icon name="workout" />}</span><div><strong>@ExercisePresentation.DisplayName(row.exercise.Exercise)</strong><small>@row.exercise.Prescription.Summary · @row.exercise.Exercise.MuscleGroup</small></div></article> }</div></section>
    <section class="tc-about" data-template-panel-content="about" hidden><h3>@card.Program.Name</h3><p>@(card.Program.Description ?? "Состав и нагрузку можно менять во время занятия.")</p><p>Цель: @card.Goal</p><p>Уровень: @card.Level</p><p>Изменения текущего занятия сохраняются в дневник. Оригинал шаблона остаётся доступен для следующей тренировки.</p><a asp-page="/Training/Programs/Details" asp-route-id="@card.Program.Id">Открыть программу <reference-icon name="arrow" /></a></section>
    <section class="tc-similar" data-template-panel-content="similar" hidden>@foreach(var other in Model.Similar) { <button type="button" data-template-select="@other.Workout.Id"><partial name="_TemplatePhoto" model="other.Photo" /><span><strong>@other.Title</strong><small>@other.Workout.EstimatedMinutes мин · @other.Exercises.Count упражнений</small></span><reference-icon name="chevron" /></button> }@if(Model.Similar.Count==0){<p>Похожие шаблоны пока не добавлены.</p>}</section>
    </div>
    <form method="post" asp-page-handler="Start" class="tc-start tc-start-mobile"><input name="templateId" type="hidden" value="@card.Workout.Id" /><button class="qw-add-primary" type="submit"><span>Начать тренировку <reference-icon name="arrow" /></span></button></form>
</section>
