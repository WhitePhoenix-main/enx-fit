@inject enx_fit.Security.IFeatureAccessService TemplateAccess
@model enx_fit.ViewModels.Workouts.WorkoutTemplateCard
@{var access=await TemplateAccess.GetAsync();var coach=access.CanUse(Feature.CoachProgramAssignment);}
<article class="tc-card @(coach?"tc-card-coach":"") @(Model.Mine ? "tc-card-mine":"")" data-template-card="@Model.Workout.Id" data-mine="@Model.Mine.ToString().ToLowerInvariant()" data-uses="@Model.Uses" data-search="@Model.Search" data-focus="@Model.Focus" data-home="@Model.Home.ToString().ToLowerInvariant()" data-level="@Model.Program.Level.ToString().ToLowerInvariant()" data-goal="@Model.Goal" data-duration="@Model.Workout.EstimatedMinutes">
    <button class="tc-card-open" type="button" data-template-select="@Model.Workout.Id" aria-pressed="false"><partial name="_TemplatePhoto" model="Model.Photo" /><span class="tc-card-copy"><strong>@Model.Title</strong><small class="tc-program-name">@Model.Program.Name</small>@if(coach){<span class="tc-coach-meta"><span>@Model.Goal</span><span>@Model.Level</span><span>@Model.Program.Weeks недель</span><span>@Model.Program.DaysPerWeek трен./нед.</span></span>}<span class="tc-card-metrics"><span><reference-icon name="clock" />@Model.Workout.EstimatedMinutes мин</span><span><reference-icon name="bars" />@Model.Level</span><span><reference-icon name="workout-outline" />@Model.Exercises.Count упражнений</span></span></span></button>
    <span class="tc-card-badge">@(Model.Mine ? "Мой шаблон" : Model.Home ? "Для дома" : Model.Goal.Contains("сил",StringComparison.OrdinalIgnoreCase) ? "Сила" : "Для зала")</span><button class="tc-bookmark" type="button" data-template-favorite="@Model.Workout.Id" aria-label="В избранное: @Model.Title" aria-pressed="false"><reference-icon name="bookmark" /></button>
    @if(coach){<a class="ref-primary tc-card-assign" asp-page="/Training/Programs/Assign" asp-route-id="@Model.Program.Id">Назначить клиенту <reference-icon name="arrow" /></a>}else if (!Model.Mine) { <form class="tc-card-start" method="post" asp-page-handler="Start"><input type="hidden" name="templateId" value="@Model.Workout.Id" /><button class="ref-primary" type="submit">Начать шаблон <reference-icon name="arrow" /></button></form> }
</article>


