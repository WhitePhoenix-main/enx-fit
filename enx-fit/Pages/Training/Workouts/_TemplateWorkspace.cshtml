@model enx_fit.Pages.Training.Workouts.TemplatesModel
@if(Model.Access.Plan==SubscriptionPlan.Pro){<div class="tc-personal-workspace"><section class="ref-panel tc-collections"><header class="ref-panel-heading"><h2><reference-icon name="star" />Мои коллекции</h2><button class="ref-link" type="button" data-dialog="template-collection-dialog">Создать <reference-icon name="plus" /></button></header><p>Группируйте шаблоны по целям, сезонам или этапам.</p><div class="tc-collection-grid">@foreach(var collection in Model.Collections){var cards=Model.Cards.Where(c=>collection.WorkoutIds.Contains(c.Workout.Id)).ToArray();<article class="tc-collection"><button type="button" data-template-collection="@string.Join(",",cards.Select(c=>c.Workout.Id))"><reference-icon name="layers" /><strong>@collection.Name</strong><small>@cards.Length шаблонов</small></button><form method="post" asp-page-handler="DeleteCollection"><input type="hidden" name="id" value="@collection.Id" /><button type="submit" aria-label="Удалить коллекцию @collection.Name"><reference-icon name="close" /></button></form></article>}<button class="tc-collection tc-collection-create" type="button" data-dialog="template-collection-dialog"><reference-icon name="plus" /><span>Создать<br />коллекцию</span></button></div></section><section class="ref-panel tc-favorites-panel"><header class="ref-panel-heading"><h2><reference-icon name="heart" />Избранные шаблоны</h2><button class="ref-link" type="button" data-template-tab="favorites">Все <reference-icon name="chevron" /></button></header><div data-template-favorite-list></div></section><section class="ref-panel tc-stats-panel"><header class="ref-panel-heading"><h2><reference-icon name="bars" />Статистика шаблонов</h2></header><div><span>Использовано шаблонов</span><strong>@Model.Cards.Sum(c=>c.Uses)</strong></div><div><span>Создано собственных</span><strong>@Model.Cards.Count(c=>c.Mine)</strong></div><div><span>Мои коллекции</span><strong>@Model.Collections.Count</strong></div></section></div>}
else if(Model.Access.CanUse(Feature.CoachProgramAssignment)){<section class="ref-panel tc-coach-stats"><header class="ref-panel-heading"><h2>Статистика шаблонов</h2></header><div class="ref-coach-summary">@foreach(var(label,value,icon)in new[]{("Всего шаблонов",Model.Cards.Count,"layers"),("Мои шаблоны",Model.Cards.Count(c=>c.Mine),"document"),("Тренировок по шаблонам",Model.Cards.Sum(c=>c.Uses),"users"),("Упражнений в шаблонах",Model.Cards.SelectMany(c=>c.Exercises).Select(e=>e.ExerciseId).Distinct().Count(),"workout")}){<div class="ref-panel"><reference-icon name="@icon" /><small>@label</small><strong>@value</strong></div>}</div></section>}
else{<section class="ref-panel tc-premium-sets"><header class="ref-panel-heading"><h2><reference-icon name="crown" />Премиум-наборы шаблонов</h2><a class="ref-link" asp-page="/Account/Subscription">Все наборы Pro <reference-icon name="chevron" /></a></header><div class="ref-progress-locks">@foreach(var(title,copy,photo)in new[]{("Мышечная масса","Планы и прогрессия нагрузки для роста мышц.","row"),("Сжигание жира","Разнообразные тренировки для вашей цели.","lunge"),("Фулбоди коллекция","Универсальные тренировки на всё тело.","pushup")}){<a class="ref-progress-lock ref-panel" asp-page="/Account/Subscription"><design-photo kind="@photo" class="tc-premium-photo" /><span class="ref-pill"><reference-icon name="crown" />Pro</span><h2>@title</h2><p>@copy</p><span class="ref-secondary">Доступно в Pro <reference-icon name="chevron" /></span><reference-icon name="lock" class="ref-lock" /></a>}</div></section>}
@if(Model.Access.Plan!=SubscriptionPlan.Free){<dialog class="app-dialog" id="template-collection-dialog"><div class="dialog-heading"><h2>Создать коллекцию</h2><button type="button" data-close aria-label="Закрыть"><reference-icon name="close" /></button></div><form method="post" asp-page-handler="Collection" class="tc-collection-form"><label>Название коллекции<input name="name" maxlength="60" required placeholder="Например, домашние тренировки" /></label><fieldset><legend>Шаблоны коллекции</legend>@foreach(var card in Model.Cards){<label><input type="checkbox" name="templateIds" value="@card.Workout.Id" /><span>@card.Title</span></label>}</fieldset><button class="ref-primary" type="submit">Создать коллекцию <reference-icon name="plus" /></button></form></dialog>}
