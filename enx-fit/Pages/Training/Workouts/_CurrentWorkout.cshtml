@using System.Text.Json
@using enx_fit.ViewModels.Workouts
@model enx_fit.Pages.Training.Workouts.DetailsModel
@{ var w=Model.Workout; var rest=w.WorkoutExercises.OrderBy(e=>e.Order).FirstOrDefault()?.TargetRestSeconds ?? 90; }
<div class="cw-session" data-training-log data-quick-workout data-current-workout data-active-workout data-session-id="@w.Id" data-viewer="@Model.ViewerId" data-session-status="@w.State" data-default-rest="@rest" data-workouts-url="@Url.Page("/Training/Index")">
    <script id="workout-execution-state" type="application/json">@Html.Raw(JsonSerializer.Serialize(Model.Execution,WorkoutBuilderInput.JsonOptions))</script>
    <header class="cw-heading"><div class="cw-title"><h1>Текущая тренировка</h1><div><h2>@w.Title</h2><span>Силовая тренировка</span></div></div><div class="cw-top-metrics"><div><reference-icon name="stopwatch" /><span><strong data-session-clock>00:00:00</strong><small>Прошло времени</small></span></div><div><reference-icon name="workout" /><span><strong data-cw-exercise-progress>0 из @Model.Exercises.Count</strong><small>Упражнений</small></span></div><div><span class="cw-progress-ring" data-cw-progress-ring></span><span><strong data-cw-progress>0%</strong><small>Прогресс</small></span></div></div><button class="qw-finish cw-finish" type="button" data-dialog="finish-workout-dialog" data-finish disabled><reference-icon name="stop" />Завершить тренировку</button></header>
    <div class="qw-sync-row"><span class="execution-sync" data-sync-status role="status" aria-live="polite">Все изменения сохранены</span><button class="text-button" type="button" data-control="pause" data-pause-button>Пауза</button></div>
    @if(TempData["StatusMessage"] is string message){<p class="qw-notice" role="status">@message</p>}
    <div asp-validation-summary="All" class="validation-message" role="alert"></div>
    <button type="button" class="button secondary" data-reconcile hidden>Применить мои изменения к текущей версии</button><button class="text-button" type="button" data-discard-operation hidden>Убрать отклонённое действие из очереди</button><p class="qw-notice" data-pause-notice hidden>Тренировка на паузе. Продолжите, чтобы записывать подходы.</p>
    @if(Model.CoachMode){<section class="ref-coach-execution-context"><div class="ref-panel"><span class="ref-client-initial">@Model.OwnerName[..1]</span><span><small>Клиент</small><strong>@Model.OwnerName</strong></span><a class="ref-link" asp-page="/Coaching/Client" asp-route-id="@w.UserId">Профиль <reference-icon name="chevron" /></a></div><div class="ref-panel"><small>Назначенная тренировка</small><strong>@w.Title</strong><p>@Model.Exercises.Count упражнений · @(w.PlannedMinutes??60) мин</p></div><div class="ref-panel"><small>Связь с клиентом</small><a class="ref-primary" asp-page="/Coaching/Messages" asp-route-ContactId="@w.UserId">Отправить обратную связь <reference-icon name="message" /></a></div></section>}
    <div class="cw-layout">@if(Model.CoachMode){<nav class="ref-coach-execution-outline ref-panel" aria-label="Упражнения тренировки"><h2>Упражнения (@Model.Exercises.Count)</h2>@foreach(var item in Model.Exercises){<button type="button" data-cw-expand="@item.Exercise.Id"><span>@item.Number</span><design-photo kind="@(enx_fit.Presentation.Exercises.ExercisePhotography.Key(item.Exercise.Exercise)??"row")" /><strong>@enx_fit.Presentation.Exercises.ExercisePresentation.DisplayName(item.Exercise.Exercise)</strong><small>@item.Exercise.SetEntries.Count(s=>s.IsCompleted)/@item.Exercise.SetEntries.Count</small></button>}</nav>}<section class="cw-exercises-column"><div data-exercises-heading hidden><span data-exercise-total>@Model.Exercises.Count</span></div><div class="session-exercises">@foreach(var exercise in Model.Exercises){<partial name="_CurrentExercise" model="exercise" />}</div>
        <div class="workout-empty qw-empty" hidden="@(Model.Exercises.Count>0)"><h2>Добавьте упражнение</h2><p>Выберите движения для текущей тренировки.</p><button class="button" type="button" data-dialog="exercise-dialog" data-add-exercise>Выбрать упражнения</button></div>
        <nav class="cw-workout-tools" aria-label="Действия тренировки"><button type="button" data-dialog="exercise-dialog" data-add-exercise><reference-icon name="plus-circle" /><span><strong>Добавить упражнение</strong><small>Выберите из базы или добавьте своё</small></span></button><button type="button" data-dialog="exercise-dialog" data-replace-exercise data-cw-replace><reference-icon name="swap" />Заменить упражнение</button><button type="button" data-dialog="current-order-dialog" data-cw-order-open><reference-icon name="sliders" />Изменить порядок</button><details class="log-menu"><summary aria-label="Дополнительные действия"><reference-icon name="more" /></summary><div><a asp-page="./Edit" asp-route-id="@w.Id">Название и заметки</a><button class="danger-text" type="button" data-dialog="cancel-workout-dialog">Отменить тренировку</button></div></details></nav>
    </section><aside class="cw-aside" data-cw-aside><partial name="_QuickRestTimer" model="Model" /><section class="cw-next qw-panel"><header><h2>Далее в тренировке</h2><button class="text-button" type="button" data-cw-show-all>Показать все</button></header><nav data-cw-next aria-label="Следующие упражнения"></nav></section><p class="cw-tip"><reference-icon name="spark" /><span><strong>Совет</strong>Держите технику. Комфортный вес и чистые повторения помогают двигаться вперёд.</span></p></aside></div>
    @if(Model.CoachMode){<button class="ref-primary ref-coach-complete-set" type="button" data-coach-complete-set><reference-icon name="check" />Отметить подход как выполненный</button>}
    <div hidden aria-hidden="true"><span data-log-volume></span><span data-log-done></span><span data-log-total></span><nav data-log-outline></nav></div><p class="log-toast" data-log-toast role="status" hidden></p>
</div>
<partial name="_LogDialogs" model="Model" /><partial name="_LogHistoryDialog" />
<dialog class="app-dialog" id="current-notes-dialog"><div class="dialog-heading"><h2 data-cw-notes-title>Заметки к упражнению</h2><button type="button" data-close aria-label="Закрыть"><reference-icon name="close" /></button></div><p>Заметки сохраняются вместе с соответствующим подходом.</p><div data-cw-notes-fields></div><button class="button" type="button" data-cw-notes-save>Сохранить заметки</button></dialog>
<dialog class="app-dialog" id="current-order-dialog"><div class="dialog-heading"><h2>Порядок упражнений</h2><button type="button" data-close aria-label="Закрыть"><reference-icon name="close" /></button></div><p>Переставляйте упражнения внутри одного блока.</p><ol data-cw-order-list></ol><p data-cw-order-status role="status" hidden></p><button class="button" type="button" data-cw-order-save>Сохранить порядок</button></dialog>


