@using enx_fit.ViewModels.Workouts
@model enx_fit.Pages.Training.IndexModel
<div class="wh-agenda" data-coach-agenda>
<header class="wh-section-heading wh-agenda-date"><h2>@(Model.SelectedDay==Model.Today?"Сегодня, ":"")@Model.SelectedDay.ToString("d MMMM", Model.Russian)</h2><a class="wh-icon-button" href="@Url.Page(null,Model.Values(view:"calendar"))" aria-label="Открыть календарь"><reference-icon name="calendar" /></a></header>
<form method="get" class="wh-client-filter"><input type="hidden" name="View" value="@Model.View" /><input type="hidden" name="Day" value="@Model.SelectedDay.ToString("yyyy-MM-dd")" /><label><reference-icon name="search" /><span class="wh-sr">Выбор клиента</span><select name="ClientId" data-hub-submit><option value="">Все клиенты</option>@foreach(var client in Model.Clients){<option value="@client.Id" selected="@(client.Id==Model.ClientId)">@client.Name</option>}</select><reference-icon name="chevron-down" /></label><noscript><button type="submit">Применить</button></noscript></form>
<div class="wh-agenda-stats wh-card"><div><strong>@Model.Agenda.Count</strong><small>@WorkoutHubCard.Noun(Model.Agenda.Count,"занятие","занятия","занятий")</small></div><div><strong>@Model.Agenda.Count(w=>w.Completed)</strong><small>завершено</small></div><div><strong>@Model.Agenda.Count(w=>w.Active)</strong><small>идёт</small></div></div>
<button class="wh-primary wh-assign" type="button" data-hub-dialog="hub-appointment" disabled="@(Model.Clients.Count==0||Model.AssignmentChoices.Count==0)"><reference-icon name="plus" />Назначить тренировку</button>
<header class="wh-section-heading"><h2>@(Model.SelectedDay==Model.Today?"Расписание на сегодня":"Расписание на день")</h2></header>
<div class="wh-agenda-list">@foreach(var w in Model.Agenda){<article class="wh-card wh-appointment @(w.Active?"is-active":"")"><time>@(w.Session!.ScheduledTime?.ToString("HH:mm")??"—")</time><span class="wh-avatar">@WorkoutHubCard.Initials(w.ClientName??"Клиент")</span><div class="wh-appointment-main"><strong>@w.ClientName</strong><span>@w.Title</span><small>@if(w.Active){<span>@w.Done из @w.Sets @WorkoutHubCard.Noun(w.Sets,"подхода","подходов","подходов")</span>}else{if(w.Minutes>0){<span>@w.Minutes мин · </span>}<span>@WorkoutHubCard.Count(w.Exercises.Count,"упражнение","упражнения","упражнений")</span>}</small>@if(w.Active){<div class="wh-meter"><i style="width:@w.Percent%"></i></div>}</div><a class="wh-appointment-action" href="@Url.Page(null,Model.Values(view:"train",workoutId:w.Session.Id))"><span class="wh-status @(w.Completed?"wh-success":w.Active?"wh-accent":"")"><reference-icon name="@(w.Completed?"check-circle":w.Active?"alert":"clock")" />@w.Status</span><strong>@(w.Active?"Открыть тренировку":w.Completed?"Результаты":"Открыть план") <reference-icon name="@(w.Active?"arrow":"chevron")" /></strong></a></article>}</div>
@if(Model.Agenda.Count==0){<section class="wh-card wh-empty"><reference-icon name="calendar" /><h2>Занятий пока нет</h2><p>@(Model.Clients.Count==0?"Добавьте клиента, чтобы планировать занятия.":"Выберите другую дату или назначьте тренировку.")</p>@if(Model.Clients.Count==0){<a class="wh-text-link" asp-page="/Coaching/Clients">Открыть клиентов <reference-icon name="arrow" /></a>}else if(Model.AssignmentChoices.Count==0){<a class="wh-text-link" asp-page="/Training/Programs/Edit">Создать шаблон <reference-icon name="arrow" /></a>}</section>}
<div class="wh-card wh-agenda-shortcuts"><a class="wh-row" href="@Url.Page(null,Model.Values(view:"templates"))"><reference-icon name="layers" /><span><strong>Шаблоны тренировок</strong><small>Переиспользовать комплексы</small></span><reference-icon name="chevron" /></a><a class="wh-row" href="@Url.Page(null,Model.Values(view:"history"))"><reference-icon name="history" /><span><strong>История клиентов</strong><small>Завершённые занятия</small></span><reference-icon name="chevron" /></a></div><p class="wh-footnote"><reference-icon name="info" />Только назначенные тебе клиенты</p>
</div>
