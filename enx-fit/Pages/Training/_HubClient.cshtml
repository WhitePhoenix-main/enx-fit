@using enx_fit.ViewModels.Workouts
@model enx_fit.Pages.Training.IndexModel
@{var w=Model.Detail!;var session=w.Session!;}
<a class="wh-back" href="@Url.Page(null,Model.Values(view:"train"))"><reference-icon name="arrow" />Все тренировки</a>
<section class="wh-client-profile"><span class="wh-avatar">@WorkoutHubCard.Initials(w.ClientName??"Клиент")</span><div><h2>@w.ClientName</h2><p>@(w.Date==Model.Today?"Сегодня":w.Date.ToString("d MMMM", Model.Russian))@if(session.ScheduledTime is {} time){<span> · @time.ToString("HH:mm")–@time.AddMinutes(session.PlannedMinutes??60).ToString("HH:mm")</span>}</p></div><a class="wh-text-link" asp-page="/Coaching/Client" asp-route-id="@w.ClientId">Профиль <reference-icon name="arrow" /></a></section>
<div class="wh-client-grid"><div class="wh-section-group"><partial name="_HubWorkoutCard" model="@(new WorkoutHubCardViewModel(Model,w,Client:true))" /></div><div class="wh-section-group">
<section><header class="wh-section-heading"><h2>План занятия</h2><button class="wh-text-link" type="button" data-hub-dialog="hub-plan-@session.Id">Все @w.Exercises.Count <reference-icon name="arrow" /></button></header><div class="wh-card">@foreach(var(e,i) in w.Exercises.Take(3).Select((e,i)=>(e,i))){<div class="wh-plan-row"><span class="wh-exercise-number">@(i+1)</span><span><strong>@e.Name</strong><small>@e.Prescription</small></span><span class="wh-plan-completion @(e.Total>0&&e.Done>=e.Total?"wh-success":"wh-muted")"><reference-icon name="@(e.Total>0&&e.Done>=e.Total?"check-circle":"circle")" />@e.Done/@e.Total</span></div>}</div></section>
<a class="wh-card wh-row" asp-page="/Training/Plans" asp-route-ClientId="@w.ClientId"><reference-icon name="calendar" /><span><strong>План и расписание</strong><small>Изменить предстоящие занятия</small></span><reference-icon name="chevron" /></a><section class="wh-card wh-trainer-note"><reference-icon name="pencil" /><div><h2>Заметка тренера</h2><p>@(string.IsNullOrWhiteSpace(Model.TrainerNote)?"Добавьте наблюдение по занятию клиента.":Model.TrainerNote)</p></div><button class="wh-text-link" type="button" data-hub-dialog="hub-trainer-note">Изменить</button></section></div></div>
<dialog class="wh-dialog" id="hub-trainer-note"><div class="wh-dialog-heading"><h2>Заметка тренера</h2><button type="button" data-hub-close aria-label="Закрыть"><reference-icon name="close" /></button></div><form method="post" asp-page-handler="Note"><input type="hidden" name="workoutId" value="@session.Id" /><label>Наблюдения<textarea name="note" maxlength="1000" rows="5">@Model.TrainerNote</textarea></label><button class="wh-primary" type="submit">Сохранить заметку</button></form></dialog>
