@page "/Training/Records"
@using enx_fit.Presentation.Exercises
@using System.Globalization
@model enx_fit.Pages.Training.RecordsModel
@{ Layout = "/Pages/Shared/Layouts/_TrainingLogLayout.cshtml"; ViewData["Title"] = Model.Selected is null ? "Личные рекорды" : ExercisePresentation.DisplayName(Model.Selected); var ru = CultureInfo.GetCultureInfo("ru-RU"); }
<header class="log-page-heading"><div><p class="eyebrow">КАЖДЫЙ ПОДХОД ИМЕЕТ ЗНАЧЕНИЕ</p><h1>@(Model.Selected is null ? "Личные рекорды" : ExercisePresentation.DisplayName(Model.Selected))<span>.</span></h1></div><reference-icon name="trophy" /></header>
<nav class="log-tabs" aria-label="Разделы тренировок"><a asp-page="/Training/Index">Тренироваться</a><a href="@Url.Page("/Training/Index", new { View = "history", Days = 30 })">История</a><a class="is-active" asp-page="/Training/Records" aria-current="page">Рекорды</a></nav>
<p class="log-record-intro">Ваши лучшие результаты по завершённым рабочим подходам. Разминка и пропуски не учитываются.</p>
<div class="log-record-grid">@foreach (var record in Model.Records) { <section class="log-record-card"><header><span class="log-record-icon"><reference-icon name="trophy" /></span><div><h2><a asp-route-exerciseId="@record.Exercise.Id">@ExercisePresentation.DisplayName(record.Exercise)</a></h2><p>@record.Exercise.MuscleGroup · @record.History.Count тренировок</p></div></header><div class="log-record-values">@if (record.BestWeight > 0) { <div><span>Максимальный вес</span><strong>@record.BestWeight.ToString("0.##", ru)<small> кг</small></strong></div> }@if (record.BestBodyweightReps > 0) { <div><span>Со своим весом</span><strong>@record.BestBodyweightReps<small> повт.</small></strong></div> }@if (record.BestSetVolume > 0) { <div><span>Объём подхода</span><strong>@record.BestSetVolume.ToString("0.##", ru)<small> кг</small></strong></div> }</div><button type="button" class="text-button" data-exercise-history="@record.Exercise.Id">История результатов <reference-icon name="up-right" /></button></section> }</div>
@if (Model.Records.Count == 0) { <section class="log-empty"><span class="log-empty-icon"><reference-icon name="trophy" /></span><h2>Всё ещё впереди</h2><p>Запишите и завершите тренировку.<br />Ваши первые результаты появятся здесь.</p><a class="button" asp-page="/Training/Index">К тренировкам</a></section> }
<partial name="/Pages/Training/Workouts/_LogHistoryDialog.cshtml" />
