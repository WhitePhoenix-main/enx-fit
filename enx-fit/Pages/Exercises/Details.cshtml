@page "{id:int}"
@model enx_fit.Pages.Exercises.DetailsModel
@{
    ViewData["Title"] = "Exercise details";
}

<div class="d-flex flex-column flex-sm-row align-items-sm-center justify-content-between gap-3 mb-4">
    <div>
        <h1 class="h3 mb-1">@Model.Exercise.Name</h1>
        <p class="text-muted mb-0">Exercise details</p>
    </div>
    <div class="d-flex gap-2">
        @if (User.IsInRole("Administrator"))
        {
            <a class="btn btn-primary" asp-page="./Edit" asp-route-id="@Model.Exercise.Id">Edit</a>
        }
        <a class="btn btn-outline-secondary" asp-page="./Index">Back to list</a>
    </div>
</div>

<div class="card">
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-3">Muscle group</dt>
            <dd class="col-sm-9">@Model.Exercise.MuscleGroup</dd>

            <dt class="col-sm-3">Equipment</dt>
            <dd class="col-sm-9">@Model.Exercise.Equipment</dd>

            <dt class="col-sm-3">Notes</dt>
            <dd class="col-sm-9 mb-0">@(string.IsNullOrWhiteSpace(Model.Exercise.Notes) ? "No notes" : Model.Exercise.Notes)</dd>
        </dl>
    </div>
</div>
