@page
@model enx_fit.Pages.Exercises.CreateModel
@{
    ViewData["Title"] = "Добавить упражнение";
}

<div class="mb-4">
    <h1 class="h3 mb-1">Добавить упражнение</h1>
    <p class="text-muted mb-0">Укажите название, группу мышц и оборудование.</p>
</div>

<div class="card">
    <div class="card-body">
        <form method="post">
            <partial name="_ExerciseForm" for="Input" />
            <div class="d-flex gap-2">
                <button class="btn btn-primary" type="submit">Создать упражнение</button>
                <a class="btn btn-outline-secondary" asp-page="./Index">Отмена</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
