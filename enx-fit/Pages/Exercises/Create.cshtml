@page
@model enx_fit.Pages.Exercises.CreateModel
@{
    ViewData["Title"] = "Add exercise";
}

<div class="mb-4">
    <h1 class="h3 mb-1">Add exercise</h1>
    <p class="text-muted mb-0">Create an exercise for future workout sessions.</p>
</div>

<div class="card">
    <div class="card-body">
        <form method="post">
            <partial name="_ExerciseForm" for="Input" />
            <div class="d-flex gap-2">
                <button class="btn btn-primary" type="submit">Create exercise</button>
                <a class="btn btn-outline-secondary" asp-page="./Index">Cancel</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
