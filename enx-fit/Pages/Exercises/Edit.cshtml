@page "{id:int}"
@model enx_fit.Pages.Exercises.EditModel
@{
    ViewData["Title"] = "Edit exercise";
}

<div class="mb-4">
    <h1 class="h3 mb-1">Edit exercise</h1>
    <p class="text-muted mb-0">Update the exercise details used in your workout library.</p>
</div>

<div class="card">
    <div class="card-body">
        <form method="post">
            <input type="hidden" asp-for="Id" />
            <partial name="_ExerciseForm" for="Input" />
            <div class="d-flex gap-2">
                <button class="btn btn-primary" type="submit">Save changes</button>
                <a class="btn btn-outline-secondary" asp-page="./Index">Cancel</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
