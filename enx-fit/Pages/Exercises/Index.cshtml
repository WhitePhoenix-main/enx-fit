@page
@model enx_fit.Pages.Exercises.IndexModel
@{
    ViewData["Title"] = "Exercises";
}

<div class="d-flex flex-column flex-sm-row align-items-sm-center justify-content-between gap-3 mb-4">
    <div>
        <h1 class="h3 mb-1">Exercises</h1>
        <p class="text-muted mb-0">Manage the exercise library used in your workouts.</p>
    </div>
    <a class="btn btn-primary" asp-page="./Create">Add exercise</a>
</div>

@if (TempData["StatusMessage"] is string statusMessage)
{
    <div class="alert alert-success" role="alert">@statusMessage</div>
}

<form method="get" class="row g-2 align-items-end mb-4">
    <div class="col-sm-6 col-md-4">
        <label class="form-label" asp-for="SelectedMuscleGroup">Muscle group</label>
        <select class="form-select" asp-for="SelectedMuscleGroup">
            <option value="">All muscle groups</option>
            @foreach (var muscleGroup in Model.MuscleGroups)
            {
                <option value="@muscleGroup">@muscleGroup</option>
            }
        </select>
    </div>
    <div class="col-auto">
        <button class="btn btn-outline-primary" type="submit">Apply filter</button>
    </div>
    @if (!string.IsNullOrWhiteSpace(Model.SelectedMuscleGroup))
    {
        <div class="col-auto">
            <a class="btn btn-link" asp-page="./Index">Clear</a>
        </div>
    }
</form>

@if (Model.Exercises.Count == 0)
{
    <div class="border rounded-3 p-5 text-center bg-body-tertiary">
        <h2 class="h5">No exercises found</h2>
        <p class="text-muted mb-4">
            @(string.IsNullOrWhiteSpace(Model.SelectedMuscleGroup)
                ? "Add your first exercise to start building workouts."
                : "Try another muscle group or add a new exercise.")
        </p>
        <a class="btn btn-primary" asp-page="./Create">Add exercise</a>
    </div>
}
else
{
    <div class="table-responsive border rounded-3">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th scope="col">Name</th>
                    <th scope="col">Muscle group</th>
                    <th scope="col">Equipment</th>
                    <th scope="col" class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var exercise in Model.Exercises)
                {
                    <tr>
                        <td class="fw-semibold">@exercise.Name</td>
                        <td>@exercise.MuscleGroup</td>
                        <td>@exercise.Equipment</td>
                        <td class="text-end text-nowrap">
                            <a class="btn btn-sm btn-outline-secondary" asp-page="./Details" asp-route-id="@exercise.Id">Details</a>
                            <a class="btn btn-sm btn-outline-primary" asp-page="./Edit" asp-route-id="@exercise.Id">Edit</a>
                            <a class="btn btn-sm btn-outline-danger" asp-page="./Delete" asp-route-id="@exercise.Id">Delete</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
