@page
@model enx_fit.Pages.Exercises.IndexModel
@using System.Security.Claims
@{
    Layout = "_DashboardReferenceLayout";
    ViewData["Title"] = "Библиотека";
    IReadOnlyList<enx_fit.Models.Exercise> exercises = Model.Reference ? new List<enx_fit.Models.Exercise> {
        new() { Id = ExerciseIds.FromLegacy(-1), Name = "Жим лёжа", MuscleGroup = "Грудные мышцы", Equipment = "Штанга, скамья" },
        new() { Id = ExerciseIds.FromLegacy(-2), Name = "Приседания со штангой", MuscleGroup = "Ноги, ягодицы", Equipment = "Штанга, силовая рама" },
        new() { Id = ExerciseIds.FromLegacy(-3), Name = "Становая тяга", MuscleGroup = "Спина, ноги", Equipment = "Штанга, помост" },
        new() { Id = ExerciseIds.FromLegacy(-4), Name = "Тяга верхнего блока", MuscleGroup = "Спина", Equipment = "Блочный тренажёр" }
    } : Model.Exercises;
    string Photo(string name) => name.Contains("присед", StringComparison.OrdinalIgnoreCase) || name.Contains("squat", StringComparison.OrdinalIgnoreCase) ? "117 801 203 162" : name.Contains("верхнего", StringComparison.OrdinalIgnoreCase) || name.Contains("pulldown", StringComparison.OrdinalIgnoreCase) ? "117 1216 203 161" : name.Contains("тяга", StringComparison.OrdinalIgnoreCase) || name.Contains("deadlift", StringComparison.OrdinalIgnoreCase) ? "117 1005 203 164" : "117 593 203 161";
}
@if (TempData["StatusMessage"] is string status) { <p class="program-notice app-status app-notice" data-app-state="saved" role="status">@status</p> }
<div class="em-library app-workspace" data-exercise-library data-library-owner="@User.FindFirstValue(ClaimTypes.NameIdentifier)" data-library-reference="@Model.Reference.ToString().ToLowerInvariant()">
    <header class="em-page-heading"><h1>Библиотека</h1>@if (!Model.Reference && User.HasMinimumRole(UserRole.Administrator)) { <a class="app-button secondary em-library-create" asp-page="./Create">Добавить упражнение</a> }</header>
    <label class="em-library-search app-field-icon"><reference-icon name="search"/><input type="search" placeholder="Название или мышцы..." aria-label="Поиск упражнений" data-library-search/></label>
    <div class="em-library-tabs" role="tablist" aria-label="Разделы библиотеки"><button class="app-button secondary active" type="button" role="tab" aria-selected="true" data-library-tab="all">Все</button><button class="app-button secondary" type="button" role="tab" aria-selected="false" data-library-tab="favorites">Избранные</button><button class="app-button secondary" type="button" role="tab" aria-selected="false" data-library-tab="recent">Недавние</button></div>
    <div class="em-library-tools"><label class="em-group-select app-field-icon"><reference-icon name="sliders"/><select aria-label="Группа мышц" data-library-group><option value="">Все группы</option>@foreach (var group in exercises.Select(e => e.MuscleGroup).Distinct()) { <option value="@group" selected="@(group == Model.SelectedMuscleGroup)">@group</option> }</select><reference-icon name="chevron"/></label><span data-library-count>@(Model.Reference ? "24 упражнения" : exercises.Count + " упражнений")</span></div>
    <div class="em-library-list">
        @foreach (var e in exercises) { var name = ExercisePresentation.DisplayName(e);
            <article class="em-card em-exercise-card" data-library-id="@e.Id" data-library-text="@name @e.MuscleGroup" data-library-muscle="@e.MuscleGroup" data-library-recent="@Model.RecentIds.Contains(e.Id).ToString().ToLowerInvariant()"><reference-photo class="em-exercise-photo" image="library" window="@Photo(name)" alt="@name"/><div><h2>@name</h2><p>@e.MuscleGroup</p><p>@e.Equipment</p></div><button class="em-favorite app-icon-button" type="button" aria-label="Добавить в избранное: @name" aria-pressed="false" data-library-favorite><reference-icon name="star"/></button><a class="em-exercise-open" href="@(Model.Reference ? "#mobile-exercise-" + e.Id : Url.Page("./Details", new { id = e.Id }))" data-dialog="@(Model.Reference ? "mobile-exercise-" + e.Id : null)" aria-label="Подробнее: @name"><reference-icon name="chevron"/></a></article>
        }
    </div>
    <div class="em-card em-empty" hidden data-library-empty><reference-icon name="search"/><h2>Упражнения не найдены</h2><p>Измените запрос или выберите другую группу.</p></div>
    <p class="em-card em-library-hint"><reference-icon name="info"/><span>Откройте упражнение, чтобы посмотреть оборудование.</span></p>
</div>
@if (Model.Reference) { @foreach (var e in exercises) { <dialog id="mobile-exercise-@e.Id" class="app-dialog app-workspace"><div class="dialog-heading"><h2>@e.Name</h2><button class="icon-button" type="button" data-close aria-label="Закрыть"><reference-icon name="close"/></button></div><reference-photo class="em-exercise-preview" image="library" window="@Photo(e.Name)" alt="@e.Name"/><p>@e.MuscleGroup</p><p>Оборудование: @e.Equipment</p><button class="app-button secondary" type="button" data-close>Закрыть</button></dialog> } }
