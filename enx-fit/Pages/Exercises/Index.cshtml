@page
@model enx_fit.Pages.Exercises.IndexModel
@{
    ViewData["Title"] = "Упражнения";
}

<div class="d-flex flex-column flex-sm-row align-items-sm-center justify-content-between gap-3 mb-4">
    <div>
        <h1 class="h3 mb-1">Упражнения</h1>
        <p class="text-muted mb-0">Библиотека упражнений для составления тренировок.</p>
    </div>
    @if (User.IsInRole("Administrator"))
    {
        <a class="btn btn-primary" asp-page="./Create">Добавить упражнение</a>
    }
</div>

@if (TempData["StatusMessage"] is string statusMessage)
{
    <div class="alert alert-success" role="alert">@statusMessage</div>
}

<form method="get" class="row g-2 align-items-end mb-4">
    <div class="col-sm-6 col-md-4">
        <label class="form-label" asp-for="SelectedMuscleGroup">Группа мышц</label>
        <select class="form-select" asp-for="SelectedMuscleGroup">
            <option value="">Все группы мышц</option>
            @foreach (var muscleGroup in Model.MuscleGroups)
            {
                <option value="@muscleGroup">@muscleGroup</option>
            }
        </select>
    </div>
    <div class="col-auto">
        <button class="btn btn-outline-primary" type="submit">Применить фильтр</button>
    </div>
    @if (!string.IsNullOrWhiteSpace(Model.SelectedMuscleGroup))
    {
        <div class="col-auto">
            <a class="btn btn-link" asp-page="./Index">Сбросить</a>
        </div>
    }
</form>

@if (Model.Exercises.Count == 0)
{
    <div class="border rounded-3 p-5 text-center bg-body-tertiary">
        <h2 class="h5">Упражнения не найдены</h2>
        <p class="text-muted mb-4">
            @(string.IsNullOrWhiteSpace(Model.SelectedMuscleGroup)
                ? "Добавьте первое упражнение для составления тренировок."
                : "Выберите другую группу мышц или добавьте упражнение.")
        </p>
        @if (User.IsInRole("Administrator"))
        {
            <a class="btn btn-primary" asp-page="./Create">Добавить упражнение</a>
        }
    </div>
}
else
{
    <div class="table-responsive border rounded-3">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th scope="col">Название</th>
                    <th scope="col">Группа мышц</th>
                    <th scope="col">Оборудование</th>
                    <th scope="col" class="text-end">Действия</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var exercise in Model.Exercises)
                {
                    <tr>
                        <td class="fw-semibold">
                            <span class="exercise-list-name">
                                <span class="exercise-list-icon" aria-hidden="true"><admin-icon name="@ExercisePresentation.MuscleIcon(exercise.MuscleGroup)" /></span>
                                <span>@exercise.Name</span>
                            </span>
                        </td>
                        <td>@exercise.MuscleGroup</td>
                        <td>
                            <span class="exercise-list-equipment" title="@ExercisePresentation.EquipmentDetails(exercise).FirstOrDefault()?.Description">
                                <admin-icon name="@ExercisePresentation.EquipmentIcon(exercise)" />
                                @exercise.Equipment
                            </span>
                        </td>
                        <td class="text-end text-nowrap">
                            <a class="btn btn-sm btn-outline-secondary" asp-page="./Details" asp-route-id="@exercise.Id">Подробнее</a>
                            @if (User.IsInRole("Administrator"))
                            {
                                <a class="btn btn-sm btn-outline-primary" asp-page="./Edit" asp-route-id="@exercise.Id">Изменить</a>
                                <a class="btn btn-sm btn-outline-danger" asp-page="./Delete" asp-route-id="@exercise.Id">Удалить</a>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@section Styles {
    <link rel="stylesheet" href="~/css/exercises.css" asp-append-version="true" />
}
