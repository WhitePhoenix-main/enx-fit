@page
@model enx_fit.Pages.Analytics.IndexModel
@{
    ViewData["Title"] = "Analytics";
}

<div class="mb-4">
    <h1 class="h3 mb-1">Analytics</h1>
    <p class="text-muted mb-0">Review strength progress for a selected exercise.</p>
</div>

@if (Model.Exercises.Count == 0)
{
    <div class="border rounded-3 p-5 text-center bg-body-tertiary">
        <h2 class="h5">No exercises available</h2>
        <p class="text-muted mb-4">Add exercises before opening training analytics.</p>
        @if (User.IsInRole("Administrator"))
        {
            <a class="btn btn-primary" asp-page="/Exercises/Create">Add exercise</a>
        }
    </div>
}
else
{
    <form method="get" class="row g-2 align-items-end mb-4">
        @if (Model.IsAdministrator)
        {
            <div class="col-sm-8 col-md-5">
                <label class="form-label" asp-for="UserId">Пользователь</label>
                <select class="form-select" asp-for="UserId">
                    <option value="">Выберите пользователя</option>
                    @foreach (var user in Model.Users)
                    {
                        <option value="@user.Id">@user.DisplayName</option>
                    }
                </select>
            </div>
        }
        <div class="col-sm-8 col-md-5">
            <label class="form-label" asp-for="ExerciseId">Exercise</label>
            <select class="form-select" asp-for="ExerciseId">
                <option value="">Select an exercise</option>
                @foreach (var exercise in Model.Exercises)
                {
                    <option value="@exercise.Id">@exercise.Name</option>
                }
            </select>
        </div>
        <div class="col-auto">
            <button class="btn btn-primary" type="submit">Show analytics</button>
        </div>
    </form>

    @if (Model.IsAdministrator && string.IsNullOrWhiteSpace(Model.UserId))
    {
        <div class="border rounded-3 p-4 bg-body-tertiary">
            <p class="text-muted mb-0">Выберите пользователя для просмотра его статистики.</p>
        </div>
    }
    else if (!Model.ExerciseId.HasValue)
    {
        <div class="border rounded-3 p-4 bg-body-tertiary">
            <p class="text-muted mb-0">Select an exercise to view progress charts and your best set.</p>
        </div>
    }
    else
    {
        <div class="row g-3 mb-4">
            <div class="col-md-5">
                <section class="card h-100">
                    <div class="card-body">
                        <h2 class="h5">Best set</h2>
                        @if (Model.BestSet is null)
                        {
                            <p class="text-muted mb-0">No valid working sets recorded yet.</p>
                        }
                        else
                        {
                            <p class="display-6 mb-1">@Model.BestSet.Weight kg × @Model.BestSet.Reps</p>
                            <p class="text-muted mb-0">
                                Estimated 1RM: <strong>@Model.BestSet.EstimatedOneRepMax kg</strong>
                                <br />
                                @Model.BestSet.Date.ToString("yyyy-MM-dd")
                            </p>
                        }
                    </div>
                </section>
            </div>
            <div class="col-md-7">
                <section class="card h-100">
                    <div class="card-body">
                        <h2 class="h5">Progress summary</h2>
                        <p class="mb-0">@Model.ProgressText</p>
                    </div>
                </section>
            </div>
        </div>

        @if (!Model.HasEnoughData)
        {
            <div class="alert alert-info" role="alert">
                Add at least two workouts with valid working sets to see progress charts.
            </div>
        }
        else
        {
            <script id="training-analytics-chart-data" type="application/json">@Html.Raw(Model.ChartDataJson)</script>

            <div class="row g-3">
                <div class="col-lg-6">
                    <section class="card h-100">
                        <div class="card-body">
                            <h2 class="h5">Working weight</h2>
                            <div class="ratio ratio-16x9">
                                <canvas id="working-weight-chart"></canvas>
                            </div>
                        </div>
                    </section>
                </div>
                <div class="col-lg-6">
                    <section class="card h-100">
                        <div class="card-body">
                            <h2 class="h5">Estimated 1RM</h2>
                            <div class="ratio ratio-16x9">
                                <canvas id="estimated-one-rep-max-chart"></canvas>
                            </div>
                        </div>
                    </section>
                </div>
                <div class="col-12">
                    <section class="card">
                        <div class="card-body">
                            <h2 class="h5">Training volume</h2>
                            <div class="ratio ratio-21x9">
                                <canvas id="exercise-volume-chart"></canvas>
                            </div>
                        </div>
                    </section>
                </div>
            </div>
        }
    }
}

@section Scripts {
    @if (Model.HasEnoughData)
    {
        <script src="~/lib/chart.js/dist/chart.umd.min.js"></script>
        <script src="~/js/training-analytics.js" asp-append-version="true"></script>
    }
}
