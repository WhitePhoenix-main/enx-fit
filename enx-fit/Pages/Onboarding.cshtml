@page
@model enx_fit.Pages.OnboardingModel
@using enx_fit.Models
@{ Layout = "_DashboardReferenceLayout"; ViewData["Title"] = "Под ваши условия"; }
@section Styles { <link rel="stylesheet" href="~/css/training-setup.css" asp-append-version="true" /> }
<div class="training-setup app-workspace" data-training-setup data-viewer="@Model.ViewerId" data-invalid="@(!ViewData.ModelState.IsValid ? "true" : "false")" data-saved="@(Model.ShowSaved ? "true" : "false")">
    <header class="setup-heading"><div><span class="setup-eyebrow">Ваш старт в Enix Fit</span><h1>@(Model.ShowSaved ? "Условия сохранены" : "Под ваши условия")</h1><p>@(Model.ShowSaved ? "Теперь можно выбрать, как начать занятие" : "Цель, оборудование и удобные дни. Всё можно изменить позже.")</p></div><a class="app-icon-button" asp-page="@Model.ReturnPage" aria-label="Вернуться"><reference-icon name="close" /></a></header>
    @if (Model.ShowSaved) {
        <div class="setup-saved" data-setup-saved>
            <section class="ef-card setup-saved-summary"><span class="setup-success"><reference-icon name="check" /></span><h2>Ваш ориентир</h2><dl><div><dt>Цель</dt><dd>@Model.Settings.GoalTitle</dd></div><div><dt>Место</dt><dd>@TrainingPreferences.LocationTitle(Model.Settings.TrainingLocation)</dd></div><div><dt>Оборудование</dt><dd>@TrainingPreferences.EquipmentTitle(Model.Settings.AvailableEquipment)</dd></div><div><dt>Удобные дни</dt><dd>@TrainingPreferences.DaysTitle(Model.Settings.PreferredDays)</dd></div></dl><a asp-page="/Onboarding" asp-route-ReturnTo="@Model.ReturnTo">Изменить условия <reference-icon name="pencil" /></a></section>
            <section class="ef-card setup-next"><reference-photo class="setup-next-photo" image="programs" window="565 425 293 117" /><span class="setup-eyebrow">Следующий шаг</span><h2>Начните в своём темпе</h2><p>Можно добавлять упражнения по ходу, использовать шаблон занятия или выбрать готовую программу.</p><a class="ef-primary app-button" asp-page="/Dashboard">К тренировке <reference-icon name="arrow" /></a><a class="setup-secondary app-button secondary" asp-page="/Programs/Index" asp-route-Tab="templates" asp-route-MatchPreferences="true" asp-route-Level="@ProgramLevel.Beginner">Посмотреть готовые планы</a><p class="setup-next-note">Фильтр проверит доступное оборудование и частоту по выбранным дням. Расписание и нагрузку сможете настроить в программе.</p><a class="setup-return" asp-page="@Model.ReturnPage">@(Model.ReturnTo == "profile" ? "Вернуться в профиль" : "На главную")</a></section>
        </div>
    } else {
        <form method="post" id="setup-form" class="setup-form" novalidate data-setup-form>
            <input type="hidden" asp-for="Input.Revision" /><input type="hidden" asp-for="ReturnTo" />
            <div asp-validation-summary="All" class="setup-errors app-status app-notice" data-app-state="error" role="alert"></div>
            @if (Model.Conflict) { <a class="setup-conflict" asp-page="/Onboarding" asp-route-ReturnTo="@Model.ReturnTo">Загрузить сохранённые условия</a> }
            <nav class="setup-steps" aria-label="Шаги знакомства"><button type="button" data-setup-goto="0"><span>1</span>Цель</button><button type="button" data-setup-goto="1"><span>2</span>Условия</button><button type="button" data-setup-goto="2"><span>3</span>Дни</button></nav>
            <div class="setup-layout"><div class="setup-content">
                <section class="ef-card setup-step" data-setup-step="0" aria-labelledby="setup-goal-title"><span class="setup-step-caption">Шаг 1 из 3</span><h2 id="setup-goal-title" tabindex="-1">Что для вас сейчас главное?</h2><p>Выберите ближайшую цель. Она станет ориентиром на главной.</p><fieldset class="setup-goals"><legend class="sr-only">Цель тренировок</legend>@foreach (var option in TrainingPreferences.Goals) { <label class="setup-choice"><input type="radio" name="Input.Goal" value="@option.Value" checked="@(Model.Input.Goal == option.Value)" required /><span><strong>@option.Title</strong><small>@option.Description</small></span><reference-icon name="check" /></label> }</fieldset><span asp-validation-for="Input.Goal" class="setup-field-error"></span></section>
                <section class="ef-card setup-step" data-setup-step="1" aria-labelledby="setup-location-title"><span class="setup-step-caption">Шаг 2 из 3</span><h2 id="setup-location-title" tabindex="-1">Где и с чем будете заниматься?</h2><p>Отметьте то, к чему у вас есть доступ. Место само по себе не определяет оборудование.</p><fieldset class="setup-locations"><legend class="sr-only">Место занятий</legend>@foreach (var option in TrainingPreferences.Locations) { <label class="setup-chip"><input type="radio" name="Input.Location" value="@option.Value" checked="@(Model.Input.Location == option.Value)" required /><span>@option.Title</span></label> }</fieldset><span asp-validation-for="Input.Location" class="setup-field-error"></span><fieldset class="setup-equipment"><legend>Доступное оборудование</legend>@foreach (var option in TrainingPreferences.Equipment) { <label class="setup-equipment-choice"><input type="checkbox" name="Input.Equipment" value="@option.Value" checked="@Model.Input.Equipment.Contains(option.Value)" /><span>@option.Title</span></label> }</fieldset><p class="setup-equipment-hint">Если ничего не отметить, сохраним «Без дополнительного оборудования». Остальные упражнения доступны в библиотеке.</p><span asp-validation-for="Input.Equipment" class="setup-field-error"></span></section>
                <section class="ef-card setup-step" data-setup-step="2" aria-labelledby="setup-days-title"><span class="setup-step-caption">Шаг 3 из 3</span><h2 id="setup-days-title" tabindex="-1">Какие дни обычно удобны?</h2><p>Выбранное количество станет целью по занятиям за неделю. Дни помогут отфильтровать частоту готовых планов.</p><fieldset class="setup-days"><legend class="sr-only">Удобные дни</legend>@for (var day = 1; day <= 7; day++) { <label class="setup-day"><input type="checkbox" name="Input.Days" value="@day" checked="@Model.Input.Days.Contains(day)" /><span><strong>@(new[] { "Пн", "Вт", "Ср", "Чт", "Пт", "Сб", "Вс" }[day - 1])</strong><small>@TrainingPreferences.Days[day - 1]</small></span></label> }</fieldset><label class="setup-days-later"><input asp-for="Input.DaysLater" /><span>Дни выберу позже</span></label><p class="setup-days-note">Программа получает конкретное расписание после выбора. Эти дни можно будет использовать как ориентир.</p><span asp-validation-for="Input.Days" class="setup-field-error"></span><p class="setup-client-error app-status" data-app-state="error" data-setup-days-error hidden>Выберите хотя бы один день или «Дни выберу позже».</p></section>
                <section class="ef-card setup-step setup-review" data-setup-step="3" aria-labelledby="setup-review-title" hidden><span class="setup-step-caption">Всё готово к сохранению</span><h2 id="setup-review-title" tabindex="-1">Проверим ваш выбор</h2><p>Условия помогут ориентироваться на главной и выбирать программы.</p><dl data-setup-review></dl><p class="setup-days-note">Рабочие веса выбираются при подготовке или выполнении тренировки.</p></section>
            </div><aside class="ef-card setup-preview" aria-label="Ваши условия"><reference-photo class="setup-preview-photo" image="programs" window="565 425 293 117" /><span class="setup-eyebrow">Ваш ориентир</span><h2>Начало, которое удобно вам</h2><dl data-setup-preview></dl><p>Можно начать свободную тренировку и пройти настройку позже.</p></aside></div>
            <p class="setup-feedback app-status" data-app-state="info" role="status" aria-live="polite" data-setup-status></p>
            <footer class="setup-actions"><button type="button" class="setup-back app-button secondary" data-setup-back hidden><reference-icon name="chevron" />Назад</button><button type="submit" asp-page-handler="Skip" formnovalidate class="setup-skip app-button secondary" data-setup-skip>Позже</button><button type="button" class="ef-primary setup-next-button app-button" data-setup-next hidden>Дальше <reference-icon name="arrow" /></button><button type="submit" class="ef-primary setup-save app-button" data-setup-save>Сохранить условия <reference-icon name="check" /></button></footer>
        </form>
    }
</div>
@section Scripts { <script src="~/js/training-setup.js" asp-append-version="true"></script> }
