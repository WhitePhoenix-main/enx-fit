@page "/pricing"
@{
    Layout = "_LandingLayout";
    ViewData["Title"] = "Тарифы и возможности";
    ViewData["Description"] = "Бесплатный дневник тренировок Enix Fit, рекомендации Pro и работа с клиентами Coach.";
}
<div class="public-page wrap public-pricing-page">
    <header class="public-page-heading"><a class="public-back" asp-page="/Index">← Главная</a><p class="eyebrow">Тарифы</p><h1>Начни с Free.<br /><span>Выбирай по задачам.</span></h1><p>Дневник, программы и история доступны бесплатно. Pro помогает выбирать нагрузку, Coach — работать с назначенными клиентами.</p></header>
    <p class="public-availability"><svg class="icon"><use href="#i-clock" /></svg><span>Онлайн-оплата пока недоступна. Доступ Pro и Coach назначается администратором.</span></p>
    <partial name="_PublicPlans" />
    <details class="public-roadmap"><summary>Что планируется дальше?</summary><p>Расширенная аналитика и новые инструменты тренера будут появляться постепенно. Здесь перечислены только уже доступные возможности; будущие функции не входят в обещания тарифов.</p></details>
    <a class="public-text-link" href="@(Url.Page("/Faq") + "#faq-access")">Как устроен доступ к планам →</a>
</div>
