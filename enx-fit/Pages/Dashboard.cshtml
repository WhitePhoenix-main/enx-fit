@page
@model enx_fit.Pages.DashboardModel
@using enx_fit.Services
@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = Model.IsCoachView ? $"{Model.Data.Name} — дэшборд клиента" : "Мой дэшборд";
    var coach = Model.IsCoachView;
}
<partial name="_DashboardContext" model="Model" />
@if (Model.Attention is { } attention) { <partial name="_CoachAttention" model="attention" /> }
@if (Model.ActiveProgram is { } activeProgram)
{
    <section class="panel program-dashboard-next"><div><p class="eyebrow">МОЯ ПРОГРАММА</p><h2>@activeProgram.Name</h2><p class="muted">@(Model.NextProgramWorkout is { } next ? $"Следующая тренировка: {next.Workout.Name} · {next.Date:dd.MM}" : "Ближайших тренировок больше нет")</p></div><div class="program-dashboard-actions"><a class="button secondary" asp-page="/Programs/Details" asp-route-id="@activeProgram.Id">Открыть программу</a>@if (Model.CanAnalyzePrograms) { <a class="button secondary" asp-page="/Programs/Details" asp-route-id="@activeProgram.Id" asp-route-Tab="progression">На что обратить внимание</a> }</div></section>
}
<div class="dashboard-tools">
<partial name="_DashboardPeriod" model="Model" />
    <button type="button" class="button secondary customize-button" data-layout-edit aria-expanded="false" aria-controls="layout-editor">
        <admin-icon name="settings" />Настроить дэшборд
    </button>
</div>
<section id="layout-editor" class="layout-editor" hidden aria-label="Настройка дэшборда">
    <div class="layout-editor-heading">
        <div><h2>Ваш дэшборд — ваши правила</h2><p>Выберите блоки, настройте ширину и переместите их в удобном порядке.</p></div>
        <div class="layout-actions">
            <button type="button" class="text-button" data-layout-reset>По умолчанию</button>
            <button type="button" class="button secondary" data-layout-cancel>Отмена</button>
            <button type="button" class="button" data-layout-save><admin-icon name="check" />Сохранить</button>
        </div>
    </div>
    <details class="widget-catalog" open>
        <summary>Добавить или убрать блок <span data-widget-count></span></summary>
        <div class="widget-catalog-grid">
            @foreach (var definition in DashboardWidgets.Catalog)
            {
                <label class="widget-option">
                    <input type="checkbox" data-widget-toggle="@definition.Id" checked="@Model.Widgets.Single(w => w.Id == definition.Id).Visible" />
                    <admin-icon name="@definition.Icon" />
                    <span><strong>@definition.Title</strong><small>@definition.Description</small></span>
                </label>
            }
        </div>
    </details>
    <p class="layout-help" id="widget-move-help">Приветствие закреплено первым. Остальные блоки можно перетаскивать за ручку или перемещать кнопками и стрелками на клавиатуре. Ширина автоматически подстраивается под экран и соседние блоки.</p>
    @if (coach) { <p class="layout-help">Эта раскладка применяется к вашему просмотру клиентов. Их личные настройки не изменятся.</p> }
</section>
<p class="layout-feedback" role="status" aria-live="polite" data-layout-feedback hidden></p>
<div class="dashboard-grid modular-grid" data-modular-dashboard data-layout-url="@Url.Page("/Dashboard", "Layout", new { Model.ClientId })">
    @foreach (var placement in Model.Widgets)
    {
        var definition = DashboardWidgets.Catalog.Single(w => w.Id == placement.Id);
        var pinned = placement.Id == DashboardWidgets.WelcomeId;
        <div class="dashboard-widget" data-widget-id="@placement.Id" data-widget-title="@definition.Title" data-widget-width="@placement.Width" hidden="@(!placement.Visible)">
            <div class="widget-editbar" hidden>
                <button type="button" class="widget-drag-handle" data-widget-drag disabled="@pinned" aria-label="Переместить: @definition.Title" aria-describedby="widget-move-help" title="@(pinned ? "Приветствие всегда первое" : "Перетащить блок")"><admin-icon name="grip" /></button>
                <span class="widget-edit-title">@definition.Title</span>
                <div class="widget-edit-actions">
                    <button type="button" data-widget-move="-1" aria-label="Раньше: @definition.Title" title="Переместить раньше"><admin-icon name="up" /></button>
                    <button type="button" data-widget-move="1" aria-label="Позже: @definition.Title" title="Переместить позже"><admin-icon name="down" /></button>
                    <button type="button" data-widget-hide aria-label="Скрыть: @definition.Title" title="Убрать блок"><admin-icon name="close" /></button>
                </div>
                <label class="widget-width-label"><span>Ширина</span><select data-widget-width-select aria-label="Ширина: @definition.Title">
                    @foreach (var width in DashboardWidgets.Widths) { <option value="@width.Key" selected="@(width.Key == placement.Width)">@width.Value</option> }
                </select></label>
            </div>
            <partial name="_DashboardWidget" model="new DashboardWidgetViewModel(Model, placement.Id)" />
        </div>
    }
</div>
<div class="panel empty-dashboard" data-layout-empty hidden="@Model.Widgets.Any(w => w.Visible)">
    <span class="icon-tile"><admin-icon name="grid" /></span>
    <h2>Место для того, что важно вам</h2><p>Добавьте первые блоки и соберите свой дэшборд.</p>
    <button type="button" class="button" data-layout-edit><admin-icon name="plus" />Добавить блоки</button>
</div>
<div hidden data-layout-token>@Html.AntiForgeryToken()</div>
<script type="application/json" id="dashboard-layout-data">@Html.Raw(System.Text.Json.JsonSerializer.Serialize(new { widgets = Model.Widgets, defaults = DashboardWidgets.Defaults(coach), pinnedWidgetId = DashboardWidgets.WelcomeId }, DashboardWidgets.JsonOptions))</script>
<partial name="_DashboardDialogs" model="Model" />
