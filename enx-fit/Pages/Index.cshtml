@page
@inject Microsoft.AspNetCore.Mvc.ViewFeatures.IFileVersionProvider AssetVersions
@{
    Layout = "_LandingLayout";
    var signedIn = User.Identity?.IsAuthenticated == true;
    var startUrl = enx_fit.Services.PublicPageLinks.Open(Url, User, "/Dashboard");
    var startLabel = signedIn ? "Открыть приложение" : "Начать бесплатно";
    var programsPreview = AssetVersions.AddFileVersionToPath(Request.PathBase, Url.Content("~/images/landing/product/programs-mobile.jpg"));
    var progressPreview = AssetVersions.AddFileVersionToPath(Request.PathBase, Url.Content("~/images/landing/product/progress-mobile.jpg"));
}
@* Screenshots come from the current application with isolated sample data. *@

<section class="hero wrap" aria-labelledby="hero-title">
    <div class="hero-copy">
        <p class="eyebrow">Твой дневник силовых тренировок</p>
        <h1 id="hero-title">Тренируйся<br />осознанно.<br /><span>Расти быстрее.</span></h1>
        <p class="hero-description">Программы, подходы, отдых и прогресс — в одном месте. Тренируйся с телефоном в зале, планируй занятия на компьютере.</p>
        <div class="button-row">
            <a class="button button-primary" href="@startUrl">@startLabel</a>
            <a class="button button-outline" href="#how-it-works"><svg class="icon"><use href="#i-arrow" /></svg>Как это работает</a>
        </div>
        <ul class="hero-benefits">
            <li><svg class="icon"><use href="#i-check" /></svg>Бесплатный старт</li>
            <li><svg class="icon"><use href="#i-check" /></svg>Без привязки карты</li>
            <li><svg class="icon"><use href="#i-check" /></svg>Телефон и компьютер</li>
        </ul>
    </div>
    <div class="hero-visual">
        <div class="dashboard-device screenshot-device">
            <img src="~/images/landing/product/dashboard-desktop.jpg" asp-append-version="true" width="1440" height="940" fetchpriority="high" alt="Главная Enix Fit: тренировка, план недели, личные рекорды и результаты. Пример данных." />
        </div>
        <p class="athlete-quote">Лучшая<br />версия себя<br />— каждый день</p>
        <div class="phone-device screenshot-phone">
            <img src="~/images/landing/product/workout-mobile.jpg" asp-append-version="true" width="390" height="844" alt="Тренировка на телефоне: жим лёжа, выполненный подход и таймер отдыха. Пример данных." />
        </div>
        <p class="hero-preview-caption">Экраны приложения · пример данных</p>
    </div>
</section>

<section class="how-it-works section-band" id="how-it-works" aria-labelledby="steps-title">
    <div class="wrap steps-grid">
        <div class="section-copy"><p class="eyebrow">Как начать</p><h2 id="steps-title">Три шага к первой тренировке</h2></div>
        <ol class="steps">
            <li><span class="step-number">1</span><div><h3>Создай аккаунт</h3><p>Начни бесплатно.<br />Карта не понадобится.</p></div></li>
            <li><span class="step-number">2</span><div><h3>Выбери свой старт</h3><p>Готовая программа<br />или свободная тренировка.</p></div></li>
            <li><span class="step-number">3</span><div><h3>Запиши результат</h3><p>Сохрани подходы<br />и возвращайся к своей истории.</p></div></li>
        </ol>
    </div>
    <div class="wrap"><partial name="_PublicStartChoices" /></div>
</section>

<section class="mobile-showcase section-band" id="mobile" aria-labelledby="mobile-title">
    <div class="wrap">
        <div class="story-grid">
            <div class="section-copy">
                <p class="eyebrow">Телефон рядом с тобой</p><h2 id="mobile-title">Всё внимание —<br />текущему подходу</h2>
                <p>Открой занятие в зале: упражнение, рабочий вес и повторы уже перед тобой. Отметь подход, отдохни и продолжай.</p>
                <ul class="story-points">
                    <li><svg class="icon"><use href="#i-dumbbell" /></svg><span><b>Вес и повторения</b>Записывай то, что выполнил.</span></li>
                    <li><svg class="icon"><use href="#i-clock" /></svg><span><b>Отдых между подходами</b>Таймер начинается после отметки выполнения.</span></li>
                    <li><svg class="icon"><use href="#i-check" /></svg><span><b>История после занятия</b>Заверши тренировку и сохрани результаты.</span></li>
                </ul>
                @if (signedIn)
                { <a class="button button-outline" asp-page="/Dashboard/Workouts">К моим тренировкам</a> }
                else
                { <a class="button button-outline" href="#planner">Как выбрать программу <svg class="icon"><use href="#i-arrow" /></svg></a> }
            </div>
            <partial name="_PublicProductPreview" />
        </div>
        <div class="integration-cards device-benefits">
            <article class="integration-card panel"><svg class="integration-logo"><use href="#i-phone" /></svg><b>В зале</b><span>Тренировка на телефоне</span></article>
            <article class="integration-card panel"><svg class="integration-logo"><use href="#i-laptop" /></svg><b>Дома</b><span>Планы и графики на компьютере</span></article>
            <article class="integration-card panel"><svg class="integration-logo"><use href="#i-users" /></svg><b>Один аккаунт</b><span>Общая история занятий</span></article>
        </div>
    </div>
</section>

<section class="planner section-band" id="planner" aria-labelledby="planner-title">
    <div class="wrap story-grid">
        <div class="section-copy">
            <p class="eyebrow">До следующего занятия</p><h2 id="planner-title">План, который<br />подходит тебе</h2>
            <p>Выбирай готовую программу по уровню и оборудованию или создавай свою. Переноси занятия в календаре, сохраняя остальное расписание.</p>
            <p>Можно тренироваться свободно, повторить прошлое занятие или записать результат после зала.</p>
            @if (signedIn)
            { <a class="button button-outline" asp-page="/Programs/Index">Открыть мои программы</a> }
            else
            { <a class="button button-outline" href="#faq-start">Можно начать без программы? <svg class="icon"><use href="#i-arrow" /></svg></a> }
        </div>
        <figure class="product-figure" data-reveal>
            <picture>
                <source media="(max-width: 600px)" srcset="@programsPreview" width="364" height="393" />
                <img src="~/images/landing/product/programs-desktop.jpg" asp-append-version="true" width="1440" height="940" loading="lazy" decoding="async" alt="Программы Enix Fit: активный план «Сила и форма» на шесть недель и выбор готовых шаблонов. Пример данных." />
            </picture>
            <figcaption>Твоя программа и расписание · пример данных</figcaption>
        </figure>
    </div>
</section>

<section class="analytics section-band" id="analytics" aria-labelledby="analytics-title">
    <div class="wrap story-grid">
        <div class="section-copy">
            <p class="eyebrow">После тренировки</p><h2 id="analytics-title">Замечай, как<br />меняется результат</h2>
            <p>Растёт ли рабочий вес? Как часто ты тренируешься? Сравнивай завершённые занятия по неделям и находи личные рекорды.</p>
            <p>Прогресс строится по выполненным подходам. Планы и незавершённые занятия остаются отдельно.</p>
            @if (signedIn)
            { <a class="button button-outline" asp-page="/Dashboard/Progress">Открыть мой прогресс</a> }
            else
            { <a class="button button-outline" href="#pricing">Что доступно бесплатно <svg class="icon"><use href="#i-arrow" /></svg></a> }
        </div>
        <figure class="product-figure" data-reveal>
            <picture>
                <source media="(max-width: 600px)" srcset="@progressPreview" width="364" height="476" />
                <img src="~/images/landing/product/progress-desktop.jpg" asp-append-version="true" width="1440" height="940" loading="lazy" decoding="async" alt="Прогресс Enix Fit: занятия по неделям и изменение рабочего веса. На телефоне показана регулярность. Пример данных." />
            </picture>
            <figcaption>Результаты по неделям · пример данных</figcaption>
        </figure>
    </div>
</section>

<section class="pricing section-band" id="pricing" aria-labelledby="pricing-title">
    <div class="wrap section-grid">
        <div class="section-copy"><p class="eyebrow">Тарифы</p><h2 id="pricing-title">Начни с Free.<br />Выбирай по задачам.</h2><p>Дневник, программы и история доступны бесплатно. Pro помогает выбирать нагрузку, Coach — работать с клиентами.</p><p class="pricing-availability">Онлайн-оплата пока недоступна. Доступ Pro и Coach назначается администратором.</p></div>
        <partial name="_PublicPlans" />
    </div>
</section>

<section class="landing-faq section-band" id="faq" aria-labelledby="faq-title">
    <div class="wrap story-grid">
        <div class="section-copy"><p class="eyebrow">Перед стартом</p><h2 id="faq-title">Осталось<br />пару вопросов?</h2><p>Начни так, как удобно тебе. План и история будут под рукой.</p></div>
        <partial name="_PublicFaq" model="enx_fit.ViewModels.PublicFaq.All.Take(4).ToArray()" />
    </div>
</section>

<section class="closing-cta" aria-labelledby="cta-title"><div class="wrap cta-inner"><div><h2 id="cta-title">Следующая тренировка —<br />начало твоей истории</h2><p>Запиши первый подход.<br />Остальное выстроится шаг за шагом.</p></div><div class="button-row"><a class="button button-primary" href="@startUrl">@startLabel</a><a class="button button-outline" href="#how-it-works">Как начать <svg class="icon"><use href="#i-arrow" /></svg></a></div><p class="mountain-quote">Дисциплина<br />сегодня —<br />большие результаты<br />завтра</p></div></section>
