@model enx_fit.Pages.Coaching.CalendarModel
@{var ru=System.Globalization.CultureInfo.GetCultureInfo("ru-RU");var monday=Model.Monday;var todayEntries=Model.Entries.Where(e=>e.Date==Model.Day).ToArray();var startHour=Math.Min(8,Model.Entries.Select(e=>e.Time.Hour).DefaultIfEmpty(8).Min());var lastHour=Math.Max(20,Model.Entries.Select(e=>Math.Min(24,e.Time.Hour+(int)Math.Ceiling(e.Minutes/60d))).DefaultIfEmpty(20).Max());var hours=lastHour-startHour;}
<header class="ref-heading"><div><h1>Планы / Календарь</h1><p>Управляйте расписанием клиентов, назначайте тренировки и отслеживайте прогресс.</p></div><button class="ref-primary" type="button" data-dialog="coach-appointment-dialog"><reference-icon name="plus" />Назначить тренировку</button></header>
@if(Model.StatusMessage is {} message){<p class="ref-notice" role="status">@message</p>}<div asp-validation-summary="All" class="ref-notice" role="alert"></div>
<div class="ref-calendar-toolbar"><div style="display:flex;align-items:center;gap:8px"><a class="ref-icon" asp-route-Day="@Model.Day!.Value.AddDays(-7).ToString("yyyy-MM-dd")" aria-label="Предыдущая неделя">‹</a><a class="ref-secondary" asp-page="/Coaching/Calendar">Сегодня</a><a class="ref-icon" asp-route-Day="@Model.Day.Value.AddDays(7).ToString("yyyy-MM-dd")" aria-label="Следующая неделя">›</a><strong>@Model.Day.Value.ToString("MMMM yyyy",ru)</strong></div><span class="ref-pill">Неделя · @monday.ToString("d MMM",ru) — @monday.AddDays(6).ToString("d MMM",ru)</span></div>
<nav class="ref-week-strip ref-coach-mobile-days" aria-label="День недели">@for(var i=0;i<7;i++){var date=monday.AddDays(i);<a class="ref-week-day" asp-route-Day="@date.ToString("yyyy-MM-dd")" aria-current="@(date==Model.Day?"date":null)"><span>@date.ToString("ddd",ru)</span><strong>@date.Day</strong></a>}</nav>
<section class="ref-coach-calendar" aria-label="Недельное расписание"><div class="ref-time-corner"></div>@for(var i=0;i<7;i++){var date=monday.AddDays(i);<a class="ref-coach-day-head @(date==Model.Day?"is-selected":"")" asp-route-Day="@date.ToString("yyyy-MM-dd")" style="grid-column:@(i+2)"><strong>@date.ToString("ddd",ru)</strong><span>@date.ToString("d MMM",ru)</span></a>}
<div class="ref-time-labels" style="height:@(hours*52)px">@for(var h=startHour;h<=lastHour;h++){<span style="top:@((h-startHour)*52)px">@h.ToString("00"):00</span>}</div>
@for(var i=0;i<7;i++){var date=monday.AddDays(i);<div class="ref-coach-day-column @(date==Model.Day?"is-selected":"")" style="height:@(hours*52)px;grid-column:@(i+2)">@foreach(var entry in Model.Entries.Where(e=>e.Date==date)){<a class="ref-calendar-event @(entry.Status==WorkoutStatus.Completed?"is-completed":entry.Status==WorkoutStatus.Cancelled?"is-cancelled":"")" asp-page="/Coaching/Client" asp-route-id="@entry.ClientId" style="top:@(((entry.Time.Hour-startHour)*52+entry.Time.Minute*52/60))px;min-height:@(Math.Max(46,entry.Minutes*52/60))px"><span class="ref-client-initial">@entry.ClientName[..1]</span><span><strong>@entry.ClientName</strong><small>@entry.Title</small><time>@entry.Time.ToString("HH:mm") – @entry.Time.AddMinutes(entry.Minutes).ToString("HH:mm")</time></span><reference-icon name="@(entry.Status==WorkoutStatus.Completed?"check-circle":entry.Status==WorkoutStatus.Cancelled?"close":"play")" /></a>}</div>}
</section>
<section class="ref-coach-daily"><header class="ref-panel-heading"><h2>@Model.Day!.Value.ToString("dddd, d MMMM",ru)</h2><span class="ref-link">@todayEntries.Length занятий</span></header>@foreach(var entry in todayEntries){<article class="ref-coach-daily-entry"><time>@entry.Time.ToString("HH:mm")</time><a class="ref-schedule-row" asp-page="/Coaching/Client" asp-route-id="@entry.ClientId"><span class="ref-client-initial">@entry.ClientName[..1]</span><div><h3>@entry.ClientName</h3><p>@entry.Title</p><small>@entry.Time.ToString("HH:mm") – @entry.Time.AddMinutes(entry.Minutes).ToString("HH:mm")</small></div><reference-icon name="@(entry.Status==WorkoutStatus.Completed?"check-circle":entry.Status==WorkoutStatus.Cancelled?"close":"play")" /></a></article>}@if(todayEntries.Length==0){<div class="ref-panel ref-empty"><reference-icon name="calendar" /><h3>Время для нового занятия</h3><p>На этот день нет записей. Назначьте тренировку клиенту.</p><button class="ref-primary" type="button" data-dialog="coach-appointment-dialog">Назначить тренировку</button></div>}</section>
<div class="ref-two-col" style="margin-top:15px"><section class="ref-panel"><header class="ref-panel-heading"><h2>Предстоящие тренировки</h2><span class="ref-link">@Model.Entries.Count(e=>e.Status==WorkoutStatus.Planned) запланировано</span></header>@foreach(var entry in Model.Entries.Where(e=>e.Status==WorkoutStatus.Planned).Take(8)){<article class="ref-calendar-upcoming"><span class="ref-client-initial">@entry.ClientName[..1]</span><span><strong>@entry.ClientName</strong><small>@entry.Title</small></span><time>@entry.Date.ToString("d MMM",ru), @entry.Time.ToString("HH:mm")</time><a class="ref-primary" asp-page="/Coaching/Client" asp-route-id="@entry.ClientId">Открыть клиента</a><form method="post" asp-page-handler="Cancel" asp-route-Day="@Model.Day.Value.ToString("yyyy-MM-dd")"><input type="hidden" name="id" value="@entry.Id" /><button class="ref-icon" type="submit" aria-label="Отменить занятие: @entry.ClientName"><reference-icon name="close" /></button></form></article>}@if(!Model.Entries.Any(e=>e.Status==WorkoutStatus.Planned)){<p style="color:var(--ref-muted)">Назначенные занятия появятся здесь.</p>}</section><section class="ref-panel"><header class="ref-panel-heading"><h2>Занятия по программам</h2><a class="ref-link" asp-page="/Training/Programs/Index" asp-route-Tab="assigned">Все программы <reference-icon name="arrow" /></a></header>@foreach(var item in Model.Schedule.Where(s=>s.Time is null).Take(5)){<a class="ref-history-row" asp-page="/Coaching/Client" asp-route-id="@item.ClientId"><span class="ref-client-initial">@item.ClientName[..1]</span><span><strong>@item.ClientName</strong><small>@item.Workout · время не назначено</small></span><reference-icon name="chevron" /></a>}@if(Model.Schedule.Count==0){<p style="color:var(--ref-muted)">На выбранный день нет занятий по программам.</p>}</section></div>
<dialog class="app-dialog" id="coach-appointment-dialog"><div class="dialog-heading"><h2>Назначить тренировку</h2><button type="button" data-close aria-label="Закрыть"><reference-icon name="close" /></button></div><form class="ref-form-grid" method="post" asp-page-handler="Assign"><input type="hidden" asp-for="Input.RequestId" /><label class="ref-full">Клиент<select asp-for="Input.ClientId" required>@foreach(var client in Model.Clients){<option value="@client.Id">@client.Name</option>}</select></label><label class="ref-full">Тренировка<select asp-for="Input.WorkoutId" required>@foreach(var choice in Model.Choices){<option value="@choice.Id">@choice.Title</option>}</select></label><label>Дата<input asp-for="Input.Date" type="date" required /></label><label>Время<input asp-for="Input.Time" type="time" required /></label><label class="ref-full">Длительность, минуты<input asp-for="Input.Minutes" type="number" min="15" max="180" step="5" required /></label><button class="ref-primary ref-full" type="submit" disabled="@(Model.Clients.Count==0||Model.Choices.Count==0)">Назначить тренировку <reference-icon name="arrow" /></button></form></dialog>

