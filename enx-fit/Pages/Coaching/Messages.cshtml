@page "/Messages"
@model enx_fit.Pages.Coaching.MessagesModel
@{Layout="/Pages/Shared/Layouts/_DashboardReferenceLayout.cshtml";ViewData["Title"]="Сообщения";}
<header class="ref-heading"><div><h1>Сообщения</h1><p>Обсуждайте тренировки и оставайтесь на связи со своим тренером и клиентами.</p></div></header>
<div asp-validation-summary="All" class="ref-notice" role="alert"></div>
<div class="ref-messages-layout"><aside class="ref-panel ref-messages-contacts"><h2>Диалоги</h2>@foreach(var contact in Model.Contacts){<a class="ref-history-row" asp-route-ContactId="@contact.Id" aria-current="@(contact.Id==Model.ContactId?"page":null)"><span class="ref-client-initial">@contact.Name[..1]</span><strong>@contact.Name</strong><reference-icon name="chevron" /></a>}</aside><section class="ref-panel ref-message-thread">@if(Model.ContactId is {} id){<header class="ref-panel-heading"><h2>@Model.Contacts.First(c=>c.Id==id).Name</h2></header><div class="ref-messages" aria-label="История сообщений">@foreach(var entry in Model.Thread){<article class="ref-message @(entry.SenderId==Model.ViewerId?"is-own":"")"><p>@entry.Text</p><time>@entry.CreatedAtUtc.AddMinutes(Model.Offset).ToString("d MMM, HH:mm",System.Globalization.CultureInfo.GetCultureInfo("ru-RU"))</time></article>}@if(Model.Thread.Count==0){<div class="ref-empty"><reference-icon name="message" /><h3>Начните разговор</h3><p>Здесь можно обсудить план, упражнение или результаты тренировки.</p></div>}</div><form method="post" asp-route-ContactId="@id" class="ref-message-compose"><input type="hidden" asp-for="RequestId" /><label><span class="pa-sr">Сообщение</span><textarea asp-for="Text" placeholder="Напишите сообщение…" required maxlength="2000" rows="3"></textarea></label><button class="ref-primary" type="submit"><reference-icon name="arrow" />Отправить</button></form>}else{<div class="ref-empty"><reference-icon name="message" /><h3>Пока нет диалогов</h3><p>Диалог появится после подключения тренера или добавления клиента.</p></div>}</section></div>
