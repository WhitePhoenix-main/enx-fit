@using enx_fit.ViewModels.Progress
@model enx_fit.Pages.Progress.IndexModel
@{ var d=Model.Data; var p=d.Person; }
<nav class="ref-client-strip ref-progress-clients" aria-label="Выбор клиента">@foreach(var client in d.Clients){<a href="@Url.Page(null,new {Model.Weeks,SelectedClient=client.Id,Model.ClientMetric})" aria-current="@(client.Id==p?.Client.Id?"true":null)"><span class="rd-avatar">@client.Name[..1]</span><span><strong>@client.Name</strong><small>@client.Goal</small></span></a>}</nav>
@if(p is null){<section class="ref-panel ref-empty"><reference-icon name="users" /><h2>Здесь будет прогресс ваших клиентов</h2><p>Добавьте клиента, чтобы видеть замеры и результаты тренировок.</p><a class="ref-primary" asp-page="/Coaching/Clients">Открыть клиентов <reference-icon name="arrow" /></a></section>}
else{
    var weightChange=p.Measurement?.WeightKg-p.FirstMeasurement?.WeightKg;
    var fatChange=p.Measurement?.BodyFatPercent-p.FirstMeasurement?.BodyFatPercent;
    var attendance=p.Program?.Completion;
    var attendancePercent=attendance is null?ProgressOverview.Percent(p.WeekCompleted,p.WeeklyGoal):ProgressOverview.Percent(attendance.DoneDue,attendance.Due);
<div class="pa-coach-grid ref-client-progress">
<div class="ref-client-profile-row" id="client-detail">
<section class="ref-panel ref-client-progress-profile"><span class="ref-profile-portrait">@p.Client.Name[..1]</span><div><h2>@p.Client.Name</h2><p><reference-icon name="target" />Цель: @p.Client.Goal</p>@if(p.Measurement?.HeightCm>0){<p><reference-icon name="muscle" />Рост: @ProgressOverview.Number(p.Measurement.HeightCm) см</p>}<p><reference-icon name="document" />@(p.Program?.Program.Name??"Программа ещё не назначена")</p>@if(p.Program is {} program){<small>Неделя @program.Week из @program.Program.Weeks</small><div class="ref-meter"><i style="width:@ProgressOverview.Percent(program.Week,program.Program.Weeks)%"></i></div>}<a class="ref-link" asp-page="/Coaching/Client" asp-route-id="@p.Client.Id">Открыть профиль <reference-icon name="chevron" /></a></div></section>
<section class="ref-panel ref-client-metric"><reference-icon name="weight" /><small>Вес</small><strong>@(p.Measurement is {} body?ProgressOverview.Number(body.WeightKg)+" кг":"—")</strong><b class="pa-change">@ProgressOverview.Signed(weightChange," кг")</b><small>@p.Measurement?.Date.ToString("d MMM yyyy")</small></section>
<section class="ref-panel ref-client-metric ref-client-measures"><reference-icon name="target" /><small>Объёмы</small>@foreach(var(label,current) in new[]{("Талия",p.Measurement?.WaistCm),("Бёдра",p.Measurement?.HipCm),("Грудь",p.Measurement?.ChestCm),("Руки",p.Measurement?.ArmCm)}){<p><span>@label</span><strong>@(current is {} value?ProgressOverview.Number(value)+" см":"—")</strong></p>}</section>
<section class="ref-panel ref-client-metric"><reference-icon name="target" /><small>Процент жира</small><strong>@(p.Measurement?.BodyFatPercent is {} fat?ProgressOverview.Number(fat)+"%":"—")</strong><b class="pa-change">@ProgressOverview.Signed(fatChange," п.п.")</b><small>по замерам клиента</small></section>
<section class="ref-panel ref-client-metric"><reference-icon name="bars" /><small>Выполнение плана</small><strong>@attendancePercent%</strong><b class="pa-change">@p.WeekCompleted / @p.WeeklyGoal</b><small>тренировок на этой неделе</small></section>
</div>
<nav class="ref-tabs ref-progress-tabs" aria-label="Разделы прогресса клиента"><a href="@Url.Page(null,Model.Values(clientMetric:"weight"))#client-detail" aria-current="@(Model.ClientMetric=="weight"?"page":null)">Обзор</a><a href="@Url.Page(null,Model.Values(clientMetric:"attendance"))#client-chart" aria-current="@(Model.ClientMetric=="attendance"?"page":null)">Тренировки</a><a href="@Url.Page(null,Model.Values(clientMetric:"measurements"))#client-chart" aria-current="@(Model.ClientMetric=="measurements"?"page":null)">Замеры</a><a href="#client-photos">Фото</a><a href="#client-notes">Заметки</a><a asp-page="/Training/Plans" asp-route-ClientId="@p.Client.Id">План</a></nav>
<div class="ref-client-progress-grid">
<section class="pa-card ref-client-chart" id="client-chart"><header class="pa-card-heading"><h2>@(Model.ClientMetric=="strength"?"Динамика силы":Model.ClientMetric=="measurements"?"Динамика замеров":Model.ClientMetric=="attendance"?"Посещаемость":"Динамика веса")</h2><div class="pa-metric-tabs">@foreach(var(key,label) in new[]{("weight","Вес"),("strength","Сила"),("measurements","Объёмы")}){<a href="@Url.Page(null,Model.Values(clientMetric:key))#client-chart" aria-current="@(Model.ClientMetric==key?"page":null)">@label</a>}</div></header>
@if(Model.ClientMetric=="strength"){<select name="ChartExercise" form="progress-filters" aria-label="Упражнение клиента" data-progress-submit>@foreach(var exercise in d.Exercises){<option value="@exercise.Id" selected="@(exercise.Id==p.ExerciseId?.ToString())">@exercise.Name</option>}</select><partial name="_Chart" model="p.ExerciseChart" />}else if(Model.ClientMetric=="attendance"){<partial name="_Chart" model="p.AttendanceChart" />}else{<partial name="_Chart" model="p.BodyChart" />}</section>
<section class="pa-card ref-client-attendance"><h2>Посещаемость и выполнение</h2><div class="ref-attendance-body"><div class="pa-ring" style="--pa-percent:@attendancePercent%"><div><strong>@attendancePercent%</strong><small>выполнено</small></div></div><ul><li><i></i>Проведено <strong>@p.Completed</strong></li><li><i></i>На этой неделе <strong>@p.WeekCompleted</strong></li><li><i></i>Пропущено по плану <strong>@(attendance?.Missed??0)</strong></li><li><i></i>План на неделю <strong>@p.WeeklyGoal</strong></li></ul></div></section>
<section class="pa-card ref-client-photos" id="client-photos"><header class="pa-card-heading"><h2>Фото прогресса</h2><a asp-page="/Progress/Photos" asp-route-ClientId="@p.Client.Id">Все фото <reference-icon name="arrow" /></a></header>@if(Model.Photos.Count>0){<div class="ref-progress-photo-pair">@foreach(var photo in new[]{Model.Photos.First(),Model.Photos.Last()}.DistinctBy(x=>x.Id)){<figure><img src="@Url.Page("/Progress/Photos","Image",new {id=photo.Id,ClientId=p.Client.Id})" alt="Прогресс клиента от @photo.Date.ToString("d MMM yyyy")" /><figcaption>@photo.Date.ToString("d MMM yyyy")</figcaption></figure>}</div>}else{<a class="ref-photo-empty" asp-page="/Progress/Photos" asp-route-ClientId="@p.Client.Id"><reference-icon name="plus" /><span>Добавить фото<br /><small>Сравнение изменений по датам</small></span></a>}</section>
<section class="pa-card ref-client-key"><header class="pa-card-heading"><h2>Ключевые показатели</h2><a href="@Url.Page(null,Model.Values(clientMetric:"measurements"))#client-chart">Все параметры <reference-icon name="arrow" /></a></header><div class="ref-client-key-grid">@foreach(var(label,value,unit) in new[]{("Вес",(decimal?)p.Measurement?.WeightKg," кг"),("Талия",p.Measurement?.WaistCm," см"),("Процент жира",p.Measurement?.BodyFatPercent,"%")}){<div><small>@label</small><strong>@(value is {} n?ProgressOverview.Number(n)+unit:"Нет замера")</strong></div>}<div><small>Рабочих подходов</small><strong>@p.WorkingSets</strong></div></div></section>
<section class="pa-card ref-client-notes" id="client-notes"><header class="pa-card-heading"><h2>Заметки тренера</h2><button class="ref-link" type="button" data-progress-dialog="client-note-dialog"><reference-icon name="plus" />Изменить</button></header><p>@(string.IsNullOrWhiteSpace(Model.TrainerNote)?"Добавьте наблюдения по технике, самочувствию и прогрессу клиента.":Model.TrainerNote)</p><a class="ref-link" asp-page="/Coaching/Messages" asp-route-ContactId="@p.Client.Id">Обсудить с клиентом <reference-icon name="message" /></a></section>
<section class="pa-card ref-client-next"><header class="pa-card-heading"><h2>Следующие шаги</h2><a asp-page="/Training/Plans" asp-route-ClientId="@p.Client.Id">Изменить</a></header>@if(p.Program?.Next is {} next){<p><reference-icon name="calendar" />@next.Date.ToString("d MMMM")</p><strong>@next.Workout.Name</strong>}else{<p>Выберите следующую тренировку в плане клиента.</p>}<a class="ref-secondary" asp-page="/Coaching/Calendar">Открыть календарь <reference-icon name="arrow" /></a></section>
</div>
<details class="ref-panel ref-cohort-overview"><summary>Общий прогресс всех клиентов</summary><div class="ref-coach-summary"><div><small>Активных на этой неделе</small><strong>@d.ActiveClients / @d.CohortCount</strong></div><div><small>Выполнение программ</small><strong>@d.ProgramPercent%</strong></div><div><small>Изменение силы</small><strong>@ProgressOverview.Signed(d.TeamStrengthGain)</strong></div><div><small>Изменение объёма</small><strong>@ProgressOverview.Signed(d.TeamVolumeGain)</strong></div></div><partial name="_Chart" model="d.TeamChart" /><partial name="_Records" model="d.TeamRecords.Take(5).ToArray()" /></details>
</div>
<dialog class="rd-dialog" id="client-note-dialog"><div class="dialog-heading"><h2>Заметка тренера</h2><button type="button" data-progress-close aria-label="Закрыть"><reference-icon name="close" /></button></div><form method="post" asp-page-handler="Note"><input type="hidden" name="clientId" value="@p.Client.Id" /><input type="hidden" name="Weeks" value="@Model.Weeks" /><label>Наблюдения<textarea name="note" maxlength="1000" rows="6">@Model.TrainerNote</textarea></label><button class="ref-primary" type="submit">Сохранить заметку <reference-icon name="check" /></button></form></dialog>
}
