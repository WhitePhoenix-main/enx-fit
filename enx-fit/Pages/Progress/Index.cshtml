@page "/Dashboard/Progress"
@using enx_fit.Pages.Dashboard

@model enx_fit.Pages.Dashboard.DashboardModel
@{ Layout = "/Pages/Shared/Layouts/_DashboardReferenceLayout.cshtml"; ViewData["Title"] = "Прогресс"; }
@section Styles {
    <link rel="stylesheet" href="~/css/progress-reference.css" asp-append-version="true" />
    @if (!Model.Reference) { <link rel="stylesheet" href="~/css/progress-workspace.css" asp-append-version="true" /> }
}
@if (Model.Reference) { <partial name="/Pages/Shared/Dashboard/_DashboardProgress.cshtml" model="Model" /> }
else { <partial name="/Pages/Shared/Progress/_ProgressWorkspace.cshtml" model="Model" /> }
