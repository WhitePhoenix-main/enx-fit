@using enx_fit.ViewModels.Progress
@model enx_fit.Pages.Progress.IndexModel
@{var d=Model.Data;var p=d.Person!;var target=p.Program?.Next?.Workout.Exercises.FirstOrDefault(e=>e.ExerciseId==p.ExerciseId)??p.Program?.Next?.Workout.Exercises.OrderBy(e=>e.Order).FirstOrDefault();var targetWeight=target?.Prescription.WeightKg;var best=p.Records.FirstOrDefault(r=>r.ExerciseId==target?.ExerciseId&&r.Unit=="кг")?.Value;}
<div class="pa-coach-insights">
<section class="pa-card pa-interpretation"><h2><reference-icon name="idea" />Интерпретация тренера</h2><small class="pa-muted">На основе записей за @d.Weeks недель</small><p>@if(Model.ClientMetric=="weight"||Model.ClientMetric=="measurements"){@(p.FirstMeasurement is null?"Для сравнения нужны минимум два замера в выбранном периоде.":$"У клиента есть замеры с {p.FirstMeasurement.Date:d MMM} по {p.Measurement!.Date:d MMM}. Оцените изменение в контексте цели: {p.Client.Goal}.")}else if(Model.ClientMetric=="attendance"){<span>За выбранный период завершено тренировок с рабочими подходами: @p.Completed.</span>}else{@p.Interpretation}</p><p>Регулярность: @p.ActiveWeeks из @d.Weeks недель с тренировками.</p></section>
<section class="pa-card pa-goal"><header class="pa-card-heading"><h2><reference-icon name="target" />Следующая цель</h2>@if(targetWeight>0){<a asp-page="/Training/Programs/Edit" asp-route-id="@p.Program!.Program.Id">Изменить <reference-icon name="chevron" /></a>}else{<a asp-page="/Training/Plans" asp-route-ClientId="@p.Client.Id">Изменить <reference-icon name="chevron" /></a>}</header>@if(targetWeight is {} weight&&weight>0){<p>@target!.Exercise.Name · <strong>@ProgressOverview.Number(weight) кг</strong></p><div class="pa-meter"><i style="width:@(best.HasValue?Math.Min(100,(int)(best.Value*100/weight)):0)%"></i></div><small>Лучший вес за период: @(best.HasValue?ProgressOverview.Number(best.Value)+" кг":"нет записи") · цель следующей тренировки программы.</small>}else{<p>@p.Client.Goal</p><div class="pa-meter"><i style="width:@ProgressOverview.Percent(p.WeekCompleted,p.WeeklyGoal)%"></i></div><small>@p.WeekCompleted из @p.WeeklyGoal тренировок на этой неделе</small>}</section>
<partial name="_CoachAttention" model="d" />
</div>
