@using enx_fit.ViewModels.Progress
@model enx_fit.Pages.Progress.IndexModel
@{
    var d=Model.Data;var p=d.Person;
    var detail=p is not null&&(Model.SelectedClient is not null||Model.ClientId is not null||Model.ProgramId.HasValue);
    string Initials(string name)=>string.Concat(name.Split(' ',StringSplitOptions.RemoveEmptyEntries).Take(2).Select(x=>x[..1])).ToUpperInvariant();
}
@if(!detail){
    <nav class="mp-tabs" aria-label="Режим прогресса"><a asp-page="/Progress/Index" aria-current="page">Клиенты</a><a asp-page="/Progress/Index" asp-route-Personal="true" asp-route-Weeks="@d.Weeks">Мой прогресс</a></nav>
    <div class="mp-summary"><div><strong>@d.CohortCount</strong><span>клиентов</span></div><div><strong>@d.ActiveClients</strong><span>активны на неделе</span></div><div><strong>@d.Alerts.DistinctBy(x=>x.ClientId).Count()</strong><span>требуют внимания</span></div></div>
    @if(d.Alerts.Count>0){<section class="mp-card mp-clients-attention"><h2>Требуют внимания <i class="mp-status is-warning"></i></h2>@foreach(var alert in d.Alerts.DistinctBy(a=>a.ClientId).Take(3)){<a class="mp-row" asp-page="/Progress/Index" asp-route-SelectedClient="@alert.ClientId" asp-route-Weeks="@d.Weeks"><span class="mp-avatar">@Initials(alert.Name)</span><span><strong>@alert.Name</strong><small><i class="mp-status is-warning"></i>@alert.Reason</small></span><reference-icon name="chevron" /></a>}</section>}
    <section class="mp-card mp-clients"><header class="mp-card-heading"><h2>Все клиенты</h2><span class="mp-accent">@d.CohortCount</span></header><label class="mp-client-search"><reference-icon name="search" /><input type="search" placeholder="Найти клиента" aria-label="Найти клиента" data-client-search /></label>
        <div data-client-list>@foreach(var client in d.Clients){var activity=d.ClientActivity.FirstOrDefault(a=>a.ClientId==client.Id);var attention=d.Alerts.FirstOrDefault(a=>a.ClientId==client.Id);<a class="mp-row" data-client-name="@client.Name" asp-page="/Progress/Index" asp-route-SelectedClient="@client.Id" asp-route-Weeks="@d.Weeks"><span class="mp-avatar">@Initials(client.Name)</span><span><strong>@client.Name <i class="mp-status @(attention is null?"is-success":"is-warning")"></i></strong><small>@(activity?.LastDate?.ToString("d MMM")??"Нет тренировок") · @(attention?.Reason??"По плану")</small></span><reference-icon name="chevron" /></a>}</div>
        <p class="mp-empty" data-client-search-empty hidden>Клиент не найден.</p>
        @if(d.Clients.Count==0){<div class="mp-empty"><p>Здесь будет прогресс ваших клиентов.</p><a class="mp-secondary" asp-page="/Coaching/Clients">Добавить клиента</a></div>}
    </section><p class="mp-footnote"><reference-icon name="info" />Только назначенные тебе клиенты</p>
}else if(p is not null){
    var completion=p.Program?.Completion;var percent=completion is null?ProgressOverview.Percent(p.WeekCompleted,p.WeeklyGoal):ProgressOverview.Percent(completion.DoneDue,completion.Due);
    <a class="mp-back" asp-page="/Progress/Index" asp-route-Weeks="@d.Weeks"><reference-icon name="arrow" />Все клиенты</a>
    <section class="mp-client-profile"><span class="mp-avatar">@Initials(p.Client.Name)</span><div><h2>@p.Client.Name</h2><p class="mp-muted">Цель: @p.Client.Goal</p><p class="mp-muted"><reference-icon name="dumbbell-outline" />@(p.Program?.Program.Name??"Программа не назначена") @if(p.Program is {} pr){<span>· Неделя @pr.Week из @pr.Program.Weeks</span>}</p></div><a class="mp-accent" asp-page="/Coaching/Client" asp-route-id="@p.Client.Id">Профиль <reference-icon name="arrow" /></a></section>
    <nav class="mp-tabs" aria-label="Разделы прогресса клиента" data-progress-tabs><a href="#strength" aria-current="true">Сила</a><a href="#client-measurements">Замеры</a><a href="#client-notes">Заметки</a></nav>
    <div class="mp-summary"><div><strong>@p.Completed</strong><span>занятий</span></div><div><strong>@percent%</strong><span>@(completion is null?"недельной цели":"плана программы")</span></div><div><strong>@(completion?.Missed??0)</strong><span>пропуска</span></div></div>
    <div class="mp-coach-detail-grid"><div class="mp-section-group"><partial name="_MobileStrength" model="Model" />
    <a class="mp-card mp-row" asp-page="/Training/Plans" asp-route-ClientId="@p.Client.Id"><reference-icon name="calendar" /><span><strong>План тренировок</strong><small>Открыть или перенести занятие</small></span><reference-icon name="chevron" /></a>
    <a class="mp-card mp-row" href="#client-measurements"><reference-icon name="image" /><span><strong>Замеры и фото</strong><small>@(p.Measurement?.Date.ToString("d MMM")??"Пока нет замеров")</small></span><reference-icon name="chevron" /></a>
    <section class="mp-card mp-client-note" id="client-notes"><header class="mp-card-heading"><h3>Заметка тренера</h3><button class="mp-icon-button" type="button" data-progress-dialog="client-note-dialog" aria-label="Изменить заметку"><reference-icon name="pencil" /></button></header><p class="mp-muted">@(string.IsNullOrWhiteSpace(Model.TrainerNote)?"Добавьте наблюдения по тренировкам клиента.":Model.TrainerNote)</p></section></div>
    <section class="mp-section-group" id="client-measurements"><header class="mp-section-heading"><h2>Вес и замеры</h2></header><div class="mp-card mp-client-measurements"><partial name="_MobileChart" model="p.BodyChart" /><dl>@foreach(var(label,value,unit) in new[]{("Вес",(decimal?)p.Measurement?.WeightKg,"кг"),("Талия",p.Measurement?.WaistCm,"см"),("Грудь",p.Measurement?.ChestCm,"см"),("Бёдра",p.Measurement?.HipCm,"см"),("Руки",p.Measurement?.ArmCm,"см")}){<div><dt>@label</dt><dd>@(value is {} v?ProgressOverview.Number(v)+" "+unit:"—")</dd></div>}</dl><a class="mp-row" asp-page="/Progress/Photos" asp-route-ClientId="@p.Client.Id"><reference-icon name="image" /><span>Фото прогресса</span><reference-icon name="chevron" /></a></div></section></div>
    <dialog class="rd-dialog" id="client-note-dialog"><div class="dialog-heading"><h2>Заметка тренера</h2><button type="button" data-progress-close aria-label="Закрыть"><reference-icon name="close" /></button></div><form method="post" asp-page-handler="Note"><input type="hidden" name="clientId" value="@p.Client.Id" /><input type="hidden" name="Weeks" value="@d.Weeks" /><label>Наблюдения<textarea name="note" maxlength="1000" rows="6">@Model.TrainerNote</textarea></label><button class="mp-secondary" type="submit">Сохранить заметку</button></form></dialog>
}
