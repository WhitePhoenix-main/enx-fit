@using enx_fit.ViewModels.Progress
@model enx_fit.Pages.Progress.IndexModel
@{var d=Model.Data;var p=d.Person!;var minutes=Model.TotalSeconds/60;var records=p.Records.Count(r=>r.Gain is null or >0);}
<nav class="mp-tabs" aria-label="Разделы прогресса" data-progress-tabs><a href="#strength" aria-current="true">Сила</a>@if(d.Advanced){<a href="#workload">Нагрузка</a>}<a href="#consistency">Регулярность</a><a href="#body">Тело</a></nav>
<div class="mp-summary"><div><strong>@p.Completed</strong><span>тренировок</span></div><div><strong>@(minutes/60)<small> ч </small>@(minutes%60)<small> мин</small></strong><span>в зале</span></div><div><strong>@records</strong><span>рекорда</span></div></div>
<div class="mp-personal-grid">
<div class="mp-section-group">
    <partial name="_MobileStrength" model="Model" />
    @if(d.Advanced){
        <div class="mp-card mp-shortcuts"><button type="button" class="mp-row" data-progress-dialog="personal-records-dialog"><reference-icon name="trophy" /><span>Личные рекорды</span><b>@records</b><reference-icon name="chevron" /></button><a class="mp-row" asp-page="/Progress/ExerciseAnalytics/Index" asp-route-ExerciseId="@p.ExerciseId"><reference-icon name="history" /><span>Все результаты упражнения</span><reference-icon name="chevron" /></a></div>
        <a class="mp-card mp-row" asp-page="@(p.Program is null?"/Training/Programs/Index":"/Training/Programs/Details")" asp-route-id="@p.Program?.Program.Id" asp-route-Tab="progression"><reference-icon name="chart-outline" /><span><strong>Рекомендации программы</strong><small>По вашим выполненным подходам</small></span><reference-icon name="chevron" /></a>
    }
    @if(!d.Advanced){<partial name="_MobileRecords" model="Model" /><a class="mp-card mp-row" asp-page="/Training/Index" asp-route-View="history"><reference-icon name="history" /><span>История тренировок</span><reference-icon name="chevron" /></a>}
</div>
@if(d.Advanced){<dialog class="rd-dialog" id="personal-records-dialog"><div class="dialog-heading"><h2>Рекорды за период</h2><button type="button" data-progress-close aria-label="Закрыть"><reference-icon name="close" /></button></div><partial name="_MobileRecords" model="Model" /><a class="mp-secondary" asp-page="/Training/Index" asp-route-View="history">История тренировок</a></dialog>}
@if(d.Advanced){
<div id="workload" class="mp-section-group">
    <section class="mp-card mp-volume"><h2>Общий объём <reference-icon name="info" /></h2><strong class="mp-result">@ProgressOverview.Number(p.Volume) кг</strong><p class="mp-delta @(p.VolumeChange>0?"is-positive":p.VolumeChange<0?"is-negative":"")">@ProgressOverview.Signed(p.VolumeChange) <span class="mp-muted">к предыдущему периоду</span></p><partial name="_MobileChart" model="p.VolumeChart" /><div class="mp-volume-footer"><span>Ранее: <b>@ProgressOverview.Number(p.PreviousVolume) кг</b></span></div><p class="mp-footnote">Текущая неделя ещё не завершена</p></section>
    <section class="mp-card mp-muscles"><h2>Нагрузка по мышцам</h2><p class="mp-muted">Завершённые рабочие подходы</p><div class="mp-muscle-bars">@foreach(var muscle in p.Muscles){<div><span>@muscle.Name</span><i><b style="width:@(ProgressOverview.Percent(muscle.Count,p.Muscles.Select(x=>x.Count).DefaultIfEmpty(1).Max()))%"></b></i><strong>@muscle.Count</strong></div>}</div><p class="mp-muted"><b>@p.WorkingSets</b> рабочих подходов за период</p><p class="mp-footnote">Распределение подходов, не оценка восстановления.</p></section>
    <a class="mp-card mp-row" asp-page="/Progress/Photos"><reference-icon name="image" /><span><strong>Фото прогресса</strong><small>Добавить или сравнить по датам</small></span><reference-icon name="chevron" /></a>
    <a class="mp-card mp-row" href="#body"><reference-icon name="tape" /><span>Вес и замеры</span><b class="mp-accent">Все записи</b><reference-icon name="arrow" /></a>
</div>
}
<div class="mp-section-group" id="consistency"><header class="mp-section-heading"><h2>Регулярность</h2></header><section class="mp-card mp-consistency"><div class="mp-consistency-heading"><div><strong class="mp-result">@p.WeekCompleted <small>из @p.WeeklyGoal</small></strong><p class="mp-muted">тренировок на этой неделе</p></div><a asp-page="/Account/TrainingSetup" aria-label="Изменить цель"><reference-icon name="pencil" /><span>Изменить цель</span></a></div><div class="mp-days">@foreach(var day in p.Days){<a asp-page="/Training/Index" asp-route-View="calendar" asp-route-SelectedDate="@day.Date.ToString("yyyy-MM-dd")" class="@(day.Date==d.Today?"is-today":"")" aria-label="@day.Date.ToString("d MMMM"), тренировок: @day.Count"><small>@day.Date.ToString("ddd")</small><span>@day.Date.Day</span><i class="@(day.Count>0?"is-done":"")">@if(day.Count>0){<reference-icon name="check" />}</i>@if(day.Date==d.Today){<small>Сегодня</small>}</a>}</div><h3>Тренировки по неделям</h3><partial name="_MobileChart" model="p.AttendanceChart" /><p class="mp-footnote"><reference-icon name="info" />Текущая неделя ещё не завершена</p></section></div>
<div class="mp-section-group" id="body"><header class="mp-section-heading"><h2>Вес и замеры</h2><a asp-page="/Progress/Measurements/Index">Все <reference-icon name="arrow" /></a></header><section class="mp-card mp-body"><div class="mp-body-top"><div><h3>Вес тела</h3><strong class="mp-result">@(p.Measurement is {} body ? ProgressOverview.Number(body.WeightKg)+" кг":"—")</strong><p class="mp-muted">@ProgressOverview.Signed(p.Measurement?.WeightKg-p.FirstMeasurement?.WeightKg," кг") за период</p></div><partial name="_MobileChart" model="p.BodyChart" /></div><a class="mp-row" asp-page="/Progress/Measurements/Index"><reference-icon name="tape" /><span>Талия</span><strong>@(p.Measurement?.WaistCm is {} waist?ProgressOverview.Number(waist)+" см":"—")</strong><small>@ProgressOverview.Signed(p.Measurement?.WaistCm-p.FirstMeasurement?.WaistCm," см")</small><reference-icon name="chevron" /></a><a class="mp-secondary" asp-page="/Progress/Measurements/Index"><reference-icon name="plus" />Добавить замер</a></section>
@if(!d.Advanced){<a class="mp-card mp-row mp-upgrade" asp-page="/Account/Subscription"><span class="mp-pro-label">Pro</span><span><strong>Больше деталей прогресса</strong><small>Объём, оценка 1RM, сравнения и фото</small><b class="mp-accent">Посмотреть возможности →</b></span><reference-icon name="chevron" /></a>}
</div>
</div>
