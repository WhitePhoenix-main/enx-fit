@using enx_fit.ViewModels.Progress
@model enx_fit.Pages.Progress.IndexModel
@{var d=Model.Data;var p=d.Person!;var program=p.Program;var rhythm=ProgressOverview.Percent(p.WeekCompleted,p.WeeklyGoal);}
<div class="pa-personal-grid">
<section class="pa-card pa-rhythm"><h2>@(d.Advanced?"Текущий прогресс":p.WeekCompleted>0?"Вы в хорошем ритме":"Ваш ритм тренировок") <span class="pa-info" title="Завершённые тренировки календарной недели и ваш недельный ориентир." tabindex="0">ⓘ</span></h2><div class="pa-rhythm-body"><div class="pa-ring" style="--pa-percent:@(d.Advanced?Math.Min(100,p.Streak*100/Math.Max(1,d.Weeks)):rhythm)%"><div><reference-icon name="flame" /><strong>@(d.Advanced?p.Streak:p.WeekCompleted)</strong><small>@(d.Advanced?"недель подряд":"из "+p.WeeklyGoal)</small></div></div><div>@if(d.Advanced){<h3>@(p.Streak>0?"Продолжайте в своём темпе":"Каждая тренировка — начало")</h3><p>Серия недель с тренировками: @p.Streak. За выбранный период — @p.Completed занятий.</p>}else{<h3>@p.WeekCompleted из @p.WeeklyGoal тренировок<br />на этой неделе</h3><p>@(p.WeekCompleted>0?"Регулярные тренировки помогают видеть изменения. Двигайтесь в своём темпе.":"Начните с одной тренировки. Ваши результаты появятся здесь.")</p>}</div></div>@if(d.Advanced){<a class="pa-streak-link" asp-page="/Training/Index" asp-route-View="history"><reference-icon name="trophy" /><span>История вашего прогресса</span><reference-icon name="chevron" /></a>}</section>
<section class="pa-card pa-volume"><h2>Общий объём @(d.Advanced?"нагрузки":"тренировок") <span class="pa-info" title="Сумма веса × повторения завершённых рабочих подходов, включая дроп-сеты. Собственный вес не переводится в килограммы." tabindex="0">ⓘ</span></h2><div class="pa-big-line"><strong>@ProgressOverview.Number(p.Volume) <small>кг</small></strong>@if(p.VolumeChange.HasValue){<span class="pa-change @(p.VolumeChange<0?"is-down":"")">@ProgressOverview.Signed(p.VolumeChange)</span>}</div><p class="pa-muted">за выбранные @d.Weeks недель @if(d.Advanced){<span>· сравнение с предыдущими @d.Weeks неделями</span>}</p><partial name="_Chart" model="p.VolumeChart" /></section>
<section class="pa-card pa-top-records"><header class="pa-card-heading"><h2>@(d.Advanced?"Сила · оценка 1RM":"Личные рекорды") <span class="pa-info" title="@(d.Advanced?"Среднее изменение оценки 1RM по упражнениям, записанным минимум в два разных дня. Оценка по формуле Эпли, не измеренный максимум.":"Лучшие рабочие результаты выбранного периода. Изменение — относительно лучшего результата до периода.")" tabindex="0">ⓘ</span></h2><a asp-page="/Training/Records">Все <reference-icon name="chevron" /></a></header>@if(d.Advanced){<div class="pa-strength-summary"><strong class="pa-accent">@ProgressOverview.Signed(p.StrengthGain)</strong><small>среднее изменение<br />оценки силы</small></div>}<partial name="_Records" model="p.Records.Take(4).ToArray()" /></section>
<section class="pa-card pa-program"><header class="pa-card-heading"><h2>Текущая программа</h2><a asp-page="/Training/Programs/Index" aria-label="Все программы"><reference-icon name="chevron" /></a></header>@if(program is {} pr){<a class="pa-program-head" asp-page="/Training/Programs/Details" asp-route-id="@pr.Program.Id"><span class="pa-program-photo" aria-hidden="true"></span><span><strong>@pr.Program.Name</strong><small>Неделя @pr.Week из @pr.Program.Weeks</small><span class="pa-meter"><i style="width:@pr.Completion.Percent%"></i></span><em>@pr.Completion.Percent%</em></span></a><p class="pa-program-count">Выполнено по программе <strong>@pr.Completion.Done из @pr.Completion.Planned</strong></p><div class="pa-program-weeks" aria-label="Недели программы">@for(var i=1;i<=pr.Program.Weeks;i++){<span class="@(i==pr.Week?"is-current":i<pr.Week?"is-past":"")" title="Неделя @i">@i</span>}</div>@if(pr.Next is {} next){<a class="pa-next-program" asp-page="/Training/Programs/Details" asp-route-id="@pr.Program.Id"><reference-icon name="workout" /><span><small>Следующая тренировка · @next.Date.ToString("d MMM")</small><strong>@next.Workout.Name</strong></span><reference-icon name="chevron" /></a>}@if(pr.Phase is {} phase){<p class="pa-program-phase"><reference-icon name="muscle" />Текущий этап: @phase</p>}}else{<div class="pa-empty-text"><reference-icon name="calendar" /><p>Пока нет активной программы.</p><a class="pa-text-link" asp-page="/Training/Programs/Index">Подобрать программу <reference-icon name="arrow" /></a></div>}</section>
<section class="pa-card pa-exercise" id="progress-exercise"><header class="pa-card-heading"><h2>@(d.Advanced?"Аналитика упражнения":"Прогресс упражнения")</h2><label><span class="pa-sr">Упражнение на графике</span><select name="ChartExercise" form="progress-filters" data-progress-submit disabled="@(Model.ExerciseId.HasValue)">@foreach(var e in d.Exercises){<option value="@e.Id" selected="@(e.Id==p.ExerciseId?.ToString())">@e.Name</option>}</select></label></header>@if(d.Advanced){<nav class="pa-metric-tabs" aria-label="Метрика упражнения">@foreach(var(key,label) in Model.Metrics){<a href="@Url.Page(null,Model.Values(metric:key))#progress-exercise" aria-current="@(p.Metric==key?"page":null)">@label</a>}</nav>}
<div class="pa-exercise-stats"><div><small>@p.CurrentLabel</small><strong>@p.CurrentDisplay</strong><span>@(p.CurrentDate?.ToString("d MMM yyyy")??"Ещё нет данных")</span></div><div><small>Изменение</small><strong class="pa-change @(p.ExerciseChange<0?"is-down":"")">@ProgressOverview.Signed(p.ExerciseChange," "+p.Unit)</strong><span>за выбранный период</span></div><div><small>Лучший результат</small><strong>@(p.BestValue.HasValue?ProgressOverview.Number(p.BestValue.Value)+" "+p.Unit:"—")</strong><span>@p.ExerciseChart.Label</span></div><div><small>Всего подходов</small><strong>@p.ExerciseSets</strong><span>с этим упражнением</span></div></div><div class="pa-exercise-name"><reference-icon name="workout-outline" />@p.ExerciseName <span>@p.ExerciseChart.Label (@p.Unit)</span></div><partial name="_Chart" model="p.ExerciseChart" /></section>
<div class="pa-personal-insights"><section class="pa-card pa-interpretation"><h2><reference-icon name="idea" />Что это значит</h2><p>@p.Interpretation</p><div class="pa-tip"><reference-icon name="trend" /><span><strong>Совет</strong> Сравнивайте одинаковые упражнения и сохраняйте технику. Записывайте рабочий вес и повторения после каждого подхода.</span></div></section>
@if(d.Advanced){<section class="pa-card pa-recommendations"><header class="pa-card-heading"><h2><reference-icon name="brain" />Умные рекомендации <span class="rd-badge">Pro</span></h2>@if(program!=null){<a asp-page="/Training/Programs/Details" asp-route-id="@program.Program.Id">Все <reference-icon name="arrow" /></a>}</header>@if(p.Recommendation is {} recommendation){<p><reference-icon name="trend" />@recommendation.SuggestedChange</p><small>@recommendation.Reason</small><a class="pa-text-link" asp-page="/Training/Programs/Details" asp-route-id="@recommendation.TrainingProgramId">Посмотреть рекомендацию в программе <reference-icon name="arrow" /></a>}else{<p>Пока нет актуальных рекомендаций. Они рассчитываются в программе по вашим сопоставимым тренировкам.</p>@if(program!=null){<a class="pa-text-link" asp-page="/Training/Programs/Details" asp-route-id="@program.Program.Id">Открыть программу <reference-icon name="arrow" /></a>}}</section>}
<section class="pa-card pa-goal"><header class="pa-card-heading"><h2><reference-icon name="target" />Следующая цель</h2><a asp-page="@(program is null?"/Account/TrainingSetup":"/Training/Programs/Edit")" asp-route-id="@program?.Program.Id">Изменить <reference-icon name="chevron" /></a></header>@{var target=program?.Next?.Workout.Exercises.FirstOrDefault(e=>e.ExerciseId==p.ExerciseId)??program?.Next?.Workout.Exercises.OrderBy(e=>e.Order).FirstOrDefault();} @if(target?.Prescription.WeightKg is {} targetWeight && targetWeight>0){<p>@target.Exercise.Name · <strong>@ProgressOverview.Number(targetWeight) кг</strong></p><div class="pa-meter"><i style="width:@(p.Current is {} actual&&actual.ExerciseId==target.ExerciseId?Math.Min(100,(int)(actual.Weight*100/targetWeight)):0)%"></i></div><small>Предписание следующей тренировки программы.</small>}else{<p>Тренировок на неделю <strong>@p.WeekCompleted / @p.WeeklyGoal</strong></p><div class="pa-meter"><i style="width:@rhythm%"></i></div><small>Ваш ориентир регулярности.</small>}</section></div>
<section class="pa-card pa-muscles"><header class="pa-card-heading"><h2>Распределение нагрузки по мышцам <span class="pa-info" title="Количество завершённых рабочих подходов по основной мышце упражнения. Это распределение подходов, а не оценка восстановления." tabindex="0">ⓘ</span></h2></header><partial name="_Donut" model="p.Muscles" /><small class="pa-footnote">@p.WorkingSets рабочих подходов за @d.Weeks недель</small></section>
<section class="pa-card pa-consistency"><h2>@(d.Advanced?"Стабильность и самочувствие":"Стабильность тренировок") <span class="pa-info" title="Календарные недели, в которых есть минимум одна завершённая тренировка. Сегодняшняя неделя может быть неполной." tabindex="0">ⓘ</span></h2><p class="pa-muted">@p.ActiveWeeks из @d.Weeks недель с тренировками</p><div class="pa-week-days">@foreach(var day in p.Days){var future=day.Date>d.Today;<div><small>@enx_fit.Services.Programs.ProgramSchedule.DayNames[((int)day.Date.DayOfWeek+6)%7]</small><span class="@(day.Count>0?"is-done":future?"is-future":"")">@if(day.Count>0){<reference-icon name="check" />}</span><small>@day.Date.ToString("d MMM")</small></div>}</div><div class="pa-day-legend"><span><i class="is-done"></i>Тренировка</span><span><i></i>Нет записи</span><span><i class="is-future"></i>Впереди</span></div>@if(d.Advanced){<div class="pa-recovery"><div><small>Сон, среднее за 7 дней</small><strong>@(p.SleepHours.HasValue?ProgressOverview.Number(p.SleepHours.Value)+" ч":"Нет отметок")</strong></div><div><small>Самочувствие</small><strong>@(p.Feeling switch{3=>"Хорошее",2=>"Обычное",1=>"Нужен отдых",_=>"Нет отметок"})</strong></div><a asp-page="/Dashboard/Habits"><reference-icon name="leaf" />Записать самочувствие</a></div>}</section>
@if(d.Advanced){<section class="pa-card pa-bottom-records" id="progress-records"><header class="pa-card-heading"><h2>Личные рекорды</h2><a asp-page="/Training/Records">Все <reference-icon name="arrow" /></a></header><partial name="_Records" model="p.Records.Take(4).ToArray()" /></section>}else{<section class="pa-card pa-upgrade" id="progress-records"><reference-icon name="crown" /><h2>Для вас в Pro</h2><p>Ещё больше аналитики и персональные инсайты</p><ul><li><reference-icon name="lock" />Продвинутые графики прогресса</li><li><reference-icon name="lock" />Сравнение с прошлыми периодами</li><li><reference-icon name="lock" />Рекомендации по рабочим весам</li><li><reference-icon name="lock" />Оценка силы и динамика объёма</li></ul><a class="rd-primary" asp-page="/Account/Subscription">Узнать больше о Pro <reference-icon name="arrow" /></a><a class="pa-text-link" asp-page="/Training/Records">Все мои рекорды <reference-icon name="arrow" /></a></section>}
</div>
