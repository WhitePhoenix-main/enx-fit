@using enx_fit.ViewModels.Progress
@model IReadOnlyList<ProgressRecord>
<div class="pa-record-list">@foreach(var record in Model){<a class="pa-record" asp-page="@(record.ClientId is null?"/Progress/ExerciseAnalytics/Index":"/Coaching/Client")" asp-route-id="@record.ClientId" asp-route-ExerciseId="@(record.ClientId is null?record.ExerciseId:(Guid?)null)"><span class="pa-record-icon">@if(record.ClientName is {} name){<span class="pa-initial">@name[..1]</span>}else{<reference-icon name="workout-outline" />}</span><span class="pa-record-name">@if(record.ClientName is {} client){<strong>@client</strong><small>@record.Name</small>}else{<span>@record.Name</span>}</span><span class="pa-record-value"><strong>@ProgressOverview.Number(record.Value) @record.Unit</strong><small>@record.Date.ToString("d MMM")</small></span>@if(record.Gain is {} gain){<b class="pa-change @(gain<0?"is-down":"")">@ProgressOverview.Signed(gain," "+record.Unit)</b>}</a>}@if(Model.Count==0){<p class="pa-empty-text">Результаты появятся после завершённых тренировок.</p>}</div>
