@using enx_fit.ViewModels.Progress
@model enx_fit.Pages.Progress.IndexModel
@{var d=Model.Data;var p=d.Person!;var percent=ProgressOverview.Percent(p.WeekCompleted,p.WeeklyGoal);var weight=p.Measurement?.WeightKg;var delta=weight-p.FirstMeasurement?.WeightKg;var totalMinutes=Model.TotalSeconds/60;}
<div class="ref-progress-summary"><section class="ref-panel"><span class="ref-progress-stat-icon"><reference-icon name="scale" /></span><div><p>Текущий вес</p><strong>@(weight.HasValue?ProgressOverview.Number(weight.Value)+" кг":"—")</strong><small class="ref-success">@ProgressOverview.Signed(delta," кг")</small></div></section><section class="ref-panel"><span class="ref-progress-stat-icon"><reference-icon name="workout" /></span><div><p>Тренировок в неделю</p><strong>@p.WeekCompleted <small>из @p.WeeklyGoal</small></strong><small>ваш недельный ориентир</small></div></section><section class="ref-panel"><span class="ref-progress-stat-icon"><reference-icon name="flame" /></span><div><p>Калории (ср. / день)</p><strong>@(Model.AverageCalories?.ToString("N0")??"—")</strong><small>по записям дневника</small></div></section><section class="ref-panel"><span class="ref-progress-stat-icon"><reference-icon name="stopwatch" /></span><div><p>Общее время тренировок</p><strong>@(totalMinutes/60) ч @(totalMinutes%60) мин</strong><small>за выбранный период</small></div></section></div>
<div class="ref-free-progress-grid"><section class="ref-panel ref-free-rhythm"><header class="ref-panel-heading"><h2>Общий прогресс <reference-icon name="info" /></h2></header><div><div class="ref-ring" style="--ref-pct:@percent%"><div><strong>@percent%</strong><small>недельной цели</small></div></div><span><h3>@(p.WeekCompleted>0?"Вы на правильном пути!":"Каждая тренировка — начало")</h3><p>Продолжайте тренироваться и двигаться к своим целям.</p></span></div></section><section class="ref-panel ref-free-weight"><header class="ref-panel-heading"><h2>Вес и динамика</h2><span class="ref-pill">@d.Weeks недель</span></header><partial name="_Chart" model="p.BodyChart" /></section><section class="ref-panel ref-free-attendance"><header class="ref-panel-heading"><h2>Тренировки в неделю <reference-icon name="info" /></h2></header><p>@p.WeekCompleted из @p.WeeklyGoal тренировок</p><div class="ref-week-bars">@foreach(var day in p.Days){<span><i class="@(day.Count>0?"is-done":"")" style="--bar-height:@(day.Count>0?Math.Min(100,day.Count*40+30):45)%"></i><small>@day.Date.ToString("ddd",System.Globalization.CultureInfo.GetCultureInfo("ru-RU"))</small></span>}</div></section><section class="ref-panel ref-free-goals"><header class="ref-panel-heading"><h2>Мои цели</h2><a class="ref-link" asp-page="/Account/TrainingSetup">Все цели <reference-icon name="chevron" /></a></header><div class="ref-goal-row"><span class="ref-progress-stat-icon"><reference-icon name="workout" /></span><div><strong>Тренироваться @p.WeeklyGoal раза в неделю</strong><div class="ref-meter"><span style="width:@percent%"></span></div><small>@p.WeekCompleted из @p.WeeklyGoal</small></div><b>@percent%</b></div>@if(p.Program is {} program){<div class="ref-goal-row"><span class="ref-progress-stat-icon"><reference-icon name="document" /></span><div><strong>@program.Program.Name</strong><div class="ref-meter"><span style="width:@program.Completion.Percent%"></span></div><small>@program.Completion.Done из @program.Completion.Planned занятий</small></div><b>@program.Completion.Percent%</b></div>}else{<a class="ref-goal-row" asp-page="/Training/Programs/Index"><span class="ref-progress-stat-icon"><reference-icon name="target" /></span><div><strong>Подобрать план под свою цель</strong><small>Готовые программы и собственный план</small></div><reference-icon name="chevron" /></a>}</section></div>
<div class="ref-progress-locks">@foreach(var (title,copy,icon) in new[]{("Анализ состава тела","Процент жира, мышечная масса и динамика замеров.","body-scale"),("Подробная статистика","Объём нагрузки, рекорды и углублённый анализ.","bars"),("Рекомендации и инсайты","Персональные советы по вашим тренировочным результатам.","idea")}){<a class="ref-panel ref-progress-lock" asp-page="/Account/Subscription"><span class="ref-pill"><reference-icon name="crown" />Pro</span><h2>@title</h2><p>@copy</p><reference-icon class="ref-lock-art" name="@icon" /><span class="ref-secondary">Доступно в Pro <reference-icon name="chevron" /></span><reference-icon class="ref-lock" name="lock" /></a>}</div>
<details class="ref-panel ref-free-details"><summary>Прогресс упражнений и рекорды <reference-icon name="chevron" /></summary><div class="ref-panel-heading" style="margin-top:18px"><h2>@p.ExerciseName</h2><select name="ChartExercise" form="progress-filters" data-progress-submit aria-label="Выбрать упражнение">@foreach(var e in d.Exercises){<option value="@e.Id" selected="@(e.Id==p.ExerciseId?.ToString())">@e.Name</option>}</select></div><partial name="_Chart" model="p.ExerciseChart" /><partial name="_Records" model="p.Records.Take(4).ToArray()" /></details>
