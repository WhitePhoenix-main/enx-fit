@page "/404_page"
@using enx_fit.Pages.Errors

@model enx_fit.Pages.Errors.NotFoundModel
@{
    Layout = "/Pages/Shared/Layouts/_LandingLayout.cshtml";
    ViewData["Title"] = Model.HttpStatus == 404 ? "Страница не найдена" : "Страница недоступна";
}
<div class="public-page wrap public-error-page"><p class="eyebrow">@(Model.HttpStatus)</p><h1>@(Model.HttpStatus == 404 ? "Этот путь закончился." : "Сейчас сюда не перейти.")</h1><p>@(Model.HttpStatus == 404 ? "Возможно, ссылка устарела. Начни с главной или найди нужный ответ в справке." : "Не удалось открыть страницу. Вернись на главную или посмотри справку.")</p><div class="button-row"><a class="button button-primary" asp-page="/Public/Index">На главную</a><a class="button button-outline secondary" asp-page="/Public/Faq">Вопросы и ответы</a></div></div>
