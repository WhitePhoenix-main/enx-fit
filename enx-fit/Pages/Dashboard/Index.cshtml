@page "/Dashboard"
@using enx_fit.Pages.Dashboard

@using enx_fit.Presentation.Dashboard
@using enx_fit.ViewModels.Dashboard
@model enx_fit.Pages.Dashboard.DashboardModel
@{
    Layout = "/Pages/Shared/Layouts/_DashboardReferenceLayout.cshtml";
    ViewData["Title"] = Model.IsCoachView ? $"{Model.Data.Name} — дэшборд клиента" : "Мой дэшборд";
    var placements = Model.Reference ? DashboardWidgets.Defaults(false) : Model.Widgets;
}
<partial name="/Pages/Shared/Dashboard/_MobileHome.cshtml" model="Model" />
<div class="ef-desktop-screen">
@if (!Model.Reference) { <partial name="/Pages/Shared/Dashboard/_DashboardContext.cshtml" model="Model" /> }
@if (!Model.Reference && Model.ActiveWorkout is { } active)
{
    <a class="ef-resume" asp-page="/Training/Workouts/Details" asp-route-id="@active.Id"><span class="live-dot"></span><span><strong>Тренировка продолжается</strong> · @active.Title</span><span>Продолжить тренировку <admin-icon name="arrow" /></span></a>
}
@if (!Model.Reference && Model.Attention is { } attention) { <partial name="/Pages/Shared/Coaching/_CoachAttention.cshtml" model="attention" /> }
<section id="layout-editor" class="layout-editor" hidden aria-label="Настройка дэшборда">
    <div class="layout-editor-heading"><div><h2>Настроить виджеты</h2><p>Выберите карточки, их ширину и порядок.</p></div><div class="layout-actions"><button type="button" class="text-button" data-layout-reset>По умолчанию</button><button type="button" class="button secondary" data-layout-cancel>Отмена</button><button type="button" class="button" data-layout-save><admin-icon name="check" />Сохранить</button></div></div>
    <details class="widget-catalog" open><summary>Добавить или убрать блок <span data-widget-count></span></summary><div class="widget-catalog-grid">
        @foreach (var definition in DashboardWidgets.Catalog)
        {
            <label class="widget-option"><input type="checkbox" data-widget-toggle="@definition.Id" checked="@placements.Single(w => w.Id == definition.Id).Visible" /><admin-icon name="@definition.Icon" /><span><strong>@definition.Title</strong><small>@definition.Description</small></span></label>
        }
    </div></details>
    <p class="layout-help" id="widget-move-help">Приветствие закреплено первым. Перетаскивайте карточки за ручку или используйте кнопки и стрелки на клавиатуре.</p>
</section>
<p class="layout-feedback" role="status" aria-live="polite" data-layout-feedback hidden></p>
<div class="ef-grid" data-modular-dashboard data-layout-url="@Url.Page("/Dashboard/Index", "Layout", new { Model.ClientId })">
    @foreach (var placement in placements)
    {
        var definition = DashboardWidgets.Catalog.Single(w => w.Id == placement.Id);
        var pinned = placement.Id == DashboardWidgets.WelcomeId;
        <div class="dashboard-widget ef-widget" data-widget-id="@placement.Id" data-widget-title="@definition.Title" data-widget-width="@placement.Width" hidden="@(!placement.Visible)">
            <div class="widget-editbar" hidden>
                <button type="button" class="widget-drag-handle" data-widget-drag disabled="@pinned" aria-label="Переместить: @definition.Title" aria-describedby="widget-move-help"><admin-icon name="grip" /></button><span class="widget-edit-title">@definition.Title</span>
                <div class="widget-edit-actions"><button type="button" data-widget-move="-1" aria-label="Раньше: @definition.Title"><admin-icon name="up" /></button><button type="button" data-widget-move="1" aria-label="Позже: @definition.Title"><admin-icon name="down" /></button><button type="button" data-widget-hide aria-label="Скрыть: @definition.Title"><admin-icon name="close" /></button></div>
                <label class="widget-width-label"><span>Ширина</span><select data-widget-width-select aria-label="Ширина: @definition.Title">@foreach (var width in DashboardWidgets.Widths) { <option value="@width.Key" selected="@(width.Key == placement.Width)">@width.Value</option> }</select></label>
            </div>
            <partial name="/Pages/Shared/Dashboard/_DashboardWidget.cshtml" model="new DashboardWidgetViewModel(Model, placement.Id)" />
        </div>
    }
</div>
<footer class="ef-footer"><button type="button" class="ef-customize" data-layout-edit aria-expanded="false" aria-controls="layout-editor"><admin-icon name="settings" />Настроить виджеты</button></footer>
<div class="panel empty-dashboard" data-layout-empty hidden="@placements.Any(w => w.Visible)"><h2>Добавьте карточки на дэшборд</h2><button type="button" class="button" data-layout-edit>Добавить блоки</button></div>
<div hidden data-layout-token>@Html.AntiForgeryToken()</div>
<script type="application/json" id="dashboard-layout-data">@Html.Raw(System.Text.Json.JsonSerializer.Serialize(new { widgets = placements, defaults = DashboardWidgets.Defaults(Model.IsCoachView), pinnedWidgetId = DashboardWidgets.WelcomeId }, DashboardWidgets.JsonOptions))</script>
</div>
<partial name="/Pages/Shared/Dashboard/_DashboardDialogs.cshtml" model="Model" />
<partial name="/Pages/Shared/Dashboard/_HomeDayDialogs.cshtml" model="Model" />
<partial name="/Pages/Shared/Workouts/_QuickWorkoutDialogs.cshtml" model="Model" />
@section Styles { <link rel="stylesheet" href="~/css/home-interactive.css" asp-append-version="true" /> }
