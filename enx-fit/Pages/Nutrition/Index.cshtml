@page "/Nutrition"
@inject enx_fit.Security.IFeatureAccessService NutritionAccess
@model enx_fit.Pages.Nutrition.IndexModel
@{ Layout="/Pages/Shared/Layouts/_DashboardReferenceLayout.cshtml"; ViewData["Title"]="Питание"; var access=await NutritionAccess.GetAsync(); var d=Model.Data; var ru=System.Globalization.CultureInfo.GetCultureInfo("ru-RU");
   int Percent(int value,int goal)=>Math.Clamp((int)Math.Round(100d*value/Math.Max(1,goal)),0,100);
   string Photo(string name) { var n=name.ToLowerInvariant(); return n.Contains("йогурт")?"yogurt":n.Contains("лосос")||n.Contains("рыб")?"salmon":n.Contains("смузи")||n.Contains("коктейл")?"smoothie":n.Contains("овся")||n.Contains("каш")?"oats":"chicken"; }
}
<header class="ref-heading"><div><h1>Питание</h1><p>@(Model.Coach?"Планируйте и контролируйте питание клиентов. Отслеживайте рацион и корректируйте цели.":"Следите за рационом, получайте энергию и поддерживайте свои цели.")</p></div><div class="ref-heading-actions"><a class="ref-icon" asp-route-Day="@Model.Day!.Value.AddDays(-1).ToString("yyyy-MM-dd")" asp-route-ClientId="@Model.ClientId" aria-label="Предыдущий день">‹</a><strong>@Model.Day.Value.ToString("d MMMM",ru)</strong>@if(Model.Day<Model.Today){<a class="ref-icon" asp-route-Day="@Model.Day.Value.AddDays(1).ToString("yyyy-MM-dd")" asp-route-ClientId="@Model.ClientId" aria-label="Следующий день">›</a>}<a class="ref-secondary" asp-route-ClientId="@Model.ClientId">Сегодня</a></div></header>
@if(Model.Coach){<div class="ref-client-strip" aria-label="Выбор клиента"><a asp-page="/Nutrition/Index" asp-route-ClientId="@Model.ViewerId" aria-current="@(!Model.ViewingClient?"true":null)"><span class="ref-client-initial"><reference-icon name="user" /></span><strong>Мой дневник</strong></a>@foreach(var client in Model.Clients){<a asp-route-ClientId="@client.Id" asp-route-Day="@Model.Day.Value.ToString("yyyy-MM-dd")" aria-current="@(client.Id==Model.ClientId?"true":null)"><span class="ref-client-initial">@client.Name[..1]</span><span><strong>@client.Name</strong><small>Питание клиента</small></span></a>}</div>}
@if(Model.StatusMessage is {} message){<p class="ref-notice" role="status">@message</p>}
<div asp-validation-summary="All" class="ref-notice validation-summary" role="alert"></div>
@if(Model.ViewingClient){<p class="ref-notice">@Model.SubjectName · дневник питания и цели клиента</p>}
<nav class="ref-tabs" aria-label="Разделы питания"><a href="#nutrition-overview" aria-current="page">Обзор</a><a href="#meals">@(Model.Coach?"Текущий план":"Мои приёмы пищи")</a><a href="#recipes">Рецепты</a><button type="button" data-dialog="nutrition-goals-dialog">Цели питания</button></nav>
@if(access.Plan==SubscriptionPlan.Free){
<div class="ref-nutrition-top" id="nutrition-overview">
<section class="ref-panel"><header class="ref-panel-heading"><h2><reference-icon name="calendar" />Калории сегодня</h2><button class="ref-link" type="button" data-dialog="nutrition-goals-dialog">Настроить</button></header><div class="ref-calorie-content"><div class="ref-ring" style="--ref-pct:@Percent(d.Calories,d.Settings.Calories)%"><div><strong>@d.Calories.ToString("N0",ru)</strong><small>из @d.Settings.Calories.ToString("N0",ru) ккал</small></div></div><div class="ref-calorie-legend"><span><reference-icon name="flame" /><span><strong>@Math.Max(0,d.Settings.Calories-d.Calories).ToString("N0",ru)</strong><small>Осталось</small></span></span><span><reference-icon name="nutrition" /><span><strong>@d.Calories.ToString("N0",ru)</strong><small>Съедено</small></span></span><span><reference-icon name="target" /><span><strong>@d.Settings.Calories.ToString("N0",ru)</strong><small>Цель на день</small></span></span></div></div></section>
<section class="ref-panel ref-water"><header class="ref-panel-heading"><h2><reference-icon name="water" />Вода</h2><span class="ref-link">250 мл / стакан</span></header><div class="ref-water-glasses" aria-label="@d.WaterMl мл из @d.Settings.WaterMl мл">@for(var i=0;i<6;i++){<i class="@(d.WaterMl > i*d.Settings.WaterMl/6 ? "is-filled":"")"></i>}</div><p><strong>@((d.WaterMl/1000m).ToString("0.##",ru)) л</strong> из @((d.Settings.WaterMl/1000m).ToString("0.##",ru)) л</p>@if(!Model.ViewingClient){<form method="post" asp-page-handler="Water" asp-route-Day="@Model.Day.Value.ToString("yyyy-MM-dd")"><button class="ref-primary" type="submit" disabled="@(d.WaterMl>=10000)"><reference-icon name="plus" />Добавить стакан</button></form>}</section>
<section class="ref-panel"><header class="ref-panel-heading"><h2>Макронутриенты</h2><button class="ref-link" type="button" data-dialog="nutrition-goals-dialog">Цели <reference-icon name="chevron" /></button></header><partial name="_NutritionMacros" model="d" /></section>
</div>
<div class="ref-nutrition-grid"><section class="ref-panel" id="meals"><header class="ref-panel-heading"><h2>Мои приёмы пищи</h2>@if(!Model.ViewingClient){<button class="ref-primary" type="button" data-dialog="meal-dialog"><reference-icon name="plus" />Добавить</button>}</header><div class="ref-meal-list">@foreach(var meal in d.Meals){<article class="ref-meal"><design-photo kind="@Photo(meal.Name)" alt="@meal.Name" /><div class="ref-meal-body"><h3>@meal.Type <small>@meal.Time.ToString("HH:mm")</small></h3><p>@meal.Name</p></div><div class="ref-meal-macros"><strong>@meal.Calories ккал</strong><small>Б @meal.Protein г　Ж @meal.Fat г　У @meal.Carbs г</small></div>@if(!Model.ViewingClient){<button class="ref-icon" type="button" data-meal-delete="@meal.Id" data-meal-name="@meal.Name" data-dialog="delete-meal-dialog" aria-label="Удалить: @meal.Name"><reference-icon name="trash" /></button>}</article>}</div>@if(d.Meals.Count==0){<div class="ref-empty"><reference-icon name="nutrition" /><h3>Начните с первого приёма пищи</h3><p>Записывайте блюда, калории и макронутриенты — дневник покажет баланс за день.</p>@if(!Model.ViewingClient){<button class="ref-primary" type="button" data-dialog="meal-dialog"><reference-icon name="plus" />Добавить приём пищи</button>}</div>}</section>
<aside class="ref-habits"><section class="ref-panel"><header class="ref-panel-heading"><h2><reference-icon name="crown" />@d.Settings.Goal</h2></header><p style="color:var(--ref-muted);font-size:13px">Ваши дневные ориентиры: @d.Settings.Calories ккал и @d.Settings.Protein г белка. Их можно изменить под свой план.</p><button class="ref-secondary" type="button" data-dialog="nutrition-goals-dialog" style="margin-top:16px;width:100%">Изменить цель <reference-icon name="arrow" /></button></section><section class="ref-panel"><header class="ref-panel-heading"><h2>Полезные привычки</h2><a class="ref-link" asp-page="/Dashboard/Habits">Все <reference-icon name="chevron" /></a></header><div class="ref-habit"><reference-icon name="water" /><span>Пить достаточно воды<small>@d.WaterMl / @d.Settings.WaterMl мл</small></span>@if(d.WaterMl>=d.Settings.WaterMl){<reference-icon class="is-done" name="check-circle" />}</div><div class="ref-habit"><reference-icon name="nutrition" /><span>Записывать приёмы пищи<small>@d.Meals.Count записей за день</small></span>@if(d.Meals.Count>0){<reference-icon class="is-done" name="check-circle" />}</div><div class="ref-habit"><reference-icon name="target" /><span>Держать белок<small>@d.Protein / @d.Settings.Protein г</small></span>@if(d.Protein>=d.Settings.Protein){<reference-icon class="is-done" name="check-circle" />}</div></section></aside></div>
<header class="ref-panel-heading" id="recipes" style="margin-top:22px"><h2>Идеи для вашего рациона</h2></header><div class="ref-recipe-grid">@foreach(var (key,title,copy) in new[]{("oats","Овсяная каша с ягодами","Простой завтрак: овсяные хлопья, ягоды и йогурт."),("chicken","Куриная грудка с рисом","Белок, гарнир и овощи для полноценного обеда."),("salmon","Лосось с овощами","Рыба, брокколи и любимая зелень на ужин.")}){<article class="ref-panel ref-recipe"><design-photo kind="@key" /><div><h3>@title</h3><p>@copy</p>@if(!Model.ViewingClient){<button type="button" class="ref-link" data-recipe-name="@title" data-dialog="meal-dialog" style="margin-top:8px">Добавить в дневник <reference-icon name="arrow" /></button>}</div></article>}</div>
}else if(Model.Coach){<partial name="_CoachNutrition" model="Model" />}else{<partial name="_ProNutrition" model="Model" />}
<dialog class="app-dialog" id="meal-dialog"><div class="dialog-heading"><h2>Добавить приём пищи</h2><button type="button" data-close aria-label="Закрыть"><reference-icon name="close" /></button></div><form class="ref-form-grid" method="post" asp-page-handler="Meal" asp-route-Day="@Model.Day.Value.ToString("yyyy-MM-dd")"><label class="ref-full">Название блюда<input asp-for="Meal.Name" placeholder="Например, овсянка с ягодами" required maxlength="120" /></label><label>Приём пищи<select asp-for="Meal.Type">@foreach(var type in new[]{"Завтрак","Обед","Ужин","Перекус"}){<option>@type</option>}</select></label><label>Время<input asp-for="Meal.Time" type="time" required /></label><label>Калории, ккал<input asp-for="Meal.Calories" type="number" min="0" max="10000" required /></label><label>Белки, г<input asp-for="Meal.Protein" type="number" min="0" max="1000" required /></label><label>Жиры, г<input asp-for="Meal.Fat" type="number" min="0" max="1000" required /></label><label>Углеводы, г<input asp-for="Meal.Carbs" type="number" min="0" max="1500" required /></label><button class="ref-primary ref-full" type="submit"><reference-icon name="check" />Сохранить</button></form></dialog>
<dialog class="app-dialog" id="nutrition-goals-dialog"><div class="dialog-heading"><h2>@(Model.ViewingClient?"Цели питания клиента":"Дневные цели")</h2><button type="button" data-close aria-label="Закрыть"><reference-icon name="close" /></button></div><form class="ref-form-grid" method="post" asp-page-handler="Goals" asp-route-Day="@Model.Day.Value.ToString("yyyy-MM-dd")" asp-route-ClientId="@Model.ClientId"><label class="ref-full">Название цели<input asp-for="Goals.Title" required maxlength="120" /></label><label>Калории, ккал<input asp-for="Goals.Calories" type="number" min="800" max="10000" required /></label><label>Белки, г<input asp-for="Goals.Protein" type="number" min="0" max="500" required /></label><label>Жиры, г<input asp-for="Goals.Fat" type="number" min="0" max="500" required /></label><label>Углеводы, г<input asp-for="Goals.Carbs" type="number" min="0" max="1500" required /></label><label class="ref-full">Вода, мл<input asp-for="Goals.WaterMl" type="number" min="250" max="10000" step="250" required /></label><button class="ref-primary ref-full" type="submit">Сохранить цели <reference-icon name="check" /></button></form></dialog>
<dialog class="app-dialog" id="delete-meal-dialog"><div class="dialog-heading"><h2>Удалить приём пищи?</h2><button type="button" data-close aria-label="Закрыть"><reference-icon name="close" /></button></div><p data-delete-meal-caption></p><form method="post" asp-page-handler="Delete" asp-route-Day="@Model.Day.Value.ToString("yyyy-MM-dd")" style="margin-top:18px"><input name="id" type="hidden" data-delete-meal-id /><button class="ref-primary" type="submit">Удалить</button><button class="ref-secondary" type="button" data-close>Отмена</button></form></dialog>
@section Scripts{<script src="~/js/nutrition.js" asp-append-version="true"></script>}


