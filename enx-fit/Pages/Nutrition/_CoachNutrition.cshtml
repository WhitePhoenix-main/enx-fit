@model enx_fit.Pages.Nutrition.IndexModel
@{var d=Model.Data;int P(int v,int t)=>Math.Clamp(v*100/Math.Max(1,t),0,100); var energy=Math.Max(1,d.Settings.Protein*4+d.Settings.Fat*9+d.Settings.Carbs*4);var protein=d.Settings.Protein*400/energy;var fat=d.Settings.Fat*900/energy;}
<div class="ref-coach-nutrition-top"><section class="ref-panel ref-coach-nutrition-profile"><span class="ref-client-initial">@Model.SubjectName[..1]</span><div><h2>@Model.SubjectName</h2><p>@d.Settings.Goal</p><strong>Цель: @d.Settings.Calories ккал</strong><div class="ref-meter"><span style="width:@P(d.Calories,d.Settings.Calories)%"></span></div><small>@d.Calories из @d.Settings.Calories ккал записано сегодня</small></div></section><section class="ref-panel"><header class="ref-panel-heading"><h2>Целевые макронутриенты</h2><button class="ref-link" type="button" data-dialog="nutrition-goals-dialog">Настроить</button></header><div class="ref-calorie-content"><div class="ref-ring ref-macro-ring ref-macro-ring-coach" style="--macro-protein:@protein%;--macro-fat:@(protein+fat)%"><div><strong>@d.Settings.Calories.ToString("N0")</strong><small>ккал / день</small></div></div><div class="ref-coach-macro-list">@foreach(var(name,value,color)in new[]{("Белки",d.Settings.Protein,"#ff3155"),("Жиры",d.Settings.Fat,"#ffbc51"),("Углеводы",d.Settings.Carbs,"#10a5ff")}){<p><i style="background:@color"></i><span>@name</span><strong>@value г</strong></p>}</div></div></section><section class="ref-panel"><header class="ref-panel-heading"><h2>Прогресс за сегодня</h2><span class="ref-pill">Дневник</span></header><div class="ref-ring" style="--ref-pct:@P(d.Calories,d.Settings.Calories)%;margin:15px auto"><div><strong>@P(d.Calories,d.Settings.Calories)%</strong><small>от цели калорий</small></div></div><p style="text-align:center;color:var(--ref-muted);font-size:12px">@d.Meals.Count приёмов пищи записано</p></section></div>
<nav class="ref-tabs" aria-label="План питания клиента"><a href="#meals" aria-current="page">Текущий план</a><a href="#nutrition-plan-templates">Шаблоны планов</a><a asp-page="/Nutrition/Index" asp-route-ClientId="@Model.ClientId" asp-route-Day="@Model.Day!.Value.AddDays(-1).ToString("yyyy-MM-dd")">История</a><a asp-page="/Progress/Index" asp-route-SelectedClient="@Model.ClientId">Аналитика</a></nav>
<section class="ref-panel ref-coach-nutrition-plan"><span class="ref-progress-stat-icon"><reference-icon name="calendar" /></span><div><h2>@d.Settings.Goal</h2><p>@d.Settings.Calories ккал · Б @d.Settings.Protein г · Ж @d.Settings.Fat г · У @d.Settings.Carbs г</p></div><button class="ref-secondary" type="button" data-dialog="nutrition-goals-dialog"><reference-icon name="bars" />Скорректировать калории</button><a class="ref-secondary" asp-page="/Progress/Index" asp-route-SelectedClient="@Model.ClientId"><reference-icon name="document" />Посмотреть отчёт</a></section>
<div class="ref-coach-nutrition-bottom"><section class="ref-panel" id="meals"><header class="ref-panel-heading"><h2>Приёмы пищи (Сегодня)</h2><span class="ref-link">@Model.Day.Value.ToString("d MMM")</span></header>@foreach(var meal in d.Meals){<article class="ref-meal"><design-photo kind="@(meal.Type=="Завтрак"?"oats":meal.Type=="Ужин"?"salmon":meal.Type=="Перекус"?"yogurt":"chicken")" /><div class="ref-meal-body"><h3>@meal.Type <small>@meal.Time.ToString("HH:mm")</small></h3><p>@meal.Name</p><p>@meal.Calories ккал　Б @meal.Protein　Ж @meal.Fat　У @meal.Carbs</p></div><reference-icon name="check-circle" style="width:19px;color:var(--ref-success)" /></article>}@if(d.Meals.Count==0){<div class="ref-empty"><reference-icon name="nutrition" /><p>Клиент пока не добавил приёмы пищи на этот день.</p></div>}</section><section class="ref-panel" id="nutrition-plan-templates"><header class="ref-panel-heading"><h2>Шаблоны планов питания</h2><button class="ref-link" type="button" data-dialog="nutrition-goals-dialog">Настроить <reference-icon name="arrow" /></button></header>@foreach(var(name,key)in new[]{("Сбалансированное питание","chicken"),("Набор мышечной массы","salmon"),("Вегетарианский план","oats"),("Высокобелковый план","yogurt"),("Гибкий рацион","pancakes")}){<button class="ref-nutrition-template" type="button" data-plan-name="@name" data-dialog="nutrition-goals-dialog"><design-photo kind="@key" /><span><strong>@name</strong><small>Настроить калории и макронутриенты</small></span><reference-icon name="chevron" /></button>}</section><section class="ref-panel"><header class="ref-panel-heading"><h2>Последние чек-ины</h2></header>@foreach(var day in Model.History){<a class="ref-history-row" asp-page="/Nutrition/Index" asp-route-ClientId="@Model.ClientId" asp-route-Day="@day.Date.ToString("yyyy-MM-dd")"><design-photo kind="chicken" /><span><strong>@day.Calories ккал</strong><small>@day.Date.ToString("d MMM") · Б @day.Protein　Ж @day.Fat　У @day.Carbs</small></span><reference-icon name="chevron" /></a>}@if(Model.History.Count==0){<p class="ref-tip">За последние 7 дней пока нет записей о питании.</p>}<h3 style="margin-top:18px;font-size:14px">Вода и обратная связь</h3><div class="ref-habit"><reference-icon name="water" /><span>Вода<small>@d.WaterMl / @d.Settings.WaterMl мл</small></span></div><p class="ref-tip"><reference-icon name="message" />Обсудите с клиентом рацион и самочувствие.</p><a class="ref-primary" asp-page="/Coaching/Messages" asp-route-ContactId="@Model.ClientId" style="margin-top:15px;width:100%">Написать клиенту <reference-icon name="arrow" /></a></section></div>
