@model enx_fit.Pages.Nutrition.IndexModel
@{var d=Model.Data;int P(int value,int goal)=>Math.Clamp(value*100/Math.Max(1,goal),0,100);string Photo(string name){var n=name.ToLowerInvariant();return n.Contains("йогур")?"yogurt":n.Contains("овся")||n.Contains("каш")?"oats":n.Contains("лосос")||n.Contains("рыб")?"salmon":n.Contains("смузи")?"smoothie":"chicken";}}
<div class="ref-pro-nutrition-top"><section class="ref-panel ref-pro-nutrition-goals"><header class="ref-panel-heading"><h2><reference-icon name="calendar" />Дневные цели</h2><button class="ref-link" type="button" data-dialog="nutrition-goals-dialog"><reference-icon name="settings" />Настроить</button></header><div class="ref-pro-nutrition-goals-body"><div class="ref-ring" style="--ref-pct:@P(d.Calories,d.Settings.Calories)%"><div><strong>@d.Calories.ToString("N0")</strong><small>из @d.Settings.Calories.ToString("N0") ккал</small></div></div><div class="ref-macro">@foreach(var(label,value,target,icon)in new[]{("Белки",d.Protein,d.Settings.Protein,"muscle"),("Жиры",d.Fat,d.Settings.Fat,"flame"),("Углеводы",d.Carbs,d.Settings.Carbs,"leaf")}){<div class="ref-macro-row"><div><span><reference-icon name="@icon" />@label</span><small>@P(value,target)%</small></div><div>@value / @target г</div><div class="ref-meter"><span style="width:@P(value,target)%"></span></div></div>}</div></div></section>
<section class="ref-panel ref-pro-nutrition-target"><design-photo kind="hero-pro" /><div><span class="ref-pill"><reference-icon name="crown" />Питание под твою цель</span><h2>@d.Settings.Goal</h2><p>Ваш дневной ориентир: @d.Settings.Calories ккал. Настройте баланс белков, жиров и углеводов под свой план.</p><button type="button" class="ref-primary" data-dialog="nutrition-goals-dialog">Изменить цель <reference-icon name="arrow" /></button></div></section>
<section class="ref-panel ref-pro-nutrition-today"><header class="ref-panel-heading"><h2>Сегодня для тебя</h2></header><p class="ref-tip"><reference-icon name="muscle" /><span>Белок: @d.Protein из @d.Settings.Protein г</span></p><p class="ref-tip"><reference-icon name="flame" /><span>@Math.Max(0,d.Settings.Calories-d.Calories) ккал осталось до дневного ориентира</span></p><p class="ref-tip"><reference-icon name="water" /><span>@((d.WaterMl/1000m).ToString("0.##")) л воды за день</span></p></section></div>
<section class="ref-panel ref-pro-meals" id="meals"><header class="ref-panel-heading"><h2><reference-icon name="home-outline" />План питания на сегодня</h2><strong class="ref-link">@d.Calories.ToString("N0") / @d.Settings.Calories.ToString("N0") ккал</strong><button class="ref-secondary" type="button" data-dialog="meal-dialog"><reference-icon name="pencil" />Изменить план</button></header><div class="ref-meal-cards">@foreach(var meal in d.Meals){<article class="ref-meal-card"><header><strong>@meal.Type</strong><time>@meal.Time.ToString("HH:mm")</time></header><design-photo kind="@Photo(meal.Name)" alt="@meal.Name" /><h3>@meal.Name</h3><strong class="ref-link">@meal.Calories ккал</strong><p>Б @meal.Protein　Ж @meal.Fat　У @meal.Carbs</p><button class="ref-link" type="button" data-meal-delete="@meal.Id" data-meal-name="@meal.Name" data-dialog="delete-meal-dialog">Удалить <reference-icon name="trash" /></button></article>}<button class="ref-meal-card ref-meal-add" type="button" data-dialog="meal-dialog"><reference-icon name="plus" /><span>Добавить<br />приём пищи</span></button></div></section>
<div class="ref-pro-nutrition-bottom"><section class="ref-panel" id="recipes"><header class="ref-panel-heading"><h2><reference-icon name="spark" />Рекомендуем для твоей цели</h2></header><div class="ref-nutrition-recommendations">@foreach(var (key,title,tag) in new[]{("chicken","Куриная грудка с киноа","Белок и овощи"),("pancakes","Протеиновые панкейки","Быстро и вкусно"),("salmon","Лосось с овощами","Идея для ужина")}){<article class="ref-workout-card"><design-photo kind="@key" /><div><span class="ref-pill">@tag</span><h3>@title</h3><button class="ref-link" type="button" data-recipe-name="@title" data-dialog="meal-dialog">В дневник <reference-icon name="arrow" /></button></div></article>}</div></section><section class="ref-panel"><header class="ref-panel-heading"><h2><reference-icon name="nutrition" />Привычки в питании</h2><a class="ref-link" asp-page="/Dashboard/Habits">Настроить</a></header><div class="ref-habit"><reference-icon name="water" /><span>Пить воду<small>@d.WaterMl / @d.Settings.WaterMl мл</small><span class="ref-meter"><span style="width:@P(d.WaterMl,d.Settings.WaterMl)%"></span></span></span><form method="post" asp-page-handler="Water" asp-route-Day="@Model.Day!.Value.ToString("yyyy-MM-dd")"><button class="ref-icon" type="submit" aria-label="Добавить стакан воды"><reference-icon name="plus" /></button></form></div><div class="ref-habit"><reference-icon name="muscle" /><span>Держать белок<small>@d.Protein / @d.Settings.Protein г</small><span class="ref-meter"><span style="width:@P(d.Protein,d.Settings.Protein)%"></span></span></span></div><div class="ref-habit"><reference-icon name="nutrition" /><span>Вести дневник<small>@d.Meals.Count записей за день</small></span><reference-icon name="@(d.Meals.Count>0?"check-circle":"plus-circle")" /></div></section></div>
