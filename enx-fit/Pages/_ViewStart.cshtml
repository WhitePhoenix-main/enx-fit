@{
    var pagePath = ViewContext.RouteData.Values["page"]?.ToString() ?? "";
    var isManagementPage = new[] { "/Admin", "/Training/Workouts", "/Training/Exercises", "/Progress/Measurements" }
        .Any(prefix => pagePath.StartsWith(prefix + "/", StringComparison.OrdinalIgnoreCase));
    Layout = User.HasMinimumRole(UserRole.Administrator) && isManagementPage ? "/Pages/Shared/Layouts/_AdminLayout.cshtml" : "_Layout";
}
